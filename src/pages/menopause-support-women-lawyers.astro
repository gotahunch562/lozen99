---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const featureImage = "/images/for_lawyers.webp";

const title = "For Women Lawyers | Lozen Advisory";

const description =
  "Menopause support for women lawyers. Understand Tacere and protect your legal career trajectory through perimenopause. Request an invitation.";

const invitationHref =
  "mailto:hello@lozenadvisory.com?subject=Session%20Invitation%20Request";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "For Women Lawyers",
  description,
  url: "https://www.lozenadvisory.com/menopause-support-women-lawyers",
  publisher: {
    "@type": "Organization",
    name: "Lozen Advisory",
    url: "https://www.lozenadvisory.com",
  },
};
---

<BaseLayout>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(pageJsonLd)}
  ></script>

  <section class="relative overflow-hidden bg-base-950">
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-[radial-gradient(circle_at_12%_18%,rgba(250,204,21,0.13),transparent_30%),radial-gradient(circle_at_88%_18%,rgba(148,163,184,0.14),transparent_34%)]"
    >
    </div>

    <Wrapper variant="standard" class="relative z-10 py-24 lg:py-32">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,0.58fr)_minmax(22rem,0.42fr)] lg:items-end">
        <div class="max-w-4xl">
          <Text
            tag="span"
            variant="textSM"
            class="pl-4 font-medium uppercase tracking-wide border-l text-accent-300 font-display border-accent-500"
          >
            For Women Lawyers
          </Text>

          <Text
            tag="h1"
            variant="display2XL"
            class="mt-8 uppercase font-display text-white"
          >
            This conversation was built for one profession.
          </Text>

          <div class="mt-10 max-w-2xl space-y-5 border-l border-white/10 pl-6">
            <Text tag="p" variant="textLG" class="font-display text-base-100">
              You have spent years building something real inside a profession that does not slow down for anyone.
            </Text>

            <Text tag="p" variant="textBase" class="text-base-300">
              You found this because you were looking for something specific.
            </Text>

            <Text tag="p" variant="textBase" class="text-base-300">
              You are in the right place.
            </Text>
          </div>
        </div>

        <div class="overflow-hidden rounded-3xl border border-white/10 bg-base-900 shadow-2xl">
          <img
            src={featureImage}
            alt="Professional woman in a law office setting, representing the confidential advisory Lozen provides for women lawyers navigating menopause in legal practice."
            loading="eager"
            class="aspect-[4/5] h-full w-full object-cover opacity-82"
          />
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="bg-white">
    <Wrapper variant="narrow" class="py-16 lg:py-24">
      <div class="space-y-8">
        <Text
          tag="span"
          variant="textSM"
          class="font-medium uppercase tracking-wide text-accent-600"
        >
          Menopause in Legal Practice: What You Are Managing
        </Text>

        <Text
          tag="p"
          variant="displaySM"
          class="font-display text-base-900"
        >
          You are still delivering. Still the person clients call when the matter is unstable. Still the one who knows where everything is.
        </Text>

        <Text tag="p" variant="textLG" class="text-base-700">
          And you are navigating menopause inside an environment where that is not a conversation you can have.
        </Text>
      </div>
    </Wrapper>
  </section>

  <section class="bg-base-950">
    <Wrapper variant="narrow" class="py-12 text-center lg:py-16">
      <Text
        tag="p"
        variant="displayXS"
        class="font-display text-accent-300"
      >
        You are navigating menopause inside an environment where that is not a conversation you can have.
      </Text>
    </Wrapper>
  </section>

  <section class="bg-base-100">
    <Wrapper variant="standard" class="py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.32fr_1fr] lg:gap-20">
        <aside>
          <Text
            tag="span"
            variant="textSM"
            class="font-medium uppercase tracking-wide text-accent-600"
          >
            Tacere
          </Text>

          <div class="mt-6 border-l border-accent-500 pl-6">
            <Text
              tag="p"
              variant="displayMD"
              class="font-display italic text-base-900"
            >
              Tacere
            </Text>

            <Text
              tag="p"
              variant="textSM"
              class="mt-4 font-medium uppercase tracking-wide text-base-500"
            >
              /tah-cher-reh/
            </Text>

            <Text tag="p" variant="textSM" class="mt-2 italic text-base-500">
              From the Latin: to be silent, to withhold, to leave unmentioned.
            </Text>
          </div>
        </aside>

        <article class="max-w-3xl space-y-6">
          <Text
            tag="p"
            variant="displayXS"
            class="font-display text-base-900"
          >
            Not the silence of someone who has nothing to say. The silence of someone who has decided.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            For many women, this collision begins during the years when leadership responsibility and biological transition overlap. That pattern is examined in detail in{" "}
            <a
              href="/blog/women-lawyers-leadership-perimenopause"
              class="text-accent-700 underline decoration-accent-300 underline-offset-4 transition-colors hover:text-base-900"
            >
              When Leadership and Biology Collide Quietly in Law Firms
            </a>.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            You know this word even if you have never seen it. You have been practicing it since the first day you walked into a room where someone questioned whether you belonged there. In the courtroom where a bailiff directed you to the gallery. In the partnership meeting where you calculated, in real time, what it would cost to say what you actually thought. In the room where a man with a weaker record than yours sat at a table you have not been invited to yet.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            Tacere (tah-CHEH-reh) is the sustained, strategic practice of keeping one's own counsel by a senior executive operating in a professional environment where disclosure carries professional risk. Whether you are a senior associate building toward partner or a partner protecting what you have already earned, it is not hiding. It is not weakness. It is a calculation you have made with full awareness of the cost you are managing and full understanding of what visibility would risk.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            It accumulates without announcement. It does not appear in your billable hours, your performance review, or your bar record. When departure eventually comes, it is recorded as personal reasons.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            It was not personal. You were practicing tacere until the cost became too high to manage alone.
          </Text>

          <div class="my-10 rounded-3xl bg-base-950 p-6 shadow-2xl outline-4 outline-base-500/10 sm:p-8">
            <Text
              tag="p"
              variant="displayXS"
              class="font-display text-white"
            >
              <a
                href="/invisible-attrition"
                class="text-accent-300 transition-colors hover:text-accent-200"
              >
                Invisible Attrition℠
              </a>{" "}
              is what the profession never sees coming. Tacere is why.
            </Text>
          </div>

          <Text tag="p" variant="textBase" class="text-base-700">
            For a detailed examination of how this pattern operates inside law firm performance systems, read{" "}
            <a
              href="/blog/menopause-law-invisible-cost"
              class="text-accent-700 underline decoration-accent-300 underline-offset-4 transition-colors hover:text-base-900"
            >
              Menopause in Law: Visible Performance vs Invisible Cost
            </a>.
          </Text>

          <Text
            tag="p"
            variant="displayXS"
            class="font-display text-base-900"
          >
            You were never silent. You decided.
          </Text>
        </article>
      </div>
    </Wrapper>
  </section>

  <section class="bg-base-950">
    <Wrapper variant="narrow" class="py-12 text-center lg:py-16">
      <Text
        tag="p"
        variant="displayXS"
        class="font-display text-accent-300"
      >
        She is not managing a transition. She is protecting what she built.
      </Text>
    </Wrapper>
  </section>

  <section class="bg-white">
    <Wrapper variant="standard" class="py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.36fr_1fr] lg:gap-20">
        <aside>
          <Text
            tag="span"
            variant="textSM"
            class="font-medium uppercase tracking-wide text-accent-600"
          >
            Designed for Women Who Practice Law
          </Text>
        </aside>

        <article class="max-w-3xl space-y-6">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            This is not a wellness conversation.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            It is a professional strategy session designed for the realities of legal practice during menopause. How authority is read. How trajectory is protected. How standing is maintained when you are managing more than the room knows.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            The work is confidential, disclosure-independent, and built around the decisions that protect what you have already earned.
          </Text>
        </article>
      </div>
    </Wrapper>
  </section>

  <section class="bg-base-100">
    <Wrapper variant="standard" class="py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.36fr_1fr] lg:gap-20">
        <aside>
          <Text
            tag="span"
            variant="textSM"
            class="font-medium uppercase tracking-wide text-accent-600"
          >
            The Advisory Session
          </Text>
        </aside>

        <article class="max-w-3xl space-y-6">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display italic text-base-900"
          >
            How do you protect what you have built?
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            This session is built around that question.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            It is grounded in the realities of legal practice during menopause, specifically in periods where you are performing at a high level while managing pressures you have not chosen to disclose.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            You do not have to share anything about your own situation to get value from this session.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            The profession is beginning to document the scale of this challenge. The{" "}
            <a
              href="/blog/aba-study-women-lawyers-mental-health"
              class="text-accent-700 underline decoration-accent-300 underline-offset-4 transition-colors hover:text-base-900"
            >
              ABA 2026 Study on why women attorneys still leave Big Law
            </a>{" "}
            will confirm what many women already know. What it cannot resolve is the calculation that shapes whether disclosure feels safe.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            The format is brief framing followed by guided discussion. You can engage or simply listen.
          </Text>

          <div class="mt-10 grid gap-4 border-y border-base-200 py-8 md:grid-cols-3">
            <div>
              <Text
                tag="h3"
                variant="displayXS"
                class="font-display uppercase text-base-900"
              >
                45 Minutes
              </Text>
              <Text tag="p" variant="textBase" class="mt-3 text-base-700">
                Focused, structured, purposeful.
              </Text>
            </div>

            <div>
              <Text
                tag="h3"
                variant="displayXS"
                class="font-display uppercase text-base-900"
              >
                Private
              </Text>
              <Text tag="p" variant="textBase" class="mt-3 text-base-700">
                No intake form. No record.
              </Text>
            </div>

            <div>
              <Text
                tag="h3"
                variant="displayXS"
                class="font-display uppercase text-base-900"
              >
                By Invitation
              </Text>
              <Text tag="p" variant="textBase" class="mt-3 text-base-700">
                Open to women lawyers only.
              </Text>
            </div>
          </div>
        </article>
      </div>
    </Wrapper>
  </section>

  <section class="bg-base-950">
    <Wrapper variant="narrow" class="py-16 text-center lg:py-24">
      <Text
        tag="span"
        variant="textSM"
        class="font-medium uppercase tracking-wide text-accent-300"
      >
        Menopause support for women lawyers
      </Text>

      <Text
        tag="h2"
        variant="displaySM"
        class="mt-6 font-display italic text-white"
      >
        Request an Invitation
      </Text>

      <Text tag="p" variant="textBase" class="mt-5 text-base-200">
        All requests are confidential. A limited number of sessions are offered.
      </Text>

      <div class="mt-10 flex justify-center">
        <a
          href={invitationHref}
          class="inline-flex h-11 items-center justify-center rounded-lg bg-accent-300 px-5 py-4 text-center text-sm font-medium uppercase tracking-wide text-base-950 transition-all duration-500 ease-in-out hover:bg-accent-400 focus:outline-2 focus:outline-offset-4 focus:outline-accent-400"
        >
          Request an Invitation
        </a>
      </div>

      <Text
        tag="p"
        variant="textSM"
        class="mt-8 font-medium uppercase tracking-wide text-accent-300"
      >
        This session is open to women lawyers only.
      </Text>
    </Wrapper>
  </section>
</BaseLayout>
