---
import BaseLayout from "@/layouts/BaseLayout.astro";
import InternalPageHero from "@/components/fundations/sections/InternalPageHero.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const effectiveDate = "May 13, 2026";
const title = "Privacy Policy | Lozen Advisory";

const description = "Read Lozen Advisory’s privacy policy, including how website information, communications, forms, and inquiry data are collected and protected.";

const dateModified = "2026-05-19";
---

<BaseLayout title={title} description={description}>
  <InternalPageHero
    eyebrow="Privacy"
    title="Privacy Policy"
    deck="How Lozen Advisory handles information submitted through this website."
  />

  <section>
    <Wrapper variant="narrow" class="py-12 lg:py-20">
      <div class="space-y-12">
        <section class="space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            1. Overview
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            Lozen Advisory LLC provides advisory services, executive briefings,
            research-based analysis, and related resources. This Privacy Policy
            applies to information collected through lozenadvisory.com, related
            website forms, email communications, scheduling workflows, payment
            workflows, and other intake or inquiry channels connected to Lozen
            Advisory services.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            By using this website or submitting information to Lozen Advisory,
            you acknowledge that you have read this Privacy Policy.
          </Text>
        </section>

        <section class="space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            2. Information We Collect
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            We may collect information you provide directly, including your
            name, email address, phone number, organization, title, company size,
            inquiry details, scheduling information, payment-related information,
            and any other information you choose to submit through a form,
            intake process, email, or other communication.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            We may also collect limited technical information automatically when
            you visit the website, including browser type, device information,
            pages visited, referring pages, approximate location derived from
            technical signals, and other analytics or usage information.
          </Text>
        </section>

        <section class="space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            3. Sensitive Information
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            Lozen Advisory does not require visitors to submit health details,
            medical records, diagnoses, employment records, legal claims,
            protected status information, or other sensitive personal information
            through public website forms.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            Do not submit sensitive information through public forms unless
            Lozen Advisory specifically requests that information through an
            appropriate intake process. Submission of information through this
            website does not create a medical, legal, fiduciary, therapeutic, or
            employment advisory relationship.
          </Text>
        </section>

        <section class="space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            4. How We Use Information
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            Lozen Advisory may use collected information to respond to
            inquiries, evaluate briefing requests, schedule advisory sessions,
            provide services, process payments, send service-related
            communications, maintain records, improve website performance,
            understand audience interest, protect the website and business, and
            comply with legal or operational obligations.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            We may also use aggregated or de-identified information to understand
            website performance, content engagement, service interest, and
            general business trends. Aggregated or de-identified information is
            not intended to identify a specific individual.
          </Text>
        </section>

        <section class="space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            5. Cookies and Analytics
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            The website may use cookies, analytics tools, hosting logs, security
            tools, or similar technologies to operate the site, measure traffic,
            understand how visitors interact with content, diagnose technical
            issues, and improve performance.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            You may be able to limit cookies through your browser settings.
            Blocking cookies may affect how some website features operate.
          </Text>
        </section>

        <section class="space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            6. Payment, Scheduling, and Third-Party Tools
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            Lozen Advisory may use third-party service providers for website
            hosting, email delivery, analytics, scheduling, payment processing,
            form management, file storage, customer communication, security, and
            other operational functions.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            These providers may process information only as necessary to perform
            services for Lozen Advisory or as otherwise described in their own
            privacy terms. Payment information is generally processed by payment
            providers and is not stored directly by Lozen Advisory unless
            otherwise stated in a specific transaction workflow.
          </Text>
        </section>

        <section class="space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            7. How We Share Information
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            Lozen Advisory does not sell personal information. We may share
            information with service providers who support business operations,
            with professional advisors when necessary, in connection with a
            business transaction, to comply with applicable law, to protect
            rights and security, or with your consent.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            We may disclose information if required by law, regulation, legal
            process, subpoena, court order, or government request, or when we
            believe disclosure is necessary to protect the rights, safety, or
            security of Lozen Advisory, website users, clients, or others.
          </Text>
        </section>

        <section class="space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            8. Data Retention
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            We retain information for as long as reasonably necessary to provide
            services, respond to inquiries, maintain business records, comply
            with legal obligations, resolve disputes, enforce agreements, and
            support legitimate business purposes.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            Retention periods may vary depending on the type of information, the
            nature of the relationship, operational requirements, and applicable
            legal or accounting obligations.
          </Text>
        </section>

        <section class="space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            9. Security
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            Lozen Advisory uses reasonable administrative, technical, and
            organizational measures designed to protect information from
            unauthorized access, loss, misuse, alteration, or disclosure.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            No website, email transmission, storage system, or internet-based
            service can be guaranteed to be completely secure. You submit
            information at your own risk.
          </Text>
        </section>

        <section class="space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            10. Your Choices
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            You may contact Lozen Advisory to request access, correction, or
            deletion of personal information you have provided, subject to
            applicable law, identity verification, business record obligations,
            and legal retention requirements.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            You may also unsubscribe from non-transactional email communications
            by using the unsubscribe mechanism provided in the message, when
            available, or by contacting Lozen Advisory directly.
          </Text>
        </section>

        <section class="space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            11. Children’s Privacy
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            This website and Lozen Advisory services are intended for adults and
            professional audiences. We do not knowingly collect personal
            information from children under the age of 13. If you believe a
            child has provided personal information through this website, contact
            us so we can review and delete the information where appropriate.
          </Text>
        </section>

        <section class="space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            12. External Links
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            This website may link to third-party websites, platforms, articles,
            tools, payment processors, scheduling systems, or resources. Lozen
            Advisory is not responsible for the privacy practices, policies, or
            content of third-party websites or services.
          </Text>
        </section>

        <section class="space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            13. Updates to This Policy
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            Lozen Advisory may update this Privacy Policy from time to time. The
            updated version will be posted on this page with a revised effective
            date. Continued use of the website after an updated policy is posted
            means you acknowledge the updated policy.
          </Text>
        </section>

        <section
          class="rounded-3xl bg-base-950 p-6 shadow-2xl outline-4 outline-base-500/10 sm:p-8"
        >
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-white"
          >
            14. Contact Information
          </Text>

          <div class="mt-6 space-y-2">
            <Text tag="p" variant="textBase" class="text-base-200">
              Lozen Advisory LLC
            </Text>
            <Text tag="p" variant="textBase" class="text-base-200">
              8401 Mayland Dr # 7597
            </Text>
            <Text tag="p" variant="textBase" class="text-base-200">
              Richmond, VA 23294
            </Text>
            <Text tag="p" variant="textBase" class="text-base-200">
              <a
                href="mailto:hello@lozenadvisory.com"
                class="text-accent-300 transition-colors hover:text-accent-200"
              >
                hello@lozenadvisory.com
              </a>
            </Text>
          </div>
        </section>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
