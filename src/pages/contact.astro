---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout>
  <section class="bg-gradient-to-t from-base-200 to-white">
    <Wrapper variant="standard" class="py-24 lg:py-32">
      <div class="max-w-3xl">
        <Text
          tag="span"
          variant="textSM"
          class="pl-4 font-medium uppercase border-l text-base-900 font-display border-accent-500"
        >
          Contact
        </Text>
        <Text
          tag="h1"
          variant="displayXL"
          class="mt-8 uppercase font-display text-base-900"
        >
          We'd Love to Hear From You
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="mt-4 text-base-600 text-balance"
        >
          Questions, media requests, and general inquiries are welcome here.
        </Text>
      </div>
    </Wrapper>
  </section>
  <section>
    <Wrapper variant="standard" class="py-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          <Text
            tag="h2"
            variant="textLG"
            class="text-base-900 font-bold uppercase"
          >
            Send us a message
          </Text>
          <form class="space-y-8 mt-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label
                  for="first-name"
                  class="text-sm font-medium text-base-900 font-display uppercase"
                  >First Name</label
                >
                <input
                  type="text"
                  id="first-name"
                  name="first-name"
                  class="w-full rounded-lg border border-base-200 bg-base-50 px-4 py-3 text-base-900 placeholder:text-base-400 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500 transition-all duration-200"
                  required
                />
              </div>
              <div class="space-y-2">
                <label
                  for="last-name"
                  class="text-sm font-medium text-base-900 font-display uppercase"
                  >Last Name</label
                >
                <input
                  type="text"
                  id="last-name"
                  name="last-name"
                  class="w-full rounded-lg border border-base-200 bg-base-50 px-4 py-3 text-base-900 placeholder:text-base-400 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500 transition-all duration-200"
                  required
                />
              </div>
            </div>
            <div class="space-y-2">
              <label
                for="email"
                class="text-sm font-medium text-base-900 font-display uppercase"
                >Email Address</label
              >
              <input
                type="email"
                id="email"
                name="email"
                class="w-full rounded-lg border border-base-200 bg-base-50 px-4 py-3 text-base-900 placeholder:text-base-400 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500 transition-all duration-200"
                required
              />
            </div>
            <div class="space-y-2">
              <label
                for="message"
                class="text-sm font-medium text-base-900 font-display uppercase"
                >How can we help?</label
              >
              <textarea
                id="message"
                name="message"
                rows="6"
                class="w-full rounded-lg border border-base-200 bg-base-50 px-4 py-3 text-base-900 placeholder:text-base-400 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500 transition-all duration-200"
                placeholder="Tell us what is on your mind."
              ></textarea>
            </div>
            <Button size="sm" variant="default" type="submit" class="w-fit">
              Send Message
            </Button>
          </form>
        </div>
        <!-- Sidebar -->
        <div>
          <aside class="lg:sticky lg:top-32">
            <div
              class="flex flex-col bg-white shadow-2xl rounded-3xl outline-4 outline-base-500/10 divide-y divide-base-500/10"
            >
              <div class="p-6">
                <Text
                  tag="h3"
                  variant="textLG"
                  class="font-medium uppercase font-display text-base-900"
                >
                  General Inquiries
                </Text>
                <Text tag="p" variant="textBase" class="mt-4 text-base-600">
                  Use the form to reach us with questions about our work, speaking requests, or anything else.
                </Text>
              </div>
              <div class="p-6">
                <Text
                  tag="h3"
                  variant="textLG"
                  class="font-medium uppercase font-display text-base-900"
                >
                  Media Requests
                </Text>
                <Text tag="p" variant="textBase" class="mt-4 text-base-600">
                  For press inquiries, interview requests, and editorial opportunities, reach us directly.
                </Text>
                <div class="mt-6">
                  <a
                    href="mailto:media@lozenadvisory.com"
                    class="text-accent-600 font-medium hover:text-accent-700 transition-colors text-lg"
                  >
                    media@lozenadvisory.com
                  </a>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
