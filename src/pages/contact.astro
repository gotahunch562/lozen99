---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import InternalPageHero from "@/components/fundations/sections/InternalPageHero.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const title = "Contact Lozen Advisory | Strategic Briefings & Advisory Inquiries";

const description = "Contact Lozen Advisory for strategic briefings, media requests, speaking inquiries, and advisory work on disclosure-dependent workforce risk.";

---

<BaseLayout title={title} description={description}>
  <InternalPageHero
    eyebrow="Contact"
    title="Contact Lozen Advisory"
    deck="Questions, media requests, and general inquiries are welcome here."
  />
  <section>
    <Wrapper variant="standard" class="py-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          <Text
            tag="h2"
            variant="textLG"
            class="text-base-900 font-bold uppercase"
          >
            Send us a message
          </Text>
          <form
            id="contact-inquiry-form"
            data-inquiry-type="contact"
            class="space-y-8 mt-8"
          >
            <div class="hidden" aria-hidden="true">
              <label for="contact-inquiry-form-website">Website</label>
              <input
                type="text"
                id="contact-inquiry-form-website"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label
                  for="first-name"
                  class="text-sm font-medium text-base-900 font-display uppercase"
                  >First Name</label
                >
                <input
                  type="text"
                  id="first-name"
                  name="first-name"
                  class="w-full rounded-lg border border-base-200 bg-base-50 px-4 py-3 text-base-900 placeholder:text-base-400 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500 transition-all duration-200"
                  required
                />
              </div>
              <div class="space-y-2">
                <label
                  for="last-name"
                  class="text-sm font-medium text-base-900 font-display uppercase"
                  >Last Name</label
                >
                <input
                  type="text"
                  id="last-name"
                  name="last-name"
                  class="w-full rounded-lg border border-base-200 bg-base-50 px-4 py-3 text-base-900 placeholder:text-base-400 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500 transition-all duration-200"
                  required
                />
              </div>
            </div>
            <div class="space-y-2">
              <label
                for="email"
                class="text-sm font-medium text-base-900 font-display uppercase"
                >Email Address</label
              >
              <input
                type="email"
                id="email"
                name="email"
                class="w-full rounded-lg border border-base-200 bg-base-50 px-4 py-3 text-base-900 placeholder:text-base-400 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500 transition-all duration-200"
                required
              />
            </div>
            <div class="space-y-2">
              <label
                for="message"
                class="text-sm font-medium text-base-900 font-display uppercase"
                >How can we help?</label
              >
              <textarea
                id="message"
                name="message"
                rows="6"
                class="w-full rounded-lg border border-base-200 bg-base-50 px-4 py-3 text-base-900 placeholder:text-base-400 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500 transition-all duration-200"
                placeholder="Tell us what is on your mind."
              ></textarea>
            </div>
            <Button size="sm" variant="default" type="submit" class="w-fit">
              Send Message
            </Button>
          
            <p
              id="contact-inquiry-status"
              class="font-sans text-base font-semibold text-base-800"
              role="status"
              aria-live="polite"
            >
            </p>
          </form>
        </div>
        <!-- Sidebar -->
        <div>
          <aside class="lg:sticky lg:top-32">
            <div
              class="flex flex-col bg-white shadow-2xl rounded-3xl outline-4 outline-base-500/10 divide-y divide-base-500/10"
            >
              <div class="p-6">
                <Text
                  tag="h3"
                  variant="textLG"
                  class="font-medium uppercase font-display text-base-900"
                >
                  General Inquiries
                </Text>
                <Text tag="p" variant="textBase" class="mt-4 text-base-600">
                  Use the form to reach us with questions about our work, speaking requests, or anything else.
                </Text>
              </div>
              <div class="p-6">
                <Text
                  tag="h3"
                  variant="textLG"
                  class="font-medium uppercase font-display text-base-900"
                >
                  Media Requests
                </Text>
                <Text tag="p" variant="textBase" class="mt-4 text-base-600">
                  For press inquiries, interview requests, and editorial opportunities, reach us directly.
                </Text>
                <div class="mt-6">
                  <a
                    href="mailto:media@lozenadvisory.com"
                    class="text-accent-600 font-medium hover:text-accent-700 transition-colors text-lg"
                  >
                    media@lozenadvisory.com
                  </a>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </Wrapper>
  </section>
  <script is:inline>
    function initInquiryForm(formId, statusId) {
      const form = document.getElementById(formId);
      const status = document.getElementById(statusId);

      if (!form || !status) return;

      form.addEventListener("submit", async function (event) {
        event.preventDefault();

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());
        payload.type = form.dataset.inquiryType || "contact";

        status.textContent = "Sending...";
        status.className = "font-sans text-base font-semibold text-base-800";

        try {
          const response = await fetch("/api/inquiry", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          });

          const data = await response.json().catch(() => ({}));

          if (!response.ok) {
            throw new Error(data.message || "Unable to send this inquiry.");
          }

          form.reset();
          status.textContent = "Your message was sent. Lozen Advisory will review your inquiry directly.";
          status.className = "font-sans text-base font-semibold text-base-900";
        } catch (error) {
          status.textContent =
            error instanceof Error
              ? error.message
              : "Unable to send this inquiry right now.";
          status.className = "font-sans text-base font-semibold text-red-700";
        }
      });
    }

    initInquiryForm("contact-inquiry-form", "contact-inquiry-status");
  </script>
</BaseLayout>
