---
import BaseLayout from "@/layouts/BaseLayout.astro";
import InternalPageHero from "@/components/fundations/sections/InternalPageHero.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { createCollectionPageJsonLd } from "@/lib/seo/jsonLd";

const mediaEmail = "media@lozenadvisory.com";

const releases = [
  {
    date: "June 30, 2026",
    category: "AI Governance",
    headline: "Lozen Advisory Launches \"When AI Carries Your Name\" for Leaders Using AI at Work",
    description:
      "Lozen Advisory introduces the Name Standard℠ in a briefing for leaders using AI at work, focused on verification, human accountability, and reputation risk when AI-assisted work moves through a leader's name or authority.",
    href: "/news-press/when-ai-carries-your-name/",
  },
  {
    date: "May 19, 2026",
    category: "Market Correction",
    headline: "The Menopause-at-Work Market Followed the Playbook. The Playbook Was Wrong.",
    description:
      "As PwC names menopause a defining women's health opportunity, Lozen Advisory issues a market correction on utilization failure and the false assumption that awareness equals adoption.",
    href: "/news-press/menopause-market-correction/",
  },
];


const title = "News & Press | Lozen Advisory";
const description = "Press releases, media materials, and public statements from Lozen Advisory on AI governance, algorithmic accountability, workforce governance, and market analysis.";
const canonical = "https://www.lozenadvisory.com/news-press/";

const collectionJsonLd = createCollectionPageJsonLd({
  title,
  description,
  href: canonical,
  items: releases.map((release) => ({
    title: release.headline,
    href: release.href,
    description: release.description,
  })),
  breadcrumbs: [
    { name: "Home", href: "/" },
    { name: "News & Press", href: "/news-press/" },
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={collectionJsonLd}
>
  <main class="bg-base-50">

    <InternalPageHero
    eyebrow="Newsroom"
    title="News & Press"
    deck="Press releases and media materials from Lozen Advisory. For media inquiries, contact media@lozenadvisory.com."
  />

    <section class="py-16 lg:py-24">
      <Wrapper variant="standard">

        <div class="divide-y divide-base-200">
          {releases.map((release) => (
            <article class="py-10 first:pt-0">
              <div class="grid gap-6 lg:grid-cols-[0.72fr_1fr] lg:items-start">

                <div>
                  <Text
                    tag="p"
                    variant="textSM"
                    class="font-sans font-semibold uppercase tracking-[0.18em] text-base-500"
                  >
                    {release.date}
                  </Text>
                  <Text
                    tag="p"
                    variant="textXS"
                    class="mt-1 font-sans font-semibold uppercase tracking-[0.14em] text-base-600"
                  >
                    {release.category}
                  </Text>
                </div>

                <div>
                  <Text
                    tag="h2"
                    variant="displaySM"
                    class="font-display font-normal tracking-[-0.03em] text-base-950"
                  >
                    {release.headline}
                  </Text>

                  <Text
                    tag="p"
                    variant="textBase"
                    class="mt-4 font-sans leading-7 text-base-700"
                  >
                    {release.description}
                  </Text>

                  <a
                    href={release.href}
                    class="mt-6 inline-flex items-center gap-2 font-sans text-sm font-semibold uppercase tracking-[0.1em] text-base-800 transition-colors hover:text-base-950"
                  >
                    Read the full release
                    <span aria-hidden="true">→</span>
                  </a>
                </div>

              </div>
            </article>
          ))}
        </div>

      </Wrapper>
    </section>

  </main>
</BaseLayout>
