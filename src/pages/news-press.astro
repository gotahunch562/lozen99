---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const releases = [
  {
    date: "May 2026",
    category: "Market Analysis",
    headline: "The Menopause Benefit Market Built the Wrong Thing. The Data Now Proves It.",
    description: "Lozen Advisory issues a market correction on menopause-at-work utilization failure. Five years of data confirm the infrastructure was built around the wrong activation condition.",
    href: "/news-press/market-correction",
  },
];
---

<BaseLayout
  title="News & Press | Lozen Advisory"
  description="Press releases and media materials from Lozen Advisory LLC."
>
  <main class="bg-base-50">

    <section class="relative overflow-hidden bg-base-950 pt-32 pb-20 text-white lg:pt-40 lg:pb-28">
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(250,204,21,0.12),transparent_28%),radial-gradient(circle_at_80%_10%,rgba(255,255,255,0.08),transparent_24%)]"
      ></div>

      <Wrapper variant="standard" class="relative z-10">
        <div class="max-w-4xl">
          <Text
            tag="span"
            variant="textSM"
            class="font-sans font-semibold uppercase tracking-[0.18em] text-accent-300"
          >
            Newsroom
          </Text>

          <Text
            tag="h1"
            variant="display2XL"
            class="mt-8 font-display font-normal uppercase tracking-[-0.05em] text-white"
          >
            News & Press
          </Text>

          <Text
            tag="p"
            variant="textXL"
            class="mt-6 max-w-2xl font-sans leading-8 text-base-300"
          >
            Press releases and media materials from Lozen Advisory.
            For media inquiries contact akilah@lozenadvisory.com.
          </Text>
        </div>
      </Wrapper>
    </section>

    <section class="py-16 lg:py-24">
      <Wrapper variant="standard">

        <div class="divide-y divide-base-200">
          {releases.map((release) => (
            <article class="py-10 first:pt-0">
              <div class="grid gap-6 lg:grid-cols-[0.72fr_1fr] lg:items-start">

                <div>
                  <Text
                    tag="p"
                    variant="textSM"
                    class="font-sans font-semibold uppercase tracking-[0.18em] text-base-500"
                  >
                    {release.date}
                  </Text>
                  <Text
                    tag="p"
                    variant="textXS"
                    class="mt-1 font-sans font-semibold uppercase tracking-[0.14em] text-accent-600"
                  >
                    {release.category}
                  </Text>
                </div>

                <div>
                  <Text
                    tag="h2"
                    variant="displaySM"
                    class="font-display font-normal tracking-[-0.03em] text-base-950"
                  >
                    {release.headline}
                  </Text>

                  <Text
                    tag="p"
                    variant="textBase"
                    class="mt-4 font-sans leading-7 text-base-700"
                  >
                    {release.description}
                  </Text>

                  <a
                    href={release.href}
                    class="mt-6 inline-flex items-center gap-2 font-sans text-sm font-semibold uppercase tracking-[0.1em] text-accent-700 transition-colors hover:text-accent-900"
                  >
                    Read the full release
                    <span aria-hidden="true">→</span>
                  </a>
                </div>

              </div>
            </article>
          ))}
        </div>

      </Wrapper>
    </section>

  </main>
</BaseLayout>
