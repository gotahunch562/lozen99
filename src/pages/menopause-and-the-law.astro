---
import AuthorityPage from "@/components/authority/AuthorityPage.astro";

const title = "Menopause and the Law: Understanding Your Legal Landscape";
const description =
  "There is no such thing as a menopause lawyer — yet. This page explains what the law currently covers, which states have enacted protections, and what kind of attorney handles menopause-related claims.";
const canonicalUrl = "https://www.lozenadvisory.com/menopause-and-the-law/";
const dateModified = "2026-06-04";
const dateLabel = "Updated June 4, 2026";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonicalUrl,
  publisher: {
    "@type": "Organization",
    name: "Lozen Advisory LLC",
    url: "https://www.lozenadvisory.com/",
  },
  dateModified,
};

const states = [
  {
    state: "Rhode Island",
    covers: "Workplace accommodation; adds menopause to protected traits under employment anti-discrimination law",
    inEffect: "June 2025",
    enacted: true,
  },
  {
    state: "New Jersey",
    covers: "Insurance coverage mandate for menopause treatment",
    inEffect: "January 2026",
    enacted: true,
  },
  {
    state: "Louisiana",
    covers: "Private insurer coverage for menopause treatments",
    inEffect: "August 2024",
    enacted: true,
  },
  {
    state: "Virginia",
    covers: "Insurance coverage; prior authorization restrictions for HRT",
    inEffect: "July 1, 2026",
    enacted: true,
  },
  {
    state: "Maryland",
    covers: "Omnibus: insurance coverage, provider training, employer accommodation obligations",
    inEffect: "October 1, 2026",
    enacted: true,
  },
  {
    state: "Washington",
    covers: "Executive Order 26-01: state agency accommodation obligations under existing civil rights law; model guidance for private employers",
    inEffect: "June 1, 2026",
    enacted: true,
  },
  {
    state: "Illinois",
    covers: "Workplace accommodation; pending Governor signature as of June 2026",
    inEffect: "Pending",
    enacted: false,
  },
  {
    state: "Philadelphia, PA",
    covers: "City ordinance: adds menopause to protected traits in employment anti-discrimination law",
    inEffect: "January 1, 2027",
    enacted: true,
  },
];

const claimTypes = [
  {
    title: "Workplace / Employment",
    body: "Were you fired, demoted, passed over, or pushed out while experiencing menopause symptoms? Did you request an accommodation and were refused? Did your employer fail to engage in any interactive process after you disclosed symptoms?",
    note: "Attorney type: Employment / Civil rights",
  },
  {
    title: "Insurance Coverage",
    body: "Was your menopause treatment denied, delayed, or required to go through prior authorization? Were you in a state with a coverage mandate — New Jersey, Virginia, Maryland, Louisiana — and still denied your claim?",
    note: "Attorney type: Insurance coverage / Bad faith",
  },
  {
    title: "Healthcare / Provider",
    body: "Were your menopause symptoms misdiagnosed as anxiety, depression, or another condition? Were you denied treatment based on a diagnostic test — such as an FSH test — that is known to produce false negatives during perimenopause?",
    note: "Attorney type: Medical malpractice / Healthcare",
  },
  {
    title: "Constructive Dismissal",
    body: "Did you feel forced to leave a job because your employer made your working conditions intolerable after symptoms began — changed your schedule, removed responsibilities, isolated you, or failed to act on documented requests?",
    note: "Attorney type: Employment / Wrongful termination",
  },
];

const attorneySteps = [
  {
    n: "1",
    heading: "Match the claim to the practice area first",
    body: "An employment attorney for workplace claims. An insurance coverage or bad-faith attorney for denied treatment. A medical malpractice attorney for misdiagnosis or treatment delay. Do not look for a menopause specialist — look for an attorney who handles your type of claim and is willing to learn the menopause-specific law in your state.",
  },
  {
    n: "2",
    heading: "Ask specifically about your state's law",
    body: "If you are in Rhode Island, New Jersey, Virginia, Maryland, Washington, or a state with active legislation, ask the attorney whether they are familiar with the specific statute or executive order. An attorney who is willing to research it is better than one who dismisses it.",
  },
  {
    n: "3",
    heading: "Understand the existing framework",
    body: "Even in states without specific menopause legislation, menopause symptoms may qualify as a disability under the ADA, a sex-related condition under Title VII, or a protected impairment under state civil rights statutes. An employment or civil rights attorney can evaluate this without waiting for new law to pass.",
  },
  {
    n: "4",
    heading: "Document before you consult",
    body: "Before your first consultation, write down the dates and facts of what happened. Any accommodation request you made, any response you received, any clinical documentation of your symptoms, any employment decision that followed. An attorney evaluating your claim needs a timeline, not a summary.",
  },
  {
    n: "5",
    heading: "Be aware of filing deadlines",
    body: "EEOC charges must generally be filed within 180 to 300 days of the discriminatory act. State agency deadlines vary. The deadline runs from the discriminatory event, not from the date of consultation. If time has passed, consult an attorney before deciding whether to proceed.",
  },
];
---

<AuthorityPage
  title={title}
  description={description}
  dateLabel={dateLabel}
  articleJsonLd={pageJsonLd}
  backHref="/tools-resources/"
  backLabel="Back to Resources"
>
  <Fragment slot="rail">
    <div class="rounded-3xl border border-base-200 bg-white p-6 shadow-sm">
      <p class="border-l border-accent-500 pl-4 text-xs font-medium uppercase tracking-[0.18em] text-base-600">
        Legal information notice
      </p>
      <p class="mt-5 font-display text-xl font-medium uppercase leading-tight tracking-tight text-base-950">
        This page provides legal landscape information only.
      </p>
      <p class="mt-4 text-sm leading-6 text-base-700">
        It is not legal advice and does not create an attorney-client relationship. If you believe you have a claim, consult a licensed attorney in your state.
      </p>
    </div>

    <div class="mt-5 rounded-3xl border border-base-200 bg-base-50 p-6">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-base-600">
        Updated
      </p>
      <p class="mt-3 text-sm font-semibold text-base-900">
        June 4, 2026
      </p>
      <p class="mt-3 text-sm leading-6 text-base-700">
        For full state-by-state tracking, see the public legislation tracker.
      </p>
      <a
        href="/menopause-legislation-tracker/"
        class="mt-5 inline-flex text-sm font-bold text-base-950 underline decoration-accent-500 underline-offset-4"
      >
        View tracker →
      </a>
    </div>
  </Fragment>

  <div class="authority-article-body">
    <p>
      People search for a menopause lawyer because something happened — at work, with their insurance, with a provider — and they do not know what kind of legal help they need. The legal issue may be real, but the attorney category is not yet organized around the word menopause.
    </p>

    <p>
      This page explains the current legal landscape, which states have enacted protections, and what kind of attorney typically handles menopause-related claims.
    </p>

    <span class="section-number">01 — Context</span>
    <h2>Why there is no menopause lawyer — yet</h2>

    <p>
      No US law school offers a menopause law specialty. No bar association has a menopause practice group. That is not because the legal issues do not exist. It is because the laws that create those issues are new, and the first cases under them are only now beginning to form.
    </p>

    <p>
      Until recently, menopause had no explicit protection under federal or most state employment law. That is changing. Six states have enacted menopause-specific protections since 2024. Eleven more bills are active in 2026 legislative sessions. The first failure-to-accommodate claims under Rhode Island's 2025 law are likely already in pipeline. The legal category is forming in real time.
    </p>

    <p>
      What exists now is a set of <strong>existing legal frameworks</strong> — employment discrimination law, disability law, insurance coverage law, civil rights statutes — that apply to menopause-related harm even where menopause is not explicitly named. The attorney who handles your case already exists. You need to know which kind to look for.
    </p>

    <span class="section-number">02 — Claim types</span>
    <h2>What kind of claim might you have</h2>

    <p>
      Menopause-related legal claims fall into three categories. They are not mutually exclusive.
    </p>

    <div class="authority-card-grid">
      {claimTypes.map((claim) => (
        <section class="authority-card">
          <h3>{claim.title}</h3>
          <p>{claim.body}</p>
          <p class="authority-card__note">{claim.note}</p>
        </section>
      ))}
    </div>

    <span class="section-number">03 — Enacted protections</span>
    <h2>Which states have enacted protections</h2>

    <p>
      If you are in one of these states, specific legal protections may apply to your situation beyond general employment or disability law.
    </p>

    <div class="authority-state-grid" aria-label="Enacted menopause protections by state">
      {states.map((row) => (
        <article class="authority-state-card">
          <div class="authority-state-card__header">
            <h3>{row.state}</h3>
            <span>{row.enacted ? (row.inEffect === "Pending" ? "Pending" : "Enacted") : "Active"}</span>
          </div>

          <dl>
            <div>
              <dt>What it covers</dt>
              <dd>{row.covers}</dd>
            </div>

            <div>
              <dt>In effect</dt>
              <dd>{row.inEffect}</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>

    <p class="authority-note">
      Enacted and near-enacted laws only. Eleven additional bills are active in 2026 sessions across additional states. For the full picture including active bills, federal legislation, and analytical notes on each law's scope, see the <a href="/menopause-legislation-tracker/">Lozen Advisory Legislation Tracker</a>.
    </p>

    <span class="section-number">04 — Finding counsel</span>
    <h2>What to look for in an attorney</h2>

    <p>
      Because menopause law is emerging rather than established, most attorneys handling these cases will come from adjacent practice areas. Here is how to find and evaluate them.
    </p>

    <div class="authority-step-list">
      {attorneySteps.map((step) => (
        <section class="authority-step">
          <span>{step.n}</span>
          <div>
            <h3>{step.heading}</h3>
            <p>{step.body}</p>
          </div>
        </section>
      ))}
    </div>

    <span class="section-number">05 — What the law cannot see</span>
    <h2>The gap between who a law names and who it serves</h2>

    <p>
      Every law in this space — at the state and federal level — creates a system that activates when you use it. It requires a request, a claim, a disclosure, a formal pathway. The protections are real for the people who access them.
    </p>

    <p>
      What the law does not yet measure is the population that decided not to. The workers who left before filing. The women who calculated that disclosure carried more professional risk than it returned. The patients whose symptoms were documented as something else. That population is not small, and it is not protected — not because the law failed them, but because the law has not yet been built to find them.
    </p>

    <p>
      Lozen Advisory tracks this gap across every active piece of menopause legislation in the United States. The tracker is public, updated in real time, and includes analytical notes on what each law can and cannot measure — and why that matters for employers, insurers, healthcare providers, and the people the laws were written for.
    </p>

    <section class="authority-bottom-stack">
      <div class="authority-cta">
        <p>Lozen Advisory</p>
        <h2>Menopause Legislation Tracker 2026</h2>
        <p>
          Every active state and federal menopause bill. Status, effective dates, coverage scope, and analytical notes on the governance gap each law creates.
        </p>
        <a href="/menopause-legislation-tracker/">View the tracker →</a>
      </div>
    </section>
  </div>
</AuthorityPage>

<style>
  .authority-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0;
  }

  .authority-card,
  .authority-state-card {
    border: 1px solid var(--color-base-200);
    border-top: 3px solid var(--color-accent-500);
    border-radius: 1.25rem;
    background: white;
    padding: 1.25rem;
    box-shadow: var(--shadow-md);
  }

  .authority-card h3,
  .authority-step h3 {
    margin: 0;
    color: var(--color-base-950);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .authority-card p,
  .authority-step p {
    margin: 0.75rem 0 0;
    color: var(--color-base-700);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .authority-card__note {
    color: var(--color-base-500) !important;
    font-size: 0.78rem !important;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .authority-state-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0 1.25rem;
  }

  .authority-state-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--color-base-200);
    padding-bottom: 0.9rem;
  }

  .authority-state-card h3 {
    margin: 0;
    color: var(--color-base-950);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 850;
    line-height: 1.35;
  }

  .authority-state-card__header span {
    flex: 0 0 auto;
    border: 1px solid var(--color-base-200);
    border-radius: 999px;
    background: var(--color-base-50);
    padding: 0.35rem 0.55rem;
    color: var(--color-base-700);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .authority-state-card dl {
    display: grid;
    gap: 1rem;
    margin: 1rem 0 0;
  }

  .authority-state-card dt {
    color: var(--color-base-500);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .authority-state-card dd {
    margin: 0.35rem 0 0;
    color: var(--color-base-700);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .authority-note {
    color: var(--color-base-500) !important;
    font-size: 0.9rem !important;
  }

  .authority-step-list {
    display: grid;
    gap: 0;
    margin: 2rem 0;
    border: 1px solid var(--color-base-200);
    border-radius: 1.25rem;
    overflow: hidden;
    background: white;
    box-shadow: var(--shadow-md);
  }

  .authority-step {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    border-bottom: 1px solid var(--color-base-200);
  }

  .authority-step:last-child {
    border-bottom: 0;
  }

  .authority-step > span {
    display: flex;
    justify-content: center;
    padding-top: 1.25rem;
    border-right: 1px solid var(--color-base-200);
    background: var(--color-base-50);
    color: var(--color-base-400);
    font-family: var(--font-display);
    font-size: 1.4rem;
  }

  .authority-step > div {
    padding: 1.25rem;
  }

  .authority-cta {
    border: 1px solid var(--color-base-800);
    border-radius: 1.5rem;
    background: var(--color-base-950);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    color: white;
    box-shadow: var(--shadow-xl);
  }

  .authority-cta p:first-child {
    margin: 0;
    color: var(--color-base-300);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .authority-cta h2 {
    margin: 0.85rem 0 0;
    color: white;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.4rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .authority-cta p {
    max-width: 42rem;
    color: var(--color-base-200);
  }

  .authority-cta a {
    display: inline-flex;
    margin-top: 1rem;
    border: 1px solid var(--color-accent-500);
    border-radius: 999px;
    background: var(--color-accent-500);
    padding: 0.78rem 1.05rem;
    color: var(--color-base-950);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .authority-card-grid,
    .authority-state-grid {
      grid-template-columns: 1fr;
    }

    .authority-state-card__header {
      display: grid;
      justify-content: stretch;
    }

    .authority-state-card__header span {
      width: fit-content;
    }

    .authority-step {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
  }
</style>
