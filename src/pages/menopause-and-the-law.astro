  }

  .authority-step > div {
    padding: 1.25rem;
  }

  @media (max-width: 760px) {
    .authority-card-grid,
    .authority-state-grid {
      grid-template-columns: 1fr;
    }

    .authority-state-card__header {
      display: grid;
      justify-content: stretch;
    }

    .authority-state-card__header span {
