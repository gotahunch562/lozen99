  "@type": "Article",
  headline: title,
  description: metaDescription,
  author: {
    "@type": "Person",
    name: "Akilah E. Kamaria",
  },
  publisher: {
    "@type": "Organization",
    name: "Lozen Advisory",
    url: "https://www.lozenadvisory.com",
  },
  url: "https://www.lozenadvisory.com/billable-hour-visibility-tax",
};

const railItems = [
  {
