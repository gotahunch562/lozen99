    value: "Billable-hour metrics and women lawyers",
  },
  {
    label: "Framework",
    value: "Invisible Attrition℠ and performance measurement risk",
  },
  {
    label: "Primary Buyer Question",
    value: "Why high-performance metrics can mask retention risk until the departure is already visible.",
  },
];

const railLinks = [
  {
    label: "Architecture of Invisible Attrition℠ Series",
    href: "/architecture-of-invisible-attrition-series",
  },
  {
    label: "Report One",
    href: "/voluntary-benefit-disclosure-gap",
  },
  {
    label: "Report Three",
    href: "/succession-planning-retention-risk-data-gap",
  },
];

const seriesItems = [
  {
    number: "01",
    title: "Visibility Tax℠: Why Employee Benefits Don't Reach the Women Who Need Them Most",
    href: "/voluntary-benefit-disclosure-gap",
    status: "available",
  },
  {
    number: "02",
    title: "Invisible Attrition℠: Why Billable-Hour Metrics Fail to Detect Risk in Women Lawyers",
    status: "current",
  },
  {
    number: "03",
    title: "Succession Planning and the Retention Risk Data Gap",
    href: "/succession-planning-retention-risk-data-gap",
    status: "available",
  },
  {
    number: "04",
    title: "The Leadership Pipeline Is Draining From Both Ends",
    href: "/leadership-pipeline-manager-engagement",
    status: "available",
  },
];

const relatedItems = [
  {
    eyebrow: "Next Report",
    title: "Succession Planning and the Retention Risk Data Gap",
    href: "/succession-planning-retention-risk-data-gap",
    description:
      "Succession plans depend on workplace data that may not show why critical talent leaves. This analysis examines the retention risk created by disclosure gaps.",
