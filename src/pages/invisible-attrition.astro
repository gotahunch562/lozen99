    <AuthorityCluster
      eyebrow="Pillar Cluster"
      title="The Dimensions of Invisible Attrition℠"
      description="Cluster articles connected to the Invisible Attrition℠ pillar."
      items={clusterItems}
    />
  </div>
</AuthorityPage>
