---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const reserveSessionHref = "https://buy.stripe.com/dRm00l0hLgip9okc8dfjG06";

const description = "A 90-minute private advisory session for women preparing for review, promotion, visibility, or another professional evaluation moment.";

const situations = [
  "You are approaching a performance review, promotion decision, or increased visibility",
  "Something has changed and you are managing it privately",
  "You cannot fully explain it at work",
  "You need to decide how to move forward before you are evaluated",
  "You may be preparing for something visible and consequential (a trial, a major presentation, a board meeting, a partner review)",
  "Health challenges are starting to impact your performance",
];

const nextSteps = [
  "A private intake form",
  "A scheduling link to choose your date and time",
];

const sequence = [
  "Reserve your session",
  "Complete your intake (sent by email)",
  "Choose your date and time",
];

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "MAPS Blueprint℠",
  description,
  provider: {
    "@type": "Organization",
    name: "Lozen Advisory LLC",
    url: "https://www.lozenadvisory.com",
  },
  areaServed: "United States",
  offers: {
    "@type": "Offer",
    price: "997",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: "https://www.lozenadvisory.com/booking",
  },
};
const title = "MAPS Blueprint℠ | Lozen Advisory";

---

<BaseLayout title={title} description={description}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(pageJsonLd)}
  ></script>

  <section class="relative overflow-hidden bg-base-950">
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-[radial-gradient(circle_at_18%_20%,rgba(247,211,50,0.16),transparent_34%),radial-gradient(circle_at_86%_12%,rgba(148,163,184,0.15),transparent_30%)]"
    >
    </div>

    <Wrapper variant="standard" class="relative z-10 py-24 lg:py-32">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,0.64fr)_minmax(18rem,0.36fr)] lg:items-end">
        <div class="max-w-4xl">
          <Text
            tag="span"
            variant="textSM"
            class="pl-4 font-medium uppercase tracking-wide border-l text-accent-300 font-display border-accent-500"
          >
            MAPS Blueprint℠
          </Text>

          <Text
            tag="h1"
            variant="display2XL"
            class="mt-8 uppercase font-display text-white"
          >
            Request a private session
          </Text>

          <Text
            tag="p"
            variant="textLG"
            class="mt-6 max-w-2xl text-base-200"
          >
            This is a 90-minute private working session.
          </Text>
        </div>

        <aside class="border-l border-white/10 pl-6 lg:pl-8">
          <Text
            tag="span"
            variant="textSM"
            class="font-medium uppercase tracking-wide text-accent-300"
          >
            Investment
          </Text>

          <Text
            tag="p"
            variant="displaySM"
            class="mt-5 font-display text-white"
          >
            $997 · 90 minutes
          </Text>

          <Text tag="p" variant="textSM" class="mt-4 text-base-300">
            Paid in full at the time of booking.
          </Text>

          <div class="mt-8">
            <a
              href={reserveSessionHref}
              class="inline-flex h-11 items-center justify-center rounded-lg bg-accent-300 px-5 py-4 text-center text-sm font-medium uppercase tracking-wide text-base-950 transition-all duration-500 ease-in-out hover:bg-accent-400 focus:outline-2 focus:outline-offset-4 focus:outline-accent-400"
            >
              Request a private session →
            </a>
          </div>
        </aside>
      </div>
    </Wrapper>
  </section>

  <section class="bg-white">
    <Wrapper variant="standard" class="py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.34fr_1fr] lg:gap-20">
        <aside>
          <Text
            tag="span"
            variant="textSM"
            class="font-medium uppercase tracking-wide text-accent-600"
          >
            Before You Continue
          </Text>
        </aside>

        <article class="max-w-4xl">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            It is designed for a specific situation:
          </Text>

          <ul class="mt-8 divide-y divide-base-200 border-y border-base-200">
            {
              situations.map((item) => (
                <li class="py-5">
                  <Text tag="p" variant="textBase" class="text-base-700">
                    {item}
                  </Text>
                </li>
              ))
            }
          </ul>

          <div class="mt-8 border-l border-accent-500 pl-6">
            <Text
              tag="p"
              variant="textLG"
              class="font-display text-base-900"
            >
              If that is not your situation, this is not the right entry point.
            </Text>
          </div>
        </article>
      </div>
    </Wrapper>
  </section>

  <section class="bg-base-100">
    <Wrapper variant="standard" class="py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.34fr_1fr] lg:gap-20">
        <aside>
          <Text
            tag="span"
            variant="textSM"
            class="font-medium uppercase tracking-wide text-accent-600"
          >
            What Happens Next
          </Text>
        </aside>

        <article class="max-w-4xl">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-base-900"
          >
            You reserve your session.
          </Text>

          <Text tag="p" variant="textBase" class="mt-6 text-base-700">
            Within minutes, you receive an email with your next steps:
          </Text>

          <ul class="mt-8 space-y-4">
            {
              nextSteps.map((item) => (
                <li class="flex gap-4">
                  <span
                    aria-hidden="true"
                    class="mt-3 h-px w-8 shrink-0 bg-accent-500"
                  >
                  </span>

                  <Text tag="p" variant="textBase" class="text-base-700">
                    {item}
                  </Text>
                </li>
              ))
            }
          </ul>

          <Text tag="p" variant="textBase" class="mt-8 text-base-700">
            Your session details and access link follow once your time is confirmed.
          </Text>
        </article>
      </div>
    </Wrapper>
  </section>

  <section class="bg-white">
    <Wrapper variant="standard" class="py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.34fr_1fr] lg:gap-20">
        <aside>
          <Text
            tag="span"
            variant="textSM"
            class="font-medium uppercase tracking-wide text-accent-600"
          >
            How This Works
          </Text>
        </aside>

        <article class="max-w-4xl">
          <ol class="divide-y divide-base-200 border-y border-base-200">
            {
              sequence.map((item, index) => (
                <li class="grid gap-3 py-6 sm:grid-cols-[4rem_1fr] sm:gap-8">
                  <Text
                    tag="p"
                    variant="displayXS"
                    class="font-display text-accent-600"
                  >
                    {String(index + 1).padStart(2, "0")}
                  </Text>

                  <Text
                    tag="p"
                    variant="displayXS"
                    class="font-display text-base-900"
                  >
                    {item}
                  </Text>
                </li>
              ))
            }
          </ol>

          <div class="mt-8 space-y-4">
            <Text tag="p" variant="textBase" class="text-base-700">
              That is the full sequence.
            </Text>

            <Text tag="p" variant="textBase" class="text-base-700">
              Nothing complicated.
            </Text>

            <Text tag="p" variant="textBase" class="text-base-700">
              Nothing that requires you to explain more than you are ready to.
            </Text>
          </div>
        </article>
      </div>
    </Wrapper>
  </section>

  <section class="bg-base-950">
    <Wrapper variant="standard" class="py-16 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div class="max-w-3xl">
          <Text
            tag="span"
            variant="textSM"
            class="font-medium uppercase tracking-wide text-accent-300"
          >
            Investment
          </Text>

          <Text
            tag="h2"
            variant="displayLG"
            class="mt-6 uppercase font-display text-white"
          >
            $997 · 90 minutes
          </Text>

          <Text tag="p" variant="textBase" class="mt-5 text-base-200">
            Paid in full at the time of booking.
          </Text>
        </div>

        <div>
          <a
            href={reserveSessionHref}
            class="inline-flex h-12 items-center justify-center rounded-lg bg-accent-300 px-6 py-4 text-center text-sm font-medium uppercase tracking-wide text-base-950 transition-all duration-500 ease-in-out hover:bg-accent-400 focus:outline-2 focus:outline-offset-4 focus:outline-accent-400"
          >
            Request a private session →
          </a>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
