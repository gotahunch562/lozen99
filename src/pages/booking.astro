---
import NarrativePage from "@/components/authority/NarrativePage.astro";

const reserveSessionHref = "https://buy.stripe.com/dRm00l0hLgip9okc8dfjG06";

const title = "MAPS Blueprint℠";

const seoTitle = "MAPS Blueprint℠ | Private Advisory Session for Women Executives";

const description =
  "A 90-minute private advisory session for a woman approaching review, promotion, visibility, or another professional evaluation moment.";

const metaDescription =
  "Reserve a private MAPS Blueprint℠ session with Lozen Advisory. A 90-minute advisory session for women preparing for review, promotion, visibility, or another professional evaluation moment.";

const canonical = "https://www.lozenadvisory.com/booking";

const situations = [
  "You are approaching a performance review, promotion decision, partner review, board meeting, trial, presentation, or another visible professional moment.",
  "Something has changed, and you are managing it privately.",
  "You cannot fully explain the situation at work without creating a record you may not control.",
  "You need to decide what to say, what not to say, what to protect, and how to move before you are evaluated.",
  "Health, family, workload, visibility, or leadership pressure is beginning to affect how you prepare, perform, or position yourself.",
];

const sequence = [
  "Reserve your session.",
  "Complete the private intake form sent by email.",
  "Choose your date and time.",
  "Arrive with the decision moment in front of you.",
];

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "MAPS Blueprint℠",
  description,
  url: canonical,
  provider: {
    "@type": "Organization",
    name: "Lozen Advisory LLC",
    url: "https://www.lozenadvisory.com",
  },
  areaServed: "United States",
  offers: {
    "@type": "Offer",
    price: "997",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: canonical,
  },
};
---

<NarrativePage
  title={title}
  seoTitle={seoTitle}
  description={description}
  metaDescription={metaDescription}
  canonical={canonical}
  eyebrow="Private Advisory"
  typeLabel="$997 · 90 minutes"
  articleJsonLd={pageJsonLd}
>
  <section class="maps-intro" aria-label="MAPS Blueprint introduction">
    <p>
      The MAPS Blueprint℠ is a 90-minute private advisory session. You are approaching something visible. A review, a promotion decision, a partner conversation, a board meeting, a trial, a presentation, or another moment where your judgment, performance, and professional standing will be evaluated.
    </p>

    <p>
      The session is built around that moment, your role, and the constraints you are managing. It is not a coaching package. It is not a wellness conversation. It is not a place where you have to disclose more than you are prepared to disclose.
    </p>

    <p>
      You leave with one clear position and exactly how to execute it.
    </p>
  </section>

  <section class="maps-rule" aria-label="Who this is for">
    <h2>This is for the woman who cannot afford a vague plan.</h2>

    <p>
      If the moment in front of you is visible, the wrong move can become part of the record. A premature explanation can narrow your options. A disclosure can travel farther than intended. Silence can protect you, but only if it is paired with strategy.
    </p>

    <p>
      MAPS Blueprint℠ gives you a private place to resolve the decision before the decision resolves you.
    </p>

    <ul class="maps-situations">
      {
        situations.map((item) => (
          <li>{item}</li>
        ))
      }
    </ul>
  </section>

  <section class="maps-deliverable" aria-label="What the session produces">
    <h2>What the session produces</h2>

    <p>
      We clarify the evaluation moment, the decision-makers, the risk you are managing, the record that could be created, and the position you need to hold. The work is practical because the moment is practical. By the end of the session, you should know what you are protecting, what you are not going to explain, what you are willing to say, and what sequence of action gives you the most control.
    </p>

    <blockquote>
      This is not about becoming more visible. It is about protecting what you have already built.
    </blockquote>
  </section>

  <section class="maps-sequence" aria-label="How booking works">
    <h2>How it works</h2>

    <ol>
      {
        sequence.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <p>{item}</p>
          </li>
        ))
      }
    </ol>

    <p>
      Within minutes of reserving your session, you receive the private intake form and scheduling link. Your session details and access link follow once your time is confirmed.
    </p>
  </section>

  <section class="maps-reserve" aria-label="Reserve a MAPS Blueprint session">
    <p class="maps-reserve__eyebrow">Investment</p>
    <h2>$997 · 90 minutes</h2>
    <p>
      Paid in full at the time of booking. The session is private, focused, and designed around the professional moment already in front of you.
    </p>
    <a href={reserveSessionHref}>Request a private session →</a>
  </section>

  <aside slot="rail" class="maps-rail" aria-label="Reserve MAPS Blueprint session">
    <p class="maps-rail__eyebrow">MAPS Blueprint℠</p>
    <h2>$997</h2>
    <p>90-minute private advisory session.</p>
    <a href={reserveSessionHref}>Request a private session →</a>
    <small>Paid in full at the time of booking. Intake and scheduling are sent by email after purchase.</small>
  </aside>
</NarrativePage>

<style>
  :global(.narrative-page__content-shell--with-rail) {
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 22rem);
  }

  .maps-intro p:first-child {
    color: var(--color-base-950) !important;
    font-family: var(--font-display) !important;
    font-size: clamp(1.55rem, 2.6vw, 2.25rem) !important;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.18 !important;
  }

  .maps-rule,
  .maps-deliverable,
  .maps-sequence,
  .maps-reserve {
    margin-top: clamp(3rem, 5vw, 4.75rem);
    padding-top: clamp(2.25rem, 4vw, 3rem);
    border-top: 1px solid var(--color-base-250, var(--color-base-200));
  }

  .maps-situations {
    display: grid;
    gap: 0;
    margin: 2rem 0 0 !important;
    padding: 0 !important;
    border-top: 1px solid var(--color-base-250, var(--color-base-200));
    list-style: none !important;
  }

  .maps-situations li {
    margin: 0 !important;
    padding: 1rem 0 1rem 1.35rem !important;
    border-bottom: 1px solid var(--color-base-250, var(--color-base-200));
    color: var(--color-base-750, var(--color-base-700));
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.7;
    position: relative;
  }

  .maps-situations li::before {
    content: "";
    position: absolute;
    top: 1.78rem;
    left: 0;
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 999px;
    background: var(--color-accent-500);
  }

  .maps-deliverable blockquote {
    max-width: 46rem;
  }

  .maps-sequence ol {
    display: grid;
    gap: 0;
    margin: 2rem 0 !important;
    padding: 0 !important;
    border-top: 1px solid var(--color-base-250, var(--color-base-200));
    list-style: none !important;
  }

  .maps-sequence li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    margin: 0 !important;
    padding: 1.25rem 0 !important;
    border-bottom: 1px solid var(--color-base-250, var(--color-base-200));
  }

  .maps-sequence li span {
    color: var(--color-accent-700);
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .maps-sequence li p {
    margin: 0 !important;
    color: var(--color-base-950) !important;
    font-family: var(--font-display) !important;
    font-size: clamp(1.28rem, 2vw, 1.7rem) !important;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.2 !important;
  }

  .maps-reserve {
    border: 1px solid color-mix(in srgb, var(--color-accent-500) 68%, var(--color-base-300));
    border-radius: 1.35rem;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--color-accent-50) 80%, white), #ffffff),
      var(--color-accent-50);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    box-shadow: 0 22px 54px rgba(6, 23, 47, 0.08);
  }

  .maps-reserve__eyebrow {
    margin: 0 0 0.75rem !important;
    color: var(--color-base-600) !important;
    font-family: var(--font-sans) !important;
    font-size: 0.75rem !important;
    font-weight: 800;
    letter-spacing: 0.15em;
    line-height: 1.4 !important;
    text-transform: uppercase;
  }

  .maps-reserve h2 {
    margin-top: 0 !important;
  }

  .maps-reserve a,
  .maps-rail a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-accent-400);
    border-radius: 999px;
    background: var(--color-accent-300);
    color: var(--color-base-950) !important;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    text-decoration: none !important;
    text-transform: uppercase;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .maps-reserve a {
    margin-top: 0.75rem;
    min-height: 3rem;
    padding: 0.95rem 1.3rem;
  }

  .maps-reserve a:hover,
  .maps-reserve a:focus-visible,
  .maps-rail a:hover,
  .maps-rail a:focus-visible {
    border-color: var(--color-accent-500);
    background: var(--color-accent-400);
    transform: translateY(-1px);
  }

  .maps-rail {
    position: sticky;
    top: 7.25rem;
    display: grid;
    gap: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-accent-500) 55%, var(--color-base-300));
    border-radius: 1.25rem;
    background: #ffffff;
    padding: 1.35rem;
    box-shadow: 0 20px 48px rgba(6, 23, 47, 0.08);
  }

  .maps-rail__eyebrow {
    margin: 0 !important;
    color: var(--color-base-600) !important;
    font-family: var(--font-sans) !important;
    font-size: 0.72rem !important;
    font-weight: 800;
    letter-spacing: 0.15em;
    line-height: 1.4 !important;
    text-transform: uppercase;
  }

  .maps-rail h2 {
    margin: 0 !important;
    color: var(--color-base-950);
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .maps-rail p {
    margin: 0 !important;
    color: var(--color-base-700) !important;
    font-size: 0.98rem !important;
    line-height: 1.55 !important;
  }

  .maps-rail a {
    width: 100%;
    min-height: 2.9rem;
    padding: 0.9rem 1rem;
  }

  .maps-rail small {
    color: var(--color-base-500);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  @media (max-width: 899px) {
    :global(.narrative-page__content-shell--with-rail) {
      display: flex;
      flex-direction: column-reverse;
    }

    .maps-rail {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .maps-sequence li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.55rem;
    }
  }
</style>
