---
import BaseLayout from "@/layouts/BaseLayout.astro";

const reserveSessionHref = "https://buy.stripe.com/dRm00l0hLgip9okc8dfjG06";

const title = "MAPS Blueprint℠";

const seoTitle = "MAPS Blueprint℠ | Private Advisory Session for Women Executives";

const description =
  "A single, structured advisory session for the professional moment you are preparing to manage with discretion.";

const metaDescription =
  "Reserve MAPS Blueprint℠ with Lozen Advisory. A single 90-minute private advisory session for a professional moment you are preparing to manage with discretion.";

const canonical = "https://www.lozenadvisory.com/booking";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "MAPS Blueprint℠",
  description,
  url: canonical,
  provider: {
    "@type": "Organization",
    name: "Lozen Advisory LLC",
    url: "https://www.lozenadvisory.com",
  },
  areaServed: "United States",
  offers: {
    "@type": "Offer",
    price: "997",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: reserveSessionHref,
  },
};
---

<BaseLayout
  title={seoTitle}
  description={metaDescription}
  canonical={canonical}
  ogType="website"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(pageJsonLd)}
  ></script>

  <main class="maps-booking" aria-labelledby="maps-booking-title">
    <section class="maps-booking__hero" aria-label="MAPS Blueprint booking">
      <div class="maps-booking__hero-shell">
        <div class="maps-booking__hero-copy">
          <p class="maps-booking__eyebrow">Private Advisory</p>
          <p class="maps-booking__type">$997 · 90 minutes</p>
          <h1 id="maps-booking-title">MAPS Blueprint℠</h1>
          <p class="maps-booking__deck">
            A single, structured advisory session for the professional moment you are preparing to manage with discretion.
          </p>
        </div>

        <aside class="maps-booking__reserve-card" aria-label="Reserve MAPS Blueprint session">
          <p class="maps-booking__reserve-label">Reserve MAPS Blueprint℠</p>
          <strong>$997</strong>
          <span>90 minutes</span>
          <p>
            One private session built around the situation already in front of you.
          </p>
          <a href={reserveSessionHref}>Reserve MAPS Blueprint℠ →</a>
          <small>Intake and scheduling are sent by email after purchase.</small>
        </aside>
      </div>
    </section>

    <section class="maps-booking__close" aria-label="Session details">
      <div class="maps-booking__close-shell">
        <div class="maps-booking__copy-column">
          <div class="maps-booking__lead">
            <p>
              The MAPS Blueprint℠ is not a program, a series, or a curriculum with modules and milestones. It is one private conversation between you and an advisor who has spent more than two decades inside the institutional environments you are navigating.
            </p>
            <p>
              You bring what you are managing. The session is built around it.
            </p>
          </div>

          <div class="maps-booking__situation-block">
            <p>
              You may be approaching a performance review, promotion decision, partner review, board meeting, trial, presentation, or another visible professional moment. Something has changed, and you are managing it privately. You cannot fully explain the situation at work without disclosing more than you intend. You need to decide what to say, what not to say, what to protect, and how to move before you are evaluated. Health, family, workload, visibility, or leadership pressure is beginning to affect how you prepare, perform, or position yourself.
            </p>
          </div>

          <div class="maps-booking__body-copy">
            <p>
              Ninety minutes is enough when the session is built correctly. Before we meet, you complete a private intake so the conversation begins with the actual situation in view. The intake prepares the conversation; it does not replace it.
            </p>
            <p>
              During the session, we clarify what matters, what should remain private, how you may be perceived, and what plan you will implement next. You leave with a clear position for the moment ahead.
            </p>
          </div>

          <div class="maps-booking__final-cta" aria-label="Reserve session">
            <div>
              <p>Investment</p>
              <h2>$997 · 90 minutes</h2>
              <span>Paid in full at booking.</span>
            </div>
            <a href={reserveSessionHref}>Reserve MAPS Blueprint℠ →</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .maps-booking {
    background: var(--color-base-50);
    color: var(--color-base-700);
  }

  .maps-booking__hero {
    background: linear-gradient(135deg, var(--color-base-950) 0%, var(--color-base-900) 58%, var(--color-base-800) 100%);
    color: #ffffff;
  }

  .maps-booking__hero-shell,
  .maps-booking__close-shell {
    width: min(100%, 78rem);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .maps-booking__hero-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 22rem);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    min-height: clamp(24rem, 48vh, 32rem);
    padding-top: clamp(8.25rem, 11vw, 9.75rem);
    padding-bottom: clamp(3rem, 5vw, 4.25rem);
  }

  .maps-booking__hero-copy {
    max-width: 48rem;
  }

  .maps-booking__eyebrow,
  .maps-booking__type {
    margin: 0;
    color: color-mix(in oklch, var(--color-base-100) 88%, #ffffff);
    font-family: var(--font-sans);
    font-size: var(--lozen-meta-label-size);
    font-weight: var(--lozen-meta-label-weight);
    letter-spacing: var(--lozen-meta-label-letter-spacing);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .maps-booking__type {
    margin-top: 0.55rem;
    color: color-mix(in oklch, var(--color-base-100) 82%, #ffffff);
  }

  .maps-booking h1 {
    max-width: var(--lozen-page-hero-text-width);
    margin: clamp(1rem, 2vw, 1.45rem) 0 0;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: var(--lozen-page-hero-title-size);
    font-weight: var(--lozen-page-hero-title-weight);
    letter-spacing: var(--lozen-page-hero-title-letter-spacing);
    line-height: var(--lozen-page-hero-title-line-height);
  }

  .maps-booking__deck {
    max-width: 42rem;
    margin: clamp(1rem, 2vw, 1.35rem) 0 0;
    color: color-mix(in oklch, var(--color-base-100) 84%, #ffffff);
    font-family: var(--font-sans);
    font-size: var(--lozen-page-hero-deck-size);
    font-weight: 400;
    letter-spacing: normal;
    line-height: var(--lozen-page-hero-deck-line-height);
  }

  .maps-booking__reserve-card {
    display: grid;
    gap: 0.85rem;
    align-self: end;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 1.35rem;
    background: color-mix(in oklch, var(--color-base-900) 76%, rgba(255, 255, 255, 0.12));
    padding: clamp(1.25rem, 2.2vw, 1.6rem);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(12px);
  }

  .maps-booking__reserve-label {
    margin: 0;
    color: color-mix(in oklch, var(--color-base-100) 85%, #ffffff);
    font-family: var(--font-sans);
    font-size: var(--lozen-meta-label-size);
    font-weight: var(--lozen-meta-label-weight);
    letter-spacing: var(--lozen-meta-label-letter-spacing);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .maps-booking__reserve-card strong {
    color: #ffffff;
    font-family: var(--font-display);
    font-size: var(--lozen-section-title-size);
    font-weight: var(--lozen-section-title-weight);
    letter-spacing: var(--lozen-section-title-letter-spacing);
    line-height: var(--lozen-section-title-line-height);
  }

  .maps-booking__reserve-card span,
  .maps-booking__reserve-card p,
  .maps-booking__reserve-card small {
    margin: 0;
    color: color-mix(in oklch, var(--color-base-100) 82%, #ffffff);
    font-family: var(--font-sans);
    line-height: 1.55;
  }

  .maps-booking__reserve-card span {
    color: color-mix(in oklch, var(--color-base-100) 82%, #ffffff);
    font-size: var(--lozen-body-copy-small-size);
    font-weight: 700;
    letter-spacing: normal;
  }

  .maps-booking__reserve-card p {
    font-size: 0.98rem;
  }

  .maps-booking__reserve-card small {
    color: color-mix(in oklch, var(--color-base-100) 66%, #ffffff);
    font-size: 0.78rem;
  }

  .maps-booking__reserve-card a,
  .maps-booking__final-cta a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    border: 1px solid var(--color-accent-400);
    border-radius: 999px;
    background: var(--color-accent-300);
    color: var(--color-base-950);
    font-family: var(--font-sans);
    font-size: var(--lozen-body-copy-small-size);
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 1;
    padding: 0.95rem 1.15rem;
    text-align: center;
    text-decoration: none;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .maps-booking__reserve-card a {
    width: 100%;
    margin-top: 0.15rem;
  }

  .maps-booking__reserve-card a:hover,
  .maps-booking__reserve-card a:focus-visible,
  .maps-booking__final-cta a:hover,
  .maps-booking__final-cta a:focus-visible {
    border-color: var(--color-accent-500);
    background: var(--color-accent-400);
    transform: translateY(-1px);
  }

  .maps-booking__close {
    background:
      linear-gradient(180deg, #ffffff 0%, var(--color-base-50) 100%);
  }

  .maps-booking__close-shell {
    padding-top: clamp(2.75rem, 6vw, 4.75rem);
    padding-bottom: clamp(4rem, 8vw, 6.5rem);
  }

  .maps-booking__copy-column {
    width: min(100%, 52rem);
  }

  .maps-booking__lead {
    display: grid;
    gap: 1rem;
  }

  .maps-booking__lead p,
  .maps-booking__situation-block p,
  .maps-booking__body-copy p {
    margin: 0;
    color: var(--color-base-750, var(--color-base-700));
    font-family: var(--font-sans);
    font-size: var(--lozen-body-copy-large-size);
    line-height: var(--lozen-body-copy-large-line-height);
  }

  .maps-booking__lead p:first-child {
    color: var(--color-base-950);
    font-family: var(--font-sans);
    font-size: var(--lozen-body-copy-large-size);
    font-weight: 500;
    letter-spacing: normal;
    line-height: var(--lozen-body-copy-large-line-height);
  }

  .maps-booking__situation-block {
    margin-top: clamp(2rem, 4vw, 3rem);
    border-left: 3px solid var(--color-base-500);
    background: #ffffff;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1.25rem, 3vw, 2rem);
  }

  .maps-booking__situation-block p {
    color: var(--color-base-850, var(--color-base-800));
  }

  .maps-booking__body-copy {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .maps-booking__final-cta {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid color-mix(in oklch, var(--color-base-300) 70%, transparent);
    padding-top: clamp(1.5rem, 3vw, 2rem);
  }

  .maps-booking__final-cta p {
    margin: 0 0 0.5rem;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: var(--lozen-meta-label-size);
    font-weight: var(--lozen-meta-label-weight);
    letter-spacing: var(--lozen-meta-label-letter-spacing);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .maps-booking__final-cta h2 {
    margin: 0;
    color: var(--color-base-950);
    font-family: var(--font-display);
    font-size: var(--lozen-section-title-size);
    font-weight: var(--lozen-section-title-weight);
    letter-spacing: var(--lozen-section-title-letter-spacing);
    line-height: var(--lozen-section-title-line-height);
  }

  .maps-booking__final-cta span {
    display: block;
    margin-top: 0.65rem;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .maps-booking__final-cta a {
    flex: 0 0 auto;
    min-width: min(100%, 18rem);
  }

  @media (max-width: 899px) {
    .maps-booking__hero-shell {
      grid-template-columns: minmax(0, 1fr);
      min-height: auto;
      padding-top: clamp(5.25rem, 18vw, 7rem);
    }

    .maps-booking__reserve-card {
      align-self: stretch;
      max-width: 28rem;
    }

    .maps-booking__final-cta {
      align-items: stretch;
      flex-direction: column;
    }

    .maps-booking__final-cta a {
      width: 100%;
      min-width: 0;
    }
  }

  @media (max-width: 640px) {
    .maps-booking h1 {
      font-size: var(--lozen-page-hero-title-size);
      line-height: var(--lozen-page-hero-title-line-height);
    }

    .maps-booking__hero-shell,
    .maps-booking__close-shell {
      padding-inline: 1rem;
    }

    .maps-booking__situation-block {
      border-left-width: 2px;
    }
  }
</style>
