---
/**
 * Executive Briefing — Alabama HB 172
 * Place at: src/pages/ai-legislation-tracker/briefings/hb172-executive-briefing.astro
 *
 * Uses BaseLayout (Lozen nav/footer), Lozen token system (Tenor Sans, DM Sans,
 * navy/teal/yellow palette), and Lovable's editorial layout structure.
 *
 * TODO (Supabase dynamic routing): Rename to [slug].astro and replace
 * the `bill` const below with:
 *   const { slug } = Astro.params;
 *   const { data: bill } = await supabase
 *     .from('legislation').select('*').eq('slug', slug).single();
 *   if (!bill) return Astro.redirect('/404');
 */
import BaseLayout from "@/layouts/BaseLayout.astro";

// ── Bill data (static — swap for Supabase fetch for dynamic routing) ─────────
const bill = {
  ref:           "HB-172",
  rev:           "2024.10",
  country:       "United States",
  state:         "Alabama",
  diagnosticUrl: "/ai-legislation-tracker/briefings/hb172-diagnostic",

  riskLevel:     "medium",       // "low" | "medium" | "high" | "critical"
  status:        "Enacted",
  operativeDate: "October 1, 2024",

  instrument:    "HB 172 (State statute)",
  domain:        "Synthetic media · Elections",
  window:        "90 days pre-election",
  jurisdiction:  "Alabama · USA",
  titleLine1:    "Alabama Materially Deceptive Election Media Law",
  titleCode:     "HB 172.",
  lead:          "A criminal and civil regime targeting synthetic political media. For enterprises, the question is not whether the law applies to your business directly — it is whether your AI stack, vendor chain, and review workflows can be defended when an incident lands inside the 90-day election window.",

  glanceStatus:  "Enacted · in force",
  riskPosture:   "Medium — situational",
  primaryOwners: "Legal · GRC · CIO",
  glanceNote:    "Treat AI-assisted political or quasi-political content as a regulated workflow, not a productivity feature.",

  tags: ["AI", "Election Communications", "Political Risk", "Regulatory Requirements", "Synthetic Media"],

  summaryLead:
    'HB 172 converts a content-moderation question into a governance question. The statute presumes a <em class="brief-accent">competent human</em> reviewed, approved, and can defend any synthetic or AI-assisted output that touches an election cycle.',
  summaryBody:
    "For B2B operators — agencies, platforms, advisory firms, communications vendors, and any enterprise whose tools or staff may touch political content — the practical exposure is not the headline criminal liability. It is the operational expectation that every AI-generated artifact has a named, accountable reviewer with a reconstructable record. That expectation, once codified in one state, becomes the working assumption regulators, plaintiffs, and boards apply everywhere else.",
  summaryCards: [
    { k: "Exposure shape",         v: "Civil + criminal, narrow window, broad definitions" },
    { k: "What's actually scarce", v: "Defensible human review capacity" },
    { k: "Board-level question",   v: "Is AI building capacity or hiding labor?" },
  ],

  lenses: [
    { icon: "shield",    tag: "Control surface", title: "AI governance question",       body: "What does this legislation require the organization to know, document, review, or control before AI-assisted work can be treated as governed?" },
    { icon: "users",     tag: "Accountability",  title: "Human verification burden",    body: "Where does the legislation assume that a person can review, correct, contest, approve, or take responsibility for AI-assisted output?" },
    { icon: "clipboard", tag: "Auditability",    title: "Decision debt",                body: "Does the legislation reduce the risk of AI-influenced decisions becoming difficult to explain, reconstruct, or defend later?" },
    { icon: "layers",    tag: "Operating cost",  title: "Botsitting & relocated labor", body: "Does the law account for the work required to make AI usable — context-loading, output checking, rework, escalation, and cleanup?" },
    { icon: "eye",       tag: "Board signal",    title: "Enterprise performance gap",   body: "Does the legislation help leaders distinguish task-level AI productivity from organization-level performance, control, and accountability?" },
  ],

  actionNote: {
    headline: "Treat the 90-day pre-election window as a control regime.",
    body:     "Pre-stage approvals, disclosures, and review SLAs <em>before</em> the window opens — not after.",
  },
  actions: [
    { title: "Inventory exposure surfaces",                   body: "Catalog tools, vendors, and workflows capable of producing election-adjacent synthetic media — including general-purpose assistants used by client-facing teams." },
    { title: "Define a named human reviewer per output class", body: "Every artifact class needs a role accountable for review, an SLA, and a logged decision. Anonymous AI output is the failure mode." },
    { title: "Stand up disclosure and provenance defaults",   body: "C2PA-style provenance, watermarking, and contractual disclosure clauses with agencies and platforms. Default-on, opt-out by exception only." },
    { title: "Capture decision-debt evidence",                body: "Persist prompts, model versions, reviewer identity, and rationale. Six months from now, you will need to reconstruct who decided what, and why." },
    { title: "Brief the board on governed capacity",          body: "Report AI not as headcount-equivalent productivity, but as capacity net of review burden, escalation, and rework. Make the gap visible." },
  ],

  audience: [
    { role: "Chief Information Officer", focus: "Model inventory, content provenance, deployment gates" },
    { role: "General Counsel",           focus: "Disclosure language, indemnity, election-period exposure" },
    { role: "GRC & Risk Leaders",        focus: "Control mapping, evidence capture, third-party review" },
    { role: "Board & Audit Committee",   focus: "Materiality, oversight cadence, reputational risk" },
  ],
};

// ── Risk meta ─────────────────────────────────────────────────────────────────
const riskMeta: Record<string, { label: string; dotClass: string; badgeClass: string }> = {
  low:      { label: "Low risk",      dotClass: "brief-dot--low",      badgeClass: "brief-badge--low"      },
  medium:   { label: "Medium risk",   dotClass: "brief-dot--medium",   badgeClass: "brief-badge--medium"   },
  high:     { label: "High risk",     dotClass: "brief-dot--high",     badgeClass: "brief-badge--high"     },
  critical: { label: "Critical risk", dotClass: "brief-dot--critical", badgeClass: "brief-badge--critical" },
};
const risk = riskMeta[bill.riskLevel] ?? riskMeta.medium;

// ── SVG icons (inline, no package dependency) ─────────────────────────────────
const icons: Record<string, string> = {
  bookmark:  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>`,
  landmark:  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="22" x2="21" y2="22"/><line x1="6" y1="18" x2="6" y2="11"/><line x1="10" y1="18" x2="10" y2="11"/><line x1="14" y1="18" x2="14" y2="11"/><line x1="18" y1="18" x2="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>`,
  fileText:  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  share:     `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>`,
  gavel:     `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m14.5 12.5-8 8a2.119 2.119 0 0 1-3-3l8-8"/><path d="m16 16 6-6"/><path d="m8 8 6-6"/><path d="m9 7 8 8"/><path d="m21 11-8-8"/></svg>`,
  alert:     `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>`,
  scroll:    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h12a2 2 0 0 0 2-2v-2H10v2a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v3h4"/><path d="M19 17V5a2 2 0 0 0-2-2H4"/></svg>`,
  shield:    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`,
  users:     `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  clipboard: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>`,
  layers:    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
  eye:       `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>`,
  arrowRight:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>`,
};
---

<BaseLayout
  title={`Executive Briefing — Alabama ${bill.ref} | AI Governance Exposure`}
  description="Enterprise briefing on Alabama's Materially Deceptive Election Media Law (HB 172): AI governance, human verification burden, and board-level accountability."
  ogType="article"
>

  <!-- ── Utility bar ──────────────────────────────────────────────── -->
  <div class="brief-util-bar">
    <div class="brief-container brief-util-bar__inner">
      <div class="brief-util-bar__left">
        <span class="brief-util-icon" set:html={icons.landmark} />
        <span>Enterprise Briefing</span>
        <span class="brief-util-sep">/</span>
        <span class="brief-util-bar__location">{bill.country} · {bill.state}</span>
      </div>
      <div class="brief-util-bar__right">
        <span>Ref. {bill.ref}</span>
        <span class="brief-util-sep">·</span>
        <span>Rev. {bill.rev}</span>
      </div>
    </div>
  </div>

  <!-- ── Masthead ─────────────────────────────────────────────────── -->
  <header class="brief-masthead">
    <div class="brief-container brief-masthead__inner">
      <div class="brief-masthead__brand">
        <div class="brief-logo" aria-hidden="true">
          <span set:html={icons.bookmark} />
        </div>
        <div>
          <div class="brief-masthead__name">Governance Desk</div>
          <div class="brief-masthead__sub">Regulatory Intelligence · AI &amp; Information Integrity</div>
        </div>
      </div>
      <div class="brief-masthead__actions">
        <button class="brief-btn brief-btn--outline">
          <span set:html={icons.fileText} />Export PDF
        </button>
        <button class="brief-btn brief-btn--navy">
          Share with board<span set:html={icons.share} />
        </button>
      </div>
    </div>
  </header>

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section class="brief-hero">
    <div class="brief-container">
      <div class="brief-hero__grid">

        <div class="brief-hero__main">
          <div class="brief-badge-row">
            <span class={`brief-badge ${risk.badgeClass}`}>
              <span class={`brief-dot ${risk.dotClass}`}></span>
              {risk.label}
            </span>
            <span class="brief-badge brief-badge--enacted">{bill.status}</span>
            <span class="brief-badge brief-badge--neutral">Operative · {bill.operativeDate}</span>
          </div>

          <h1 class="brief-hero__title">
            {bill.titleLine1}<span class="brief-hero__title-code"> — {bill.titleCode}</span>
          </h1>

          <p class="brief-hero__lead">{bill.lead}</p>

          <div class="brief-meta-row">
            {[
              { k: "Jurisdiction", v: bill.jurisdiction },
              { k: "Instrument",   v: bill.instrument   },
              { k: "Domain",       v: bill.domain       },
              { k: "Window",       v: bill.window       },
            ].map(m => (
              <div class="brief-meta-item">
                <div class="brief-meta-item__label">{m.k}</div>
                <div class="brief-meta-item__value">{m.v}</div>
              </div>
            ))}
          </div>

          <div class="brief-tag-row">
            {bill.tags.map(t => <span class="brief-tag">{t}</span>)}
          </div>
        </div>

        <aside>
          <div class="brief-glance-card">
            <div class="brief-glance-card__header">
              <span class="brief-eyebrow">At a glance</span>
              <span class="brief-glance-card__icon" set:html={icons.gavel} />
            </div>
            <dl class="brief-glance-dl">
              <div><dt>Status</dt><dd>{bill.glanceStatus}</dd></div>
              <div><dt>Operative date</dt><dd>{bill.operativeDate}</dd></div>
              <div>
                <dt>Risk posture</dt>
                <dd><span class={`brief-dot brief-dot--inline ${risk.dotClass}`}></span>{bill.riskPosture}</dd>
              </div>
              <div><dt>Primary owners</dt><dd>{bill.primaryOwners}</dd></div>
            </dl>
            <p class="brief-glance-note">{bill.glanceNote}</p>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <!-- ── § 01 Executive Summary ───────────────────────────────────── -->
  <section class="brief-section brief-section--cream">
    <div class="brief-container">
      <div class="brief-split-3-9">
        <div class="brief-section__label">
          <div class="brief-eyebrow">§ 01</div>
          <h2 class="brief-section__title">Executive summary</h2>
          <div class="brief-accent-rule"></div>
        </div>
        <div class="brief-section__body">
          <p class="brief-summary-lead" set:html={bill.summaryLead} />
          <p class="brief-body-text" style="margin-top:1.25rem">{bill.summaryBody}</p>
          <div class="brief-cell-grid">
            {bill.summaryCards.map(c => (
              <div class="brief-cell">
                <div class="brief-cell__label">{c.k}</div>
                <div class="brief-cell__value">{c.v}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── § 02 Five Lenses ─────────────────────────────────────────── -->
  <section class="brief-section brief-section--white">
    <div class="brief-container">
      <div class="brief-section-header">
        <div>
          <div class="brief-eyebrow">§ 02 · Analytical frame</div>
          <h2 class="brief-section__title brief-section__title--xl">Five lenses for the board pack</h2>
          <p class="brief-section__deck">
            Use the same lenses across every new AI-adjacent statute. Consistency is what makes risk legible to non-technical directors.
          </p>
        </div>
        <div class="brief-section-header__meta">Framework · Governed capacity</div>
      </div>
      <div class="brief-lens-grid">
        {bill.lenses.map((lens, i) => (
          <article class="brief-lens-card">
            <div class="brief-lens-card__top">
              <div class="brief-lens-card__icon" set:html={icons[lens.icon]} />
              <span class="brief-eyebrow brief-eyebrow--sm">0{i + 1} · {lens.tag}</span>
            </div>
            <h3 class="brief-lens-card__title">{lens.title}</h3>
            <p class="brief-lens-card__body">{lens.body}</p>
            <div class="brief-lens-card__cta">
              Map to control library<span set:html={icons.arrowRight} />
            </div>
          </article>
        ))}
        <div class="brief-lens-filler" aria-hidden="true">
          <span class="brief-lens-filler__icon" set:html={icons.scroll} />
          <div>
            <div class="brief-eyebrow brief-eyebrow--light">Operating principle</div>
            <p class="brief-lens-filler__quote">Governed capacity, not relocated accountability.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── § 03 Recommended Actions ────────────────────────────────── -->
  <section class="brief-section brief-section--cream">
    <div class="brief-container">
      <div class="brief-split-4-8">
        <div>
          <div class="brief-eyebrow">§ 03 · Next 90 days</div>
          <h2 class="brief-section__title">Recommended actions</h2>
          <p class="brief-body-text" style="margin-top:1rem">
            A short, defensible action set. Each item produces evidence a board, regulator, or plaintiff can read.
          </p>
          <div class="brief-alert-box">
            <span class="brief-alert-box__icon" set:html={icons.alert} />
            <div>
              <p class="brief-alert-box__title">{bill.actionNote.headline}</p>
              <p class="brief-alert-box__body" set:html={bill.actionNote.body} />
            </div>
          </div>
        </div>
        <div>
          <ol class="brief-timeline">
            {bill.actions.map((step, i) => (
              <li class="brief-timeline__item">
                <span class="brief-timeline__dot" aria-hidden="true"></span>
                <div class="brief-timeline__header">
                  <span class="brief-timeline__num">0{i + 1}</span>
                  <h3 class="brief-timeline__title">{step.title}</h3>
                </div>
                <p class="brief-timeline__body">{step.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ── § 04 Audience ────────────────────────────────────────────── -->
  <section class="brief-section brief-section--navy">
    <div class="brief-container">
      <div class="brief-audience-header">
        <div class="brief-eyebrow brief-eyebrow--light">§ 04 · Who this is for</div>
        <h2 class="brief-section__title brief-section__title--xl brief-section__title--light">Enterprise relevance</h2>
        <p class="brief-section__deck brief-section__deck--light">
          This record helps senior leaders evaluate whether AI adoption is creating
          <em>governed capacity</em> or merely relocating accountability into human review work.
        </p>
      </div>
      <div class="brief-audience-grid">
        {bill.audience.map((a, i) => (
          <div class="brief-audience-card">
            <div class="brief-audience-card__num">0{i + 1}</div>
            <h3 class="brief-audience-card__role">{a.role}</h3>
            <p class="brief-audience-card__focus">{a.focus}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────────── -->
  <section class="brief-section brief-section--white">
    <div class="brief-container">
      <div class="brief-cta">
        <div class="brief-cta__copy">
          <h2 class="brief-cta__title">Add {bill.ref} to your governance register, then close the briefing.</h2>
          <p class="brief-body-text" style="margin-top:0.75rem">
            Route this record to Legal, GRC, and the CIO office. Set review for the next election cycle and capture
            evidence of distribution — the same evidentiary discipline the statute itself assumes.
          </p>
        </div>
        <div class="brief-cta__actions">
          <a href={bill.diagnosticUrl} class="brief-btn brief-btn--navy brief-btn--lg">
            Open Name Standard&#8480; diagnostic<span set:html={icons.arrowRight} />
          </a>
          <button class="brief-btn brief-btn--outline brief-btn--lg">Close briefing</button>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
/* ══════════════════════════════════════════════════════════════════════════════
   EXECUTIVE BRIEFING PAGE — brief- scoped styles
   Uses Lozen token system. Lovable's layout structure, Lozen's visual identity.
══════════════════════════════════════════════════════════════════════════════ */

.brief-container {
  max-width: 80rem;
  margin-inline: auto;
  padding-inline: clamp(1rem, 4vw, 2rem);
}

/* Sections */
.brief-section { border-bottom: 1px solid var(--color-base-200); }
.brief-section--cream { background: var(--color-base-50); }
.brief-section--white { background: #ffffff; }
.brief-section--navy {
  background: linear-gradient(135deg,
    color-mix(in oklch, var(--color-base-950) 97%, transparent) 0%,
    color-mix(in oklch, var(--lozen-tracker-anchor) 85%, transparent) 60%,
    var(--color-base-900) 100%);
  color: var(--color-base-50);
}

/* Two-column grids */
.brief-split-3-9,
.brief-split-4-8 { display: grid; grid-template-columns: 1fr; gap: 3rem; padding-block: 5rem; }
@media (min-width: 1024px) {
  .brief-split-3-9 { grid-template-columns: 3fr 9fr; }
  .brief-split-4-8 { grid-template-columns: 4fr 8fr; }
}

/* ── Utility bar ─────────────────────────────────────────────────────────── */
.brief-util-bar {
  background: var(--color-base-50);
  border-bottom: 1px solid var(--color-base-200);
  padding-top: 5rem; /* clears sticky Lozen nav (~80px) */
}
.brief-util-bar__inner {
  display: flex; align-items: center; justify-content: space-between;
  padding-block: 0.6rem;
  font-family: var(--font-sans); font-size: 0.7rem; font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-base-500);
}
.brief-util-bar__left, .brief-util-bar__right { display: flex; align-items: center; gap: 0.5rem; }
.brief-util-bar__right { display: none; }
@media (min-width: 768px) { .brief-util-bar__right { display: flex; } }
.brief-util-bar__location { color: var(--color-base-800); }
.brief-util-sep { color: var(--color-base-300); }
.brief-util-icon { display: flex; align-items: center; color: var(--color-base-400); }
.brief-util-icon svg { width: 14px; height: 14px; }

/* ── Masthead ────────────────────────────────────────────────────────────── */
.brief-masthead { background: #ffffff; border-bottom: 1px solid var(--color-base-200); }
.brief-masthead__inner {
  display: flex; align-items: center; justify-content: space-between; padding-block: 1.25rem;
}
.brief-masthead__brand { display: flex; align-items: center; gap: 0.75rem; }
.brief-logo {
  width: 2.25rem; height: 2.25rem;
  display: flex; align-items: center; justify-content: center;
  background: var(--color-base-950); border-radius: 4px; flex-shrink: 0;
  color: var(--color-accent-400);
}
.brief-logo svg { width: 16px; height: 16px; }
.brief-masthead__name {
  font-family: var(--font-display); font-size: 1.05rem; font-weight: 400;
  letter-spacing: -0.01em; color: var(--color-base-900); line-height: 1;
}
.brief-masthead__sub { font-size: 0.72rem; color: var(--color-base-500); margin-top: 3px; }
.brief-masthead__actions { display: flex; align-items: center; gap: 0.5rem; }

/* ── Buttons ─────────────────────────────────────────────────────────────── */
.brief-btn {
  display: inline-flex; align-items: center; gap: 0.375rem;
  border-radius: 6px; padding: 0.5rem 0.875rem;
  font-family: var(--font-sans); font-size: 0.78rem; font-weight: 600;
  cursor: pointer; transition: background 0.15s, opacity 0.15s;
  border: 1px solid transparent; text-decoration: none; line-height: 1; white-space: nowrap;
}
.brief-btn svg { width: 14px; height: 14px; }
