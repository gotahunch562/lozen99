---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import NarrativePage from "@/components/authority/NarrativePage.astro";
import servicePlaceholder from "@/images/services/marketintelligence.webp";
import { createServiceJsonLd } from "@/lib/seo/jsonLd";

const title = "What We Do";

const seoTitle = "Services | Lozen Advisory";

const description = "Strategic counsel for the era of algorithmic accountability.";

const canonical = "https://www.lozenadvisory.com/services";

const serviceOrder = [
  "Market Intelligence",
  "Governance Readiness Briefing",
  "Advisory Engagement",
  "Crisis, Reputation, and Workforce Risk",
];

const serviceEntries = await getCollection("services");

const services = serviceEntries
  .sort((a, b) => {
    const aIndex = serviceOrder.indexOf(a.data.title);
    const bIndex = serviceOrder.indexOf(b.data.title);

    if (aIndex === -1 && bIndex === -1) {
      return a.data.title.localeCompare(b.data.title);
    }

    if (aIndex === -1) return 1;
    if (bIndex === -1) return -1;

    return aIndex - bIndex;
  })
  .map((service) => ({
    title: service.data.title,
    href: `/services/${service.id}`,
    description: service.data.shortDescription || service.data.description,
    image: service.data.image?.url || servicePlaceholder,
    imageAlt: service.data.image?.alt || `${service.data.title} service image`,
  }));

const pageJsonLd = createServiceJsonLd({
  name: seoTitle,
  description,
  href: canonical,
  serviceType: "Governance advisory",
  offers: services.map((service) => ({
    name: service.title,
    description: service.description,
    href: service.href,
  })),
});
---

<NarrativePage
  title={title}
  seoTitle={seoTitle}
  description={description}
  metaDescription={description}
  canonical={canonical}
  eyebrow="Services"
  articleJsonLd={pageJsonLd}
>

 <p>
  Lozen Advisory works with leadership teams when utilization is low, retention risk is unclear, succession exposure is underestimated, or a workforce or AI governance issue is beginning to carry operational, reputational, or board-level weight. We advise on the infrastructure questions those conditions reveal: what the current system can and cannot detect, where human accountability must remain traceable under the Name Standard℠, and what a disclosure-independent design would require.
</p>

  <p class="service-thesis">
    The absence of data is not the absence of risk.
  </p>

  <section class="service-scope" aria-label="What Lozen Advisory is not">
    <div class="service-scope__label">Scope Clarification</div>

    <div class="service-scope__grid">
      <h2>What Lozen Advisory Is Not</h2>

      <div class="service-scope__copy">
        <p>
          Lozen Advisory does not collect employee data, administer benefits, or audit workforce behavior. We are not an HR analytics platform. We do not access your employees' records, claims history, or utilization files.
        </p>

        <p>
          We advise on the design conditions that determine what your current infrastructure can detect and what it cannot. That is a governance question, not a data question. The work is at the leadership level, with your leadership team.
        </p>
      </div>
    </div>
  </section>


  <section class="service-cards" aria-label="Services">
    <div class="service-cards__heading">
      <h2>Services</h2>
    </div>

    <div class="service-cards__grid">
      {
        services.map((service) => (
          <article class="service-card">
            <a href={service.href} class="service-card__link">
              <div class="service-card__media">
                <Image
                  src={service.image}
                  alt={service.imageAlt}
                  class="service-card__image"
                  loading="lazy"
                />
              </div>

              <div class="service-card__content">
                <div class="service-card__title-row">
                  <h3>{service.title}</h3>
                  <span aria-hidden="true">→</span>
                </div>

                <p>{service.description}</p>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</NarrativePage>

<style>
  .service-thesis {
    margin: 2.25rem 0 0 !important;
    color: var(--color-base-950) !important;
    font-family: var(--font-display) !important;
    font-size: var(--lozen-section-title-size) !important;
    font-weight: var(--lozen-section-title-weight);
    letter-spacing: var(--lozen-section-title-letter-spacing);
    line-height: var(--lozen-section-title-line-height) !important;
    text-wrap: balance;
  }


  .service-scope {
    margin: 3rem 0 0;
    border: 1px solid var(--color-base-300);
    border-radius: 1.25rem;
    background: var(--color-base-50);
    padding: clamp(1.35rem, 3vw, 2rem);
    box-shadow: 0 18px 42px rgba(6, 23, 47, 0.06);
  }

  .service-scope__label {
    border-left: 1px solid var(--color-accent-500);
    padding-left: 0.9rem;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: var(--lozen-meta-label-size);
    font-weight: var(--lozen-meta-label-weight);
    letter-spacing: var(--lozen-meta-label-letter-spacing);
    line-height: 1.15;
    text-transform: uppercase;
  }

  .service-scope__grid {
    display: grid;
    grid-template-columns: minmax(12rem, 0.38fr) minmax(0, 1fr);
    gap: clamp(1.35rem, 4vw, 2.75rem);
    align-items: start;
    margin-top: 1.35rem;
  }

  .service-scope h2 {
    margin: 0 !important;
    color: var(--color-base-950) !important;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.45vw, 2.15rem) !important;
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.12 !important;
    text-wrap: balance;
  }

  .service-scope__copy {
    display: grid;
    gap: 1rem;
  }

  .service-scope__copy p {
    margin: 0 !important;
    color: var(--color-base-750, var(--color-base-700)) !important;
    font-family: var(--font-sans);
    font-size: 1.0625rem !important;
    line-height: 1.82 !important;
  }

.service-cards {
    position: relative;
    left: 50%;
    width: min(calc(100vw - 3rem), 78rem);
    margin: 3.25rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--color-base-300);
    transform: translateX(-50%);
  }

  .service-cards__heading h2 {
    margin-top: 0 !important;
  }

  .service-cards__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: 1.65rem;
  }

  .service-card {
    margin: 0;
  }

  .service-card__link {
    display: block;
    height: 100%;
    color: inherit !important;
    text-decoration: none !important;
  }

  .service-card__media {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-base-200);
    border-radius: 1.1rem;
    background: var(--color-base-100);
    box-shadow: 0 18px 42px rgba(6, 23, 47, 0.08);
  }

  .service-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 520ms ease,
      filter 520ms ease;
  }

  .service-card__link:hover .service-card__image,
  .service-card__link:focus-visible .service-card__image {
    transform: scale(1.035);
    filter: saturate(0.96) contrast(1.04);
  }

  .service-card__content {
    padding-top: 1.25rem;
  }

  .service-card__title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .service-card__title-row h3 {
    margin: 0 !important;
    color: var(--color-base-950) !important;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem) !important;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08 !important;
    transition: color 220ms ease;
  }

  .service-card__title-row span {
    flex: 0 0 auto;
    color: var(--color-base-950);
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1;
    transition:
      color 220ms ease,
      transform 220ms ease;
  }

  .service-card__link:hover .service-card__title-row h3,
  .service-card__link:focus-visible .service-card__title-row h3,
  .service-card__link:hover .service-card__title-row span,
  .service-card__link:focus-visible .service-card__title-row span {
    color: var(--color-accent-700) !important;
  }

  .service-card__link:hover .service-card__title-row span,
  .service-card__link:focus-visible .service-card__title-row span {
    transform: translateX(0.25rem);
  }

  .service-card__content p {
    margin: 0.85rem 0 0 !important;
    color: var(--color-base-700) !important;
    font-family: var(--font-sans);
    font-size: 1rem !important;
    line-height: 1.72 !important;
  }

  @media (max-width: 760px) {


    .service-scope__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .service-scope__copy p {
      font-size: 1rem !important;
      line-height: 1.78 !important;
    }

    .service-cards {
      left: auto;
      width: 100%;
      margin-top: 2.75rem;
      padding-top: 1.5rem;
      transform: none;
    }

    .service-cards__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .service-card__media {
      border-radius: 1rem;
    }

    .service-card__content p {
      font-size: 0.97rem !important;
      line-height: 1.65 !important;
    }
  }
</style>
