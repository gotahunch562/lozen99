---
import { Image } from "astro:assets";
import NarrativePage from "@/components/authority/NarrativePage.astro";
import MailerLiteSignup from "@/components/forms/MailerLiteSignup.astro";
import servicePlaceholder from "@/images/services/serviceplaceholder.webp";

const title = "What We Do";

const seoTitle = "Services | Lozen Advisory";

const description =
  "Lozen Advisory helps organizations see the risks their current systems are not built to detect.";

const canonical = "https://www.lozenadvisory.com/services";

const services = [
  {
    title: "Market Intelligence",
    href: "/services/market-intelligence",
    description:
      "Research and analysis on disclosure-dependent workforce risk, menopause-at-work benefits utilization, AI implementation burden, and the business consequences of undercounted need.",
  },
  {
    title: "Executive Briefing",
    href: "/services/executive-briefing",
    description:
      "A focused advisory session for leadership teams that need clarity before a hidden issue becomes a visible crisis.",
  },
  {
    title: "Advisory Engagement",
    href: "/services/advisory-engagement",
    description:
      "Ongoing counsel on non-disclosure infrastructure, benefits strategy, AI governance, retention risk, leadership continuity, and reputational exposure.",
  },
  {
    title: "Crisis, Reputation, and Workforce Risk",
    href: "/services/crisis-reputation-workforce-risk",
    description:
      "Support for organizations facing sensitive workforce issues where incomplete data, low utilization, leadership exits, or AI implementation burden may create operational or reputational consequences.",
  },
];

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: seoTitle,
  description,
  url: canonical,
  provider: {
    "@type": "Organization",
    name: "Lozen Advisory LLC",
    url: "https://www.lozenadvisory.com",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Lozen Advisory Services",
    itemListElement: services.map((service) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: service.title,
        description: service.description,
        url: `https://www.lozenadvisory.com${service.href}`,
      },
    })),
  },
};
---

<NarrativePage
  title={title}
  seoTitle={seoTitle}
  description={description}
  metaDescription={description}
  canonical={canonical}
  eyebrow="Services"
  typeLabel="Advisory Architecture"
  articleJsonLd={pageJsonLd}
  bottomCta={{
    label: "Why Clients Come",
    title: "Lozen Advisory works before that point.",
    description:
      "Menopause is the signal. AI is the multiplier. Retention is where the cost becomes visible.",
    href: "/request-briefing",
    linkLabel: "Request Briefing →",
  }}
>
  <h2>Where visible systems stop short.</h2>

  <p>
    We work with leadership teams when benefits utilization is low, retention risk is unclear, succession exposure is underestimated, AI implementation burden is hidden, or a workforce issue is beginning to carry reputational, operational, or governance consequences.
  </p>

  <p>
    The problem is rarely the absence of data. Most organizations already have dashboards, benefits reports, HR records, engagement surveys, productivity metrics, AI adoption data, and retention analysis. The problem is that those systems often measure only what becomes visible.
  </p>

  <p>
    That creates false confidence.
  </p>

  <section class="service-cards" aria-label="Services">
    <div class="service-cards__heading">
      <h2>Services</h2>
    </div>

    <div class="service-cards__grid">
      {
        services.map((service) => (
          <article class="service-card">
            <a href={service.href} class="service-card__link">
              <div class="service-card__media" aria-hidden="true">
                <Image
                  src={servicePlaceholder}
                  alt=""
                  class="service-card__image"
                  loading="lazy"
                />
              </div>

              <div class="service-card__content">
                <div class="service-card__title-row">
                  <h3>{service.title}</h3>
                  <span aria-hidden="true">→</span>
                </div>

                <p>{service.description}</p>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <h2>Tacere: The Framework</h2>

  <p>
    The employee who never files a claim, never requests an accommodation, and never flags a performance issue is not absent from your workforce.
  </p>

  <p>
    They are present, performing, and keeping their own counsel.
  </p>

  <p>
    Tacere names that practice and explains what it costs when organizations rely on systems that can only see employees after they disclose, request, or report.
  </p>

  <p>
    Download the Tacere paper to understand the framework
  </p>

  <section id="tacere-download" class="narrative-callout service-download" aria-label="Download the Tacere paper">
    <h3>Download the Tacere Paper →</h3>

    <p>
      Enter your email to receive the download link.
    </p>

    <MailerLiteSignup
      formId="tacere-paper-download"
      group="tacere"
      buttonLabel="Send the paper"
      successMessage="Thank you. You can download the Tacere brief here."
      downloadHref="/download/Lozen_Tacere_Brief.pdf"
      downloadLabel="Download the Tacere brief"
    />
  </section>

  <h2>The MAPS Blueprint℠</h2>

  <p>
    The MAPS Blueprint℠ is the private advisory session for the woman executive.
  </p>

  <p>
    It belongs on this page because Lozen Advisory works both sides of the same structural problem. Organizations need to understand the risk their systems cannot see. Women executives need to protect themselves inside those systems before a professional record is created.
  </p>

  <p>
    The MAPS Blueprint℠ is for the woman approaching a visible professional moment: a review, a promotion decision, a leadership transition, a difficult performance cycle, a return from leave, or a situation where disclosure may create a record she cannot control.
  </p>

  <p>
    She arrives with a situation. She leaves with a plan.
  </p>

  <p>
    <a class="service-action" href="/booking">Begin MAPS Blueprint℠ →</a>
  </p>

  <h2>Clients come when they need clarity before the cost becomes visible.</h2>

  <p>
    Clients come to Lozen Advisory when the issue is no longer theoretical.
  </p>

  <p>
    They may have invested in benefits and still see low utilization. They may be seeing senior women leave without clear warning. They may be rolling out AI and relying on the same high performers to make it work. They may be preparing for questions from executives, boards, employees, journalists, or external stakeholders. They may need to understand whether their current data can support the claims they are making.
  </p>

  <p>
    In those moments, standard workforce language is not enough.
  </p>

  <p>
    Lozen Advisory helps clients understand the structural issue, the business exposure, and the decision in front of them. The work is built for moments when leaders need clarity before a hidden problem becomes a visible crisis.
  </p>
</NarrativePage>

<style>
  .service-cards {
    position: relative;
    left: 50%;
    width: min(calc(100vw - 3rem), 78rem);
    margin: 3.25rem 0 3.75rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-base-300);
    transform: translateX(-50%);
  }

  .service-cards__heading h2 {
    margin-top: 0 !important;
  }

  .service-cards__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: 1.65rem;
  }

  .service-card {
    margin: 0;
  }

  .service-card__link {
    display: block;
    height: 100%;
    color: inherit !important;
    text-decoration: none !important;
  }

  .service-card__media {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-base-200);
    border-radius: 1.1rem;
    background: var(--color-base-100);
    box-shadow: 0 18px 42px rgba(6, 23, 47, 0.08);
  }

  .service-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 520ms ease, filter 520ms ease;
  }

  .service-card__link:hover .service-card__image,
  .service-card__link:focus-visible .service-card__image {
    transform: scale(1.035);
    filter: saturate(0.96) contrast(1.04);
  }

  .service-card__content {
    padding-top: 1.25rem;
  }

  .service-card__title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .service-card__title-row h3 {
    margin: 0 !important;
    color: var(--color-base-950) !important;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem) !important;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08 !important;
    transition: color 220ms ease;
  }

  .service-card__title-row span {
    flex: 0 0 auto;
    color: var(--color-base-950);
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1;
    transition:
      color 220ms ease,
      transform 220ms ease;
  }

  .service-card__link:hover .service-card__title-row h3,
  .service-card__link:focus-visible .service-card__title-row h3,
  .service-card__link:hover .service-card__title-row span,
  .service-card__link:focus-visible .service-card__title-row span {
    color: var(--color-accent-700) !important;
  }

  .service-card__link:hover .service-card__title-row span,
  .service-card__link:focus-visible .service-card__title-row span {
    transform: translateX(0.25rem);
  }

  .service-card__content p {
    margin: 0.85rem 0 0 !important;
    color: var(--color-base-700) !important;
    font-family: var(--font-sans);
    font-size: 1rem !important;
    line-height: 1.72 !important;
  }

  .service-download {
    display: grid;
    gap: 1rem;
  }

  .service-download h3 {
    margin-top: 0 !important;
  }

  .service-action {
    display: inline-flex;
    border: 1px solid var(--color-base-950);
    border-radius: 999px;
    background: var(--color-base-950);
    padding: 0.82rem 1.05rem;
    color: white !important;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 850;
    text-decoration: none !important;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .service-action:hover,
  .service-action:focus-visible {
    border-color: var(--color-accent-600);
    background: var(--color-accent-600);
    color: var(--color-base-950) !important;
    transform: translateY(-1px);
  }

  @media (max-width: 760px) {
    .service-cards {
      left: auto;
      width: 100%;
      margin-block: 2.75rem 3rem;
      padding-top: 1.5rem;
      transform: none;
    }

    .service-cards__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .service-card__media {
      border-radius: 1rem;
    }

    .service-card__content p {
      font-size: 0.97rem !important;
      line-height: 1.65 !important;
    }
  }
</style>
