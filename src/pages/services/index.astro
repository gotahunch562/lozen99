---
import { Image } from "astro:assets";
import NarrativePage from "@/components/authority/NarrativePage.astro";
import servicePlaceholder from "@/images/services/serviceplaceholder.webp";

const title = "What We Do";

const seoTitle = "Services | Lozen Advisory";

const description =
  "We bring specialized expertise to refine your benefits infrastructure, sharpen your governance strategy, and ensure the analytical framework matches your organization\'s actual risk exposure.";

const canonical = "https://www.lozenadvisory.com/services";

const services = [
  {
    title: "Market Intelligence",
    href: "/services/market-intelligence",
    description:
      "Research and analysis on disclosure-dependent workforce risk, menopause-at-work benefits utilization, AI implementation burden, and the business consequences of undercounted need.",
  },
  {
    title: "Executive Briefing",
    href: "/services/executive-briefing",
    description:
      "A focused advisory session for leadership teams that need clarity before a hidden issue becomes a visible crisis.",
  },
  {
    title: "Advisory Engagement",
    href: "/services/advisory-engagement",
    description:
      "Ongoing counsel on non-disclosure infrastructure, benefits strategy, AI governance, retention risk, leadership continuity, and reputational exposure.",
  },
  {
    title: "Crisis, Reputation, and Workforce Risk",
    href: "/services/crisis-reputation-workforce-risk",
    description:
      "Support for organizations facing sensitive workforce issues where incomplete data, low utilization, leadership exits, or AI implementation burden may create operational or reputational consequences.",
  },
];

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: seoTitle,
  description,
  url: canonical,
  provider: {
    "@type": "Organization",
    name: "Lozen Advisory LLC",
    url: "https://www.lozenadvisory.com",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Lozen Advisory Services",
    itemListElement: services.map((service) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: service.title,
        description: service.description,
        url: `https://www.lozenadvisory.com${service.href}`,
      },
    })),
  },
};
---

<NarrativePage
  title={title}
  seoTitle={seoTitle}
  description={description}
  metaDescription={description}
  canonical={canonical}
  eyebrow="Services"
  articleJsonLd={pageJsonLd}
>
  <p>
    We understand that no two organizations arrive at these questions the same way, and we deliver guidance built around your specific conditions.
  </p>

  <p>
    Lozen Advisory works with leadership teams when utilization is low, retention risk is unclear, succession exposure is underestimated, or a workforce issue is beginning to carry operational, reputational, or governance weight. We advise on the infrastructure questions those conditions reveal: what the current system can and cannot reach, and what a disclosure-independent design would require.
  </p>

  <p class="service-thesis">
    The absence of data is not the absence of risk.
  </p>

  <section class="service-cards" aria-label="Services">
    <div class="service-cards__heading">
      <h2>Services</h2>
    </div>

    <div class="service-cards__grid">
      {
        services.map((service) => (
          <article class="service-card">
            <a href={service.href} class="service-card__link">
              <div class="service-card__media" aria-hidden="true">
                <Image
                  src={servicePlaceholder}
                  alt=""
                  class="service-card__image"
                  loading="lazy"
                />
              </div>

              <div class="service-card__content">
                <div class="service-card__title-row">
                  <h3>{service.title}</h3>
                  <span aria-hidden="true">→</span>
                </div>

                <p>{service.description}</p>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</NarrativePage>

<style>
  .service-thesis {
    margin: 2.25rem 0 0 !important;
    color: var(--color-base-950) !important;
    font-family: var(--font-display) !important;
    font-size: var(--lozen-section-title-size) !important;
    font-weight: var(--lozen-section-title-weight);
    letter-spacing: var(--lozen-section-title-letter-spacing);
    line-height: var(--lozen-section-title-line-height) !important;
    text-wrap: balance;
  }

.service-cards {
    position: relative;
    left: 50%;
    width: min(calc(100vw - 3rem), 78rem);
    margin: 3.25rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--color-base-300);
    transform: translateX(-50%);
  }

  .service-cards__heading h2 {
    margin-top: 0 !important;
  }

  .service-cards__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: 1.65rem;
  }

  .service-card {
    margin: 0;
  }

  .service-card__link {
    display: block;
    height: 100%;
    color: inherit !important;
    text-decoration: none !important;
  }

  .service-card__media {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-base-200);
    border-radius: 1.1rem;
    background: var(--color-base-100);
    box-shadow: 0 18px 42px rgba(6, 23, 47, 0.08);
  }

  .service-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 520ms ease,
      filter 520ms ease;
  }

  .service-card__link:hover .service-card__image,
  .service-card__link:focus-visible .service-card__image {
    transform: scale(1.035);
    filter: saturate(0.96) contrast(1.04);
  }

  .service-card__content {
    padding-top: 1.25rem;
  }

  .service-card__title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .service-card__title-row h3 {
    margin: 0 !important;
    color: var(--color-base-950) !important;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem) !important;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08 !important;
    transition: color 220ms ease;
  }

  .service-card__title-row span {
    flex: 0 0 auto;
    color: var(--color-base-950);
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1;
    transition:
      color 220ms ease,
      transform 220ms ease;
  }

  .service-card__link:hover .service-card__title-row h3,
  .service-card__link:focus-visible .service-card__title-row h3,
  .service-card__link:hover .service-card__title-row span,
  .service-card__link:focus-visible .service-card__title-row span {
    color: var(--color-accent-700) !important;
  }

  .service-card__link:hover .service-card__title-row span,
  .service-card__link:focus-visible .service-card__title-row span {
    transform: translateX(0.25rem);
  }

  .service-card__content p {
    margin: 0.85rem 0 0 !important;
    color: var(--color-base-700) !important;
    font-family: var(--font-sans);
    font-size: 1rem !important;
    line-height: 1.72 !important;
  }

  @media (max-width: 760px) {

    .service-cards {
      left: auto;
      width: 100%;
      margin-top: 2.75rem;
      padding-top: 1.5rem;
      transform: none;
    }

    .service-cards__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .service-card__media {
      border-radius: 1rem;
    }

    .service-card__content p {
      font-size: 0.97rem !important;
      line-height: 1.65 !important;
    }
  }
</style>
