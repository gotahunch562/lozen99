---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { createWebPageJsonLd } from "@/lib/seo/jsonLd";

import Hero from "@/components/landing/Hero.astro";
import BenefitsUtilizationSection from "@/components/landing/BenefitsUtilizationSection.astro";
import IntelligenceAnalysisSection from "@/components/landing/IntelligenceAnalysisSection.astro";
import PolicyGovernanceTrackerSection from "@/components/landing/PolicyGovernanceTrackerSection.astro";
import WhatWeDoSection from "@/components/landing/WhatWeDoSection.astro";
import AdvisoryFoundationSection from "@/components/landing/AdvisoryFoundationSection.astro";
import AiGovernanceRetentionSection from "@/components/landing/AiGovernanceRetentionSection.astro";
import BlogPreviewSection from "@/components/landing/BlogPreviewSection.astro";

const title = "Lozen Advisory | Board Governance: AI & Menopause at Work";
const description =
"Lozen Advisory equips corporate boards with disclosure-independent governance for hidden risks: menopause at work and human-in-the-loop AI gaps.";
const canonical = "https://www.lozenadvisory.com/";
const dateModified = "2026-06-26";

const pageJsonLd = createWebPageJsonLd({
  title,
  description,
  dateModified,
  href: canonical,
  image: "/images/herobg.webp",
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  dateModified={dateModified}
  jsonLd={pageJsonLd}
>
  <Hero />
  <BenefitsUtilizationSection />
  <AiGovernanceRetentionSection />
  <IntelligenceAnalysisSection />
  <PolicyGovernanceTrackerSection />
  <WhatWeDoSection />
  <AdvisoryFoundationSection />
  <BlogPreviewSection />
</BaseLayout>
