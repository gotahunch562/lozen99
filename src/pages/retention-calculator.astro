---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const title = "Retention Risk Calculator for Senior Women Leaders";

const description = "Estimate replacement-cost exposure, institutional-knowledge loss, and leadership-continuity risk when senior women leaders exit before standard retention metrics explain the loss.";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: title,
  description,
  url: "https://www.lozenadvisory.com/retention-calculator",
  applicationCategory: "BusinessApplication",
  publisher: {
    "@type": "Organization",
    name: "Lozen Advisory",
    url: "https://www.lozenadvisory.com",
  },
};

const levels = [
  { id: "director", label: "Director" },
  { id: "vp", label: "VP" },
  { id: "svp", label: "SVP / MD" },
  { id: "csuite", label: "C-Suite" },
  { id: "partner", label: "Partner / Principal" },
];

const ageRanges = [
  { id: "35", label: "35–39" },
  { id: "40", label: "40–44" },
  { id: "45", label: "45–49" },
  { id: "50", label: "50–54" },
  { id: "55", label: "55–58" },
  { id: "59", label: "59+" },
];

const pipelineRows = [
  { id: "entry", label: "Entry Level", value: "49%", width: "49%" },
  { id: "manager", label: "Manager", value: "40%", width: "40%" },
  { id: "director", label: "Sr. Manager / Director", value: "39%", width: "39%" },
  { id: "vp", label: "VP", value: "34%", width: "34%" },
  { id: "svp", label: "SVP / C-Suite / Partner", value: "29%", width: "29%" },
];
---

<BaseLayout title={title} description={description}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(pageJsonLd)}
  ></script>

  <style is:global>
    .lozen-calculator input[type="range"] {
      width: 100%;
      height: 0.25rem;
      cursor: pointer;
      appearance: none;
      border-radius: 9999px;
      background: rgba(216, 225, 238, 0.65);
      outline: none;
    }

    .lozen-calculator input[type="range"]::-webkit-slider-thumb {
      width: 1.25rem;
      height: 1.25rem;
      appearance: none;
      border-radius: 9999px;
      border: 3px solid var(--color-base-950);
      background: var(--color-accent-300);
      box-shadow: 0 0 0 1px rgba(247, 211, 50, 0.55);
      transition:
        transform 180ms ease,
        box-shadow 180ms ease;
    }

    .lozen-calculator input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.18);
      box-shadow: 0 0 0 4px rgba(247, 211, 50, 0.22);
    }

    .lozen-calculator input[type="range"]::-moz-range-thumb {
      width: 1.25rem;
      height: 1.25rem;
      border-radius: 9999px;
      border: 3px solid var(--color-base-950);
      background: var(--color-accent-300);
      box-shadow: 0 0 0 1px rgba(247, 211, 50, 0.55);
      transition:
        transform 180ms ease,
        box-shadow 180ms ease;
    }

    .lozen-calculator input[type="range"]::-moz-range-thumb:hover {
      transform: scale(1.18);
      box-shadow: 0 0 0 4px rgba(247, 211, 50, 0.22);
    }
  </style>

  <div class="lozen-calculator bg-base-950 text-white">
    <section class="relative isolate overflow-hidden bg-base-950">
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,rgba(247,211,50,0.16),transparent_45%),radial-gradient(ellipse_at_bottom_left,rgba(66,88,115,0.38),transparent_45%)]"
      >
      </div>

      <Wrapper variant="standard" class="py-24 lg:py-32">
        <div class="max-w-5xl">
          <Text
            tag="span"
            variant="textSM"
            class="pl-4 font-medium uppercase tracking-wide border-l text-accent-300 font-display border-accent-500"
          >
            Quantify Invisible Attrition℠ Before It Becomes Cost
          </Text>

          <Text
            tag="h1"
            variant="display2XL"
            class="mt-8 uppercase font-display text-white"
          >
            Retention Risk Calculator for Senior Women Leaders
          </Text>

          <Text
            tag="p"
            variant="textLG"
            class="mt-6 max-w-3xl text-base-200"
          >
            Use this calculator to model the replacement-cost exposure, institutional-knowledge loss, and leadership-continuity risk created when senior women exit before standard retention metrics explain the loss.
          </Text>

          <div class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 md:grid-cols-3">
            <article class="bg-base-900/80 p-6 sm:p-8">
              <Text
                tag="p"
                variant="displaySM"
                class="font-display text-accent-300"
              >
                213%
              </Text>
              <Text tag="p" variant="textSM" class="mt-3 text-base-200">
                Conservative SHRM replacement cost floor for senior executives.
              </Text>
            </article>

            <article class="bg-base-900/80 p-6 sm:p-8">
              <Text
                tag="p"
                variant="displaySM"
                class="font-display text-accent-300"
              >
                29%
              </Text>
              <Text tag="p" variant="textSM" class="mt-3 text-base-200">
                Women in the C-suite, up from 17% in 2015. They entered the pipeline at 49%. The broken rung is at manager level: for every 100 men promoted, only 81 women are.
              </Text>
            </article>

            <article class="bg-base-900/80 p-6 sm:p-8">
              <Text
                tag="p"
                variant="displaySM"
                class="font-display text-accent-300"
              >
                43%
              </Text>
              <Text tag="p" variant="textSM" class="mt-3 text-base-200">
                Senior women in leadership who report burnout, versus 31% of men at the same level. For employers, this is a retention signal standard dashboards may classify too late. McKinsey &amp; LeanIn 2024.
              </Text>
            </article>
          </div>
        </div>
      </Wrapper>
    </section>

    <section class="bg-base-950">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <div class="max-w-3xl">
          <Text
            tag="span"
            variant="textSM"
            class="pl-4 font-medium uppercase tracking-wide border-l text-accent-300 font-display border-accent-500"
          >
            From Individual Departure to Institutional Exposure
          </Text>

          <Text
            tag="h2"
            variant="displayLG"
            class="mt-6 uppercase font-display text-white"
          >
            What does it cost to replace a senior woman leader?
          </Text>

          <Text tag="p" variant="textBase" class="mt-5 text-base-200">
            Enter a representative leadership profile. The calculation uses SHRM's documented replacement cost methodology, the same published framework used to quantify senior leadership value across industries. No data is stored.
          </Text>
        </div>

        <div class="mt-12 rounded-3xl border border-white/10 bg-base-900 p-5 shadow-2xl sm:p-8 lg:p-10">
          <div class="grid gap-10 lg:grid-cols-[1fr_0.95fr] lg:gap-14">
            <div>
              <Text
                tag="p"
                variant="textXS"
                class="border-b border-white/10 pb-4 font-medium uppercase tracking-[0.24em] text-base-100"
              >
                Leadership Profile
              </Text>

              <div class="mt-8 space-y-10">
                <div>
                  <Text
                    tag="p"
                    variant="textXS"
                    class="mb-4 pl-3 font-medium uppercase tracking-[0.2em] border-l border-accent-400 text-accent-300"
                  >
                    Base compensation
                  </Text>

                  <div class="mb-4 flex items-baseline justify-between gap-6">
                    <Text tag="p" variant="textSM" class="text-base-100">
                      Annual base compensation
                    </Text>
                    <Text
                      tag="p"
                      variant="displayXS"
                      id="val-sal"
                      class="font-display text-accent-300"
                    >
                      $250,000
                    </Text>
                  </div>

                  <input
                    type="range"
                    id="sl-sal"
                    min="75000"
                    max="600000"
                    step="5000"
                    value="250000"
                    aria-label="Annual base compensation"
                  />

                  <Text tag="p" variant="textXS" class="mt-3 text-base-300">
                    Slide to the approximate annual base compensation. Does not include bonus, equity, or benefits.
                  </Text>
                </div>

                <div>
                  <Text
                    tag="p"
                    variant="textXS"
                    class="mb-4 pl-3 font-medium uppercase tracking-[0.2em] border-l border-accent-400 text-accent-300"
                  >
                    Leadership level
                  </Text>

                  <div class="flex flex-wrap gap-2" data-button-group="level">
                    {
                      levels.map((level) => (
                        <button
                          type="button"
                          id={`lvl-${level.id}`}
                          data-level={level.id}
                          class:list={[
                            "rounded-lg border px-4 py-2 text-sm transition-all duration-200",
                            level.id === "svp"
                              ? "border-accent-300 bg-accent-300 text-base-950"
                              : "border-white/15 bg-transparent text-base-200 hover:border-accent-300 hover:text-white",
                          ]}
                        >
                          {level.label}
                        </button>
                      ))
                    }
                  </div>
                </div>

                <div>
                  <Text
                    tag="p"
                    variant="textXS"
                    class="mb-4 pl-3 font-medium uppercase tracking-[0.2em] border-l border-accent-400 text-accent-300"
                  >
                    Tenure at current organization
                  </Text>

                  <div class="mb-4 flex items-baseline justify-between gap-6">
                    <Text tag="p" variant="textSM" class="text-base-100">
                      Years in this role or organization
                    </Text>
                    <Text
                      tag="p"
                      variant="displayXS"
                      id="val-tenure"
                      class="font-display text-accent-300"
                    >
                      8 years
                    </Text>
                  </div>

                  <input
                    type="range"
                    id="sl-tenure"
                    min="1"
                    max="30"
                    step="1"
                    value="8"
                    aria-label="Years in this role or organization"
                  />

                  <Text tag="p" variant="textXS" class="mt-3 text-base-300">
                    Tenure determines institutional knowledge premium: relationships, systems, history that cannot be hired from the outside.
                  </Text>
                </div>

                <div>
                  <Text
                    tag="p"
                    variant="textXS"
                    class="mb-4 pl-3 font-medium uppercase tracking-[0.2em] border-l border-accent-400 text-accent-300"
                  >
                    Age range
                  </Text>

                  <div class="flex flex-wrap gap-2" data-button-group="age">
                    {
                      ageRanges.map((age) => (
                        <button
                          type="button"
                          id={`age-${age.id}`}
                          data-age={age.id}
                          class:list={[
                            "rounded-lg border px-4 py-2 text-sm transition-all duration-200",
                            age.id === "45"
                              ? "border-accent-300 bg-accent-300 text-base-950"
                              : "border-white/15 bg-transparent text-base-200 hover:border-accent-300 hover:text-white",
                          ]}
                        >
                          {age.label}
                        </button>
                      ))
                    }
                  </div>

                  <Text
                    tag="p"
                    variant="textXS"
                    id="window-note"
                    class="mt-3 text-base-300"
                  >
                    Selected profile is inside the perimenopause transition window (40–58), when senior leadership pipeline loss can remain invisible until departure.
                  </Text>
                </div>
              </div>
            </div>

            <div>
              <Text
                tag="p"
                variant="textXS"
                class="border-b border-white/10 pb-4 font-medium uppercase tracking-[0.24em] text-base-100"
              >
                Organizational Exposure
              </Text>

              <div class="mt-8 rounded-3xl border border-white/10 bg-base-800 p-6 sm:p-8">
                <Text
                  tag="p"
                  variant="textXS"
                  class="font-medium uppercase tracking-[0.24em] text-accent-300"
                >
                  Replacement value estimate
                </Text>

                <div class="mt-8 border-b border-white/10 pb-8">
                  <Text tag="p" variant="textSM" class="text-base-100">
                    Estimated replacement exposure
                  </Text>
                  <div
                    id="out-erv"
                    class="mt-3 font-display text-4xl leading-none tracking-[-0.03em] text-accent-300 sm:text-5xl"
                  >
                    $532,500
                  </div>
                  <Text tag="p" variant="textXS" class="mt-4 text-base-300">
                    Base compensation × 2.13. SHRM documents replacement cost at 200–400% of annual salary for senior executives. 213% is the conservative floor.
                  </Text>
                </div>

                <div class="mt-8 space-y-7">
                  <div>
                    <div class="mb-3 flex items-baseline justify-between gap-4">
                      <Text tag="p" variant="textSM" class="text-base-100">
                        Institutional knowledge premium
                      </Text>
                      <Text
                        tag="p"
                        variant="displayXS"
                        id="out-tenure"
                        class="font-display text-white"
                      >
                        $160,000
                      </Text>
                    </div>
                    <div class="h-1 rounded-full bg-white/10">
                      <div
                        id="bar-tenure"
                        class="h-1 rounded-full bg-accent-300 transition-all duration-500"
                        style="width: 40%;"
                      >
                      </div>
                    </div>
                  </div>

                  <div>
                    <div class="mb-3 flex items-baseline justify-between gap-4">
                      <Text tag="p" variant="textSM" class="text-base-100">
                        Total organizational investment at risk
                      </Text>
                      <Text
                        tag="p"
                        variant="displayXS"
                        id="out-total"
                        class="font-display text-white"
                      >
                        $692,500
                      </Text>
                    </div>
                    <div class="h-1 rounded-full bg-white/10">
                      <div
                        id="bar-total"
                        class="h-1 rounded-full bg-accent-300 transition-all duration-500"
                        style="width: 65%;"
                      >
                      </div>
                    </div>
                  </div>

                  <div>
                    <div class="mb-3 flex items-baseline justify-between gap-4">
                      <Text tag="p" variant="textSM" class="text-base-100">
                        SHRM full-range replacement cost
                      </Text>
                      <Text
                        tag="p"
                        variant="displayXS"
                        id="out-high"
                        class="font-display text-white"
                      >
                        $1,000,000
                      </Text>
                    </div>
                    <div class="h-1 rounded-full bg-white/10">
                      <div
                        id="bar-high"
                        class="h-1 rounded-full bg-accent-300 transition-all duration-500"
                        style="width: 85%;"
                      >
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div
                id="window-status"
                class="mt-4 rounded-2xl border border-accent-300/30 bg-accent-300/10 p-5"
              >
                <Text
                  tag="p"
                  variant="textXS"
                  class="font-medium uppercase tracking-[0.2em] text-accent-300"
                >
                  Transition Window Signal
                </Text>
                <Text
                  tag="p"
                  variant="textSM"
                  id="window-text"
                  class="mt-3 text-base-100"
                >
                  Inside the window. Selected profile is inside the perimenopause transition window (40–58), when senior leadership pipeline loss can remain invisible until departure. When leaders at this stage leave, the departure is often recorded as personal, family, or unspecified. The calculation behind it is not.
                </Text>
              </div>
            </div>
          </div>
        </div>
      </Wrapper>
    </section>

    <section class="border-y border-white/10 bg-base-900">
      <Wrapper variant="narrow" class="py-16 lg:py-20">
        <Text
          tag="blockquote"
          variant="displaySM"
          class="text-center font-display text-accent-300"
        >
          “The Broken Rung”: Only 54% of companies are currently focused on women’s career advancement, making leadership continuity a measurement issue, not an individual planning issue.
        </Text>
        <Text
          tag="p"
          variant="textXS"
          class="mt-6 text-center font-medium uppercase tracking-[0.24em] text-base-300"
        >
          McKinsey &amp; LeanIn, Women in the Workplace 2024
        </Text>
      </Wrapper>
    </section>

    <section class="bg-base-950">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <div class="max-w-3xl">
          <Text
            tag="span"
            variant="textSM"
            class="pl-4 font-medium uppercase tracking-wide border-l text-accent-300 font-display border-accent-500"
          >
            The pipeline
          </Text>

          <Text
            tag="h2"
            variant="displayLG"
            class="mt-6 uppercase font-display text-white"
          >
            Where senior leadership loss enters the retention pattern.
          </Text>

          <Text tag="p" variant="textBase" class="mt-5 text-base-200">
            McKinsey and LeanIn 2024 Women in the Workplace data show pipeline compression from 49% at entry level to 29% at the senior-most tiers. A senior leader’s departure at this stage can remove replacement value, institutional knowledge, and continuity long before the organization has a clean record of what drove the exit.
          </Text>
        </div>

        <div class="mt-12 max-w-4xl space-y-5">
          {
            pipelineRows.map((row) => (
              <div
                id={`pipe-${row.id}`}
                class="grid items-center gap-3 sm:grid-cols-[13rem_1fr_3rem]"
              >
                <Text
                  tag="p"
                  variant="textSM"
                  id={`lbl-${row.id}`}
                  class:list={[
                    "text-base-300",
                    row.id === "svp" ? "font-medium text-white" : "",
                  ]}
                >
                  {row.label}
                </Text>

                <div class="relative h-3 rounded-full bg-white/10">
                  <div
                    id={`fill-${row.id}`}
                    class="h-3 rounded-full bg-accent-300 transition-all duration-500"
                    style={`width: ${row.width};`}
                  >
                  </div>

                  {
                    ["director", "vp", "svp"].includes(row.id) && (
                      <div
                        id={`you-${row.id}`}
                        class:list={[
                          "absolute -top-7 hidden -translate-x-1/2 whitespace-nowrap text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-accent-300",
                          row.id === "svp" ? "block" : "",
                        ]}
                        style={`left: ${row.width};`}
                      >
                        Selected level
                      </div>
                    )
                  }
                </div>

                <Text
                  tag="p"
                  variant="textSM"
                  id={`pct-${row.id}`}
                  class:list={[
                    "text-right font-display text-base-300",
                    row.id === "svp" ? "text-white" : "",
                  ]}
                >
                  {row.value}
                </Text>
              </div>
            ))
          }

          <Text tag="p" variant="textXS" class="pt-4 text-base-300">
            Source: McKinsey and LeanIn, Women in the Workplace 2024. The Invisible Attrition℠ transition window (ages 40–58) spans the senior manager through C-suite stages where the steepest departures occur.
          </Text>
        </div>
      </Wrapper>
    </section>

    <section class="bg-base-900">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <div class="max-w-3xl">
          <Text
            tag="span"
            variant="textSM"
            class="pl-4 font-medium uppercase tracking-wide border-l text-accent-300 font-display border-accent-500"
          >
            What this means
          </Text>

          <Text
            tag="h2"
            variant="displayLG"
            class="mt-6 uppercase font-display text-white"
          >
            This number is not individual worth. It is organizational exposure.
          </Text>
        </div>

        <div class="mt-12 grid gap-4 lg:grid-cols-3">
          <article class="rounded-3xl border border-white/10 bg-base-950 p-6 sm:p-8">
            <Text
              tag="p"
              variant="displayXS"
              class="font-display text-accent-300"
            >
              01
            </Text>
            <Text
              tag="h3"
              variant="displayXS"
              class="mt-5 font-display text-white"
            >
              The exposure is already in the data
            </Text>
            <Text tag="p" variant="textSM" class="mt-4 text-base-200">
              Replacement value is calculated and benchmarked at every senior level. The exposure exists whether the organization has formally modeled it or not.
            </Text>
          </article>

          <article class="rounded-3xl border border-white/10 bg-base-950 p-6 sm:p-8">
            <Text
              tag="p"
              variant="displayXS"
              class="font-display text-accent-300"
            >
              02
            </Text>
            <Text
              tag="h3"
              variant="displayXS"
              class="mt-5 font-display text-white"
            >
              The exit can read as voluntary
            </Text>
            <Text tag="p" variant="textSM" class="mt-4 text-base-200">
              When senior women leave, the departure may be recorded as personal, family, or unspecified. The calculation behind that exit is often longer and more deliberate than the code assigned to it. Invisible Attrition℠ names the pattern of exits that appear voluntary after the organization has missed the earlier risk signals.
            </Text>
          </article>

          <article class="rounded-3xl border border-white/10 bg-base-950 p-6 sm:p-8">
            <Text
              tag="p"
              variant="displayXS"
              class="font-display text-accent-300"
            >
              03
            </Text>
            <Text
              tag="h3"
              variant="displayXS"
              class="mt-5 font-display text-white"
            >
              Private management creates measurement gaps
            </Text>
            <Text tag="p" variant="textSM" class="mt-4 text-base-200">
              When leaders manage strain without formal disclosure, standard systems may record continued performance while missing the risk forming beneath it. Tacere, the practice of strategic non-disclosure, explains why the absence of a record should not be mistaken for the absence of exposure.
            </Text>
          </article>
        </div>
      </Wrapper>
    </section>

    <section class="bg-base-950">
      <Wrapper variant="narrow" class="py-16 text-center lg:py-24">
        <Text
          tag="h2"
          variant="displayLG"
          class="uppercase font-display text-white"
        >
          Retention risk is a measurement problem before it becomes a cost event.
        </Text>

        <Text tag="p" variant="textBase" class="mt-6 text-base-200">
          Lozen Advisory advises CFOs, General Counsel, and corporate boards on workforce exposure that standard dashboards often miss: disclosure-dependent data gaps, leadership-capacity strain, institutional-knowledge erosion, and retention risk that becomes visible only after departure.
        </Text>

        <div class="mt-10 flex justify-center">
          <Button
            isLink
            href="/request-briefing/"
            variant="accent"
            size="md"
            class="w-fit"
          >
            Request a Strategic Briefing
          </Button>
        </div>

        <Text tag="p" variant="textXS" class="mt-5 text-base-400">
          This briefing is designed for organizational leaders assessing retention exposure, succession risk, and board-facing workforce measurement.
        </Text>
      </Wrapper>
    </section>

    <section class="border-t border-white/10 bg-base-950">
      <Wrapper
        variant="standard"
        class="flex flex-col gap-4 py-8 md:flex-row md:items-center md:justify-between"
      >
        <Text tag="p" variant="textSM" class="font-display text-base-300">
          Lozen Advisory LLC
        </Text>

        <Text tag="p" variant="textXS" class="max-w-2xl text-base-400 md:text-right">
          Invisible Attrition℠ is a service mark of Lozen Advisory LLC. This tool uses SHRM-documented replacement cost methodology for illustrative purposes. No data entered here is stored or transmitted. Not financial, legal, or medical advice.
        </Text>
      </Wrapper>
    </section>
  </div>

  <script is:inline>
    (() => {
      let currentLevel = "svp";
      let currentAge = "45";

      const levelMap = {
        director: { pipe: "director", label: "Sr. Manager / Director" },
        vp: { pipe: "vp", label: "VP" },
        svp: { pipe: "svp", label: "SVP / MD" },
        csuite: { pipe: "svp", label: "C-Suite" },
        partner: { pipe: "svp", label: "Partner / Principal" },
      };

      const ageConfig = {
        "35": {
          inWindow: false,
          note:
            "Selected profile is approaching the transition window. Perimenopause onset is documented as early as age 40 by NAMS. This is the period before the pattern fully registers.",
        },
        "40": {
          inWindow: true,
          note:
            "Selected profile is inside the perimenopause transition window (40–58). This is when the pipeline is steepest and when departures are most likely to be described as personal timing or unspecified.",
        },
        "45": {
          inWindow: true,
          note:
            "Selected profile is inside the perimenopause transition window (40–58), when senior leadership pipeline loss can remain invisible until departure.",
        },
        "50": {
          inWindow: true,
          note:
            "Selected profile is inside the transition window. Research documents that the underlying recalibration is underway long before any decision becomes visible.",
        },
        "55": {
          inWindow: true,
          note:
            "Selected profile is in the later stage of the transition window. Departures at this stage are often described as lifestyle choices. The calculations behind them are not.",
        },
        "59": {
          inWindow: false,
          note:
            "Selected profile is past the primary transition window. The replacement value calculation and institutional knowledge premium apply regardless of age range.",
        },
      };

      const activeButtonClasses = [
        "border-accent-300",
        "bg-accent-300",
        "text-base-950",
      ];

      const inactiveButtonClasses = [
        "border-white/15",
        "bg-transparent",
        "text-base-200",
      ];

      const formatCurrency = (value) =>
        "$" + Math.round(value).toLocaleString("en-US");

      const getElement = (id) => document.getElementById(id);

      const setButtonState = (button, isActive) => {
        if (!button) return;

        button.classList.remove(...activeButtonClasses, ...inactiveButtonClasses);

        if (isActive) {
          button.classList.add(...activeButtonClasses);
        } else {
          button.classList.add(...inactiveButtonClasses);
        }
      };

      const updateAgeContext = () => {
        const config = ageConfig[currentAge];
        const windowNote = getElement("window-note");
        const windowStatus = getElement("window-status");
        const windowText = getElement("window-text");

        if (!config || !windowNote || !windowStatus || !windowText) return;

        windowNote.textContent = config.note;

        if (config.inWindow) {
          windowStatus.classList.remove("border-white/10", "bg-base-900");
          windowStatus.classList.add("border-accent-300/30", "bg-accent-300/10");
          windowText.textContent =
            "Inside the window. " +
            config.note +
            " When leaders at this stage leave, the departure is often recorded as personal, family, or unspecified. The calculation behind it is not.";
        } else {
          windowStatus.classList.remove(
            "border-accent-300/30",
            "bg-accent-300/10",
          );
          windowStatus.classList.add("border-white/10", "bg-base-900");
          windowText.textContent = "Outside the primary window. " + config.note;
        }
      };

      const updatePipeline = () => {
        const targetPipe = levelMap[currentLevel]?.pipe || "svp";
        const trackedPipes = ["director", "vp", "svp"];

        trackedPipes.forEach((pipe) => {
          const marker = getElement(`you-${pipe}`);
          const label = getElement(`lbl-${pipe}`);
          const percent = getElement(`pct-${pipe}`);
          const fill = getElement(`fill-${pipe}`);

          if (marker) {
            if (pipe === targetPipe) {
              marker.classList.remove("hidden");
              marker.classList.add("block");
              if (fill?.style?.width) {
                marker.style.left = fill.style.width;
              }
            } else {
              marker.classList.remove("block");
              marker.classList.add("hidden");
            }
          }

          if (label) {
            label.classList.toggle("text-white", pipe === targetPipe);
            label.classList.toggle("font-medium", pipe === targetPipe);
            label.classList.toggle("text-base-300", pipe !== targetPipe);
          }

          if (percent) {
            percent.classList.toggle("text-white", pipe === targetPipe);
            percent.classList.toggle("text-base-300", pipe !== targetPipe);
          }
        });
      };

      const updateCalculator = () => {
        const salaryInput = getElement("sl-sal");
        const tenureInput = getElement("sl-tenure");

        if (!salaryInput || !tenureInput) return;

        const salary = Number.parseFloat(salaryInput.value);
        const tenure = Number.parseFloat(tenureInput.value);

        const salaryValue = getElement("val-sal");
        const tenureValue = getElement("val-tenure");

        if (salaryValue) salaryValue.textContent = formatCurrency(salary);
        if (tenureValue) {
          tenureValue.textContent =
            tenure + (tenure === 1 ? " year" : " years");
        }

        const estimatedReplacementValue = salary * 2.13;
        const tenurePercent = Math.min(tenure * 0.08, 0.8);
        const tenurePremium = salary * tenurePercent;
        const totalInvestment = estimatedReplacementValue + tenurePremium;
        const highReplacementValue = salary * 4.0;

        const outputEstimatedReplacementValue = getElement("out-erv");
        const outputTenure = getElement("out-tenure");
        const outputTotal = getElement("out-total");
        const outputHigh = getElement("out-high");

        if (outputEstimatedReplacementValue) {
          outputEstimatedReplacementValue.textContent = formatCurrency(
            estimatedReplacementValue,
          );
        }

        if (outputTenure) {
          outputTenure.textContent = formatCurrency(tenurePremium);
        }

        if (outputTotal) {
          outputTotal.textContent = formatCurrency(totalInvestment);
        }

        if (outputHigh) {
          outputHigh.textContent = formatCurrency(highReplacementValue);
        }

        const maxValue = highReplacementValue * 1.1;
        const tenureBar = getElement("bar-tenure");
        const totalBar = getElement("bar-total");
        const highBar = getElement("bar-high");

        if (tenureBar) {
          tenureBar.style.width =
            Math.min((tenurePremium / maxValue) * 100, 100) + "%";
        }

        if (totalBar) {
          totalBar.style.width =
            Math.min((totalInvestment / maxValue) * 100, 100) + "%";
        }

        if (highBar) {
          highBar.style.width =
            Math.min((highReplacementValue / maxValue) * 100, 95) + "%";
        }

        updatePipeline();
      };

      const bindEvents = () => {
        document.querySelectorAll("[data-level]").forEach((button) => {
          button.addEventListener("click", () => {
            const selectedLevel = button.getAttribute("data-level");
            if (!selectedLevel) return;

            currentLevel = selectedLevel;

            document.querySelectorAll("[data-level]").forEach((levelButton) => {
              setButtonState(
                levelButton,
                levelButton.getAttribute("data-level") === selectedLevel,
              );
            });

            updatePipeline();
          });
        });

        document.querySelectorAll("[data-age]").forEach((button) => {
          button.addEventListener("click", () => {
            const selectedAge = button.getAttribute("data-age");
            if (!selectedAge) return;

            currentAge = selectedAge;

            document.querySelectorAll("[data-age]").forEach((ageButton) => {
              setButtonState(
                ageButton,
                ageButton.getAttribute("data-age") === selectedAge,
              );
            });

            updateAgeContext();
            updateCalculator();
          });
        });

        const salaryInput = getElement("sl-sal");
        const tenureInput = getElement("sl-tenure");

        salaryInput?.addEventListener("input", updateCalculator);
        tenureInput?.addEventListener("input", updateCalculator);
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
          bindEvents();
          updateAgeContext();
          updateCalculator();
        });
      } else {
        bindEvents();
        updateAgeContext();
        updateCalculator();
      }
    })();
  </script>
</BaseLayout>
