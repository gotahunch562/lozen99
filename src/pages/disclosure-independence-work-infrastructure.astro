<html lang="en" class="lozen-landing-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonical} />
    <title>Workforce Disclosure &amp; Risk Assessment | Lozen Advisory</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>

  <body class="lozen-landing">
    <!-- ============================================================ -->
    <!-- 1. STICKY HEADER                                              -->
    <!-- ============================================================ -->
    <header class="lozen-header" role="banner">
      <div class="lozen-header__inner">
        <a class="lozen-header__brand" href="/" aria-label="Lozen Advisory home">
          <span class="lozen-header__brand-text">LOZEN ADVISORY</span>
        </a>

        <nav class="lozen-header__nav" aria-label="Page sections">
          <a href="#scorecard">Scorecard</a>
          <a href="#benchmarks">Benchmarks</a>
          <a href="#reports">Reports &amp; Research</a>
          <a href="/request-briefing/">Advisory</a>
        </nav>

        <a class="lozen-btn lozen-btn--primary lozen-header__cta" href="/request-briefing/">
          Request Briefing
        </a>

        <button
          class="lozen-header__menu"
          type="button"
          aria-expanded="false"
          aria-controls="lozen-mobile-nav"
          aria-label="Toggle navigation"
          data-mobile-nav-toggle
        >
          <span></span><span></span><span></span>
        </button>
      </div>

      <div
        id="lozen-mobile-nav"
        class="lozen-header__mobile"
        data-mobile-nav
        hidden
      >
        <a href="#scorecard">Scorecard</a>
        <a href="#benchmarks">Benchmarks</a>
        <a href="#reports">Reports &amp; Research</a>
        <a href="/request-briefing/">Advisory</a>
        <a class="lozen-btn lozen-btn--primary" href="/request-briefing/">
          Request Briefing
        </a>
      </div>
    </header>

    <main id="main" class="lozen-main">
      <!-- ========================================================== -->
      <!-- 2. HERO                                                    -->
      <!-- ========================================================== -->
      <section class="lozen-hero" aria-labelledby="hero-title">
        <!-- Atmospheric depth blobs — no grid, no rings -->
        <div class="lozen-hero__blob lozen-hero__blob--right" aria-hidden="true"></div>
