        <p class="lozen-modal__body" data-modal-body>
          <!-- populated by JS -->
        </p>

        <div class="lozen-modal__cta">
          <a
            class="lozen-btn lozen-btn--primary lozen-btn--lg"
            href="/request-briefing/"
            data-modal-cta
          >
            <span>Request a Confidential Briefing</span>
            <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16">
              <path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- PAGE STYLES                                                  -->
    <!-- ============================================================ -->
    <style is:global>
      /* =========================================================
         LOZEN LANDING — bespoke styles
         These styles are scoped under `.lozen-landing` so they
         do not bleed into other pages. The token system from
         global.css is inherited (--color-base-*, --color-accent-*,
         --font-display, --font-sans).
         ========================================================= */

      .lozen-landing-root,
      .lozen-landing {
        background: #ffffff;
        --color-base-50: #ffffff;
      }

      .lozen-landing {
        color: var(--color-base-900);
        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
        margin: 0;
        line-height: 1.6;
      }

      .lozen-landing *,
      .lozen-landing *::before,
      .lozen-landing *::after {
        box-sizing: border-box;
      }

      /* -------- Shared tokens (page-local) -------- */
      .lozen-landing {
        --lz-navy-950: #0d2149;
        --lz-navy-900: #162d5c;
        --lz-navy-800: #1e3a6e;
        --lz-paper:    #ffffff;
        --lz-paper-2:  #f5f7fa;
        --lz-paper-3:  #e4e9f0;
        --lz-yellow-400: var(--color-accent-400, #f5e36b);
        --lz-yellow-500: var(--color-accent-500, #e7d35a);
        --lz-yellow-600: var(--color-accent-600, #b89c2d);
        --lz-section-pad-y: clamp(5rem, 10vw, 8rem);
        --lz-shell-max: 76rem;
        --lz-shell-pad: clamp(1.25rem, 4vw, 2.5rem);
        --lz-transition: 160ms ease-out;
        --lz-radius-card: 14px;
        --lz-radius-btn:  999px;
        /* Landing page fonts — Instrument Serif + Work Sans */
        --font-display: "Instrument Serif", ui-serif, Georgia, serif;
        --font-sans: "Work Sans", ui-sans-serif, system-ui, sans-serif;
      }

      /* -------- Type primitives -------- */
      .lozen-landing h1,
      .lozen-landing h2,
      .lozen-landing h3,
      .lozen-landing h4 {
        font-family: var(--font-display);
        font-weight: 400;
        color: var(--lz-navy-950);
        margin: 0;
        text-wrap: balance;
      }

      .lozen-landing p { margin: 0; text-wrap: pretty; }

      .lozen-eyebrow {
        display: inline-block;
        font-family: var(--font-sans);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--lz-navy-800);
      }
      .lozen-eyebrow--on-dark { color: var(--lz-yellow-400); }

      /* -------- Buttons -------- */
      .lozen-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        font-family: var(--font-sans);
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        padding: 0.85rem 1.4rem;
        border-radius: var(--lz-radius-btn);
        border: 1px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: background-color var(--lz-transition),
                    color var(--lz-transition),
                    border-color var(--lz-transition),
                    transform var(--lz-transition),
                    box-shadow var(--lz-transition);
        white-space: nowrap;
        line-height: 1;
      }
      .lozen-btn--lg {
        padding: 1.05rem 1.7rem;
        font-size: 0.95rem;
      }
      .lozen-btn--primary {
        background: var(--lz-yellow-400);
        color: var(--lz-navy-950);
        border-color: var(--lz-yellow-500);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6) inset,
                    0 8px 24px -10px rgba(184, 156, 45, 0.55);
      }
      .lozen-btn--primary:hover {
        background: var(--lz-yellow-500);
        border-color: var(--lz-yellow-600);
        transform: translateY(-1px);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.7) inset,
                    0 12px 28px -10px rgba(184, 156, 45, 0.65);
      }
      .lozen-btn--primary:focus-visible {
        outline: 2px solid var(--lz-yellow-600);
        outline-offset: 3px;
      }
      .lozen-btn--primary:disabled {
        opacity: 0.42;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
      }
      .lozen-btn--ghost {
        background: transparent;
        color: var(--lz-navy-900);
        border-color: var(--lz-paper-3);
      }
      .lozen-btn--ghost:hover {
        background: var(--lz-paper);
        border-color: var(--lz-navy-800);
      }

      /* =========================================================
         HEADER
         ========================================================= */
      .lozen-header {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: saturate(140%) blur(10px);
        -webkit-backdrop-filter: saturate(140%) blur(10px);
        background: rgba(6, 23, 47, 0.82);
        border-bottom: 1px solid rgba(247, 249, 252, 0.06);
      }
      .lozen-header__inner {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        max-width: var(--lz-shell-max);
        margin: 0 auto;
        padding: 1rem var(--lz-shell-pad);
      }
      .lozen-header__brand {
        font-family: var(--font-display);
        color: var(--lz-paper);
        text-decoration: none;
        letter-spacing: 0.18em;
        font-size: 0.86rem;
        font-weight: 400;
        transition: opacity var(--lz-transition);
      }
      .lozen-header__brand:hover { opacity: 0.85; }
      .lozen-header__brand-text { display: inline-block; padding: 0.25rem 0; }

      .lozen-header__nav {
        display: none;
        gap: 1.85rem;
        margin-left: auto;
      }
      .lozen-header__nav a {
        font-size: 0.86rem;
        color: rgba(247, 249, 252, 0.74);
        text-decoration: none;
        font-weight: 500;
        letter-spacing: 0.01em;
        position: relative;
        padding: 0.4rem 0;
        transition: color var(--lz-transition);
      }
      .lozen-header__nav a::after {
        content: "";
        position: absolute;
        left: 0; right: 0; bottom: -2px;
        height: 1px;
        background: var(--lz-yellow-400);
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform var(--lz-transition);
      }
      .lozen-header__nav a:hover { color: var(--lz-paper); }
      .lozen-header__nav a:hover::after { transform: scaleX(1); }

      .lozen-header__cta { display: none; }

      .lozen-header__menu {
        display: inline-flex;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
        margin-left: auto;
        width: 40px;
        height: 36px;
        padding: 0 8px;
        background: transparent;
        border: 1px solid rgba(247, 249, 252, 0.18);
        border-radius: 8px;
        cursor: pointer;
      }
      .lozen-header__menu span {
        display: block;
        height: 1px;
        background: var(--lz-paper);
        transition: transform var(--lz-transition), opacity var(--lz-transition);
      }
      .lozen-header__menu[aria-expanded="true"] span:nth-child(1) {
        transform: translateY(5px) rotate(45deg);
      }
      .lozen-header__menu[aria-expanded="true"] span:nth-child(2) {
        opacity: 0;
      }
      .lozen-header__menu[aria-expanded="true"] span:nth-child(3) {
        transform: translateY(-5px) rotate(-45deg);
      }

      .lozen-header__mobile {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 0.5rem var(--lz-shell-pad) 1.25rem;
        background: rgba(6, 23, 47, 0.96);
        border-top: 1px solid rgba(247, 249, 252, 0.06);
      }
      .lozen-header__mobile a {
        padding: 0.85rem 0;
        color: var(--lz-paper);
        text-decoration: none;
        border-bottom: 1px solid rgba(247, 249, 252, 0.08);
        font-size: 0.95rem;
      }
      .lozen-header__mobile a.lozen-btn {
        border-bottom: none;
        margin-top: 0.5rem;
        justify-content: center;
      }

      @media (min-width: 880px) {
        .lozen-header__nav { display: flex; }
        .lozen-header__cta { display: inline-flex; }
        .lozen-header__menu { display: none; }
        .lozen-header__mobile { display: none !important; }
      }

      /* =========================================================
         HERO — dark navy, glassmorphism, atmospheric blobs
         ========================================================= */
      .lozen-hero {
        position: relative;
        overflow: hidden;
        background: var(--lz-navy-950);
        min-height: 92vh;
        display: flex;
        align-items: center;
        padding: clamp(9rem, 14vw, 12rem) var(--lz-shell-pad) clamp(6rem, 10vw, 8rem);
        isolation: isolate;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        color: var(--lz-paper);
      }

      /* Atmospheric glow blobs — no grid lines */
      .lozen-hero__blob {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
      }
      .lozen-hero__blob--right {
        top: -10%;
        right: -8%;
        width: clamp(400px, 50vw, 700px);
        height: clamp(400px, 50vw, 700px);
        background: radial-gradient(ellipse at center, rgba(95, 130, 210, 0.35) 0%, transparent 70%);
        filter: blur(60px);
      }
      .lozen-hero__blob--left {
        bottom: -5%;
        left: -5%;
        width: clamp(300px, 35vw, 500px);
        height: clamp(300px, 35vw, 500px);
        background: radial-gradient(ellipse at center, rgba(242, 221, 110, 0.09) 0%, transparent 70%);
        filter: blur(50px);
      }

      .lozen-hero__wrap {
        position: relative;
        z-index: 1;
        max-width: var(--lz-shell-max);
        width: 100%;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
        align-items: center;
      }
      .lozen-hero__left { min-width: 0; }
      .lozen-hero__right { display: none; }

      .lozen-hero__eyebrow { margin-bottom: 1.25rem; }

      .lozen-landing .lozen-hero__title {
        font-size: clamp(2.8rem, 6.5vw, 5.5rem);
        line-height: 1.02;
        letter-spacing: -0.01em;
        color: var(--lz-paper);
        margin: 0 0 2rem;
      }
      .lozen-landing .lozen-hero__title em {
        font-style: italic;
        color: rgba(247, 249, 252, 0.72);
      }

      .lozen-hero__deck {
        font-size: clamp(1.05rem, 1.5vw, 1.2rem);
        line-height: 1.55;
        color: rgba(247, 249, 252, 0.78);
        max-width: 36rem;
        margin: 0 0 2.75rem;
      }

      .lozen-hero__ctas {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }

      .lozen-btn--hero {
        padding: 1.25rem 2.25rem;
        font-size: clamp(1rem, 1.4vw, 1.15rem);
        font-weight: 700;
        letter-spacing: 0.005em;
        border-radius: var(--lz-radius-btn);
        min-width: clamp(18rem, 36vw, 24rem);
        justify-content: space-between;
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.65) inset,
          0 16px 36px -8px rgba(184, 156, 45, 0.55),
          0 4px 12px -2px rgba(184, 156, 45, 0.3);
        transition: background-color var(--lz-transition),
                    transform var(--lz-transition),
                    box-shadow var(--lz-transition);
      }
      .lozen-btn--hero:hover {
        transform: translateY(-3px);
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.75) inset,
          0 24px 48px -8px rgba(184, 156, 45, 0.65),
          0 8px 20px -4px rgba(184, 156, 45, 0.4);
      }

      .lozen-hero__meta {
        margin-top: 1.5rem;
        font-size: 0.76rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(247, 249, 252, 0.45);
      }

      /* Desktop: 2-column hero grid */
      @media (min-width: 960px) {
        .lozen-hero__wrap {
          grid-template-columns: 7fr 5fr;
          gap: 4rem;
        }
        .lozen-hero__right { display: block; }
      }

      /* =========================================================
         DISCLOSURE RISK INDEX PANEL — glassmorphism on dark
         ========================================================= */
      .lozen-risk-panel {
        position: relative;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        overflow: hidden;
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.08) inset,
          0 -1px 0 rgba(0, 0, 0, 0.2) inset,
          0 24px 60px -20px rgba(0, 0, 0, 0.5);
      }
      .lozen-risk-panel__rule {
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: var(--lz-yellow-400);
        z-index: 2;
      }
      .lozen-risk-panel__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.4rem 1.5rem 0.75rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }
      .lozen-risk-panel__eyebrow {
        font-family: var(--font-sans);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--lz-yellow-400);
        margin: 0;
      }
      .lozen-risk-panel__badge {
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(247, 249, 252, 0.45);
        border: 1px solid rgba(247, 249, 252, 0.15);
        border-radius: 4px;
        padding: 0.2rem 0.5rem;
      }
      .lozen-risk-panel__metrics {
        padding: 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
      }
      .lozen-risk-panel__metric-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 0.5rem;
      }
      .lozen-risk-panel__label {
        font-family: var(--font-sans);
        font-size: 0.82rem;
        color: rgba(247, 249, 252, 0.72);
      }
      .lozen-risk-panel__val {
        font-family: var(--font-display);
        font-size: 1.55rem;
        line-height: 1;
        letter-spacing: -0.02em;
      }
      .lozen-risk-panel__val span {
        font-size: 0.78rem;
        opacity: 0.55;
        margin-left: 1px;
      }
      .lozen-risk-panel__val--muted  { color: rgba(247, 249, 252, 0.38); }
      .lozen-risk-panel__val--alert  { color: var(--lz-yellow-400); }
      .lozen-risk-panel__val--warn   { color: rgba(247, 249, 252, 0.75); }
      .lozen-risk-panel__track {
        height: 2px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 1px;
        overflow: hidden;
      }
      .lozen-risk-panel__fill {
        height: 100%;
        border-radius: 1px;
      }
      .lozen-risk-panel__fill--muted  { background: rgba(247, 249, 252, 0.25); }
      .lozen-risk-panel__fill--alert  { background: var(--lz-yellow-400); }
      .lozen-risk-panel__fill--warn   { background: rgba(247, 249, 252, 0.5); }
      .lozen-risk-panel__footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.85rem 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        font-family: var(--font-sans);
        font-size: 0.72rem;
        color: rgba(247, 249, 252, 0.38);
      }
      .lozen-risk-panel__delta {
        color: var(--lz-yellow-400);
        font-weight: 600;
      }
      .lozen-risk-panel__disclaimer {
        padding: 0.75rem 1.5rem 1rem;
        font-family: var(--font-sans);
        font-size: 0.64rem;
        line-height: 1.5;
        font-style: italic;
        color: rgba(247, 249, 252, 0.28);
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        margin: 0;
      }

      /* =========================================================
         PROOF STRIP
         ========================================================= */
      .lozen-proof {
        background: var(--lz-paper);
        border-bottom: 1px solid var(--lz-paper-3);
        padding: clamp(3rem, 6vw, 4.5rem) var(--lz-shell-pad);
      }
      .lozen-proof__inner {
        max-width: var(--lz-shell-max);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }
      .lozen-proof__stat {
        padding-left: 1.5rem;
        border-left: 3px solid var(--lz-yellow-400);
      }
      .lozen-proof__number {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 5vw, 3.75rem);
        line-height: 1;
        letter-spacing: -0.03em;
        color: var(--lz-navy-950);
      }
      .lozen-proof__text {
        font-family: var(--font-sans);
        font-size: 0.92rem;
        line-height: 1.6;
        color: var(--lz-navy-800);
        margin-top: 0.6rem;
        max-width: 22rem;
      }
      .lozen-proof__source {
        font-family: var(--font-sans);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--lz-navy-800);
        opacity: 0.45;
        margin-top: 0.75rem;
      }
      @media (min-width: 640px) {
        .lozen-proof__inner {
          grid-template-columns: repeat(3, 1fr);
          gap: 0;
        }
        .lozen-proof__stat {
          padding: 0 2.5rem;
          border-left: 1px solid var(--lz-paper-3);
        }
        .lozen-proof__stat:first-child {
          padding-left: 0;
          border-left: none;
        }
        .lozen-proof__stat + .lozen-proof__stat {
          border-left: 1px solid var(--lz-paper-3);
        }
      }

      /* =========================================================
         SHARED SECTION SHELL
         ========================================================= */
      .lozen-section {
        position: relative;
        padding: var(--lz-section-pad-y) var(--lz-shell-pad);
        overflow: hidden;
      }
      .lozen-section__inner {
        position: relative;
        z-index: 1;
        max-width: var(--lz-shell-max);
        margin: 0 auto;
      }
      .lozen-section--navy {
        background:
          radial-gradient(ellipse at 50% 0%, #1e3a6e 0%, var(--lz-navy-950) 60%),
          var(--lz-navy-950);
        color: var(--lz-paper);
      }
      .lozen-section--light { background: #ffffff; }
      .lozen-section--paper { background: #ffffff; }
      .lozen-section__head { margin-bottom: clamp(2.5rem, 4vw, 3.75rem); }
      .lozen-section__head--center { text-align: center; }
      .lozen-section__title {
        font-size: clamp(2rem, 4vw, 3.5rem);
        line-height: 1.05;
        letter-spacing: -0.025em;
        margin-top: 1rem;
        color: var(--lz-navy-950);
      }
      .lozen-landing .lozen-section__title--on-dark { color: var(--lz-paper); }
      .lozen-section__head--on-dark .lozen-section__deck,
      .lozen-section__head--on-dark .lozen-section__title {
        color: var(--lz-paper);
      }
      .lozen-section__deck {
        margin: 1.2rem auto 0;
        max-width: 44rem;
        font-size: clamp(1rem, 1.2vw, 1.1rem);
        color: var(--lz-navy-800);
        line-height: 1.7;
      }

      /* =========================================================
         SCORECARD / QUIZ
         ========================================================= */
      .lozen-scorecard {
        position: relative;
      }
      .lozen-scorecard::before {
        /* Soft grain plate behind the quiz */
        content: "";
        position: absolute;
        inset: auto 0 0 0;
        height: 50%;
        background:
          radial-gradient(ellipse at 50% 100%, rgba(242, 221, 110, 0.06) 0%, transparent 60%);
        pointer-events: none;
        z-index: 0;
      }

      .lozen-quiz {
        position: relative;
        margin: 0 auto;
        max-width: 56rem;
        background: var(--lz-paper);
        border-radius: 20px;
        padding: clamp(2rem, 4vw, 3.25rem);
        box-shadow:
          0 1px 0 rgba(255,255,255,0.5) inset,
          0 30px 60px -30px rgba(0, 0, 0, 0.55),
          0 70px 130px -40px rgba(0, 0, 0, 0.45);
        border: 1px solid var(--lz-paper-3);
        overflow: hidden;
        isolation: isolate;
      }
      .lozen-quiz::before {
        /* Etched top yellow rule */
        content: "";
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: var(--lz-yellow-400);
      }
      .lozen-quiz::after {
        /* Groove under rule */
        content: "";
        position: absolute;
        top: 3px; left: 0; right: 0;
        height: 1px;
        background: rgba(11, 31, 61, 0.18);
      }

      .lozen-quiz__step {
        display: none;
      }
      .lozen-quiz__step.is-active {
        display: block;
        animation: lozen-fade-in 320ms ease-out;
      }
      @keyframes lozen-fade-in {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .lozen-quiz__intro { text-align: left; padding: 1.5rem 0; }
      .lozen-quiz__intro-title {
        font-size: clamp(1.7rem, 3vw, 2.4rem);
        line-height: 1.12;
        letter-spacing: -0.02em;
        margin-top: 0.9rem;
      }
      .lozen-quiz__intro-speed {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--lz-navy-800);
        margin: -0.5rem 0 1.5rem;
      }
      .lozen-quiz__intro-body {
        max-width: 38rem;
        margin: 1.4rem auto 2rem;
        color: var(--lz-navy-800);
        font-size: 1rem;
        line-height: 1.75;
      }

      .lozen-quiz__progress {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2.2rem;
      }
      /* Step dots */
      .lozen-quiz__dots {
        display: flex;
        gap: 6px;
        align-items: center;
      }
      .lozen-quiz__dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--lz-paper-3);
        transition: background var(--lz-transition), transform var(--lz-transition);
        flex-shrink: 0;
      }
      .lozen-quiz__dot.is-active {
        background: var(--lz-navy-950);
        transform: scale(1.2);
      }
      .lozen-quiz__dot.is-complete {
        background: var(--lz-yellow-500);
        transform: scale(1);
      }
      .lozen-quiz__progress-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--lz-navy-800);
        white-space: nowrap;
      }

      .lozen-quiz__question { display: none; }
      .lozen-quiz__question.is-active {
        display: block;
        animation: lozen-fade-in 280ms ease-out;
      }
      .lozen-quiz__question-title {
        font-size: clamp(1.45rem, 2.4vw, 2rem);
        line-height: 1.16;
        letter-spacing: -0.018em;
        margin: 0.4rem 0 0.6rem;
      }
      .lozen-quiz__category {
        font-family: var(--font-sans);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #3b6fa0;
        margin: 0.3rem 0 0;
      }
      .lozen-quiz__anchor {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        margin: 0.75rem 0 1.5rem;
        padding: 0.75rem 1rem;
        background: #f0f7ff;
        border-left: 3px solid #3b6fa0;
        border-radius: 0 6px 6px 0;
        font-family: var(--font-sans);
        font-size: 0.86rem;
        line-height: 1.55;
        color: var(--lz-navy-800);
        font-style: italic;
      }
      .lozen-quiz__anchor svg { color: #3b6fa0; }
      .lozen-quiz__question-deck {
        color: var(--lz-navy-800);
        font-size: 0.98rem;
        line-height: 1.65;
        margin-bottom: 1.85rem;
        max-width: 40rem;
      }

      /* ROLE GRID */
      .lozen-role-grid {
        display: grid;
        gap: 0.85rem;
        grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
      }
      .lozen-role-grid--2col {
        grid-template-columns: repeat(2, 1fr);
      }
      .lozen-role {
        position: relative;
        text-align: left;
        background: var(--lz-paper);
        border: 1px solid var(--lz-paper-3);
        border-radius: 12px;
        padding: 1.1rem 1.25rem 1.15rem;
        cursor: pointer;
        font-family: var(--font-sans);
        transition: border-color var(--lz-transition),
                    transform var(--lz-transition),
                    box-shadow var(--lz-transition),
                    background var(--lz-transition);
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .lozen-role:hover {
        border-color: var(--lz-navy-800);
        transform: translateY(-1px);
        box-shadow: 0 12px 24px -16px rgba(11, 31, 61, 0.3);
      }
      .lozen-role:focus-visible {
        outline: 2px solid var(--lz-yellow-500);
        outline-offset: 2px;
      }
      .lozen-role__mark {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 1px solid var(--lz-paper-3);
        background: var(--lz-paper);
        transition: background var(--lz-transition),
                    border-color var(--lz-transition);
      }
      .lozen-role__label {
        font-family: var(--font-display);
        font-size: 1.08rem;
        color: var(--lz-navy-950);
        letter-spacing: -0.005em;
      }
      .lozen-role__sub {
        font-size: 0.78rem;
        color: var(--lz-navy-800);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .lozen-role[aria-checked="true"] {
        border-color: var(--lz-navy-950);
        background: #fdfaea;
        box-shadow: 0 0 0 3px rgba(242, 221, 110, 0.22);
      }
      .lozen-role[aria-checked="true"] .lozen-role__mark {
        background: var(--lz-yellow-400);
        border-color: var(--lz-navy-950);
        box-shadow: 0 0 0 2px var(--lz-paper) inset;
      }

      /* ANSWER LIST */
      .lozen-answers {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }
      .lozen-answer {
        position: relative;
        display: grid;
        grid-template-columns: 2.2rem 1fr 1.4rem;
        align-items: center;
        gap: 0.95rem;
        text-align: left;
        background: var(--lz-paper);
        border: 1px solid var(--lz-paper-3);
        border-radius: 12px;
        padding: 1rem 1.15rem;
        cursor: pointer;
        font-family: var(--font-sans);
        font-size: 0.98rem;
        line-height: 1.5;
        color: var(--lz-navy-900);
        transition: border-color var(--lz-transition),
                    transform var(--lz-transition),
                    background var(--lz-transition),
                    box-shadow var(--lz-transition);
      }
      .lozen-answer:hover {
        border-color: var(--lz-navy-800);
        transform: translateX(2px);
      }
      .lozen-answer:focus-visible {
        outline: 2px solid var(--lz-yellow-500);
        outline-offset: 2px;
      }
      .lozen-answer__index {
        font-family: var(--font-display);
        font-size: 0.95rem;
        color: var(--lz-navy-800);
        background: var(--lz-paper-2);
        width: 2.2rem;
        height: 2.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: background var(--lz-transition),
                    color var(--lz-transition);
      }
      .lozen-answer__label { color: var(--lz-navy-900); }
      .lozen-answer__mark {
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        color: var(--lz-navy-950);
        transition: opacity var(--lz-transition);
      }
      .lozen-answer[aria-checked="true"] {
        border-color: var(--lz-navy-950);
        background: #fdfaea;
        box-shadow: 0 0 0 3px rgba(242, 221, 110, 0.22);
      }
      .lozen-answer[aria-checked="true"] .lozen-answer__index {
        background: var(--lz-yellow-400);
        color: var(--lz-navy-950);
      }
      .lozen-answer[aria-checked="true"] .lozen-answer__mark {
        opacity: 1;
      }

      .lozen-quiz__nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-top: 2rem;
      }
      [data-quiz-prev][hidden] { visibility: hidden; }
      [data-quiz-prev][hidden] + [data-quiz-next] { margin-left: auto; }

      /* =========================================================
         RISK CATEGORIES (TABS)
         ========================================================= */
      .lozen-categories {
        padding: var(--lz-section-pad-y) var(--lz-shell-pad);
      }

      /* =========================================================
         FRAMEWORKS — LEFT LIST + RIGHT PANEL
         ========================================================= */
      .lozen-frameworks {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
        align-items: start;
        max-width: var(--lz-shell-max);
        margin: 0 auto;
      }
      @media (min-width: 800px) {
        .lozen-frameworks {
          grid-template-columns: 5fr 7fr;
          gap: 5rem;
          align-items: center;
        }
      }

      /* Left column */
      .lozen-frameworks__left {}
      .lozen-frameworks__title {
        font-family: var(--font-display);
        font-size: clamp(2rem, 4vw, 3.25rem);
        line-height: 1.08;
        letter-spacing: -0.02em;
        color: var(--lz-navy-950);
        margin: 1rem 0 1.1rem;
      }
      .lozen-frameworks__deck {
        font-family: var(--font-sans);
        font-size: 0.96rem;
        line-height: 1.65;
        color: var(--lz-navy-800);
        margin-bottom: 2.5rem;
        max-width: 28rem;
      }

      /* Nav rows */
      .lozen-frameworks__nav {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--lz-paper-3);
      }
      .lozen-framework-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.1rem 0;
        border: 0;
        border-bottom: 1px solid var(--lz-paper-3);
        background: transparent;
        cursor: pointer;
        font-family: var(--font-sans);
        font-size: 1rem;
        font-weight: 500;
        color: var(--lz-navy-800);
        text-align: left;
        transition: color var(--lz-transition);
      }
      .lozen-framework-row:hover { color: var(--lz-navy-950); }
      .lozen-framework-row:focus-visible {
        outline: 2px solid var(--lz-yellow-500);
        outline-offset: 2px;
        border-radius: 4px;
      }
      .lozen-framework-row__label { flex: 1; }
      .lozen-framework-row__arrow {
        opacity: 0;
        color: var(--lz-navy-950);
        flex-shrink: 0;
        margin-left: 0.75rem;
        transform: translateX(-4px);
        transition: opacity var(--lz-transition), transform var(--lz-transition);
      }
      .lozen-framework-row.is-active {
        font-weight: 700;
        color: var(--lz-navy-950);
      }
      .lozen-framework-row.is-active .lozen-framework-row__arrow {
        opacity: 1;
        transform: translateX(0);
      }
      .lozen-framework-row:hover .lozen-framework-row__arrow {
        opacity: 0.45;
        transform: translateX(0);
      }

      /* Right panel */
      .lozen-frameworks__right {
        position: relative;
      }
      .lozen-framework-panel {
        display: none;
        position: relative;
        background: #f8f9fb;
        border-radius: 16px;
        border: 1px solid var(--lz-paper-3);
        padding: clamp(2.5rem, 5vw, 4rem);
        min-height: clamp(28rem, 45vw, 36rem);
        box-shadow:
          0 1px 0 rgba(255,255,255,0.9) inset,
          0 12px 32px -16px rgba(11, 31, 61, 0.14);
        overflow: hidden;
      }
      .lozen-framework-panel.is-active {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        animation: lozen-fade-in 280ms ease-out;
      }

      /* Ghost number — top-right, large architectural anchor */
      .lozen-framework-panel__ghost {
        position: absolute;
        top: 1rem;
        right: 1.5rem;
        font-family: var(--font-display);
        font-size: clamp(8rem, 16vw, 14rem);
        line-height: 1;
        color: rgba(212, 220, 232, 0.7);
        letter-spacing: -0.04em;
        user-select: none;
        pointer-events: none;
      }

      .lozen-framework-panel__body {
        position: relative;
        z-index: 1;
        max-width: 32rem;
      }
      .lozen-framework-panel__eyebrow {
        color: #3b6fa0;
        margin-bottom: 1.25rem;
      }
      .lozen-framework-panel__title {
        font-family: var(--font-display);
        font-size: clamp(2rem, 4vw, 3.25rem);
        line-height: 1.06;
        letter-spacing: -0.02em;
        color: var(--lz-navy-950);
        margin: 0 0 1.25rem;
      }
      .lozen-framework-panel__rule {
        width: 2.5rem;
        height: 2px;
        background: #3b6fa0;
        border-radius: 1px;
        margin-bottom: 1.5rem;
      }
      .lozen-framework-panel__text {
        font-family: var(--font-sans);
        font-size: clamp(1rem, 1.4vw, 1.12rem);
        line-height: 1.75;
        color: var(--lz-navy-900);
      }

      /* =========================================================
         REPORTS — SCULPTED CARDS WITH ICON BADGES
         ========================================================= */
      .lozen-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(14.5rem, 1fr));
        gap: 1.5rem;
      }

      .lozen-card {
        position: relative;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        /* Micro-gradient surface — gives the white face direction */
        background: #ffffff;
        border-radius: var(--lz-radius-card);
        padding: 2.25rem 1.6rem 1.5rem;
        min-height: 18rem;
        color: var(--lz-navy-900);
        border: 1px solid var(--lz-paper-3);
        /* Four-sided inset shadow stack + multi-layer drop shadows */
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 1) inset,
          0 -1px 0 rgba(189, 202, 219, 0.55) inset,
          1px 0 0 rgba(255, 255, 255, 0.75) inset,
          -1px 0 0 rgba(189, 202, 219, 0.35) inset,
          0 1px 2px rgba(11, 31, 61, 0.05),
          0 4px 10px -3px rgba(11, 31, 61, 0.1),
          0 14px 28px -12px rgba(11, 31, 61, 0.14),
          0 32px 56px -24px rgba(11, 31, 61, 0.1);
        transition:
          transform var(--lz-transition),
          box-shadow var(--lz-transition),
          border-color var(--lz-transition);
        overflow: hidden;
        isolation: isolate;
      }

      /* Embedded yellow rule — top brand mark */
      .lozen-card__rule {
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        background: var(--lz-yellow-400);
        z-index: 2;
      }
      /* Carved groove beneath the rule */
      .lozen-card__groove {
        position: absolute;
        top: 4px; left: 0; right: 0;
        height: 1px;
        background: rgba(11, 31, 61, 0.16);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.9);
        z-index: 2;
      }

      /* Icon badge — stamped/recessed into the card surface */
      .lozen-card__icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        background: #f0f4fa;
        border: 1px solid rgba(11, 31, 61, 0.11);
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.9) inset,
          0 2px 0 rgba(255, 255, 255, 0.5) inset,
          0 -1px 0 rgba(11, 31, 61, 0.08) inset,
          0 2px 4px rgba(11, 31, 61, 0.1),
          0 4px 8px -4px rgba(11, 31, 61, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.2rem;
        color: var(--lz-navy-800);
        flex-shrink: 0;
        transition: box-shadow var(--lz-transition), background var(--lz-transition);
      }
      .lozen-card__icon-svg {
        display: block;
        color: var(--lz-navy-800);
      }

      .lozen-card:hover {
        transform: translateY(-4px);
        border-color: #bfcede;
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 1) inset,
          0 -1px 0 rgba(189, 202, 219, 0.65) inset,
          1px 0 0 rgba(255, 255, 255, 0.8) inset,
          -1px 0 0 rgba(189, 202, 219, 0.4) inset,
          0 2px 4px rgba(11, 31, 61, 0.07),
          0 8px 18px -4px rgba(11, 31, 61, 0.16),
          0 24px 48px -16px rgba(11, 31, 61, 0.2),
          0 48px 80px -32px rgba(11, 31, 61, 0.12);
      }
      .lozen-card:hover .lozen-card__rule {
        background: var(--lz-yellow-500);
      }
      .lozen-card:hover .lozen-card__icon-wrap {
        background: #e8eef8;
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.9) inset,
          0 -1px 0 rgba(11, 31, 61, 0.1) inset,
          0 3px 6px rgba(11, 31, 61, 0.12),
          0 6px 12px -6px rgba(11, 31, 61, 0.1);
      }
      .lozen-card:focus-visible {
        outline: 2px solid var(--lz-yellow-500);
        outline-offset: 3px;
      }

      .lozen-card__body { flex: 1; }

      .lozen-card__eyebrow {
        font-family: var(--font-sans);
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--lz-navy-800);
        opacity: 0.7;
      }
      .lozen-card__title {
        font-family: var(--font-display);
        font-size: clamp(1.15rem, 1.5vw, 1.35rem);
        line-height: 1.18;
        letter-spacing: -0.015em;
        margin: 0.55rem 0 0.75rem;
        color: var(--lz-navy-950);
      }
      .lozen-card__deck {
        font-family: var(--font-sans);
        font-size: 0.92rem;
        line-height: 1.65;
        color: var(--lz-navy-800);
      }
      .lozen-card__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-top: 1.4rem;
        padding-top: 1rem;
        border-top: 1px solid var(--lz-paper-2);
        font-family: var(--font-sans);
        font-size: 0.84rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        color: var(--lz-navy-950);
        transition: gap var(--lz-transition), color var(--lz-transition);
      }
      .lozen-card:hover .lozen-card__cta {
        gap: 0.7rem;
        color: var(--lz-navy-800);
      }

      /* =========================================================
         ADVISORY PRE-CLOSE SECTION
         ========================================================= */
      .lozen-advisory {
        position: relative;
        background: var(--lz-navy-950);
        color: var(--lz-paper);
        padding: clamp(5rem, 10vw, 8rem) var(--lz-shell-pad);
        text-align: center;
        overflow: hidden;
        isolation: isolate;
      }
      .lozen-advisory__blob {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
      }
      .lozen-advisory__blob--top {
        top: -15%;
        left: 50%;
        transform: translateX(-50%);
        width: clamp(400px, 60vw, 800px);
        height: clamp(300px, 40vw, 500px);
        background: radial-gradient(ellipse at center, rgba(95, 130, 210, 0.28) 0%, transparent 70%);
        filter: blur(70px);
      }
      .lozen-advisory__blob--bottom {
        bottom: -10%;
        right: 10%;
        width: clamp(200px, 30vw, 400px);
        height: clamp(200px, 30vw, 400px);
        background: radial-gradient(ellipse at center, rgba(242, 221, 110, 0.1) 0%, transparent 70%);
        filter: blur(50px);
      }
      .lozen-advisory__inner {
        position: relative;
        z-index: 1;
        max-width: var(--lz-shell-max);
        margin: 0 auto;
      }
      .lozen-advisory__head {
        max-width: 52rem;
        margin: 0 auto;
      }
      .lozen-landing .lozen-advisory__title {
        font-family: var(--font-display);
        font-size: clamp(2.4rem, 5.5vw, 4.5rem);
        line-height: 1.06;
        letter-spacing: -0.02em;
        color: var(--lz-paper);
        margin: 1rem 0 1.5rem;
      }
      .lozen-landing .lozen-advisory__title em {
        font-style: italic;
        color: rgba(247, 249, 252, 0.7);
      }
      .lozen-advisory__deck {
        font-family: var(--font-sans);
        font-size: clamp(1rem, 1.4vw, 1.15rem);
        line-height: 1.65;
        color: rgba(247, 249, 252, 0.72);
        max-width: 38rem;
        margin: 0 auto 2.5rem;
      }
      .lozen-advisory__ctas {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        margin-bottom: 0;
      }
      .lozen-advisory__secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--font-sans);
        font-size: 0.95rem;
        font-weight: 500;
        color: rgba(247, 249, 252, 0.65);
        text-decoration: none;
        transition: color var(--lz-transition);
      }
      .lozen-advisory__secondary:hover { color: var(--lz-paper); }

      /* Divider rule */
      .lozen-advisory__rule {
        width: 100%;
        height: 1px;
        background: rgba(247, 249, 252, 0.1);
        margin: 3.5rem 0;
      }

      /* Spec chips */
      .lozen-advisory__specs {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        max-width: 48rem;
        margin: 0 auto;
        text-align: left;
      }
      @media (max-width: 580px) {
        .lozen-advisory__specs { grid-template-columns: 1fr; gap: 1.5rem; text-align: center; }
      }
      .lozen-advisory__spec {}
      .lozen-advisory__spec-value {
        display: block;
        font-family: var(--font-display);
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        line-height: 1;
        color: var(--lz-paper);
        letter-spacing: -0.02em;
        margin-bottom: 0.4rem;
      }
      .lozen-advisory__spec-label {
        display: block;
        font-family: var(--font-sans);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(247, 249, 252, 0.45);
      }

      /* =========================================================
         FOOTER
         ========================================================= */
      .lozen-footer {
        background: var(--lz-navy-950);
        color: rgba(247, 249, 252, 0.7);
        padding: 3rem var(--lz-shell-pad);
      }
      .lozen-footer__inner {
        max-width: var(--lz-shell-max);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
      }
      .lozen-footer__brand {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .lozen-footer__wordmark {
        font-family: var(--font-display);
        letter-spacing: 0.2em;
        font-size: 0.85rem;
        color: var(--lz-paper);
      }
      .lozen-footer__tag {
        font-size: 0.85rem;
        color: rgba(247, 249, 252, 0.55);
      }
      .lozen-footer__nav {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
      }
