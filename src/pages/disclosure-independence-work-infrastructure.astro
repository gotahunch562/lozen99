                      <span class="lozen-role__label">{role.label}</span>
                      <span class="lozen-role__sub">{role.subtitle}</span>
                    </button>
                  ))}
                </div>
              </div>

              <!-- STEPS 1–5: THE FIVE QUESTIONS -->
              {quizQuestions.map((q) => (
                <div class="lozen-quiz__question" data-question={q.key}>
                  <p class="lozen-eyebrow">{q.eyebrow}</p>
                  <p class="lozen-quiz__category">{q.category}</p>
                  <h3 class="lozen-quiz__question-title">{q.title}</h3>
                  <div class="lozen-quiz__anchor">
                    <svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13" style="flex-shrink:0;margin-top:2px">
                      <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.4"/>
                      <path d="M8 7v4M8 5.5v.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                    <span>{q.anchor}</span>
                  </div>
                  <div class="lozen-answers" role="radiogroup" aria-label={q.category}>
                    {q.options.map((opt, i) => (
                      <button
                        type="button"
                        class="lozen-answer"
                        data-answer-option={q.key}
                        data-score={opt.score}
                        data-answer-value={opt.value}
                        data-answer-index={i}
                        role="radio"
                        aria-checked="false"
                      >
                        <span class="lozen-answer__index" aria-hidden="true">
                          {String.fromCharCode(65 + i)}
                        </span>
                        <span class="lozen-answer__label">{opt.label}</span>
                        <span class="lozen-answer__mark" aria-hidden="true">
                          <svg viewBox="0 0 16 16" width="14" height="14">
                            <path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                      </button>
                    ))}
                  </div>
                </div>
              ))}

              <div class="lozen-quiz__nav">
                <button type="button" class="lozen-btn lozen-btn--ghost" data-quiz-prev hidden>
                  <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
                    <path d="M15 8H2M7 3L2 8l5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
                  </svg>
                  Back
                </button>
                <button type="button" class="lozen-btn lozen-btn--primary" data-quiz-next disabled>
                  <span data-next-label>Continue</span>
                  <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
                    <path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- STEP: CAPTURE -->
            <div class="lozen-quiz__step" data-step="capture">
              <div class="lozen-quiz__capture">
                <p class="lozen-eyebrow">Your result is ready</p>
                <h3 class="lozen-quiz__capture-title">Where should we send your scorecard?</h3>
                <p class="lozen-quiz__capture-deck">
                  Enter your work email to receive your full disclosure risk profile and a summary of your scorecard results.
                </p>
                <div class="lozen-quiz__capture-fields">
                  <div class="lozen-quiz__field">
                    <label class="lozen-quiz__label" for="capture-name">First name</label>
                    <input type="text" id="capture-name" class="lozen-quiz__input" placeholder="Your first name" autocomplete="given-name" data-capture-name />
                  </div>
                  <div class="lozen-quiz__field">
                    <label class="lozen-quiz__label" for="capture-email">
                      Work email <span class="lozen-quiz__required" aria-hidden="true">*</span>
                    </label>
                    <input type="email" id="capture-email" class="lozen-quiz__input" placeholder="you@company.com" autocomplete="email" required data-capture-email />
                    <p class="lozen-quiz__field-error" data-capture-error hidden>Please enter a valid work email to see your result.</p>
                  </div>
                </div>
                <div class="lozen-quiz__capture-cta">
                  <button type="button" class="lozen-btn lozen-btn--primary lozen-btn--lg lozen-quiz__capture-submit" data-capture-submit>
                    <span>Show My Result</span>
                    <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16">
                      <path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
