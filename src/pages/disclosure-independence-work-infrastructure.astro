---
const pageTitle = "Disclosure-Independent Work Infrastructure | Lozen Advisory";
const pageDescription =
  "Lower Turnover Is Not Lower Risk. A Lozen Advisory diagnostic page for disclosure-dependent workforce risk and Invisible Attrition exposure.";

const fieldTerms = [
  {
    id: "tacere",
    label: "Tacere",
    description:
      "Tacere names the condition in which strain, risk, or performance constraint remains present in the workforce but absent from the formal record because disclosure never occurs.",
  },
  {
    id: "invisible-attrition",
    label: "Invisible Attrition℠",
    description:
      "Invisible Attrition℠ describes leadership capacity erosion that begins before resignation, leave, or exit data creates a measurable event inside the organization.",
  },
  {
    id: "power-user-trap",
    label: "Power User Trap℠",
    description:
      "Power User Trap℠ describes the overreliance on high-output institutional knowledge holders whose visible performance can mask overload until capacity loss becomes operationally expensive.",
  },
  {
    id: "disclosure-independent-performance-protection",
    label: "Disclosure-Independent Performance Protection℠",
    description:
      "Disclosure-Independent Performance Protection℠ is the infrastructure standard for identifying workforce risk without requiring employees to create personal health, caregiving, or vulnerability records first.",
  },
];

const resultTiers = [
  {
    title: "Invisible Attrition Exposure",
    description:
      "Risk is likely accumulating before formal HR, benefits, or exit systems can see it.",
  },
  {
    title: "Disclosure-Dependent Visibility",
    description:
      "Your systems can identify some risk, but only after an employee names the constraint, files the request, or triggers a formal record.",
  },
  {
    title: "Disclosure-Independent Readiness",
    description:
      "Your organization has stronger non-disclosure signals for workforce risk, leadership capacity, and preventable exit exposure.",
  },
];

const resources = [
  {
    title: "Tacere",
    description: "The Strategic Practice of Non-Disclosure in Professional Environments",
    href: "https://zenodo.org/records/20370916",
    action: "View on Zenodo",
    icon: "document",
  },
  {
    title: "Invisible Attrition℠",
    description: "A Conceptual Framework for Leadership Capacity Erosion Prior to Organizational Detection",
    href: "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6397780",
    action: "View on SSRN",
    icon: "book",
  },
  {
    title: "Market Correction",
    description: "The menopause-at-work market correction narrative and evidence base",
    href: "https://www.lozenadvisory.com/news-press/menopause-market-correction/",
    action: "Read report",
    icon: "trend",
  },
  {
    title: "Menopause Legislation Tracker",
    description: "A policy tracker for menopause-related workplace legislation and formal system design",
    href: "https://www.lozenadvisory.com/menopause-legislation-tracker/",
    action: "Explore tracker",
    icon: "scale",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href="https://www.lozenadvisory.com/disclosure-independence-work-infrastructure/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Tenor+Sans&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="work-page">
      <header class="sandbox-header" aria-label="Disclosure-independent work infrastructure navigation">
        <div class="sandbox-header__inner">
          <a class="sandbox-brand" href="/">LOZEN ADVISORY</a>

          <nav class="sandbox-nav" aria-label="Page sections">
            <a href="#scorecard">Scorecard</a>
            <a href="#benchmarks">Benchmarks</a>
            <a href="#evidence">Evidence & Resources</a>
            <a href="/request-briefing/">Advisory</a>
          </nav>

          <a class="button button--header" href="/request-briefing/">Request Briefing</a>
        </div>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero__arcs" aria-hidden="true">
            <svg viewBox="0 0 900 560" preserveAspectRatio="xMaxYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M260 -60 C520 90 535 335 250 620" stroke="rgba(255,255,255,0.10)" stroke-width="82" stroke-linecap="round" />
              <path d="M455 -70 C730 135 710 370 460 620" stroke="rgba(255,255,255,0.13)" stroke-width="74" stroke-linecap="round" />
              <path d="M650 -60 C880 145 900 390 675 630" stroke="rgba(255,255,255,0.11)" stroke-width="68" stroke-linecap="round" />
              <path d="M210 -20 C485 165 480 385 220 610" stroke="rgba(255,255,255,0.10)" stroke-width="1.4" />
              <path d="M410 -35 C675 190 662 400 430 620" stroke="rgba(255,255,255,0.12)" stroke-width="1.4" />
              <path d="M625 -40 C835 185 840 420 640 632" stroke="rgba(255,255,255,0.10)" stroke-width="1.4" />
            </svg>
          </div>

          <div class="shell hero__shell">
            <div class="hero__content">
              <p class="eyebrow eyebrow--light">2026 Retention Risk</p>

              <h1 id="hero-title">Lower Turnover<br />Is Not Lower Risk</h1>

              <p class="hero__deck">
                Lower quit rates can create false reassurance. Employees may stay longer while disengagement, workload strain, and exit decisions form quietly. Use the scorecard to identify risk while there is still time to act.
              </p>

              <div class="hero__actions">
                <a class="button button--accent" href="#scorecard">
                  Take the 5-Point Scorecard
                  <span aria-hidden="true">→</span>
                </a>

                <a class="hero-link" href="#evidence">
                  See the retention-risk evidence
                  <span aria-hidden="true">→</span>
                </a>
              </div>

            </div>
          </div>
        </section>

        <section id="scorecard" class="scorecard-section" aria-labelledby="scorecard-title">
          <div class="shell shell--scorecard">
            <div class="section-heading section-heading--scorecard">
              <h1 id="scorecard-title">Diagnostic Scorecard</h1>
              <h2>Disclosure-Dependent Workforce Risk</h2>
              <span aria-hidden="true"></span>
            </div>

            <div class="scorecard-unified-frame">
            <section class="scorecard-intro-card" id="scorecard-intro" aria-labelledby="scorecard-intro-title">
              <h3 id="scorecard-intro-title">What is your workforce risk visibility profile?</h3>
              <p class="scorecard-intro-card__summary">Lower turnover can create false reassurance. Your organization may appear stable while resignation risk, leadership strain, benefits underuse, and succession exposure are forming. Complete the scorecard to see whether your current systems are detecting risk early, only after disclosure, or only after an exit.</p>
              <button class="button button--accent scorecard-intro-card__button" type="button" data-start-scorecard>
                Start the scorecard
                <span aria-hidden="true">→</span>
              </button>
            </section>

            <form class="scorecard scorecard--hidden" id="scorecard-form" hidden>
              <div class="scorecard-progress" aria-hidden="true">
                <span class="is-active" data-progress-step="1">1</span>
                <span data-progress-step="2">2</span>
                <span data-progress-step="3">3</span>
                <span data-progress-step="4">4</span>
              </div>

              <fieldset class="scorecard-panel is-active" data-step="1">
                <legend class="quiz-legend-spacer" aria-hidden="true"></legend>
                <div class="question-heading">
                  <p class="question-heading__eyebrow">Question 1 of 3</p>
                  <h3>Select your role.</h3>
                </div>
                <p>Your role helps tailor the scorecard interpretation and recommendations.</p>

                <div class="role-grid" role="group" aria-label="Select your role">
                  <label class="role-card" data-shift-card data-palette="blue">
                    <input type="radio" name="role" value="CFO" />
                    <span class="role-card__check" aria-hidden="true">✓</span>
                    <span class="role-card__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="7" width="18" height="13" rx="2" />
                        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                        <path d="M3 12h18" />
                      </svg>
                    </span>
                    <span>CFO</span>
                  </label>

                  <label class="role-card" data-shift-card data-palette="emerald">
                    <input type="radio" name="role" value="Board / Committee" />
                    <span class="role-card__check" aria-hidden="true">✓</span>
                    <span class="role-card__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                      </svg>
                    </span>
                    <span>Board /<br />Committee</span>
                  </label>

                  <label class="role-card" data-shift-card data-palette="violet">
                    <input type="radio" name="role" value="CHRO / People Leader" />
                    <span class="role-card__check" aria-hidden="true">✓</span>
                    <span class="role-card__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                      </svg>
                    </span>
                    <span>CHRO /<br />People Leader</span>
                  </label>

                  <label class="role-card" data-shift-card data-palette="slate">
                    <input type="radio" name="role" value="Other" />
                    <span class="role-card__check" aria-hidden="true">✓</span>
                    <span class="role-card__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                        <path d="M12 17h.01" />
                      </svg>
                    </span>
                    <span>Other</span>
                  </label>
                </div>

                <p class="scorecard-error" data-error-for="role" hidden>
                  Select your role before continuing.
                </p>

                <div class="scorecard-nav">
                  <button class="button button--accent" type="button" data-next-step="2" data-required-name="role">
                    Continue
                    <span aria-hidden="true">→</span>
                  </button>
                </div>
              </fieldset>

              <fieldset class="scorecard-panel" data-step="2" hidden>
                <legend class="quiz-legend-spacer" aria-hidden="true"></legend>
                <div class="question-heading">
                  <p class="question-heading__eyebrow">Question 2 of 3</p>
                  <h3>When does your system first see workforce risk?</h3>
                </div>
                <p>Choose the condition that best describes how risk becomes visible inside your organization.</p>

                <div class="choice-stack">
                  <label class="choice-row" data-shift-card data-palette="coral">
                    <input type="radio" name="visibility" value="3" />
                    <span>Only after resignation, leave, accommodation request, complaint, or exit interview.</span>
                  </label>
                  <label class="choice-row" data-shift-card data-palette="violet">
                    <input type="radio" name="visibility" value="2" />
                    <span>After benefits use, manager escalation, engagement survey, or formal self-report.</span>
                  </label>
                  <label class="choice-row" data-shift-card data-palette="emerald">
                    <input type="radio" name="visibility" value="1" />
                    <span>Through non-disclosure signals connected to workload, role exposure, capacity, and continuity risk.</span>
                  </label>
                </div>

                <p class="scorecard-error" data-error-for="visibility" hidden>
                  Select the answer that best matches when risk becomes visible.
                </p>

                <div class="scorecard-nav scorecard-nav--split">
                  <button class="button button--secondary" type="button" data-prev-step="1">
                    ← Back
                  </button>
                  <button class="button button--accent" type="button" data-next-step="3" data-required-name="visibility">
                    Continue
                    <span aria-hidden="true">→</span>
                  </button>
                </div>
              </fieldset>

              <fieldset class="scorecard-panel" data-step="3" hidden>
                <legend class="quiz-legend-spacer" aria-hidden="true"></legend>
                <div class="question-heading">
                  <p class="question-heading__eyebrow">Question 3 of 3</p>
                  <h3>Which risk is least visible before a formal event?</h3>
                </div>
                <p>This identifies the most likely blind spot in the current measurement architecture.</p>

                <div class="choice-stack">
                  <label class="choice-row" data-shift-card data-palette="coral">
                    <input type="radio" name="blindspot" value="3" />
                    <span>Leadership capacity erosion among women in leadership and institutional knowledge holders.</span>
                  </label>
                  <label class="choice-row" data-shift-card data-palette="violet">
                    <input type="radio" name="blindspot" value="2" />
                    <span>Benefits utilization failure and low uptake of point solutions.</span>
                  </label>
                  <label class="choice-row" data-shift-card data-palette="slate">
                    <input type="radio" name="blindspot" value="1" />
                    <span>General engagement scores, reported satisfaction, and manager sentiment.</span>
                  </label>
                </div>

                <p class="scorecard-error" data-error-for="blindspot" hidden>
                  Select the least visible risk before viewing the result.
                </p>

                <div class="scorecard-nav scorecard-nav--split">
                  <button class="button button--secondary" type="button" data-prev-step="2">
                    ← Back
                  </button>
                  <button class="button button--accent" type="button" data-reveal-result data-required-name="blindspot">
                    View result
                    <span aria-hidden="true">→</span>
                  </button>
                </div>
              </fieldset>

              <section class="scorecard-panel scorecard-result" data-step="4" hidden aria-live="polite">
                <p class="scorecard-result__label">Result Tier</p>
                <h3 id="result-tier">Invisible Attrition Exposure</h3>
                <p id="result-copy">
                  Risk is likely accumulating before formal HR, benefits, or exit systems can see it.
                </p>

                <div class="scorecard-result__actions">
                  <a class="button button--accent" href="/request-briefing/">
                    Request a Strategic Briefing
                    <span aria-hidden="true">→</span>
                  </a>
                  <button class="button button--secondary" type="button" data-reset-scorecard>
                    Retake scorecard
                  </button>
                </div>
              </section>
            </form>
          </div>
          </div>
        </section>

        <section class="tiers-section" aria-labelledby="tiers-title">
          <div class="shell">
            <div class="section-heading section-heading--compact">
              <p>Result Tiers</p>
              <h2 id="tiers-title">How the scorecard interprets exposure</h2>
              <span aria-hidden="true"></span>
            </div>

            <div class="tier-grid">
              {resultTiers.map((tier) => (
                <article class="tier-card">
                  <p>Result Tier</p>
                  <h3>{tier.title}</h3>
                  <span aria-hidden="true"></span>
                  <p>{tier.description}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section id="benchmarks" class="field-section benchmarks-section" aria-labelledby="benchmarks-title">
          <div class="shell shell--narrow">
            <div class="section-heading section-heading--compact">
              <p>Benchmarks</p>
              <h2 id="benchmarks-title">The Risk Categories</h2>
              <span aria-hidden="true"></span>
            </div>

            <div class="term-tabs" role="tablist" aria-label="Benchmarks terms">
              {fieldTerms.map((term, index) => (
                <button
                  class={index === 0 ? "term-tab is-active" : "term-tab"}
                  type="button"
                  role="tab"
                  aria-selected={index === 0 ? "true" : "false"}
                  aria-controls={`panel-${term.id}`}
                  id={`tab-${term.id}`}
                  data-term-tab={term.id}
                >
                  {term.label}
                </button>
              ))}
            </div>

            <div class="term-panel-wrap">
              {fieldTerms.map((term, index) => (
                <section
                  class={index === 0 ? "term-panel is-active" : "term-panel"}
                  id={`panel-${term.id}`}
                  role="tabpanel"
                  aria-labelledby={`tab-${term.id}`}
                  hidden={index !== 0}
                  data-term-panel={term.id}
                >
                  <h3>{term.label}</h3>
                  <p>{term.description}</p>
                </section>
              ))}
            </div>
          </div>
        </section>

        
        <section id="evidence" class="resources-section evidence-section" aria-labelledby="evidence-title">
          <div class="section-shell section-shell--wide">
            <div class="section-heading">
              <p class="eyebrow eyebrow--dark">Evidence & Resources</p>
              <h2 id="evidence-title">Evidence & Resources</h2>
              <span aria-hidden="true"></span>
            </div>

            <div class="evidence-grid" aria-label="Evidence and resources">
              <a class="evidence-card" href="https://zenodo.org/records/20370916" target="_blank" rel="noreferrer">
                <span class="evidence-card__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M7 3.75h6.25L17 7.5v12.75H7V3.75Z" stroke="currentColor" stroke-width="1.7" />
                    <path d="M13.25 3.75V7.5H17" stroke="currentColor" stroke-width="1.7" />
                    <path d="M9.5 11h5M9.5 14h5M9.5 17h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                  </svg>
                </span>
                <span class="evidence-card__body">
                  <strong>Tacere</strong>
                  <span class="evidence-card__description">The Strategic Practice of Non-Disclosure in Professional Environments</span>
                  <small>View on Zenodo <span aria-hidden="true">→</span></small>
                </span>
              </a>

              <a class="evidence-card" href="https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6397780" target="_blank" rel="noreferrer">
                <span class="evidence-card__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M5 5.25c2.65 0 4.55.55 7 2.05 2.45-1.5 4.35-2.05 7-2.05v13.5c-2.65 0-4.55.55-7 2.05-2.45-1.5-4.35-2.05-7-2.05V5.25Z" stroke="currentColor" stroke-width="1.7" />
                    <path d="M12 7.3v13.5" stroke="currentColor" stroke-width="1.7" />
                  </svg>
                </span>
                <span class="evidence-card__body">
                  <strong>Invisible Attrition℠</strong>
                  <span class="evidence-card__description">A Conceptual Framework for Leadership Capacity Erosion Prior to Organizational Detection</span>
                  <small>View on SSRN <span aria-hidden="true">→</span></small>
                </span>
              </a>

              <a class="evidence-card" href="https://www.lozenadvisory.com/news-press/menopause-market-correction/" target="_blank" rel="noreferrer">
                <span class="evidence-card__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M5 17.5 10 12l3.5 3.5L19 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M15 8h4v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="evidence-card__body">
                  <strong>Market Correction</strong>
                  <span class="evidence-card__description">The menopause-at-work market correction narrative and evidence base</span>
                  <small>Read report <span aria-hidden="true">→</span></small>
                </span>
              </a>

              <a class="evidence-card" href="https://www.lozenadvisory.com/menopause-legislation-tracker/" target="_blank" rel="noreferrer">
                <span class="evidence-card__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 4v15M7 7h10M8 7l-3 6h6L8 7ZM16 7l-3 6h6l-3-6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="evidence-card__body">
                  <strong>Menopause Legislation Tracker</strong>
                  <span class="evidence-card__description">A policy tracker for menopause-related workplace legislation and formal system design</span>
                  <small>Explore tracker <span aria-hidden="true">→</span></small>
                </span>
              </a>
            </div>

            <div class="evidence-briefing-card">
              <div class="evidence-briefing-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 3.75 18.5 6v5.25c0 4.2-2.55 7.85-6.5 9-3.95-1.15-6.5-4.8-6.5-9V6L12 3.75Z" stroke="currentColor" stroke-width="1.7" />
                  <path d="m9.3 12.2 1.8 1.8 3.8-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <div>
                <h3>Discover Your Invisible Attrition Risk</h3>
              </div>
              <a class="button button--accent" href="/request-briefing/">
                Request a Confidential Briefing
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </section>

      </main>
    </div>

    <script is:inline>
      const scorecardForm = document.querySelector("#scorecard-form");

      if (scorecardForm) {
        document.body.classList.remove("quiz-result-ready");
        const panels = Array.from(scorecardForm.querySelectorAll("[data-step]"));
        const progressSteps = Array.from(scorecardForm.querySelectorAll("[data-progress-step]"));
        const tierHeading = scorecardForm.querySelector("#result-tier");
        const tierCopy = scorecardForm.querySelector("#result-copy");
        const resetButton = scorecardForm.querySelector("[data-reset-scorecard]");

        const tiers = [
          {
            min: 5,
            name: "Invisible Attrition Exposure",
            copy: "Risk is likely accumulating before formal HR, benefits, or exit systems can see it. This is the strongest signal that lower turnover may be masking higher enterprise exposure.",
          },
          {
            min: 3,
            name: "Disclosure-Dependent Visibility",
            copy: "Your systems can identify some workforce risk, but much of the visibility still depends on self-report, formal use, manager escalation, or an event that creates the record.",
          },
          {
            min: 0,
            name: "Disclosure-Independent Readiness",
            copy: "Your organization appears better positioned to detect risk through non-disclosure signals before resignation, leave, or exit data becomes the first measurable event.",
          },
        ];

        const getSelectedValue = (name) => {
          const selected = scorecardForm.querySelector(`input[name="${name}"]:checked`);
          return selected ? selected.value : "";
        };

        const setError = (name, visible) => {
          const error = scorecardForm.querySelector(`[data-error-for="${name}"]`);
          if (error) error.hidden = !visible;
        };

        const requireAnswer = (name) => {
          const hasAnswer = Boolean(getSelectedValue(name));
          setError(name, !hasAnswer);
          return hasAnswer;
        };

        const showStep = (stepNumber) => {
          panels.forEach((panel) => {
            const isActive = Number(panel.dataset.step) === stepNumber;
            panel.hidden = !isActive;
            panel.classList.toggle("is-active", isActive);
          });

          progressSteps.forEach((progressStep) => {
            const current = Number(progressStep.dataset.progressStep);
            progressStep.classList.toggle("is-active", current <= stepNumber);
          });

          scorecardForm.scrollIntoView({ behavior: "smooth", block: "center" });
        };

        const calculateScore = () => {
          const visibility = Number(getSelectedValue("visibility") || 0);
          const blindspot = Number(getSelectedValue("blindspot") || 0);
          return visibility + blindspot;
        };

        const revealResult = () => {
          const score = calculateScore();
          const tier = tiers.find((item) => score >= item.min) || tiers[tiers.length - 1];

          if (tierHeading) tierHeading.textContent = tier.name;
          if (tierCopy) tierCopy.textContent = tier.copy;

          document.body.classList.add("quiz-result-ready");
          showStep(4);
        };

        scorecardForm.addEventListener("change", (event) => {
          const target = event.target;
          if (!(target instanceof HTMLInputElement)) return;
          setError(target.name, false);
        });

        scorecardForm.addEventListener("click", (event) => {
          const target = event.target;

          const nextButton = target.closest("[data-next-step]");
          if (nextButton) {
            const requiredName = nextButton.getAttribute("data-required-name");
            if (requiredName && !requireAnswer(requiredName)) return;
            showStep(Number(nextButton.getAttribute("data-next-step")));
            return;
          }

          const prevButton = target.closest("[data-prev-step]");
          if (prevButton) {
            showStep(Number(prevButton.getAttribute("data-prev-step")));
            return;
          }

          const resultButton = target.closest("[data-reveal-result]");
          if (resultButton) {
            const requiredName = resultButton.getAttribute("data-required-name");
            if (requiredName && !requireAnswer(requiredName)) return;
            revealResult();
          }
        });

        if (resetButton) {
          resetButton.addEventListener("click", () => {
            scorecardForm.reset();
            ["role", "visibility", "blindspot"].forEach((name) => setError(name, false));
            document.body.classList.remove("quiz-result-ready");
            showStep(1);
          });
        }
      }

      const termTabs = Array.from(document.querySelectorAll("[data-term-tab]"));
      const termPanels = Array.from(document.querySelectorAll("[data-term-panel]"));

      termTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const activeTerm = tab.getAttribute("data-term-tab");

          termTabs.forEach((item) => {
            const isActive = item === tab;
            item.classList.toggle("is-active", isActive);
            item.setAttribute("aria-selected", isActive ? "true" : "false");
          });

          termPanels.forEach((panel) => {
            const isActive = panel.getAttribute("data-term-panel") === activeTerm;
            panel.hidden = !isActive;
            panel.classList.toggle("is-active", isActive);
          });
        });
      });
    </script>


    <script is:inline data-color-shift>
      const shiftCards = Array.from(document.querySelectorAll("[data-shift-card]"));

      shiftCards.forEach((card) => {
        card.style.setProperty("--shift-x", "50%");
        card.style.setProperty("--shift-y", "50%");

        card.addEventListener("pointermove", (event) => {
          const bounds = card.getBoundingClientRect();
          const x = ((event.clientX - bounds.left) / bounds.width) * 100;
          const y = ((event.clientY - bounds.top) / bounds.height) * 100;

          card.style.setProperty("--shift-x", `${x.toFixed(2)}%`);
          card.style.setProperty("--shift-y", `${y.toFixed(2)}%`);
          card.classList.add("is-shift-active");
        });

        card.addEventListener("pointerleave", () => {
          card.style.setProperty("--shift-x", "50%");
          card.style.setProperty("--shift-y", "50%");
          card.classList.remove("is-shift-active");
        });

        card.addEventListener("pointercancel", () => {
          card.style.setProperty("--shift-x", "50%");
          card.style.setProperty("--shift-y", "50%");
          card.classList.remove("is-shift-active");
        });
      });
    </script>
