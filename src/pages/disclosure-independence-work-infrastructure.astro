          inset -7px -7px 15px rgba(255, 255, 255, 1),
          0 2px 0 rgba(255, 255, 255, 0.88),
          0 34px 50px -34px rgba(6, 23, 47, 0.66) !important;
      }

      #evidence .evidence-card__icon {
        background: #f8fbfd !important;
        border: 1.5px solid rgba(38, 62, 95, 0.38) !important;
        box-shadow:
          inset 5px 5px 11px rgba(6, 23, 47, 0.12),
          inset -5px -5px 11px rgba(255, 255, 255, 0.98),
          0 1px 0 rgba(255, 255, 255, 0.86) !important;
      }

      #evidence .evidence-card strong {
        color: #06172f !important;
        font-weight: 900 !important;
      }

      #evidence .evidence-card__description {
        color: #263e5f !important;
        font-weight: 750 !important;
      }

      #evidence .evidence-card small {
        color: #004d5d !important;
        font-weight: 900 !important;
      }
      /* END EVIDENCE BRIGHT CARD PASS */

    
      /* HERO LANDING PAGE FINAL POSITION PASS */
      .hero {
        min-height: clamp(45rem, calc(100svh - 4.6rem), 54rem) !important;
      }

      .hero__shell {
        min-height: inherit !important;
        display: grid !important;
        align-items: start !important;
        padding-top: clamp(3.85rem, 6.25vh, 5.35rem) !important;
        padding-bottom: clamp(5.25rem, 8vh, 7rem) !important;
      }

      .hero__content {
        max-width: 49rem !important;
        transform: translateY(-0.35rem) !important;
      }

      .hero .eyebrow,
      .hero .eyebrow--light {
        display: block !important;
        margin: 0 0 clamp(1.25rem, 1.85vw, 1.7rem) !important;
        color: #e8b94a !important;
        font-size: clamp(0.78rem, 0.9vw, 0.88rem) !important;
        font-weight: 900 !important;
        letter-spacing: 0.17em !important;
        line-height: 1 !important;
        text-transform: uppercase !important;
      }

      .hero h1,
      .hero #hero-title {
        max-width: 50rem !important;
        margin: 0 !important;
        color: #ffffff !important;
        font-size: clamp(4.75rem, 7.25vw, 7rem) !important;
        line-height: 0.955 !important;
        letter-spacing: -0.067em !important;
        text-wrap: balance !important;
      }

      .hero__deck {
        max-width: 43rem !important;
        margin-top: clamp(1.35rem, 2vw, 1.75rem) !important;
        color: rgba(255, 255, 255, 0.88) !important;
        font-size: clamp(1.05rem, 1.25vw, 1.18rem) !important;
        line-height: 1.58 !important;
      }

      .hero__actions {
        margin-top: clamp(1.65rem, 2.5vw, 2.15rem) !important;
        gap: clamp(1.1rem, 2vw, 1.6rem) !important;
      }

      .hero__actions .button {
        min-height: 3.25rem !important;
        padding-inline: 1.35rem !important;
        border-radius: 0.62rem !important;
        font-weight: 900 !important;
      }

      .hero-link {
        font-size: 0.98rem !important;
        font-weight: 850 !important;
      }

      @media (max-width: 980px) {
        .hero {
          min-height: auto !important;
        }

        .hero__shell {
          padding-top: clamp(4rem, 10vw, 5.25rem) !important;
          padding-bottom: clamp(4.25rem, 10vw, 5.75rem) !important;
        }

        .hero__content {
          transform: none !important;
        }

        .hero h1,
        .hero #hero-title {
          font-size: clamp(3.35rem, 12vw, 5.25rem) !important;
        }
      }

      @media (max-width: 640px) {
        .hero__actions {
          align-items: stretch !important;
          flex-direction: column !important;
        }

        .hero__actions .button,
        .hero-link {
          width: 100% !important;
        }
      }
      /* END HERO LANDING PAGE FINAL POSITION PASS */

    
      /* QUIZ WHITE QUESTION SURFACE PASS */
      .scorecard-unified-frame .scorecard {
        padding: clamp(1.3rem, 2.4vw, 2rem) !important;
      }

      .scorecard-unified-frame .scorecard-panel {
        position: relative !important;
        overflow: hidden !important;
        border: 1px solid rgba(189, 202, 219, 0.86) !important;
        border-radius: 0.92rem !important;
        background:
          radial-gradient(circle at 18% 0%, rgba(232, 185, 74, 0.08), transparent 18rem),
          linear-gradient(180deg, #ffffff 0%, #f8fbfd 100%) !important;
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.76),
          0 28px 56px -34px rgba(6, 23, 47, 0.48),
          0 16px 28px -24px rgba(6, 23, 47, 0.32),
          inset 1px 1px 0 rgba(255, 255, 255, 1),
          inset -1px -1px 0 rgba(6, 23, 47, 0.08) !important;
        padding: clamp(1.45rem, 2.6vw, 2rem) !important;
      }

      .scorecard-unified-frame .scorecard-panel::before {
        content: "" !important;
        position: absolute !important;
        inset: 0.48rem !important;
        z-index: 0 !important;
        border: 1px solid rgba(255, 255, 255, 0.82) !important;
        border-radius: 0.68rem !important;
        background: transparent !important;
        box-shadow:
          inset 4px 4px 12px rgba(6, 23, 47, 0.055),
          inset -4px -4px 12px rgba(255, 255, 255, 0.92) !important;
        pointer-events: none !important;
      }

      .scorecard-unified-frame .scorecard-panel > * {
        position: relative !important;
        z-index: 1 !important;
      }

      .scorecard-unified-frame .question-heading__eyebrow {
        color: #425873 !important;
      }

      .scorecard-unified-frame .question-heading h3 {
        color: #06172f !important;
        text-shadow: none !important;
      }

      .scorecard-unified-frame .scorecard-panel > .question-heading + p {
        color: #425873 !important;
      }

      .scorecard-unified-frame .choice-row[data-shift-card] {
        min-height: 4rem !important;
        border: 1.5px solid rgba(var(--card-rgb), 0.52) !important;
        border-left-width: 0.38rem !important;
        border-radius: 0.58rem !important;
        background:
          linear-gradient(90deg, rgba(var(--card-rgb), 0.12) 0%, rgba(var(--card-rgb), 0.045) 34%, #ffffff 100%) !important;
        color: #06172f !important;
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.86),
          0 12px 22px -20px rgba(6, 23, 47, 0.34),
          inset 1px 1px 0 rgba(255, 255, 255, 0.98),
          inset -1px -1px 0 rgba(6, 23, 47, 0.06) !important;
      }

      .scorecard-unified-frame .choice-row[data-shift-card] span {
        color: #06172f !important;
      }

      .scorecard-unified-frame .choice-row[data-shift-card]::before {
        color: #06172f !important;
        opacity: 0.62 !important;
      }

      .scorecard-unified-frame .choice-row[data-shift-card]::after {
        background:
          radial-gradient(
            circle at var(--shift-x) var(--shift-y),
            rgba(var(--card-rgb), 0.22) 0%,
            rgba(var(--card-rgb), 0.10) 24%,
            transparent 62%
          ) !important;
      }

      .scorecard-unified-frame .choice-row[data-shift-card]:hover,
      .scorecard-unified-frame .choice-row[data-shift-card]:focus-within {
        background:
          linear-gradient(90deg, rgba(var(--card-rgb), 0.18) 0%, rgba(var(--card-rgb), 0.07) 36%, #ffffff 100%) !important;
        border-color: rgba(var(--card-rgb), 0.78) !important;
        box-shadow:
          0 0 0 2px rgba(var(--card-rgb), 0.16),
          0 18px 30px -24px rgba(var(--card-rgb), 0.54),
          0 12px 22px -18px rgba(6, 23, 47, 0.30),
          inset 1px 1px 0 rgba(255, 255, 255, 1),
          inset -1px -1px 0 rgba(6, 23, 47, 0.08) !important;
      }

      .scorecard-unified-frame .choice-row[data-shift-card]:has(input:checked) {
        background:
          linear-gradient(90deg, rgba(var(--card-rgb), 0.24) 0%, rgba(var(--card-rgb), 0.10) 38%, #ffffff 100%) !important;
        border-color: rgba(var(--card-rgb), 0.90) !important;
        color: #06172f !important;
      }

      .scorecard-unified-frame .scorecard-nav .button--secondary {
        background: #ffffff !important;
        border-color: rgba(99, 123, 152, 0.48) !important;
        color: #06172f !important;
        box-shadow:
          0 10px 20px -18px rgba(6, 23, 47, 0.34),
          inset 1px 1px 0 rgba(255, 255, 255, 1) !important;
      }

      .scorecard-unified-frame .scorecard-result h3,
      .scorecard-unified-frame .scorecard-result p {
        color: #06172f !important;
        text-shadow: none !important;
      }

      .scorecard-unified-frame .scorecard-result__label {
        color: #425873 !important;
      }
      /* END QUIZ WHITE QUESTION SURFACE PASS */

    
      /* QUIZ DIRECT VALUE COLOR PASS */
      /*
        This pass does not depend on data-palette.
        It targets the actual radio values so the colors cannot be lost through old palette-variable cascade.
      */

      .scorecard-unified-frame .role-card:has(input[name="role"][value="CFO"]) {
        --q-rgb: 37, 99, 235;
        --q-border: #2563eb;
        --q-soft: #dbeafe;
      }

      .scorecard-unified-frame .role-card:has(input[name="role"][value="Board / Committee"]) {
        --q-rgb: 22, 163, 74;
        --q-border: #16a34a;
        --q-soft: #dcfce7;
      }

      .scorecard-unified-frame .role-card:has(input[name="role"][value="CHRO / People Leader"]) {
        --q-rgb: 147, 51, 234;
        --q-border: #9333ea;
        --q-soft: #f3e8ff;
      }

      .scorecard-unified-frame .role-card:has(input[name="role"][value="Other"]) {
        --q-rgb: 71, 85, 105;
        --q-border: #475569;
        --q-soft: #e2e8f0;
      }

      .scorecard-unified-frame .choice-row:has(input[name="visibility"][value="3"]),
      .scorecard-unified-frame .choice-row:has(input[name="blindspot"][value="3"]) {
        --q-rgb: 220, 38, 38;
        --q-border: #dc2626;
        --q-soft: #fee2e2;
      }

      .scorecard-unified-frame .choice-row:has(input[name="visibility"][value="2"]),
      .scorecard-unified-frame .choice-row:has(input[name="blindspot"][value="2"]) {
        --q-rgb: 147, 51, 234;
        --q-border: #9333ea;
        --q-soft: #f3e8ff;
      }

      .scorecard-unified-frame .choice-row:has(input[name="visibility"][value="1"]) {
        --q-rgb: 22, 163, 74;
        --q-border: #16a34a;
        --q-soft: #dcfce7;
      }

      .scorecard-unified-frame .choice-row:has(input[name="blindspot"][value="1"]) {
        --q-rgb: 71, 85, 105;
        --q-border: #475569;
        --q-soft: #e2e8f0;
      }

      .scorecard-unified-frame .role-card:has(input[name="role"]) {
        border-color: var(--q-border) !important;
        border-left-width: 0.44rem !important;
        background:
          radial-gradient(circle at 18% 14%, rgba(var(--q-rgb), 0.58), transparent 42%),
          radial-gradient(circle at 82% 82%, rgba(255, 255, 255, 0.92), transparent 46%),
          linear-gradient(
            145deg,
            color-mix(in srgb, var(--q-soft) 92%, #ffffff) 0%,
            #ffffff 48%,
            color-mix(in srgb, var(--q-soft) 70%, #d8e1ee) 100%
          ) !important;
        color: #06172f !important;
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.96),
          0 30px 48px -26px rgba(var(--q-rgb), 0.92),
          0 18px 30px -24px rgba(6, 23, 47, 0.42),
          inset 1px 1px 0 rgba(255, 255, 255, 1),
          inset -1px -1px 0 rgba(6, 23, 47, 0.12),
          inset 0 -14px 22px -24px rgba(6, 23, 47, 0.42) !important;
      }

      .scorecard-unified-frame .role-card:has(input[name="role"])::before {
        border-color: rgba(255, 255, 255, 0.68) !important;
        box-shadow:
          inset 1px 1px 0 rgba(255, 255, 255, 0.95),
          inset -1px -1px 0 rgba(6, 23, 47, 0.10) !important;
      }

      .scorecard-unified-frame .role-card:has(input[name="role"])::after {
        background:
          radial-gradient(
            circle at var(--shift-x) var(--shift-y),
            rgba(var(--q-rgb), 0.70) 0%,
            rgba(var(--q-rgb), 0.32) 24%,
            transparent 66%
          ),
          linear-gradient(135deg, rgba(255, 255, 255, 0.48), transparent 52%) !important;
      }

      .scorecard-unified-frame .role-card:has(input[name="role"]):hover,
      .scorecard-unified-frame .role-card:has(input[name="role"]):focus-within,
      .scorecard-unified-frame .role-card:has(input[name="role"]:checked) {
        border-color: var(--q-border) !important;
        background:
          radial-gradient(circle at var(--shift-x) var(--shift-y), rgba(var(--q-rgb), 0.64), transparent 52%),
          radial-gradient(circle at 82% 82%, rgba(255, 255, 255, 0.94), transparent 46%),
          linear-gradient(
            145deg,
            color-mix(in srgb, var(--q-soft) 96%, #ffffff) 0%,
            #ffffff 48%,
            color-mix(in srgb, var(--q-soft) 76%, #d8e1ee) 100%
          ) !important;
        box-shadow:
          0 0 0 2px rgba(var(--q-rgb), 0.38),
          0 36px 58px -26px rgba(var(--q-rgb), 0.96),
          0 22px 36px -24px rgba(6, 23, 47, 0.48),
          inset 1px 1px 0 rgba(255, 255, 255, 1),
          inset -1px -1px 0 rgba(6, 23, 47, 0.14) !important;
      }

      .scorecard-unified-frame .choice-row:has(input[name="visibility"]),
      .scorecard-unified-frame .choice-row:has(input[name="blindspot"]) {
        border-color: var(--q-border) !important;
        border-left-width: 0.48rem !important;
        background:
          linear-gradient(
            90deg,
            rgba(var(--q-rgb), 0.34) 0%,
            rgba(var(--q-rgb), 0.15) 38%,
            #ffffff 100%
          ) !important;
        color: #06172f !important;
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.92),
          0 18px 30px -22px rgba(var(--q-rgb), 0.66),
          inset 1px 1px 0 rgba(255, 255, 255, 0.98),
          inset -1px -1px 0 rgba(6, 23, 47, 0.08) !important;
      }

      .scorecard-unified-frame .choice-row:has(input[name="visibility"]) span,
      .scorecard-unified-frame .choice-row:has(input[name="blindspot"]) span {
        color: #06172f !important;
      }

      .scorecard-unified-frame .choice-row:has(input[name="visibility"])::before,
      .scorecard-unified-frame .choice-row:has(input[name="blindspot"])::before {
        color: var(--q-border) !important;
        opacity: 0.92 !important;
      }

      .scorecard-unified-frame .choice-row:has(input[name="visibility"])::after,
      .scorecard-unified-frame .choice-row:has(input[name="blindspot"])::after {
        background:
          radial-gradient(
            circle at var(--shift-x) var(--shift-y),
            rgba(var(--q-rgb), 0.48) 0%,
            rgba(var(--q-rgb), 0.22) 24%,
            transparent 62%
          ) !important;
      }

      .scorecard-unified-frame .choice-row:has(input[name="visibility"]):hover,
      .scorecard-unified-frame .choice-row:has(input[name="visibility"]):focus-within,
      .scorecard-unified-frame .choice-row:has(input[name="visibility"]:checked),
      .scorecard-unified-frame .choice-row:has(input[name="blindspot"]):hover,
      .scorecard-unified-frame .choice-row:has(input[name="blindspot"]):focus-within,
      .scorecard-unified-frame .choice-row:has(input[name="blindspot"]:checked) {
        border-color: var(--q-border) !important;
        background:
          linear-gradient(
            90deg,
            rgba(var(--q-rgb), 0.44) 0%,
            rgba(var(--q-rgb), 0.20) 40%,
            #ffffff 100%
          ) !important;
        box-shadow:
          0 0 0 2px rgba(var(--q-rgb), 0.30),
          0 24px 38px -24px rgba(var(--q-rgb), 0.76),
          0 12px 22px -18px rgba(6, 23, 47, 0.30),
          inset 1px 1px 0 rgba(255, 255, 255, 1),
          inset -1px -1px 0 rgba(6, 23, 47, 0.10) !important;
      }

      .scorecard-unified-frame .choice-row:has(input[name="visibility"]:checked)::before,
      .scorecard-unified-frame .choice-row:has(input[name="blindspot"]:checked)::before {
        background: #ffffff !important;
        border-color: var(--q-border) !important;
        box-shadow: inset 0 0 0 0.24rem var(--q-border) !important;
      }
      /* END QUIZ DIRECT VALUE COLOR PASS */

    </style>

    <script is:inline data-scorecard-intro>
      const scorecardIntro = document.querySelector("#scorecard-intro");
      const scorecardStartButton = document.querySelector("[data-start-scorecard]");
      const scorecardFormElement = document.querySelector("#scorecard-form");
      const firstQuestionInput = document.querySelector(".scorecard-panel.is-active input");

      if (scorecardIntro && scorecardStartButton && scorecardFormElement) {
        scorecardFormElement.hidden = true;
        scorecardFormElement.classList.add("scorecard--hidden");

        scorecardStartButton.addEventListener("click", () => {
          scorecardIntro.hidden = true;
          scorecardFormElement.hidden = false;
          scorecardFormElement.classList.remove("scorecard--hidden");
          setTimeout(() => firstQuestionInput?.focus(), 120);
        });
      }
    </script>

  </body>
</html>
