                  <span class="lozen-quiz__dot" data-dot="1"></span>
                  <span class="lozen-quiz__dot" data-dot="2"></span>
                  <span class="lozen-quiz__dot" data-dot="3"></span>
                  <span class="lozen-quiz__dot" data-dot="4"></span>
                  <span class="lozen-quiz__dot" data-dot="5"></span>
                </div>
                <span class="lozen-quiz__progress-label" data-progress-label>
                  Select your role
                </span>
              </div>

              <!-- STEP 0: ROLE -->
