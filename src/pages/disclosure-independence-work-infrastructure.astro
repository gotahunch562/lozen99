      .lozen-quiz__capture-privacy a { color: var(--lz-navy-800); text-underline-offset: 3px; }
      .lozen-quiz__capture-privacy a:hover { color: var(--lz-navy-950); }
    </style>

    <!-- ============================================================ -->
    <!-- PAGE SCRIPT                                                  -->
    <!-- ============================================================ -->
    <script is:inline>
      (function () {
        "use strict";

        // ----- MOBILE NAV -----
        const navToggle = document.querySelector("[data-mobile-nav-toggle]");
        const navPanel = document.querySelector("[data-mobile-nav]");
        if (navToggle && navPanel) {
          navToggle.addEventListener("click", function () {
            const expanded = navToggle.getAttribute("aria-expanded") === "true";
            navToggle.setAttribute("aria-expanded", String(!expanded));
            if (expanded) {
              navPanel.setAttribute("hidden", "");
            } else {
              navPanel.removeAttribute("hidden");
            }
          });
          navPanel.querySelectorAll("a").forEach(function (a) {
            a.addEventListener("click", function () {
              navToggle.setAttribute("aria-expanded", "false");
              navPanel.setAttribute("hidden", "");
            });
          });
        }

        // ----- TABS -----
        const tabsRoot = document.querySelector("[data-tabs]");
        if (tabsRoot) {
          const triggers = Array.from(
            tabsRoot.querySelectorAll("[data-tab-trigger]")
          );
          const panels = Array.from(
            tabsRoot.querySelectorAll("[data-tab-panel]")
          );

          function activate(id, focusTrigger) {
            triggers.forEach(function (t) {
              const active = t.dataset.tabTrigger === id;
              t.classList.toggle("is-active", active);
              t.setAttribute("aria-selected", active ? "true" : "false");
              t.setAttribute("tabindex", active ? "0" : "-1");
              if (active && focusTrigger) t.focus();
            });
            panels.forEach(function (p) {
              const active = p.dataset.tabPanel === id;
              p.classList.toggle("is-active", active);
              if (active) {
                p.removeAttribute("hidden");
              } else {
                p.setAttribute("hidden", "");
              }
            });
          }

          triggers.forEach(function (t, i) {
            t.addEventListener("click", function () {
              activate(t.dataset.tabTrigger, false);
            });
            t.addEventListener("keydown", function (e) {
              let next = i;
              if (e.key === "ArrowRight") next = (i + 1) % triggers.length;
              else if (e.key === "ArrowLeft") next = (i - 1 + triggers.length) % triggers.length;
              else if (e.key === "Home") next = 0;
              else if (e.key === "End") next = triggers.length - 1;
              else return;
              e.preventDefault();
              activate(triggers[next].dataset.tabTrigger, true);
            });
          });
        }

        // ----- QUIZ -----
        const quiz = document.querySelector("[data-quiz]");
        if (!quiz) return;

        const stepIntro = quiz.querySelector('[data-step="intro"]');
        const stepQs = quiz.querySelector('[data-step="questions"]');
        const stepCapture = quiz.querySelector('[data-step="capture"]');
        const captureEmail = quiz.querySelector("[data-capture-email]");
        const captureName = quiz.querySelector("[data-capture-name]");
        const captureSubmit = quiz.querySelector("[data-capture-submit]");
        const captureError = quiz.querySelector("[data-capture-error]");
        const startBtn = quiz.querySelector("[data-quiz-start]");
        const nextBtn = quiz.querySelector("[data-quiz-next]");
        const prevBtn = quiz.querySelector("[data-quiz-prev]");
        const nextLabel = quiz.querySelector("[data-next-label]");
        const progressDots = Array.from(quiz.querySelectorAll("[data-dot]"));
        const progressLabel = quiz.querySelector("[data-progress-label]");
        const questions = Array.from(quiz.querySelectorAll("[data-question]"));

        const state = {
          stepIndex: 0,
          role: null,
          q1: null, q1_value: null,
          q2: null, q2_value: null,
          q3: null, q3_value: null,
          q4: null, q4_value: null,
          q5: null, q5_value: null,
          email: null,
          firstName: null,
        };

        const totalQuestions = questions.length; // 6: role + 5 questions

        function setStep(i) {
          state.stepIndex = i;
          questions.forEach(function (q, idx) {
            q.classList.toggle("is-active", idx === i);
          });
          if (progressLabel) {
            progressLabel.textContent = i === 0 ? "Select your role" : "Question " + i + " of 5";
          }
          // Activate dots up to current step
          progressDots.forEach(function(dot, idx) {
            dot.classList.toggle("is-active", idx <= i);
            dot.classList.toggle("is-complete", idx < i);
          });
          if (prevBtn) {
            if (i === 0) prevBtn.setAttribute("hidden", "");
            else prevBtn.removeAttribute("hidden");
          }
          if (nextLabel) {
            nextLabel.textContent = i === totalQuestions - 1 ? "See my result" : "Continue";
          }
          updateNextAvailability();
        }

        function updateNextAvailability() {
          var current = questions[state.stepIndex];
          if (!current) return;
          var key = current.dataset.question;
          var value = key === "role" ? state.role : state[key];
          if (nextBtn) nextBtn.disabled = value == null;
        }

        if (startBtn) {
          startBtn.addEventListener("click", function () {
            stepIntro.classList.remove("is-active");
            stepQs.classList.add("is-active");
            setStep(0);
            window.scrollTo({
              top: window.scrollY + quiz.getBoundingClientRect().top - 120,
              behavior: "smooth",
            });
          });
        }

        (function () {
          var roleGroup = Array.from(quiz.querySelectorAll("[data-role-option]"));
          function selectRole(btn) {
            state.role = btn.dataset.roleId;
            roleGroup.forEach(function (b) {
              b.setAttribute("aria-checked", "false");
              b.setAttribute("tabindex", "-1");
            });
            btn.setAttribute("aria-checked", "true");
            btn.setAttribute("tabindex", "0");
            updateNextAvailability();
          }
          roleGroup.forEach(function (btn, i) {
            btn.setAttribute("tabindex", i === 0 ? "0" : "-1");
            btn.addEventListener("click", function () { selectRole(btn); });
            btn.addEventListener("keydown", function (e) {
              var next = -1;
              if (e.key === "ArrowRight" || e.key === "ArrowDown") next = (i + 1) % roleGroup.length;
              else if (e.key === "ArrowLeft" || e.key === "ArrowUp") next = (i - 1 + roleGroup.length) % roleGroup.length;
              else if (e.key === "Home") next = 0;
              else if (e.key === "End") next = roleGroup.length - 1;
              else if (e.key === " " || e.key === "Enter") { e.preventDefault(); selectRole(btn); }
              if (next >= 0) { e.preventDefault(); selectRole(roleGroup[next]); roleGroup[next].focus(); }
            });
          });
        })();

        (function () {
          ["q1","q2","q3","q4","q5"].forEach(function (key) {
            var group = Array.from(quiz.querySelectorAll('[data-answer-option="' + key + '"]')); 
            function selectAnswer(btn) {
              state[key] = parseFloat(btn.dataset.score);
              state[key + "_value"] = btn.dataset.answerValue;
              group.forEach(function (b) {
                b.setAttribute("aria-checked", "false");
                b.setAttribute("tabindex", "-1");
              });
              btn.setAttribute("aria-checked", "true");
              btn.setAttribute("tabindex", "0");
              updateNextAvailability();
            }
            group.forEach(function (btn, i) {
              btn.setAttribute("tabindex", i === 0 ? "0" : "-1");
              btn.addEventListener("click", function () { selectAnswer(btn); });
              btn.addEventListener("keydown", function (e) {
                var next = -1;
                if (e.key === "ArrowDown" || e.key === "ArrowRight") next = (i + 1) % group.length;
                else if (e.key === "ArrowUp" || e.key === "ArrowLeft") next = (i - 1 + group.length) % group.length;
                else if (e.key === "Home") next = 0;
                else if (e.key === "End") next = group.length - 1;
                else if (e.key === " " || e.key === "Enter") { e.preventDefault(); selectAnswer(btn); }
                if (next >= 0) { e.preventDefault(); selectAnswer(group[next]); group[next].focus(); }
              });
            });
          });
        })();

        if (nextBtn) {
          nextBtn.addEventListener("click", function () {
            if (nextBtn.disabled) return;
            if (state.stepIndex < totalQuestions - 1) {
              setStep(state.stepIndex + 1);
            } else {
              // All questions done — show contact capture step
              stepQs.classList.remove("is-active");
              if (stepCapture) {
                stepCapture.classList.add("is-active");
                if (captureEmail) captureEmail.focus();
              }
            }
          });
        }
        if (prevBtn) {
          prevBtn.addEventListener("click", function () {
            if (state.stepIndex > 0) setStep(state.stepIndex - 1);
          });
        }

        // Capture step — email validation and submit
        function isValidEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }

        if (captureSubmit) {
          // Must be async — handler awaits submitToSupabase() before revealing result
          captureSubmit.addEventListener("click", async function () {
            var email = captureEmail ? captureEmail.value.trim() : "";
            var name  = captureName  ? captureName.value.trim()  : "";
            if (!isValidEmail(email)) {
              if (captureError) captureError.removeAttribute("hidden");
              if (captureEmail) captureEmail.focus();
              return;
            }
            if (captureError) captureError.setAttribute("hidden", "");
            state.email = email;
            state.firstName = name || null;
            if (captureSubmit) {
              captureSubmit.disabled = true;
              var btnSpan = captureSubmit.querySelector("span[data-next-label], span:not([aria-hidden])");
              if (btnSpan) btnSpan.textContent = "Saving\u2026";
            }

            // Submit to Supabase first — only reveal result if insert succeeds
            var total = Math.round(((state.q1||0)+(state.q2||0)+(state.q3||0)+(state.q4||0)+(state.q5||0))*10)/10;
            var tier = tierFor(total);
            var ok = await submitToSupabase({
              email:                  state.email,
              first_name:             state.firstName,
              role:                   state.role,
              q1_disclosure:          state.q1_value,
              q2_invisible_attrition: state.q2_value,
              q3_power_user_trap:     state.q3_value,
              q4_board_governance:    state.q4_value,
              q5_capital_efficiency:  state.q5_value,
              score:                  total,
              score_tier:             tier.eyebrow,
              referrer:               document.referrer || null,
            });

            if (!ok) {
              // Re-enable form and show submission error
              if (captureSubmit) captureSubmit.disabled = false;
              if (btnSpan) btnSpan.textContent = "Show My Result";
              if (captureError) {
                captureError.textContent = "We couldn\u2019t save your result. Please check your connection and try again.";
                captureError.removeAttribute("hidden");
              }
              return;
            }

            showResult(total, tier);
          });
          if (captureEmail) {
            captureEmail.addEventListener("keydown", function (e) {
              if (e.key === "Enter") { e.preventDefault(); captureSubmit.click(); }
            });
          }
        }

        // ----- RESULTS -----
        const modal = document.querySelector("[data-modal]");
        const modalEyebrow = modal.querySelector("[data-modal-eyebrow]");
        const modalTierBadge = modal.querySelector("[data-modal-tier-badge]");
        const modalTitle = modal.querySelector("[data-modal-title]");
        const modalScoreNumber = modal.querySelector("[data-modal-score-number]");
        const modalBody = modal.querySelector("[data-modal-body]");
        const modalCta = modal.querySelector("[data-modal-cta]");
        const modalCloses = modal.querySelectorAll("[data-modal-close]");

        function tierFor(total) {
          if (total <= 2) {
            return {
              eyebrow: "Critical Alert",
              title: "Your Human Capital Strategy is Reactive.",
              body: "You are likely absorbing 100% of your executive Invisible Attrition\u2120 costs. Disclosure-dependent systems are creating silent, undetected risk across your senior leadership pipeline.",
              cta: "Request an Immediate Briefing",
              href: "/request-briefing/",
              colorKey: "critical",
            };
          }
          if (total <= 4) {
            return {
              eyebrow: "Operational Drift",
              title: "You Have the Right Tools \u2014 Wrong Architecture.",
              body: "Disclosure-dependent systems are creating a silent leak in your senior leadership pipeline. The infrastructure exists but only activates when employees come forward. Your highest-risk employees are the least likely to do that.",
              cta: "Request a Structural Audit",
              href: "/request-briefing/",
              colorKey: "drift",
            };
          }
          return {
            eyebrow: "Strategic Resilience",
            title: "Your Organization is a Power User of Human Capital.",
            body: "You are among the 7% of leaders effectively building disclosure-independent workforce infrastructure. The next move is comparing your architecture to 2026 sector benchmarks.",
            cta: "Compare Your Metrics to 2026 Benchmarks",
            href: "/request-briefing/",
            colorKey: "resilient",
          };
        }

        async function submitToSupabase(payload) {
          try {
            var response = await fetch("https://yaebacffmklidylcejlq.supabase.co/rest/v1/quiz_submissions", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "apikey": "sb_publishable_OiCvatOmGSEDBpx_9J2mew_AIeZyd3-",
                "Authorization": "Bearer sb_publishable_OiCvatOmGSEDBpx_9J2mew_AIeZyd3-",
                "Prefer": "return=minimal",
              },
              body: JSON.stringify(payload),
            });
            if (!response.ok) {
              console.warn("Supabase insert failed:", response.status, response.statusText);
              return false;
            }
            return true;
          } catch (err) {
            console.warn("Supabase fetch error:", err);
            return false;
          }
        }

        function showResult(total, tier) {
          if (modalEyebrow) modalEyebrow.textContent = tier.eyebrow;
          if (modalTitle) modalTitle.textContent = tier.title;
          if (modalScoreNumber) modalScoreNumber.textContent = total;
          if (modalBody) modalBody.textContent = tier.body;
          // Update CTA text via child span — preserves the SVG arrow
          if (modalCta) {
            var ctaSpan = modalCta.querySelector("span") || modalCta;
            if (ctaSpan !== modalCta) ctaSpan.textContent = tier.cta;
            modalCta.href = tier.href;
          }

          if (modalTierBadge) {
            modalTierBadge.className = "lozen-modal__tier-badge lozen-modal__tier-badge--" + tier.colorKey;
          }
          var panel = modal.querySelector(".lozen-modal__panel");
          if (panel) {
            panel.className = panel.className.replace(/lozen-modal__panel--\S+/g, "").trim();
            panel.classList.add("lozen-modal__panel--" + tier.colorKey);
          }
          openModal();
        }


        let lastFocus = null;

        function getFocusable() {
          return Array.from(
            modal.querySelectorAll(
              'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
            )
          ).filter(function (el) {
            return !el.closest("[hidden]") && el.offsetParent !== null;
          });
        }

        function trapFocus(e) {
          if (e.key !== "Tab") return;
          var focusable = getFocusable();
          if (!focusable.length) { e.preventDefault(); return; }
          var first = focusable[0];
          var last  = focusable[focusable.length - 1];
          if (e.shiftKey) {
            if (document.activeElement === first) {
              e.preventDefault();
              last.focus();
            }
          } else {
            if (document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }

        function openModal() {
          lastFocus = document.activeElement;
          modal.classList.add("is-open");
          modal.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
          modal.addEventListener("keydown", trapFocus);
          var firstFocus = modal.querySelector(".lozen-modal__close");
          if (firstFocus) firstFocus.focus();
        }

        function closeModal() {
          modal.classList.remove("is-open");
          modal.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
          modal.removeEventListener("keydown", trapFocus);
          if (lastFocus && typeof lastFocus.focus === "function") {
            lastFocus.focus();
          }
        }

        modalCloses.forEach(function (el) {
          el.addEventListener("click", closeModal);
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && modal.classList.contains("is-open")) {
            closeModal();
          }
        });

      })();
    </script>
  </body>
</html>
