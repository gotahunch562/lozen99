---
// Foundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import InternalPageHero from "@/components/fundations/sections/InternalPageHero.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Plus from "@/components/fundations/icons/Plus.astro";
// FAQ Data organized by categories
const faqCategories = [
  {
    category: "The MAPS Blueprint℠",
    questions: [
      {
        question: "What is the MAPS Blueprint℠?",
        answer:
          "The MAPS Blueprint℠ is a 90-minute private advisory session for the woman executive. She arrives with a situation. She leaves with a plan. The session maps the operating environment before any record is created. It identifies what is being decided, who has influence over the outcome, what evidence matters, what risk must be prioritized, and what position she needs to take.",
      },
      {
        question: "How do I know if the MAPS Blueprint℠ is for me?",
        answer:
          "This session is designed for a specific situation. You are approaching something visible and consequential — a performance review, a promotion decision, a board presentation, a partner review, a trial, or a leadership transition. Or something has changed and you are managing it privately. It is affecting your performance. You cannot fully explain it at work, and you need to decide how to move forward before you are evaluated. You may be navigating a health challenge that has begun to affect how you work. If that is not your situation, this is not the right entry point.",
      },
      {
        question: "Is this a coaching session?",
        answer:
          "No. This is not a coaching engagement and it is not a space to process. It is a working session built on the principle of Disclosure-Independent Performance Protection℠. You should not have to create a record to get help. You should not have to explain what is happening to preserve what you have built. The session produces a plan, not a conversation.",
      },
      {
        question: "What happens after the MAPS Blueprint℠ session?",
        answer:
          "The MAPS Blueprint℠ is the entry point. Women who need ongoing advisory support as situations evolve — the next exposure, the next transition, the next moment that cannot be said out loud anywhere else — move into a continued advisory relationship with Lozen Advisory. That relationship belongs entirely to you, not your employer.",
      },
      {
        question: "Does my employer have access to anything discussed in the session?",
        answer:
          "No. Lozen Advisory has no organizational relationship with your employer and no reporting structure connected to your workplace. The session exists entirely outside your employer's systems. Nothing you share creates a record your organization can access.",
      },
    ],
  },
  {
    category: "Organizational Services",
    questions: [
      {
        question: "What problem does Lozen Advisory solve for organizations?",
        answer:
          "Boards and leadership teams are being asked to govern AI systems, sustain leadership continuity, and manage workforce risk — using evidence that was built for a different era. Standard governance systems only record what becomes visible through a formal act: a disclosure made, a claim filed, a review completed. When the initiating act never happens, the record was never created. Lozen Advisory advises leadership teams on what that governance gap is costing before it appears as a board issue, a legal exposure, a retention failure, or an exit that will not be labeled correctly.",
      },
      {
        question: "What is Invisible Attrition℠?",
        answer:
          "Invisible Attrition℠ is the unmeasured erosion of leadership and performance capacity that occurs before traditional retention metrics detect risk. It is present in succession exposure, capacity strain, and diminished leadership continuity long before a data point confirms it. Organizations with AI adoption burden concentrated among key talent, unexplained leadership exits, or succession plans built from disclosed data only may already be experiencing Invisible Attrition℠.",
      },
      {
        question: "What is the right entry point for our organization?",
        answer:
          "Organizations that need to understand the scope of the problem start with Market Intelligence, which provides advisory analysis on disclosure-dependent workforce risk and what the data is not capturing. Organizations that need to bring the analysis into a decision room quickly request an Executive Briefing. Organizations that already understand the gap and need ongoing advisory counsel on strategy, disclosure-independent infrastructure design, and leadership continuity retain Lozen Advisory through an Advisory Engagement.",
      },
      {
        question: "What is the Executive Briefing?",
        answer:
          "The Executive Briefing is a private, structured advisory engagement for corporate boards, CFOs, General Counsel, risk leaders, corporate secretaries, and senior executives examining enterprise governance risk. It is not a discovery call or a vendor pitch. It is a standalone advisory engagement designed to help leadership understand exposure — in AI accountability, workforce risk, or succession continuity — before cost, legal exposure, or retention loss appears in standard reporting systems.",
      },
      {
        question: "What does the AI Workforce Materiality Briefing examine?",
        answer:
          "The AI Workforce Materiality Briefing examines where AI-assisted output is moving faster than current compliance, review, approval, or escalation systems can detect. It maps where automated velocity is relying on unpriced human calibration, institutional knowledge, exception handling, and judgment. It also establishes the governance conditions that should exist before AI-assisted output carries a professional name, executive approval, board reliance, client communication, regulatory representation, or enterprise record.",
      },
      {
        question: "We already have menopause benefits in place. Why would we need Lozen Advisory?",
        answer:
          "Benefits availability is not the same as governance coverage. For women executives operating in competitive environments, the cost of using a benefit — the professional risk of becoming visible as someone whose capacity may be in question — is often the actual barrier. A leader may never file a claim, never enter the platform, and never generate a record. Your report then shows no problem. The board is succession planning from a dataset that does not reflect the population actually at risk. Lozen Advisory advises organizations on what that gap is costing in governance terms before it surfaces as a leadership continuity failure.",
      },
      {
        question: "Does Lozen Advisory work with organizations outside of menopause benefits?",
        answer:
          "Yes. Menopause at work exposes the measurement failure. AI adoption expands it. Lozen Advisory advises organizations across disclosure-dependent governance systems — AI accountability, human attribution, board evidence, workforce risk, succession exposure, and the Power User Trap℠. In AI adoption, verification and correction burden concentrates among employees with technical proficiency and deep institutional knowledge while standard productivity metrics show improvement. The board sees adoption. It does not see the capacity loss accumulating underneath it.",
      },
    ],
  },
  {
    category: "Frameworks & Research",
    questions: [
      {
        question: "What is Disclosure-Independent Governance℠?",
        answer:
          "Disclosure-Independent Governance℠ is the category Lozen Advisory named and defined — the governance discipline for evaluating risks that legacy systems were not built to see. It addresses the structural condition in which organizations cannot govern what their measurement systems were not designed to detect: disclosure-dependent workforce exposure, hidden AI oversight labor, and human accountability gaps. The category hub is at lozenadvisory.com/disclosure-independent-governance/.",
      },
      {
        question: "What is the Name Standard℠?",
        answer:
          "The Name Standard℠ is Lozen Advisory's diagnostic framework for human attribution in AI governance. It evaluates whether AI-assisted decisions, outputs, escalations, and sign-off remain traceable to a responsible human or institutional actor — whether that person had the time, authority, information, documentation, escalation path, and formal right of refusal necessary to make oversight real. Human-in-the-loop and human-on-the-loop models describe placement. The Name Standard℠ evaluates accountability.",
      },
      {
        question: "What is the 5Ws of Decision Integrity℠?",
        answer:
          "The 5Ws of Decision Integrity℠ is Lozen Advisory's board-level diagnostic for evaluating AI-assisted decisions through five evidence standards: What data or AI outputs were relied upon and is that reliance documented? Who held named accountability and did that person have the authority required to sign off? Which performance indicators were tracked and what would trigger escalation? What was missed, overlooked, or not detected? And Witness — what documented record exists that would withstand regulatory scrutiny, litigation, or board inquiry?",
      },
      {
        question: "What is Tacere?",
        answer:
          "Tacere is the sustained, strategic practice of keeping one's own counsel by a senior executive operating in a professional environment where disclosure carries professional risk. It names what the executive who never files a claim, never requests an accommodation, and never flags a performance issue is actually doing — and why. She was never silent. She decided. Tacere is not a failure condition. It is a unilateral decision produced by an incentive structure where visibility carries cost and concealment remains an option. The Tacere research is published at lozenadvisory.com/invisible-attrition/structural-silence/.",
      },
      {
        question: "What is the Power User Trap℠?",
        answer:
          "The Power User Trap℠ begins when employees with technical proficiency and deep institutional knowledge become the informal validation layer for AI adoption. They learn the tools first, troubleshoot failures, verify outputs, train colleagues, and absorb the cognitive burden while standard productivity metrics show improvement. The organization sees adoption. It does not see the concentration of oversight work. By the time the exit appears in retention data, the institutional knowledge is already gone.",
      },
      {
        question: "What is the Committee Ownership Map?",
        answer:
          "The Committee Ownership Map is a Lozen Advisory framework assigning each board committee a Disclosure-Independent Governance℠ question and the evidentiary record it must be able to produce if that oversight is ever challenged. Task ownership is not the same as evidentiary ownership. A committee can be formally responsible for an AI risk category and still have no way to prove — to a regulator, a plaintiff's attorney, or its own shareholders — that the oversight it performed was real. The framework is at lozenadvisory.com/frameworks/committee-ownership-map/.",
      },
      {
        question: "What is Disclosure-Independent Performance Protection℠?",
        answer:
          "Disclosure-Independent Performance Protection℠ is the governing principle of the MAPS Blueprint℠. It holds that a woman should not have to create a record to get help, and should not have to explain what is happening to preserve what she has built. The session is designed to protect performance, reputation, and career trajectory without requiring entry into any employer system, triggering any formal process, or producing any documentation.",
      },
    ],
  },
  {
    category: "Working With Lozen Advisory",
    questions: [
      {
        question: "Is Lozen Advisory a consulting firm?",
        answer:
          "Lozen Advisory is an advisory practice, not a consulting firm. The distinction matters. Lozen Advisory advises decision-makers on what their current systems cannot see, what that gap costs, and what leadership needs to examine before risk appears in conventional reporting. The work is built from over 20 years of experience with the decision systems executives use to evaluate performance, risk, and organizational movement.",
      },
      {
        question: "How does Lozen Advisory price its services?",
        answer:
          "Pricing varies by service and engagement scope. The MAPS Blueprint℠ is a fixed-fee session. Organizational services, including Market Intelligence, Executive Briefing, and Advisory Engagement, are priced based on the organization's needs and the depth of advisory analysis required. Contact Lozen Advisory to discuss the right entry point for your situation.",
      },
      {
        question: "How do I get started?",
        answer:
          "Women executives book the MAPS Blueprint℠ directly. Organizations begin by requesting a briefing. Use the contact page at lozenadvisory.com to reach us, or request a briefing directly from the site navigation.",
      },
    ],
  },
];

const title = "FAQ | Lozen Advisory";
const description = "Common questions about Lozen Advisory, board governance briefings, disclosure-independent governance frameworks, and private advisory sessions.";
const dateModified = "2026-05-19";
---

<BaseLayout title={title} description={description}>
  <InternalPageHero
    eyebrow="FAQ"
    title="Frequently Asked Questions"
    deck="Answers to common questions about Lozen Advisory, strategic briefings, research, and advisory work."
  />
  <section>
    <Wrapper variant="standard" class="py-12 lg:py-24">
      <div class="space-y-24 gap-8 lg:gap-1 divide-y divide-base-200">
        {
          faqCategories.map((cat) => (
            <div class="pb-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
              <Text
                tag="h3"
                variant="textBase"
                class="pl-4 uppercase border-l font-display text-base-900  border-accent-500 h-fit lg:sticky lg:top-24"
              >
                {cat.category}
              </Text>
              <div class="space-y-2 lg:col-span-2 ">
                {cat.questions.map((faq) => (
                  <details class="py-4 select-none group">
                    <summary class="flex items-center  gap-4 justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                      <Text
                        tag="span"
                        variant="textBase"
                        class="font-medium text-base-900 "
                      >
                        {faq.question}
                      </Text>
                      <span class="flex items-center justify-center rounded-full shrink-0 size-8 bg-base-200 group-open:bg-accent-500 transition-colors">
                        <Plus
                          size="sm"
                          class="text-base-600 group-open:text-white group-open:rotate-45 transition-transform duration-300"
                        />
                      </span>
                    </summary>
                    <div class="pt-4 pb-8">
                      <Text tag="p" variant="textBase" class="text-base-600">
                        {faq.answer}
                      </Text>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
