---
// Foundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Plus from "@/components/fundations/icons/Plus.astro";
// FAQ Data organized by categories
const faqCategories = [
  {
    category: "The MAPS Blueprint℠",
    questions: [
      {
        question: "What is the MAPS Blueprint℠?",
        answer:
          "The MAPS Blueprint℠ is a 90-minute private advisory session for the woman executive. She arrives with a situation. She leaves with a plan. The session maps the operating environment before any record is created. It identifies what is being decided, who has influence over the outcome, what evidence matters, what risk must be prioritized, and what position she needs to take.",
      },
      {
        question: "How do I know if the MAPS Blueprint℠ is for me?",
        answer:
          "This session is designed for a specific situation. You are approaching something visible and consequential — a performance review, a promotion decision, a board presentation, a partner review, a trial, or a leadership transition. Or something has changed and you are managing it privately. It is affecting your performance. You cannot fully explain it at work, and you need to decide how to move forward before you are evaluated. You may be navigating a health challenge that has begun to affect how you work. If that is not your situation, this is not the right entry point.",
      },
      {
        question: "Is this a coaching session?",
        answer:
          "No. This is not a coaching engagement and it is not a space to process. It is a working session built on the principle of Disclosure-Independent Performance Protection℠. You should not have to create a record to get help. You should not have to explain what is happening to preserve what you have built. The session produces a plan, not a conversation.",
      },
      {
        question: "What happens after the MAPS Blueprint℠ session?",
        answer:
          "The MAPS Blueprint℠ is the entry point. Women who need ongoing advisory support as situations evolve — the next exposure, the next transition, the next moment that cannot be said out loud anywhere else — move into a continued advisory relationship with Lozen Advisory. That relationship belongs entirely to you, not your employer.",
      },
      {
        question: "Does my employer have access to anything discussed in the session?",
        answer:
          "No. Lozen Advisory has no organizational relationship with your employer and no reporting structure connected to your workplace. The session exists entirely outside your employer's systems. Nothing you share creates a record your organization can access.",
      },
    ],
  },
  {
    category: "Organizational Services",
    questions: [
      {
        question: "What problem does Lozen Advisory solve for organizations?",
        answer:
          "Most organizations already have benefits, dashboards, HR records, and retention reports. The problem is that those systems only measure what becomes visible through a formal act — a claim filed, an accommodation requested, a survey completed, an exit interview conducted. When the initiating act never happens, the data was never created. Lozen Advisory advises leadership teams on what that gap is costing before it appears in retention numbers, succession exposure, or an exit that will not be labeled correctly.",
      },
      {
        question: "What is Invisible Attrition℠?",
        answer:
          "Invisible Attrition℠ is the unmeasured erosion of leadership and performance capacity that occurs before traditional retention metrics detect risk. It is present in workload strain, succession exposure, and diminished leadership continuity long before a data point confirms it. Organizations experiencing low benefits utilization, unexplained leadership exits, or AI implementation burden concentrated among capable early adopters may already be experiencing Invisible Attrition℠.",
      },
      {
        question: "What is the right entry point for our organization?",
        answer:
          "Organizations that need to understand the scope of the problem start with Market Intelligence, which provides advisory analysis on disclosure-dependent workforce risk, benefits utilization, and what the data is not capturing. Organizations that need to bring the analysis into a decision room quickly request an Executive Briefing. Organizations that already understand the gap and need ongoing advisory counsel on strategy, disclosure-independent infrastructure design, and leadership continuity retain Lozen Advisory through an Advisory Engagement.",
      },
      {
        question: "What is a Strategic Briefing?",
        answer:
          "The Strategic Briefing is a private, 90-minute paid advisory engagement for corporate boards, CFOs, General Counsel, CHROs, risk leaders, and senior executives examining enterprise workforce risk. It is not a discovery call or a vendor pitch. It is a standalone advisory engagement designed to help leadership understand exposure before cost, liability, retention loss, or operational strain appears in standard reporting systems.",
      },
      {
        question: "What does the AI Workforce Materiality Briefing examine?",
        answer:
          "The AI Workforce Materiality Briefing examines where AI-assisted output is moving faster than current compliance, review, approval, or escalation systems can detect. It maps where automated velocity is relying on unpriced human calibration, institutional knowledge, exception handling, and judgment. It also establishes the governance conditions that should exist before AI-assisted output carries a professional name, executive approval, board reliance, client communication, regulatory representation, or enterprise record.",
      },
      {
        question: "We already have menopause benefits in place. Why would we need Lozen Advisory?",
        answer:
          "Low utilization is often treated as a communication problem. For women executives operating in fast-paced and competitive environments, the cost of using the benefit may be the actual barrier — not awareness. A woman may never file a claim, never request an accommodation, and never enter the platform you built for her. Your report then shows no problem. Lozen Advisory advises organizations on why utilization understates need, and what that gap is costing in ways current data cannot show.",
      },
      {
        question: "Are menopause benefits worth investing in for our workforce?",
        answer:
          "The investment case depends on whether the benefit can reach the workforce risk it was purchased to address. Availability is not the same as adoption and utilization is not the same as need. A menopause benefit that depends entirely on voluntary utilization will serve the women in the workforce that enters the system. It cannot demonstrate that it reached the women most likely to avoid a menopause-coded pathway, and for a CFO evaluating return, that distinction matters. Low utilization is not evidence that the risk is absent. It may be evidence that the benefit cannot reach the population it was designed to benefit. The investment case is strongest when menopause benefits are evaluated alongside retention risk, leadership continuity, and the cost of non-use.",
      },
      {
        question: "Does Lozen Advisory work with organizations outside of menopause benefits?",
        answer:
          "Yes. Menopause exposes the measurement flaw. AI expands it. Lozen Advisory advises organizations across disclosure-dependent workforce systems, including benefits utilization, HR records, performance data, accommodation pathways, leave structures, leadership pipeline reporting, AI governance, and the Power User Trap℠. In AI adoption, implementation burden can concentrate among the employees most capable of verifying outputs, correcting failures, training colleagues, and absorbing the cognitive load while standard productivity metrics show improvement. The organization sees adoption. It does not see the capacity loss accumulating underneath it.",
      },
    ],
  },
  {
    category: "Frameworks & Research",
    questions: [
      {
        question: "What is Tacere?",
        answer:
          "Tacere is the sustained, strategic practice of keeping one's own counsel by a senior professional operating in an environment where disclosure carries professional risk. It names what the woman who never files a claim, never requests an accommodation, and never flags a performance issue is actually doing — and why. She was never silent, she decided. The Tacere paper is available for download at lozenadvisory.com.",
      },
      {
        question: "What is the Power User Trap℠?",
        answer:
          "The Power User Trap℠ begins when capable early adopters become the informal validation layer for AI adoption. They learn the tools first, troubleshoot failures, verify outputs, train colleagues, and absorb the cognitive burden while standard productivity metrics show improvement. The organization sees adoption. It does not see the concentration of oversight work. By the time the exit appears in retention data, the implementation capacity has already left.",
      },
      {
        question: "What is Disclosure-Independent Performance Protection℠?",
        answer:
          "Disclosure-Independent Performance Protection℠ is the governing principle of the MAPS Blueprint℠. It holds that a woman should not have to create a record to get help, and should not have to explain what is happening to preserve what she has built. The session is designed to protect performance, reputation, and career trajectory without requiring entry into any employer system, triggering any formal process, or producing any documentation.",
      },
    ],
  },
  {
    category: "Working With Lozen Advisory",
    questions: [
      {
        question: "Is Lozen Advisory a consulting firm?",
        answer:
          "Lozen Advisory is an advisory practice, not a consulting firm. The distinction matters. Lozen Advisory advises decision-makers on what their current systems cannot see, what that gap costs, and what leadership needs to examine before risk appears in conventional reporting. The work is built from over 20 years of experience with the decision systems executives use to evaluate performance, risk, and organizational movement.",
      },
      {
        question: "How does Lozen Advisory price its services?",
        answer:
          "Pricing varies by service and engagement scope. The MAPS Blueprint℠ is a fixed-fee session. Organizational services, including Market Intelligence, Executive Briefing, Strategic Briefing, and Advisory Engagement, are priced based on the organization's needs and the depth of advisory analysis required. Contact Lozen Advisory to discuss the right entry point for your situation.",
      },
      {
        question: "How do I get started?",
        answer:
          "Women executives book the MAPS Blueprint℠ directly. Organizations begin by requesting a briefing. Use the contact page at lozenadvisory.com to reach us, or request a briefing directly from the site navigation.",
      },
    ],
  },
];
const title = "FAQ | Lozen Advisory";

const description = "Answers to common questions about Lozen Advisory, strategic briefings, private advisory sessions, and disclosure-independent performance protection.";
---

<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-t from-base-200 to-white">
    <Wrapper variant="standard" class="py-24 lg:py-32">
      <div class="max-w-3xl">
        <Text
          tag="span"
          variant="textSM"
          class="pl-4 font-medium uppercase border-l text-base-900 font-display border-accent-500"
        >
          Support
        </Text>
        <Text
          tag="h1"
          variant="displayXL"
          class="mt-8 uppercase font-display text-base-900 text-balance"
        >
          Frequently Asked Questions
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="mt-4 text-base-600 text-balance"
        >
          Common questions about Lozen Advisory services, frameworks, and how the work is structured.
        </Text>
      </div>
    </Wrapper>
  </section>
  <section>
    <Wrapper variant="standard" class="py-12 lg:py-24">
      <div class="space-y-24 gap-8 lg:gap-1 divide-y divide-base-200">
        {
          faqCategories.map((cat) => (
            <div class="pb-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
              <Text
                tag="h3"
                variant="textBase"
                class="pl-4 uppercase border-l font-display text-base-900  border-accent-500 h-fit lg:sticky lg:top-24"
              >
                {cat.category}
              </Text>
              <div class="space-y-2 lg:col-span-2 ">
                {cat.questions.map((faq) => (
                  <details class="py-4 select-none group">
                    <summary class="flex items-center  gap-4 justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                      <Text
                        tag="span"
                        variant="textBase"
                        class="font-medium text-base-900 "
                      >
                        {faq.question}
                      </Text>
                      <span class="flex items-center justify-center rounded-full shrink-0 size-8 bg-base-200 group-open:bg-accent-500 transition-colors">
                        <Plus
                          size="sm"
                          class="text-base-600 group-open:text-white group-open:rotate-45 transition-transform duration-300"
                        />
                      </span>
                    </summary>
                    <div class="pt-4 pb-8">
                      <Text tag="p" variant="textBase" class="text-base-600">
                        {faq.answer}
                      </Text>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>

