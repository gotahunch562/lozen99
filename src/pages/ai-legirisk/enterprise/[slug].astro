---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/briefing-doc.css";
import {
  getAiLegiRiskReportBySlug,
  formatJurisdiction,
  formatSignal,
  compactDate,
} from "@/lib/aiLegiRiskReports";

export const prerender = false;

const slug = Astro.params.slug;
const report = await getAiLegiRiskReportBySlug(slug);

if (!report) {
  return Astro.redirect("/404/");
}

const { law, profile } = report;

/*
  Report naming standard

  reportTitleName:
  - Use for the large report H1.
  - Prefers the full law/report name unless the full name is missing.

  shortDisplayName:
  - Use for compact report labels, footer labels, nav labels, CTA copy, and short references.
  - Prefers the short name.
*/
const reportTitleName = law.law_name || law.short_name || "AI legislation record";
const shortDisplayName = law.short_name || law.law_name || "AI legislation record";

const trackerUrl = "/ai-legislation-tracker/";
const advisoryBriefingUrl = "/ai-workforce-materiality-briefing/";
// PLACEHOLDER — swap for the real Name Standard(SM) diagnostic URL once it exists.
const nameStandardDiagnosticUrl = "/name-standard-diagnostic/";

const title = `Enterprise Impact Map — ${shortDisplayName} | Lozen Advisory`;
const description = `Enterprise impact analysis for ${law.law_name || shortDisplayName}. This map identifies operating-model impact raised by the legislation.`;

const enterpriseSignals = [
  profile.enterprise_signal_1,
  profile.enterprise_signal_2,
  profile.enterprise_signal_3,
].filter(Boolean);

const enterpriseQuestions = [
  profile.enterprise_question_1,
  profile.enterprise_question_2,
  profile.enterprise_question_3,
].filter(Boolean);

/*
  Title-trail split: if the title ends in a parenthetical citation/acronym
  (e.g. "Colorado SB 26-189 (ADMT)"), render that trailing piece in a quieter
  tone than the rest of the headline — see .briefing-title-trail in the CSS.
  Falls through cleanly (titleTrail stays null) for titles with no trailing
  parenthetical, so this is safe across every report shape, not just this one.
*/
const titleMatch = reportTitleName.match(/^(.*\S)\s+(\([^)]+\))\s*$/);
const titleBase = titleMatch ? titleMatch[1] : reportTitleName;
const titleTrail = titleMatch ? titleMatch[2] : null;
---

<BaseLayout title={title} description={description} ogType="article" hideNavigation={true} hideFooter={true}>
  <article class="briefing-document">
    <div class="briefing-page">
      <header class="briefing-masthead">
        <div>
          <p class="briefing-masthead-name">Lozen Advisory LLC</p>
        </div>

        <div class="briefing-actions">
          <button class="briefing-doc-action" type="button" onclick="window.print()">
            <svg viewBox="0 0 24 24">
              <path d="M12 3v12" />
              <path d="M7 10l5 5 5-5" />
              <path d="M5 21h14" />
            </svg>
            Export PDF
          </button>

          <button class="briefing-doc-action" type="button" onclick="navigator.share ? navigator.share({ title: document.title, url: window.location.href }) : navigator.clipboard.writeText(window.location.href)">
            <svg viewBox="0 0 24 24">
              <circle cx="18" cy="5" r="3" />
              <circle cx="6" cy="12" r="3" />
              <circle cx="18" cy="19" r="3" />
              <path d="M8.6 13.5l6.8 4" />
              <path d="M15.4 6.5l-6.8 4" />
            </svg>
            Share with board
          </button>

          <a class="briefing-doc-action is-close" href={trackerUrl}>
            <svg viewBox="0 0 24 24">
              <path d="M18 6 6 18" />
              <path d="M6 6l12 12" />
            </svg>
            Close briefing
          </a>
        </div>
      </header>

      <div class="briefing-util-bar">
        <span class="briefing-util-position">Page 1 · Enterprise Impact Map</span>
      </div>

      <div class="briefing-doc-header">
        <h1 class="briefing-doc-header-title">
          {titleBase}{titleTrail && <> <span class="briefing-title-trail">{titleTrail}</span></>}
        </h1>

        {law.verified_summary && (
          <div class="briefing-doc-header-summary briefing-doc-header-summary-with-icon">
            <span class="briefing-summary-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="M9 18h6" />
                <path d="M10 21h4" />
                <path d="M8.5 14.5c-1.4-1.2-2.5-3-2.5-5.2A6 6 0 0 1 12 3a6 6 0 0 1 6 6.3c0 2.2-1.1 4-2.5 5.2-.8.7-1.3 1.4-1.5 2.2h-4c-.2-.8-.7-1.5-1.5-2.2Z" />
              </svg>
            </span>
            <p>{law.verified_summary}</p>
          </div>
        )}

        <div class="briefing-doc-header-meta">
          <div class="briefing-doc-header-meta-item">
            <span class="briefing-doc-header-meta-label">Jurisdiction</span>
            <span class="briefing-doc-header-meta-value">{formatJurisdiction(law)}</span>
          </div>

          <div class="briefing-doc-header-meta-item">
            <span class="briefing-doc-header-meta-label">Enterprise Impact</span>
            <span class="briefing-doc-header-meta-value">{formatSignal(profile.enterprise_exposure_signal)}</span>
          </div>

          <div class="briefing-doc-header-meta-item">
            <span class="briefing-doc-header-meta-label">Effective / operative date</span>
            <span class="briefing-doc-header-meta-value">{compactDate(law)}</span>
          </div>
        </div>
      </div>

      {profile.primary_governance_gap && (
        <section class="briefing-primary-gap">
          <p class="briefing-eyebrow">Primary gap</p>
          <h2 class="briefing-section-title">{profile.primary_governance_gap}</h2>
        </section>
      )}

      <section class="briefing-hero briefing-hero-flat">
        <div class="briefing-question-card">
          <p class="briefing-eyebrow">Enterprise Question</p>
          <blockquote>{profile.enterprise_question}</blockquote>
        </div>
      </section>

      <main class="briefing-main">
        <section class="briefing-exposure-grid">
          <div class="briefing-exposure-column">
            <p class="briefing-exposure-kicker">Where the operating model is exposed</p>
            <h2 class="briefing-exposure-title">{profile.enterprise_verdict}</h2>

            <p class="briefing-exposure-subhead">What management may need to examine</p>
            <ol class="briefing-dash-list">
              {enterpriseSignals.map((signal) => <li>{signal}</li>)}
            </ol>
          </div>

          <div class="briefing-exposure-column">
            <p class="briefing-exposure-kicker">Where the controls may need to be visible</p>
            <h2 class="briefing-exposure-title">Control visibility questions</h2>

            <ol class="briefing-control-list">
              {enterpriseQuestions.map((question) => <li>{question}</li>)}
            </ol>
          </div>
        </section>

        {/*
          Enterprise relevance — audience matrix. Fixed copy, not data-driven: these four
          lines are the same on every report, by request. Renders unconditionally — no
          Supabase fields, no per-report variation, no visibility check.
        */}
        <section class="briefing-relevance">
          <p class="briefing-eyebrow">Who this is for</p>
          <h2 class="briefing-section-title">Enterprise relevance</h2>
          <p class="briefing-relevance-lead">
           This record helps senior leaders see whether AI adoption has{" "}
            <span class="briefing-accent-word">clear governance,</span> or whether human reviewers are 
                        carrying accountability the organization has not formally assigned.
          </p>
          <div class="briefing-relevance-grid">
            <div class="briefing-relevance-cell">
              <p class="briefing-relevance-index">01</p>
              <h3 class="briefing-relevance-role">Chief Information Officer</h3>
              <p class="briefing-relevance-focus">Model inventory, content provenance, deployment gates</p>
            </div>
            <div class="briefing-relevance-cell">
              <p class="briefing-relevance-index">02</p>
              <h3 class="briefing-relevance-role">General Counsel</h3>
              <p class="briefing-relevance-focus">Disclosure language, indemnity, contractual risk allocation</p>
            </div>
            <div class="briefing-relevance-cell">
              <p class="briefing-relevance-index">03</p>
              <h3 class="briefing-relevance-role">GRC &amp; Risk Leaders</h3>
              <p class="briefing-relevance-focus">Control mapping, evidence capture, third-party review</p>
            </div>
            <div class="briefing-relevance-cell">
              <p class="briefing-relevance-index">04</p>
              <h3 class="briefing-relevance-role">Board &amp; Audit Committee</h3>
              <p class="briefing-relevance-focus">Materiality, oversight cadence, reputational risk</p>
            </div>
          </div>
        </section>

        <section class="briefing-conclusion-flat">
          <div class="briefing-conclusion-flat-text">
            <p class="briefing-eyebrow">Next step</p>
            <h2 class="briefing-section-title">Request Governance Readiness Briefing</h2>
            <p>
              Lozen Advisory identifies where {shortDisplayName} may create operating-model exposure, unclear accountability paths, evidence gaps, or board-readiness questions.
            </p>
          </div>

          <div class="briefing-conclusion-flat-actions">
            <a class="briefing-cta-button is-primary" href={advisoryBriefingUrl}>Request advisory briefing</a>
          </div>
        </section>

        {/*
          Separate from the section above on purpose: that one is the sales CTA
          (request a briefing from Lozen Advisory), this one is pure navigation —
          file this report away and move to the next one. Neither button here is
          .is-primary; the yellow treatment is reserved for the single CTA above
          so the two sections don't compete for the same visual weight.
        */}
        <section class="briefing-conclusion-flat">
          <div class="briefing-conclusion-flat-text">
            <p class="briefing-eyebrow">Continue</p>
            <h2 class="briefing-section-title">Add {shortDisplayName} to your governance register, then close the briefing.</h2>
            <p>
              Route this record to Legal, GRC, and the CIO office. Set review for the next board meeting.
            </p>
          </div>

          <div class="briefing-conclusion-flat-actions">
            <a class="briefing-cta-button is-secondary" href={nameStandardDiagnosticUrl}>Open Name Standard&#8480; diagnostic</a>
            <a class="briefing-cta-button is-secondary" href={trackerUrl}>Close briefing</a>
          </div>
        </section>
      </main>

      <footer class="briefing-footer-note">
        <p class="briefing-body-small">
          Lozen Advisory identifies where AI legislation may reveal incomplete governance data, unclear human accountability, board-readiness gaps, or enterprise operating impact. This is not a Legal interpretation.
        </p>
      </footer>
    </div>
  </article>
</BaseLayout>
