---
import NarrativePage from "@/components/authority/NarrativePage.astro";
import { createCollectionPageJsonLd } from "@/lib/seo/jsonLd";

const title = "Speaking, Sessions, and Appearances";
const seoTitle = "Events | Lozen Advisory";
const description =
  "Lozen Advisory participates in events concerning leadership, disclosure, workforce risk, AI implementation burden, and performance protection.";
const metaDescription =
  "Speaking engagements, hosted sessions, conferences, and appearances from Lozen Advisory.";
const canonical = "https://www.lozenadvisory.com/events";

const events = [
  {
    title: "Akilah E. Kamaria at the 21st Annual LIWOCA CLE Leadership Conference",
    eyebrow: "Speaking Engagement",
    displayDate: "2026",
    context: "21st Annual LIWOCA CLE Leadership Conference",
    description:
      'Lozen Advisory founder Akilah E. Kamaria served as the sole presenter for the "Navigating Health Conditions Without Workplace Disclosure" Bold Breakout sessions at the 21st Annual LIWOCA CLE Leadership Conference.',
    href: "/events/akilah-kamaria-presenting-at-2026-liwoca-cle-conference",
    cta: "View event",
  },
];

const speakingTopics = [
  "What Women Protect When They Do Not Disclose",
  "Power Requires Privacy",
  "Leadership, disclosure, workforce risk, AI implementation burden, and performance protection",
];

const pageJsonLd = createCollectionPageJsonLd({
  title: seoTitle,
  description: metaDescription,
  href: canonical,
  items: events.map((event) => ({
    title: event.title,
    href: event.href,
    description: event.description,
  })),
  breadcrumbs: [
    { name: "Home", href: "/" },
    { name: "Events", href: "/events" },
  ],
});
const dateModified = "2026-05-19";
---

<NarrativePage
  title={title}
  seoTitle={seoTitle}
  description={description}
  metaDescription={metaDescription}
  canonical={canonical}
  eyebrow="Events"
  typeLabel="Speaking and Hosted Sessions"
  articleJsonLd={pageJsonLd}
  bottomCta={{
    label: "Speaking and Hosted Sessions",
    title: "Invite Lozen Advisory into the room.",
    description:
      "For speaking invitations, hosted sessions, conferences, panels, or private leadership conversations, contact Lozen Advisory with the event context, audience, timing, and topic.",
    href: "/contact",
    linkLabel: "Contact Lozen Advisory →",
  }}
>
  <h2>Speaking Focus</h2>

  <p>
    Akilah K. speaks to ambitious women who have already built power, reputation, and authority, and who now face a different problem: how to protect what they have amassed in systems that still require visibility before support, recognition, or risk can be recorded.
  </p>

  <p>
    Her work examines disclosure as a power decision, not a personal confession. Through Lozen Advisory, she helps women understand the professional cost of visibility, the limits of institutional support, and the private strategy required to protect performance, reputation, and career trajectory when no formal infrastructure exists for the ambition they are carrying.
  </p>

  <p>
    She speaks to women lawyers and other women in high profile careers.
  </p>

  <h2>Topics</h2>

  <ul class="lozen-event-topics">
    {speakingTopics.map((topic) => <li>{topic}</li>)}
  </ul>

  <h2>Event Record</h2>

  <div class="lozen-event-list" aria-label="Event record">
    {
      events.map((event) => (
        <article class="lozen-event-card">
          <div class="lozen-event-card__meta">
            <span>{event.eyebrow}</span>
            <strong>{event.displayDate}</strong>
          </div>

          <div class="lozen-event-card__body">
            <h3>{event.title}</h3>
            <p class="lozen-event-card__context">{event.context}</p>
            <p>{event.description}</p>
            <a href={event.href}>{event.cta} →</a>
          </div>
        </article>
      ))
    }
  </div>
</NarrativePage>

<style>
  .lozen-event-topics {
    display: grid;
    gap: 0.85rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .lozen-event-topics li {
    border-top: 1px solid var(--color-base-200);
    padding-top: 0.85rem;
    color: var(--color-base-850, var(--color-base-800));
    font-weight: 700;
    line-height: 1.55;
  }

  .lozen-event-list {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.4rem;
  }

  .lozen-event-card {
    display: grid;
    gap: 1.25rem;
    border-top: 1px solid var(--color-base-200);
    padding-top: 1.25rem;
  }

  .lozen-event-card__meta {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .lozen-event-card__meta span {
    color: var(--color-accent-700);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lozen-event-card__meta strong {
    color: var(--color-base-600);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .lozen-event-card__body h3 {
    margin: 0;
    color: var(--color-base-950);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .lozen-event-card__context {
    margin-top: 0.85rem !important;
    color: var(--color-base-500) !important;
    font-size: 0.82rem !important;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.5 !important;
    text-transform: uppercase;
  }

  .lozen-event-card a {
    display: inline-flex;
    margin-top: 0.85rem;
    color: var(--color-accent-700);
    font-weight: 800;
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent-400);
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .lozen-event-card a:hover,
  .lozen-event-card a:focus-visible {
    color: var(--color-base-950);
    border-color: var(--color-base-950);
  }

  @media (min-width: 720px) {
    .lozen-event-card {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>
