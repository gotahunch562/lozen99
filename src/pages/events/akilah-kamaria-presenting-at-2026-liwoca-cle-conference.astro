---
import NarrativePage from "@/components/authority/NarrativePage.astro";

const title = "Akilah E. Kamaria Presenting at the 2026 LIWOCA CLE Conference";
const seoTitle =
  "Akilah E. Kamaria Presenting at the 2026 LIWOCA CLE Conference | Lozen Advisory";
const description =
  "Akilah E. Kamaria presented on navigating health conditions without workplace disclosure at the LIWOCA CLE Leadership Conference in Atlanta.";
const canonical =
  "https://www.lozenadvisory.com/events/akilah-kamaria-presenting-at-2026-liwoca-cle-conference";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: "Navigating Health Conditions Without Workplace Disclosure",
  description,
  startDate: "2026-03-26",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventCompleted",
  location: {
    "@type": "Place",
    name: "Loews Atlanta Hotel",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Atlanta",
      addressRegion: "GA",
      addressCountry: "US",
    },
  },
  performer: {
    "@type": "Person",
    name: "Akilah E. Kamaria",
  },
  organizer: {
    "@type": "Organization",
    name: "Leadership Institute for Women of Color Attorneys",
    url: "https://www.liwoca.org/",
  },
  publisher: {
    "@type": "Organization",
    name: "Lozen Advisory",
    url: "https://www.lozenadvisory.com",
  },
  url: canonical,
};
---

<NarrativePage
  title={title}
  seoTitle={seoTitle}
  description={description}
  metaDescription={description}
  canonical={canonical}
  eyebrow="Speaking Engagement"
  typeLabel="Event Record"
  dateLabel="March 26, 2026"
  backHref="/events"
  backLabel="Back to Events"
  articleJsonLd={pageJsonLd}
  bottomCta={{
    label: "Speaking and Hosted Sessions",
    title: "Invite Lozen Advisory into the room.",
    description:
      "For speaking invitations, hosted sessions, conferences, panels, or private leadership conversations, contact Lozen Advisory with the event context, audience, timing, and topic.",
    href: "/contact",
    linkLabel: "Contact Lozen Advisory →",
  }}
>
  <h2>Navigating Health Conditions Without Workplace Disclosure</h2>

  <dl class="lozen-event-facts" aria-label="Event details">
    <div>
      <dt>Conference</dt>
      <dd>21st Annual Leadership Institute for Women of Color Attorneys CLE Leadership Conference</dd>
    </div>

    <div>
      <dt>Date</dt>
      <dd>March 26, 2026</dd>
    </div>

    <div>
      <dt>Location</dt>
      <dd>Loews Atlanta Hotel</dd>
    </div>
  </dl>

  <p>
    Lozen Advisory founder Akilah E. Kamaria served as the sole presenter for the <em>“Navigating Health Conditions Without Workplace Disclosure”</em> Bold Breakout sessions at the 21st Annual Leadership Institute for Women of Color Attorneys CLE Leadership Conference, held March 26, 2026 at the Loews Atlanta Hotel.
  </p>

  <p>
    The session ran twice during the conference agenda, offered in both a group format and as private one-on-one advising sessions. Both required advance registration, reflecting the confidential nature of the conversation.
  </p>

  <p>
    The session addressed workplace disclosure decisions facing women attorneys at the senior level, including the professional calculus involved when disclosure of a health transition carries career risk. Drawing on the Tacere framework and the Disclosure-Independent Performance Protection℠ methodology developed through Lozen Advisory, the session gave women in the legal profession a private space to examine their own situations and identify strategies that protect professional continuity without requiring organizational disclosure.
  </p>

  <p>
    The 2026 LIWOCA conference was held under the theme <em>“Bold Steps, New Horizons”</em> and offered 8.5 CLE credits including 2 professionalism and 1 ethics credit.
  </p>

  <h2>Session Focus</h2>

  <p>
    Disclosure-Independent Strategy for Women Attorneys
  </p>

  <p>
    A private advisory session on professional continuity, workplace disclosure risk, and career protection when a health transition cannot be safely named inside the workplace.
  </p>

  <p>
    <a href="https://www.liwoca.org/" target="_blank" rel="noopener noreferrer">Learn more about LIWOCA</a>
  </p>
</NarrativePage>

<style>
  .lozen-event-facts {
    display: grid;
    gap: 1px;
    overflow: hidden;
    margin: 1.5rem 0 2rem;
    border: 1px solid var(--color-base-200);
    border-radius: 1.15rem;
    background: var(--color-base-200);
  }

  .lozen-event-facts div {
    background: #ffffff;
    padding: 1rem;
  }

  .lozen-event-facts dt {
    color: var(--color-accent-700);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lozen-event-facts dd {
    margin: 0.4rem 0 0;
    color: var(--color-base-750, var(--color-base-700));
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (min-width: 720px) {
    .lozen-event-facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
