---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const title = "Akilah E. Kamaria Presenting at the 2026 LIWOCA CLE Conference | Lozen Advisory";

const description = "Akilah E. Kamaria presented on navigating health conditions without workplace disclosure at the LIWOCA CLE Leadership Conference in Atlanta.";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: "Navigating Health Conditions Without Workplace Disclosure",
  description,
  startDate: "2026-03-26",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventCompleted",
  location: {
    "@type": "Place",
    name: "Loews Atlanta Hotel",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Atlanta",
      addressRegion: "GA",
      addressCountry: "US",
    },
  },
  performer: {
    "@type": "Person",
    name: "Akilah E. Kamaria",
  },
  organizer: {
    "@type": "Organization",
    name: "Leadership Institute for Women of Color Attorneys",
    url: "https://www.liwoca.org/",
  },
  publisher: {
    "@type": "Organization",
    name: "Lozen Advisory",
    url: "https://www.lozenadvisory.com",
  },
  url: "https://www.lozenadvisory.com/events/akilah-kamaria-presenting-at-2026-liwoca-cle-conference",
};
---

<BaseLayout title={title} description={description}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(pageJsonLd)}
  ></script>

  <section class="bg-gradient-to-t from-base-200 to-white">
    <Wrapper variant="standard" class="py-24 lg:py-32">
      <div class="max-w-5xl">
        <Text
          tag="span"
          variant="textSM"
          class="pl-4 font-medium uppercase border-l text-base-900 font-display border-accent-500"
        >
          Speaking Engagement
        </Text>

        <Text
          tag="h1"
          variant="displayXL"
          class="mt-8 uppercase font-display text-base-900"
        >
          {title}
        </Text>

        <Text
          tag="p"
          variant="displayXS"
          class="mt-6 max-w-3xl font-display italic text-base-600 text-balance"
        >
          Navigating Health Conditions Without Workplace Disclosure
        </Text>

        <div class="mt-10 grid gap-px overflow-hidden rounded-3xl border border-base-200 bg-base-200 md:grid-cols-3">
          <article class="bg-white p-6">
            <Text
              tag="span"
              variant="textXS"
              class="font-medium uppercase tracking-wide text-accent-600"
            >
              Conference
            </Text>
            <Text tag="p" variant="textSM" class="mt-3 text-base-700">
              21st Annual Leadership Institute for Women of Color Attorneys CLE Leadership Conference
            </Text>
          </article>

          <article class="bg-white p-6">
            <Text
              tag="span"
              variant="textXS"
              class="font-medium uppercase tracking-wide text-accent-600"
            >
              Date
            </Text>
            <Text tag="p" variant="textSM" class="mt-3 text-base-700">
              March 26, 2026
            </Text>
          </article>

          <article class="bg-white p-6">
            <Text
              tag="span"
              variant="textXS"
              class="font-medium uppercase tracking-wide text-accent-600"
            >
              Location
            </Text>
            <Text tag="p" variant="textSM" class="mt-3 text-base-700">
              Loews Atlanta Hotel
            </Text>
          </article>
        </div>
      </div>
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="standard" class="py-12 lg:py-20">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,0.3fr)] lg:items-start">
        <article class="max-w-3xl space-y-6">
          <Text tag="p" variant="textBase" class="text-base-700">
            Lozen Advisory founder Akilah E. Kamaria served as the sole presenter for the <em>“Navigating Health Conditions Without Workplace Disclosure”</em> Bold Breakout sessions at the 21st Annual Leadership Institute for Women of Color Attorneys CLE Leadership Conference, held March 26, 2026 at the Loews Atlanta Hotel.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            The session ran twice during the conference agenda, offered in both a group format and as private one-on-one advising sessions. Both required advance registration, reflecting the confidential nature of the conversation.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            The session addressed workplace disclosure decisions facing women attorneys at the senior level, including the professional calculus involved when disclosure of a health transition carries career risk. Drawing on the Tacere framework and the Disclosure-Independent Performance Protection℠ methodology developed through Lozen Advisory, the session gave women in the legal profession a private space to examine their own situations and identify strategies that protect professional continuity without requiring organizational disclosure.
          </Text>

          <Text tag="p" variant="textBase" class="text-base-700">
            The 2026 LIWOCA conference was held under the theme <em>“Bold Steps, New Horizons”</em> and offered 8.5 CLE credits including 2 professionalism and 1 ethics credit.
          </Text>

          <div class="pt-4">
            <Button
              isLink
              href="https://www.liwoca.org/"
              target="_blank"
              rel="noopener noreferrer"
              variant="default"
              size="sm"
              class="w-fit"
            >
              Learn more about LIWOCA
            </Button>
          </div>
        </article>

        <aside class="rounded-3xl border border-base-200 bg-base-950 p-6 shadow-2xl outline-4 outline-base-500/10 sm:p-8 lg:sticky lg:top-32">
          <Text
            tag="span"
            variant="textSM"
            class="font-medium uppercase tracking-wide text-accent-300"
          >
            Session Focus
          </Text>

          <Text
            tag="h2"
            variant="displaySM"
            class="mt-5 font-display uppercase text-white"
          >
            Disclosure-Independent Strategy for Women Attorneys
          </Text>

          <Text tag="p" variant="textBase" class="mt-5 text-base-200">
            A private advisory session on professional continuity, workplace disclosure risk, and career protection when a health transition cannot be safely named inside the workplace.
          </Text>
        </aside>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
