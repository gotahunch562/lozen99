  },
];

const articleJsonLd: JsonLdObject[] = [
  createDefinedTermSetJsonLd({
    name: "Committee Ownership Map by Lozen Advisory",
    description,
    href: "/frameworks/committee-ownership-map/",
    id: termSetId,
    terms: terms.map((term) => ({
      ...term,
      termId: term.href.includes("#")
        ? new URL(term.href, canonicalUrl).toString()
        : `${new URL(term.href, canonicalUrl).toString()}#term`,
    })),
  }),
  ...terms.map((term) =>
    createDefinedTermJsonLd({
      name: term.name,
      description: term.description,
      href: term.href,
      termId: term.href.includes("#")
        ? new URL(term.href, canonicalUrl).toString()
        : `${new URL(term.href, canonicalUrl).toString()}#term`,
      termSetId,
      keywords: [
        "Committee Ownership Map",
        "Lozen Advisory",
        "board AI governance",
        "Disclosure-Independent Governance℠",
        "human accountability",
        "board evidence",
        "AI governance",
      ],
    }),
  ),
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${canonicalUrl}#webpage`,
    name: pageTitle,
    headline: pageTitle,
    description,
    url: canonicalUrl,
    datePublished,
    dateModified,
    author: {
      "@type": "Person",
      name: "Akilah E. Kamaria",
    },
    creator: {
      "@id": "https://www.lozenadvisory.com/#organization",
    },
    publisher: {
      "@id": "https://www.lozenadvisory.com/#organization",
    },
    about: {
      "@id": termSetId,
    },
    mainEntity: {
      "@id": termSetId,
    },
