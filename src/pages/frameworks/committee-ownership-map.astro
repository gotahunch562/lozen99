const datePublished = "2026-07-04";
const dateModified = "2026-07-14";

const termSetId = `${canonicalUrl}#defined-term-set`;

const terms = [
  {
    name: "Committee Ownership Map",
    href: "/frameworks/committee-ownership-map/",
    description:
      "Lozen Advisory's framework assigning each board committee a Disclosure-Independent Governance℠ question and the specific evidentiary record it must be able to produce if that oversight is challenged. Ownership without producible evidence is not governance. It is exposure with a committee name attached to it.",
