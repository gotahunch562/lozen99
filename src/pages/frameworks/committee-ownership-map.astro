  {
    name: "The Name Standard℠",
    href: "/blog/the-name-standard-ai-governance/",
    description:
      "Lozen Advisory's human-attribution standard for determining whether AI-assisted decisions remain traceable to a responsible human or institutional actor.",
  },
  {
    name: "The 5Ws of Decision Integrity℠",
    href: "/disclosure-independent-governance/#5ws-decision-integrity",
    description:
      "Lozen Advisory's board-level diagnostic for evaluating AI-assisted decisions through five evidence standards: What, Who, Which, What was missed, and Witness.",
