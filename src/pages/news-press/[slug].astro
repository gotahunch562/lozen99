---
import { getCollection } from "astro:content";
import PressReleasePage from "@/components/press/PressReleasePage.astro";

export async function getStaticPaths() {
  const releases = await getCollection("news");

  return releases.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const canonical = new URL(`/news-press/${entry.slug}/`, Astro.site).href;

const publishedDateIso = entry.data.pubDate.toISOString();

const publishedDate = entry.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<PressReleasePage
  title={entry.data.title}
  description={entry.data.description}
  metaDescription={entry.data.metaDescription}
  canonical={canonical}
  image={entry.data.image}
  imageAlt={entry.data.imageAlt}
  imageCaption={entry.data.imageCaption}
  publishedDate={publishedDate}
  publishedDateIso={publishedDateIso}
  releaseLabel={entry.data.releaseLabel}
  category={entry.data.category}
>
  <Content />
</PressReleasePage>
