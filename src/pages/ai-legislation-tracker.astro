---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AILegislationWorkflow from "@/components/ai-tracker/AILegislationWorkflow.jsx";

const title = "Governance Maps:AI LegiRisk | Lozen Advisory";
const description =
  "Tracking AI legislation, accountability signals, and governance exposure for Board of Directors. Strengthen your impact in the boardroom.";
---

<BaseLayout title={title} description={description} hideNavigation={true}>
  <main class="bg-base-50 text-base-950">
    <section class="bg-[#0b2e33] text-white">
     <div class="mx-auto max-w-7xl px-4 pb-28 pt-24 sm:px-6 sm:pb-32 sm:pt-28 lg:px-8 lg:pb-40 lg:pt-32 xl:pb-44">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(320px,0.46fr)] lg:items-center">
          <div>
            <p class="border-l-2 border-[#f2d300] pl-4 font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-[#9fd8dd]">
             The Name Standard℠ Governance Maps
            </p>

           <h1 class="mt-6 max-w-4xl lozen-type-page-title text-white">
              Has your board built oversight for AI —<br />
              or just assumed the old processes cover it?
            </h1>

            <p class="mt-6 max-w-4xl font-sans text-base leading-7 text-[#cfe8ea] sm:text-[1.0625rem] sm:leading-8">
              Most AI rules name an entity: a provider, sponsor, agency, or covered organization — not a person.
            </p>

            <p class="mt-5 max-w-4xl font-sans text-base leading-7 text-[#cfe8ea] sm:text-[1.0625rem] sm:leading-8">
              Can management identify the person whose name is already on every AI-assisted decision — the one who would have to answer for it?
            </p>

            <p class="mt-5 max-w-4xl font-sans text-base leading-7 text-[#cfe8ea] sm:text-[1.0625rem] sm:leading-8">
              The Name Standard℠ tests whether that person actually exists.
            </p>
          </div>

         <aside class="border-2 border-[#f2d300] bg-[#f2d300] p-6 shadow-2xl lg:p-7">
            <p class="border-l-2 border-[#0b2e33] pl-4 font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-[#3a2f00]">
              Nasdaq Governance Pulse
            </p>

            <div class="mt-5 border-2 border-[#0b2e33] bg-[#0b2e33] p-5">
              <p class="font-display text-[3.75rem] font-normal leading-none tracking-[-0.045em] text-[#a7a9ff] sm:text-[4.5rem]">
                Nearly 20%
              </p>

              <p class="mt-4 font-sans text-sm leading-6 text-white">
                of surveyed organizations say AI is not being discussed at the board level.
              </p>
            </div>

            <p class="mt-5 font-sans text-xs leading-5 text-[#3a2f00]">
              Source: Nasdaq, 3rd Annual Global Governance Pulse. AI LegiRisk is a Lozen Advisory GRC diagnostic. It is not legal advice.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <section class="bg-base-100">
      <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 sm:pb-16 lg:px-8">
        <div class="mb-6 max-w-3xl">
          <h2 class="font-display text-[2rem] font-normal uppercase leading-[1.05] tracking-[-0.035em] text-base-950 sm:text-[2.55rem]">
            Governance reports
          </h2>

          <p class="mt-4 font-sans text-base leading-7 text-base-700">
            The tracker organizes AI legislation through three report pathways:
            board visibility, Name Standard℠ accountability, and enterprise operating burden.
          </p>
        </div>

        <div class="grid gap-5 lg:grid-cols-3">
          <article class="overflow-hidden rounded-2xl border border-base-300 bg-white shadow-xl ring-1 ring-base-950/5">
            <div class="bg-[#f2d300] px-6 py-5">
              <p class="font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-[#3a2f00]">
                Report pathway
              </p>
              <h3 class="mt-2 font-display text-[1.7rem] font-normal uppercase leading-[1.05] tracking-[-0.03em] text-[#3a2f00]">
                Board Executive Briefing
              </h3>
            </div>
            <p class="px-6 py-5 font-sans text-sm leading-6 text-base-700">
              Frames what directors should be prepared to see, ask, and evidence when AI rules create governance exposure.
            </p>
          </article>

          <article class="overflow-hidden rounded-2xl border border-base-300 bg-white shadow-xl ring-1 ring-base-950/5">
            <div class="bg-[#1497a3] px-6 py-5">
              <p class="font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-[#d8f3f5]">
                Report pathway
              </p>
              <h3 class="mt-2 font-display text-[1.7rem] font-normal uppercase leading-[1.05] tracking-[-0.03em] text-white">
                Name Standard℠ Diagnostic
              </h3>
            </div>
            <p class="px-6 py-5 font-sans text-sm leading-6 text-base-700">
              Evaluates whether the rule creates real individual accountability or only procedural oversight.
            </p>
          </article>

          <article class="overflow-hidden rounded-2xl border border-base-300 bg-white shadow-xl ring-1 ring-base-950/5">
            <div class="bg-[#a7a9ff] px-6 py-5">
              <p class="font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-[#2a2b6b]">
                Report pathway
              </p>
              <h3 class="mt-2 font-display text-[1.7rem] font-normal uppercase leading-[1.05] tracking-[-0.03em] text-[#2a2b6b]">
                Enterprise Governance Analysis
              </h3>
            </div>
            <p class="px-6 py-5 font-sans text-sm leading-6 text-base-700">
              Maps the operating burden behind AI governance, documentation, review, and implementation.
            </p>
          </article>
        </div>

      <div class="mt-8 rounded-2xl border border-[#f2d300]/70 bg-[#0b2e33] p-6 shadow-xl ring-1 ring-[#f2d300]/25 sm:p-10">
          <img
          src="/images/lozen-name-standard-illustration-v4.svg"
          alt="The Name Standard℠ architecture."
          class="mx-auto block w-full max-w-5xl"
          loading="lazy"
            />
      </div>
    
    </section>

    <section class="bg-[#eeeeff]">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <div class="mb-6 max-w-3xl">
          <p class="border-l-2 border-[#a7a9ff] pl-4 font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-[#5b5dc4]">
            Public accountability signal
          </p>
          <h2 class="mt-3 font-display text-[2rem] font-normal uppercase leading-[1.05] tracking-[-0.035em] text-[#2a2b6b] sm:text-[2.55rem]">
            Name Standard℠ governance maps
          </h2>

          <p class="mt-4 font-sans text-base leading-7 text-[#3f4080]">
            Toggle between the United States and global views to see how selected AI
            laws and policy frameworks are categorized by public accountability signal.
          </p>
        </div>

        <div
          class="overflow-hidden rounded-2xl border border-[#a7a9ff] bg-white shadow-xl"
          data-map-tabs
        >
          <div
            class="flex bg-[#2a2b6b]"
            role="tablist"
            aria-label="AI LegiRisk map views"
          >
            <button
              class="map-tab-button is-active flex-1 border-r border-white/10 px-5 py-4 font-sans text-sm font-semibold uppercase tracking-[0.12em] text-white sm:flex-none"
              type="button"
              role="tab"
              id="map-tab-us"
              aria-controls="map-panel-us"
              aria-selected="true"
              data-map-tab="us"
            >
              United States
            </button>

            <button
              class="map-tab-button flex-1 border-r border-white/10 px-5 py-4 font-sans text-sm font-semibold uppercase tracking-[0.12em] text-[#b3b4e6] sm:flex-none"
              type="button"
              role="tab"
              id="map-tab-global"
              aria-controls="map-panel-global"
              aria-selected="false"
              data-map-tab="global"
            >
              Global
            </button>
          </div>

          <div
            class="map-tab-panel bg-white"
            role="tabpanel"
            id="map-panel-us"
            aria-labelledby="map-tab-us"
            data-map-panel="us"
          >
            <div style="min-height:527px" id="datawrapper-vis-UDISR">
              <script
                type="text/javascript"
                defer
                src="https://datawrapper.dwcdn.net/UDISR/embed.js"
                charset="utf-8"
                data-target="#datawrapper-vis-UDISR"
              ></script>

              <noscript>
                <img
                  src="https://datawrapper.dwcdn.net/UDISR/full.png"
                  alt="A choropleth map of the United States evaluating state-level AI legislation against The Name Standard℠ framework. The map categories states into tiers based on human accountability requirements."
                />
              </noscript>
            </div>
          </div>

          <div
            class="map-tab-panel bg-white"
            role="tabpanel"
            id="map-panel-global"
            aria-labelledby="map-tab-global"
            data-map-panel="global"
            hidden
          >
            <iframe
              title="The Name Standard℠ AI LegiRisk Global Accountability"
              aria-label="Choropleth map"
              id="datawrapper-chart-Arwef"
              src="https://datawrapper.dwcdn.net/Arwef/2/"
              scrolling="no"
              frameborder="0"
              width="100%"
              height="477"
              data-external="1"
              class="block w-full border-0"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-base-100">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <div class="mb-6 max-w-3xl">
          <h2 class="font-display text-[2rem] font-normal uppercase leading-[1.05] tracking-[-0.035em] text-base-950 sm:text-[2.55rem]">
            AI legislation index
          </h2>

          <p class="mt-4 font-sans text-base leading-7 text-base-700">
            Review selected AI laws and policy frameworks by rule name, region, status,
            sector scope, Name Standard℠ signal, live date, and source.
          </p>
        </div>

        <div class="overflow-hidden rounded-2xl border border-base-300 bg-white shadow-xl ring-1 ring-base-950/5 lg:rounded-3xl">
          <AILegislationWorkflow client:load />
        </div>
      </div>
    </section>

<section class="bg-[#f2d300]">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(280px,0.42fr)] lg:items-end">
      <div>
        <p class="border-l-2 border-[#3a2f00] pl-4 font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-[#3a2f00]">
          Governance readiness
        </p>

        <h2 class="mt-4 max-w-3xl font-sans text-base font-medium leading-7 tracking-normal text-[#1a1500] sm:text-lg sm:leading-8">
          Does your team possess the explicit capacity, information, and formal right of refusal to legally and professionally sign off on AI-assisted corporate output?
        </h2>
      </div>

      <div class="lg:text-right">
        <a
          class="inline-flex items-center justify-center rounded-full border-2 border-[#1a1500] bg-[#1a1500] px-6 py-3.5 font-sans text-sm font-semibold text-[#f2d300] shadow-sm transition hover:bg-[#0b2e33]"
          href="/ai-workforce-materiality-briefing/"
        >
          Request governance readiness briefing
        </a>
      </div>
    </div>
  </div>
</section>
</main>
</BaseLayout>

<script>
  const mapTabGroups = document.querySelectorAll("[data-map-tabs]");

  mapTabGroups.forEach((group) => {
    const tabs = group.querySelectorAll("[data-map-tab]");
    const panels = group.querySelectorAll("[data-map-panel]");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const selected = tab.getAttribute("data-map-tab");

        tabs.forEach((currentTab) => {
          const isSelected = currentTab === tab;
          currentTab.classList.toggle("is-active", isSelected);
          currentTab.setAttribute("aria-selected", String(isSelected));

          if (isSelected) {
            currentTab.classList.remove("text-[#b3b4e6]");
            currentTab.classList.add("text-white");
          } else {
            currentTab.classList.remove("text-white");
            currentTab.classList.add("text-[#b3b4e6]");
          }
        });

        panels.forEach((panel) => {
          const isSelected = panel.getAttribute("data-map-panel") === selected;
          panel.toggleAttribute("hidden", !isSelected);
        });
      });
    });
  });
</script>

<style>
  .map-tab-button {
    background: transparent;
  }

  .map-tab-button.is-active,
  .map-tab-button:hover {
    background: #1f2080;
  }

  #datawrapper-vis-UDISR img {
    display: block;
    width: 100%;
    height: auto;
    border: 0;
  }
</style>
