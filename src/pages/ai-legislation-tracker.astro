---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AILegislationWorkflow from "@/components/ai-tracker/AILegislationWorkflow.jsx";
import { createDatasetJsonLd } from "@/lib/seo/jsonLd";

const title = "AI Legislation Tracker for Corporate Boards| Lozen Advisory";
const description =
  "Track AI legislation, human accountability architecture, and governance risks. Empower your corporate board with data to protect reputational and boardroom impact.";

const pageDates = {
  datePublished: "2026-06-23",
  dateModified: "2026-06-23",
};

const trackerJsonLd = createDatasetJsonLd({
  name: title,
  description,
  href: "/ai-legislation-tracker/",
  datePublished: pageDates.datePublished,
  dateModified: pageDates.dateModified,
  creatorName: "Lozen Advisory LLC",
  keywords: [
    "AI legislation",
    "AI governance",
    "AI accountability",
    "AI LegiRisk",
    "Name Standard",
    "board governance",
    "human attribution",
    "enterprise AI risk",
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  canonical="/ai-legislation-tracker/"
  dateModified={pageDates.dateModified}
  jsonLd={trackerJsonLd}
>
  <main class="bg-base-50 text-base-950">
    <section class="lozen-tracker-hero min-h-[800px]">
      <div class="mx-auto max-w-7xl px-4 pt-40 pb-16 sm:px-6 sm:pt-44 sm:pb-20 lg:px-8 lg:pt-48 lg:pb-24">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(300px,0.5fr)] lg:items-center lg:gap-12">
          <div class="max-w-4xl">
            <p class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-700">
            Name Standard℠ Governance Map
            </p>

<h1 class="lozen-ai-tracker-hero-title mt-6 max-w-4xl font-display font-normal uppercase text-base-950 sm:mt-8">
  Has your board built oversight for AI?
</h1>

<div class="mt-7 max-w-3xl font-sans text-lg leading-8 text-base-700 sm:mt-8 sm:text-xl sm:leading-9 space-y-4">
  <p>Or just assumed the old processes cover it?</p>

  <p>
    Boards may think they are funding AI capability. In practice, they may be funding dependency.
    Most AI rules name an entity: a provider, sponsor, agency, or covered organization — not a person.
  </p>

  <p>
    Can management identify the person whose name is already on every AI-assisted decision — the
    one who would have to answer for it?
  </p>

  <p class="font-semibold">
    The Name Standard℠ tests whether that person actually exists.
  </p>
</div>

            <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 lg:mt-12">
              <a
              href="#legislation-index"
               class="lozen-btn-bevel-yellow inline-flex items-center justify-center rounded-none px-6 py-3 font-sans text-sm font-semibold text-lozen-blue-950 transition"
                >
               Explore the legislation index
              </a>

             <a href="/ai-workforce-materiality-briefing/" class="font-sans text-sm font-semibold text-[#f2d300] underline-offset-4 hover:text-white hover:underline">
              
                Request a governance briefing →
              </a>
            </div>
          </div>

          <aside class="lozen-tracker-insight-card p-5 sm:p-6 lg:rounded-3xl">
            <div
              aria-hidden="true"
              class="absolute inset-x-0 top-0 h-1 bg-accent-500"
            >
            </div>

            <p class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500">
              Nasdaq Governance Pulse
            </p>

            <p class="mt-5 font-display text-[4.5rem] font-normal leading-none tracking-[-0.06em] text-base-950 sm:text-[5.5rem] lg:text-[6rem]">
              20%
            </p>

            <p class="mt-4 font-sans text-sm leading-6 text-base-700">
              Nearly 20% of surveyed organizations say AI is not being discussed at the board level.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <section class="bg-base-100">
      <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 sm:pb-16 lg:px-8">
        <div class="mb-6 max-w-3xl">
          <h2 class="font-display text-[2rem] font-normal uppercase leading-[1.05] tracking-[-0.035em] text-base-950 sm:text-[2.55rem]">
            Board Governance Blueprints
          </h2>

          <p class="mt-4 font-sans text-base leading-7 text-base-700">
            Get instant visibility into AI compliance. Our three targeted toolkits break down pending legislation by board visibility, Name Standard℠ accountability, and enterprise operating burden.
          </p>
        </div>

        <div class="grid gap-5 lg:grid-cols-3">
          <article class="overflow-hidden rounded-2xl border border-base-300 bg-white p-6 shadow-xl ring-1 ring-base-950/5 sm:p-7">
            <p class="border-l-2 border-[#f2d300] pl-4 font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-[#857400]">
              Report pathway
            </p>
            <h3 class="mt-3 font-display text-[1.7rem] font-normal uppercase leading-[1.05] tracking-[-0.03em] text-lozen-blue-950">
              Board Executive Briefing
            </h3>
            <p class="mt-4 font-sans text-sm leading-6 text-base-700">
              Monitor AI regulatory exposure and compliance liabilities. Ground your corporate board decisions in independent workforce and governance risk analysis.
            </p>
          </article>

          <article class="overflow-hidden rounded-2xl border border-base-300 bg-white p-6 shadow-xl ring-1 ring-base-950/5 sm:p-7">
            <p class="border-l-2 border-[#f2d300] pl-4 font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-[#857400]">
              Report pathway
            </p>
            <h3 class="mt-3 font-display text-[1.7rem] font-normal uppercase leading-[1.05] tracking-[-0.03em] text-lozen-blue-950">
              Name Standard℠ Diagnostic
            </h3>
            <p class="mt-4 font-sans text-sm leading-6 text-base-700">
              Measures whether a rule exposes leaders to personal liability or simply mandates procedural compliance.
            </p>
          </article>

          <article class="overflow-hidden rounded-2xl border border-base-300 bg-white p-6 shadow-xl ring-1 ring-base-950/5 sm:p-7">
            <p class="border-l-2 border-[#f2d300] pl-4 font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-[#857400]">
              Report pathway
            </p>
            <h3 class="mt-3 font-display text-[1.7rem] font-normal uppercase leading-[1.05] tracking-[-0.03em] text-lozen-blue-950">
              Enterprise Governance Analysis
            </h3>
            <p class="mt-4 font-sans text-sm leading-6 text-base-700">
              Audit AI legislation, liability exposures, and accountability signals. Strengthen executive oversight and safeguard your company in the boardroom.
            </p>
          </article>
        </div>

        <div class="mx-auto mt-8 max-w-3xl rounded-xl bg-lozen-blue-950 p-4 shadow-lg ring-1 ring-white/10 sm:p-6">
          <img
            src="/images/name_standard_five_pillars_brand.avif"
            alt="The Name Standard℠ architecture."
            class="block h-auto w-full"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="bg-base-50">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <div class="mb-6 max-w-3xl">
          <p class="border-l-2 border-[#f2d300] pl-4 font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-[#857400]">
            Name Standard℠ Signal: Human attribution
          </p>
          <h2 class="mt-3 font-display text-[2rem] font-normal uppercase leading-[1.05] tracking-[-0.035em] text-lozen-blue-950 sm:text-[2.55rem]">
            Name Standard℠ Map
          </h2>

          <p class="mt-4 font-sans text-base leading-7 text-base-700">
            Toggle between USA and global views to see AI
            laws and policy frameworks categorized.
          </p>
        </div>

        <div
          class="overflow-hidden rounded-2xl border border-base-300 bg-white shadow-xl ring-1 ring-base-950/5"
          data-map-tabs
        >
          <div
            class="flex bg-lozen-blue-950"
            role="tablist"
            aria-label="AI LegiRisk map views"
          >
            <button
              class="map-tab-button is-active flex-1 border-r border-white/10 px-5 py-4 font-sans text-sm font-semibold uppercase tracking-[0.12em] text-white sm:flex-none"
              type="button"
              role="tab"
              id="map-tab-us"
              aria-controls="map-panel-us"
              aria-selected="true"
              data-map-tab="us"
            >
              United States
            </button>

            <button
              class="map-tab-button flex-1 border-r border-white/10 px-5 py-4 font-sans text-sm font-semibold uppercase tracking-[0.12em] text-base-300 sm:flex-none"
              type="button"
              role="tab"
              id="map-tab-global"
              aria-controls="map-panel-global"
              aria-selected="false"
              data-map-tab="global"
            >
              Global
            </button>
          </div>

<div
  class="map-tab-panel bg-white"
  role="tabpanel"
  id="map-panel-us"
  aria-labelledby="map-tab-us"
  data-map-panel="us"
>
  <div style="min-height:527px" id="datawrapper-vis-UDISR">
    <script
      type="text/javascript"
      defer
      src="https://datawrapper.dwcdn.net/UDISR/embed.js"
      charset="utf-8"
      data-target="#datawrapper-vis-UDISR"
    ></script>

    <noscript>
      <img
        src="https://datawrapper.dwcdn.net/UDISR/full.png"
        alt="A choropleth map of the United States evaluating state-level AI legislation against The Name Standard℠ framework. The map categories states into tiers based on human accountability requirements."
      />
    </noscript>
  </div>
</div>

          <div
            class="map-tab-panel min-h-[477px] bg-white"
            role="tabpanel"
            id="map-panel-global"
            aria-labelledby="map-tab-global"
            data-map-panel="global"
            hidden
          >
            <iframe
              title="The Name Standard℠ AI LegiRisk Global"
              aria-label="Choropleth map"
              id="datawrapper-chart-Arwef"
              data-src="https://datawrapper.dwcdn.net/Arwef/2/"
              scrolling="no"
              frameborder="0"
              width="100%"
              height="477"
              data-external="1"
              class="block w-full border-0"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <section id="legislation-index" class="bg-base-100">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <div class="mb-6 max-w-3xl">
          <h2 class="font-display text-[2rem] font-normal uppercase leading-[1.05] tracking-[-0.035em] text-base-950 sm:text-[2.55rem]">
            AI legislation index
          </h2>

          <p class="mt-4 font-sans text-base leading-7 text-base-700">
            Review selected AI laws and policy frameworks by rule name, region, status,
            sector scope, Name Standard℠ signal, live date, and source.
          </p>
        </div>

        <div class="overflow-hidden rounded-2xl border border-base-300 bg-white shadow-xl ring-1 ring-base-950/5 lg:rounded-3xl">
          <AILegislationWorkflow client:load />
        </div>
      </div>
    </section>

    <section class="bg-[#f2d300]">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(280px,0.42fr)] lg:items-end">
          <div>
            <p class="border-l-2 border-lozen-blue-950 pl-4 font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-lozen-blue-950">
              Governance readiness
            </p>

            <h2 class="mt-4 max-w-3xl font-sans text-base font-medium leading-7 tracking-normal text-lozen-blue-950 sm:text-lg sm:leading-8">
              Does your team possess the explicit capacity, information, and formal right of refusal to legally and professionally sign off on AI-assisted corporate output?
            </h2>
          </div>

          <div class="lg:text-right">
            <a
              class="lozen-btn-bevel-navy inline-flex items-center justify-center rounded-full px-6 py-3.5 font-sans text-sm font-semibold text-[#f2d300] transition"
              href="/ai-workforce-materiality-briefing/"
            >
              Request governance readiness briefing
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const mapTabGroups = document.querySelectorAll("[data-map-tabs]");

  mapTabGroups.forEach((group) => {
    const tabs = group.querySelectorAll("[data-map-tab]");
    const panels = group.querySelectorAll("[data-map-panel]");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const selected = tab.getAttribute("data-map-tab");

        tabs.forEach((currentTab) => {
          const isSelected = currentTab === tab;
          currentTab.classList.toggle("is-active", isSelected);
          currentTab.setAttribute("aria-selected", String(isSelected));

          if (isSelected) {
            currentTab.classList.remove("text-base-300");
            currentTab.classList.add("text-white");
          } else {
            currentTab.classList.remove("text-white");
            currentTab.classList.add("text-base-300");
          }
        });

        panels.forEach((panel) => {
          const isSelected = panel.getAttribute("data-map-panel") === selected;
          panel.toggleAttribute("hidden", !isSelected);

          if (isSelected) {
            const iframe = panel.querySelector("iframe[data-src]");

            if (iframe && !iframe.getAttribute("src")) {
              iframe.setAttribute("src", iframe.getAttribute("data-src"));
            }

            window.dispatchEvent(new Event("resize"));
          }
        });
      });
    });
  });
</script>

<style>
  .lozen-ai-tracker-hero-title {
    font-size: clamp(2.25rem, 3.4vw, 3rem);
    letter-spacing: -0.025em;
    line-height: 1.08;
    text-wrap: balance;
  }

  @media (min-width: 1280px) {
    .lozen-ai-tracker-hero-title {
      font-size: clamp(2.75rem, 3.3vw, 3.15rem);
    }
  }

  @media (max-width: 768px) {
    .lozen-ai-tracker-hero-title {
      font-size: clamp(2.25rem, 10vw, 3rem);
      line-height: 1.06;
    }
  }

  .map-tab-button {
    background: transparent;
  }

  .map-tab-button.is-active,
  .map-tab-button:hover {
    background: var(--color-lozen-blue-800);
  }

  #datawrapper-vis-UDISR img {
    display: block;
    width: 100%;
    height: auto;
    border: 0;
  }

  /* Beveled CTA buttons: a top-to-bottom gradient plus an inset top
     highlight, inset bottom shadow, and soft outer drop shadow — gives
     the button real edge/depth instead of a flat color fill. */
  .lozen-btn-bevel-yellow {
    background: linear-gradient(180deg, #f4da26 0%, #f2d300 55%, #ceb300 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 -2px 1px rgba(0, 0, 0, 0.12),
      0 2px 4px rgba(6, 23, 47, 0.25);
  }

  .lozen-btn-bevel-yellow:hover {
    background: linear-gradient(180deg, #f7e158 0%, #f4da26 55%, #d9bc00 100%);
  }

  .lozen-btn-bevel-navy {
    background: linear-gradient(180deg, var(--color-lozen-blue-900) 0%, var(--color-lozen-blue-950) 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 -2px 1px rgba(0, 0, 0, 0.35),
      0 2px 4px rgba(6, 23, 47, 0.35);
  }

  .lozen-btn-bevel-navy:hover {
    background: linear-gradient(180deg, var(--color-lozen-blue-800) 0%, var(--color-lozen-blue-900) 100%);
  }

  /* Hero stat figure: true brand yellow (#f2d300) as the fill, not a
     darkened version of it — darkening shifts the hue toward gold/olive,
     which is exactly what we don't want. A thin navy outline (via
     text-shadow, so it works without -webkit-text-stroke support) gives
     it definition against the white card instead of dimming the color. */
  .lozen-stat-figure {
    font-family: var(--font-display);
    font-size: clamp(3rem, 5.5vw, 4.5rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: #f2d300;
    text-shadow:
      -1.5px -1.5px 0 var(--color-lozen-blue-950),
       1.5px -1.5px 0 var(--color-lozen-blue-950),
      -1.5px  1.5px 0 var(--color-lozen-blue-950),
       1.5px  1.5px 0 var(--color-lozen-blue-950);
    text-wrap: balance;
  }
</style>
