    raise SystemExit("Could not locate Recent Analysis section boundaries. No changes made.")

new_section = '''  {categoryPreviewSections.length > 0 && (
    <section>
      <Wrapper variant="standard" class="py-10 lg:py-16">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
