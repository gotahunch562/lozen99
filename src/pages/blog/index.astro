---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

// Content
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");

const getData = (post: any) => post.data as any;

const normalizeSlug = (value: string) =>
  String(value || "")
    .replace(/^\/?blog\//, "")
    .replace(/^\/+/, "")
    .replace(/\.mdx?$/, "");

const getSlug = (post: any) => {
  const data = getData(post);
  return normalizeSlug(data.slug || post.slug || post.id);
};

const getPostHref = (post: any) => `/blog/${getSlug(post)}`;

const getDateValue = (post: any) => {
  const data = getData(post);
  return data.dateModified || data.datePublished || data.pubDate || "";
};

const getPublishedDate = (post: any) => {
  const data = getData(post);
  return data.datePublished || data.pubDate || data.dateModified || "";
};

const getSortDate = (post: any) => {
  const dateValue = getDateValue(post);
  return dateValue ? new Date(dateValue).getTime() : 0;
};

const getImageSrc = (post: any) => {
  const data = getData(post);
  const imageUrl = data.image?.url;

  if (imageUrl?.src) return imageUrl.src;
  if (typeof imageUrl === "string") return imageUrl;
  if (data.heroImage?.src) return data.heroImage.src;
  if (typeof data.heroImage === "string") return data.heroImage;

  return "";
};

const getImageAlt = (post: any) => {
  const data = getData(post);
  return data.image?.alt || data.heroAlt || data.title || "";
};

const getCategory = (post: any) => {
  const data = getData(post);
  return data.category || data.tags?.[0] || "Articles";
};

const getExcerpt = (post: any) => {
  const data = getData(post);
  return data.excerpt || data.metaDescription || data.description || "";
};

const formatDate = (dateValue: string | Date) => {
  if (!dateValue) return "";

  return new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  }).format(new Date(dateValue));
};

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

// Use all non-draft posts. Do not require data.slug because the template schema
// may strip custom frontmatter fields; post.id is the stable fallback.
const livePosts = allPosts
  .filter((post) => getData(post).draft !== true)
  .sort((a, b) => getSortDate(b) - getSortDate(a));

const articlePosts = livePosts;

const featuredPost = articlePosts.find((post) => getData(post).isFeatured) || articlePosts[0];

const latestPosts = articlePosts
  .filter((post) => !featuredPost || post.id !== featuredPost.id)
  .slice(0, 4);

const postsByCategory = articlePosts.reduce((groups: Record<string, any[]>, post) => {
  const category = getCategory(post);

  if (!groups[category]) {
    groups[category] = [];
  }

  groups[category].push(post);
  return groups;
}, {});

const preferredCategoryOrder = [
  "Legislative Analysis",
  "Research & Policy",
  "Legal Profession",
  "Performance & Career",
  "The Tender Path",
  "Series Hub",
];

const categorySections = Object.entries(postsByCategory).sort(([a], [b]) => {
  const aIndex = preferredCategoryOrder.indexOf(a);
  const bIndex = preferredCategoryOrder.indexOf(b);

  if (aIndex === -1 && bIndex === -1) return a.localeCompare(b);
  if (aIndex === -1) return 1;
  if (bIndex === -1) return -1;

  return aIndex - bIndex;
});

const categoryLinks = categorySections.map(([category, posts]) => ({
  category,
  href: `#${slugify(category)}`,
  count: posts.length,
}));
const title = "Blog | Lozen Advisory";

const description = "Articles for women navigating perimenopause, disclosure, performance pressure, leadership, career protection, and private decision-making at work.";

---

<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-b from-base-200 via-white to-base-100">
    <Wrapper variant="standard" class="py-20 lg:py-28">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-end">
        <div>
          <Text
            tag="span"
            variant="textSM"
            class="pl-4 font-medium uppercase border-l text-base-900 font-display border-accent-500"
          >
            Research
          </Text>

          <Text
            tag="h1"
            variant="displayXL"
            class="mt-8 font-display text-base-900"
          >
            Lozen Advisory Research & Analysis
          </Text>

          <Text
            tag="p"
            variant="textBase"
            class="mt-6 max-w-2xl text-base-600 text-balance"
          >
            Disclosure-independent analysis on retention risk, menopause at work,
            invisible attrition, leadership continuity, and the organizational data
            sources that fail to capture what was never disclosed.
          </Text>
        </div>

        {categoryLinks.length > 0 && (
          <nav
            class="rounded-sm border border-base-300 bg-white p-5 shadow-sm"
            aria-label="Blog categories"
          >
            <p class="mb-4 text-xs font-medium uppercase tracking-[0.2em] text-accent-600 font-display">
              Explore the research
            </p>

            <div class="flex flex-wrap gap-2">
              {categoryLinks.map((item) => (
                <a
                  href={item.href}
                  class="rounded-full border border-base-300 px-4 py-2 text-sm text-base-700 transition-colors hover:border-accent-500 hover:text-base-900"
                >
                  {item.category}
                  <span class="ml-1 text-base-500">({item.count})</span>
                </a>
              ))}
            </div>
          </nav>
        )}
      </div>
    </Wrapper>
  </section>

  {featuredPost && (
    <section>
      <Wrapper variant="standard" class="py-8 lg:py-14">
        <div class="grid grid-cols-1 overflow-hidden rounded-sm border border-base-300 bg-white shadow-sm lg:grid-cols-[1.1fr_0.9fr]">
          {getImageSrc(featuredPost) && (
            <a href={getPostHref(featuredPost)} class="block overflow-hidden">
              <img
                src={getImageSrc(featuredPost)}
                alt={getImageAlt(featuredPost)}
                class="h-80 w-full object-cover transition-transform duration-500 hover:scale-[1.02] lg:h-full"
                loading="eager"
              />
            </a>
          )}

          <div class="flex flex-col justify-center p-8 lg:p-12">
            <div class="flex flex-wrap items-center gap-3 text-xs font-medium uppercase tracking-wide text-accent-600 font-display">
              <span>{getCategory(featuredPost)}</span>
              {getPublishedDate(featuredPost) && (
                <>
                  <span aria-hidden="true">·</span>
                  <time datetime={String(getPublishedDate(featuredPost))}>
                    {formatDate(getPublishedDate(featuredPost))}
                  </time>
                </>
              )}
            </div>

            <h2 class="mt-5 text-3xl leading-tight font-display text-base-900 lg:text-5xl">
              <a href={getPostHref(featuredPost)} class="transition-colors hover:text-accent-600">
                {getData(featuredPost).title}
              </a>
            </h2>

            {getExcerpt(featuredPost) && (
              <p class="mt-6 text-base leading-8 text-base-600">
                {getExcerpt(featuredPost)}
              </p>
            )}

            <div class="mt-8">
              <a
                href={getPostHref(featuredPost)}
                class="inline-flex text-sm font-medium text-accent-600 hover:text-base-900 transition-colors"
              >
                Read article →
              </a>
            </div>
          </div>
        </div>
      </Wrapper>
    </section>
  )}

    {latestPosts.length > 0 && (
    <section>
      <Wrapper variant="standard" class="py-10 lg:py-16">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div class="max-w-3xl">
            <Text
              tag="span"
              variant="textSM"
              class="pl-4 font-medium uppercase border-l text-base-900 font-display border-accent-500"
            >
              Latest Stories
            </Text>

            <Text
              tag="h2"
              variant="displayLG"
              class="mt-8 font-display text-base-900"
            >
              Recent Analysis
            </Text>
          </div>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-2">
          {latestPosts.map((post) => {
            const publishedDate = getPublishedDate(post);

            return (
              <article class="group overflow-hidden rounded-sm border border-base-300 bg-white shadow-sm transition-transform duration-300 hover:-translate-y-1">
                {getImageSrc(post) && (
                  <a href={getPostHref(post)} class="block overflow-hidden">
                    <img
                      src={getImageSrc(post)}
                      alt={getImageAlt(post)}
                      class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      loading="lazy"
                    />
                  </a>
                )}

                <div class="p-8">
                  <div class="flex flex-wrap items-center gap-3 text-xs font-medium uppercase tracking-[0.16em] text-accent-600 font-display">
                    <span>{getCategory(post)}</span>
                    {publishedDate && <span aria-hidden="true">·</span>}
                    {publishedDate && (
                      <time datetime={String(publishedDate)}>
                        {formatDate(publishedDate)}
                      </time>
                    )}
                  </div>

                  <h3 class="mt-5 text-2xl leading-tight font-display text-base-900 lg:text-3xl">
                    <a href={getPostHref(post)} class="transition-colors hover:text-accent-600">
                      {getData(post).title}
                    </a>
                  </h3>

                  {getExcerpt(post) && (
                    <p class="mt-5 line-clamp-4 text-base leading-8 text-base-600">
                      {getExcerpt(post)}
                    </p>
                  )}

                  <div class="mt-7">
                    <a
                      href={getPostHref(post)}
                      class="inline-flex text-sm font-medium text-accent-600 hover:text-base-900 transition-colors"
                    >
                      Read article →
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </Wrapper>
    </section>
  )}

  <section>
    <Wrapper variant="standard" class="py-10 lg:py-24">
      <div class="max-w-3xl">
        <Text
          tag="span"
          variant="textSM"
          class="pl-4 font-medium uppercase border-l text-base-900 font-display border-accent-500"
        >
          Browse by Category
        </Text>
      </div>

      <div class="mt-12 space-y-20">
        {
          categorySections.map(([category, posts]) => (
            <section id={slugify(category)} class="scroll-mt-28">
              <div class="mb-8 flex flex-col gap-3 border-b border-base-300 pb-5 md:flex-row md:items-end md:justify-between">
                <Text
                  tag="h2"
                  variant="displayLG"
                  class="font-display text-base-900"
                >
                  {category}
                </Text>

                <p class="text-sm text-base-500">
                  {posts.length} {posts.length === 1 ? "article" : "articles"}
                </p>
              </div>

              <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
                {posts.map((post) => {
                  const publishedDate = getPublishedDate(post);

                  return (
                    <article class="group overflow-hidden rounded-sm border border-base-300 bg-white shadow-sm transition-transform duration-300 hover:-translate-y-1">
                      {getImageSrc(post) && (
                        <a href={getPostHref(post)} class="block overflow-hidden">
                          <img
                            src={getImageSrc(post)}
                            alt={getImageAlt(post)}
                            class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                            loading="lazy"
                          />
                        </a>
                      )}

                      <div class="p-8">
                        <div class="text-xs font-medium uppercase tracking-[0.16em] text-accent-600 font-display">
                          {publishedDate && (
                            <time datetime={String(publishedDate)}>
                              {formatDate(publishedDate)}
                            </time>
                          )}
                        </div>

                        <h3 class="mt-5 text-2xl leading-tight font-display text-base-900 lg:text-3xl">
                          <a href={getPostHref(post)} class="transition-colors hover:text-accent-600">
                            {getData(post).title}
                          </a>
                        </h3>

                        {getExcerpt(post) && (
                          <p class="mt-5 line-clamp-4 text-base leading-8 text-base-600">
                            {getExcerpt(post)}
                          </p>
                        )}

                        <div class="mt-7">
                          <a
                            href={getPostHref(post)}
                            class="inline-flex text-sm font-medium text-accent-600 hover:text-base-900 transition-colors"
                          >
                            Read article →
                          </a>
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
