old_latest_const = '''const latestPosts = livePosts
  .filter((post) => !featuredPost || post.id !== featuredPost.id)
  .slice(0, 8);

'''
if old_latest_const not in text:
    raise SystemExit("Could not find latestPosts const block. No changes made.")

text = text.replace(old_latest_const, "")

# Add category preview sections after categoryLinks.
