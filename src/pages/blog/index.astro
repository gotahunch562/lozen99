  .map((category) => ({
    category,
    href: `/blog/archive#${slugify(category)}`,
    count: livePosts.filter((post) => getCategory(post) === category).length,
  }))
  .filter((item) => item.count > 0);

'''

new_category_links = '''const categoryLinks = curatedCategories
  .map((category) => ({
    category,
    href: `/blog/archive#${slugify(category)}`,
    count: livePosts.filter((post) => getCategory(post) === category).length,
  }))
  .filter((item) => item.count > 0);

const categoryPreviewSections = curatedCategories
  .map((category) => {
    const posts = livePosts
      .filter((post) => getCategory(post) === category)
      .slice(0, 2);

    return {
      category,
      href: `/blog/archive#${slugify(category)}`,
      count: livePosts.filter((post) => getCategory(post) === category).length,
      posts,
    };
  })
  .filter((section) => section.posts.length > 0);

'''

if old_category_links not in text:
    raise SystemExit("Could not find categoryLinks block. No changes made.")

text = text.replace(old_category_links, new_category_links)

