---
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const normalizeSlug = (value: string) =>
    String(value || "")
      .replace(/^\/?blog\//, "")
      .replace(/^\/+/, "")
      .replace(/\.mdx?$/, "");

  const blogEntries = await getCollection("posts");

  return blogEntries
    .filter((entry) => entry.data.draft !== true)
    .map((entry) => {
      const slug = normalizeSlug(entry.data.slug || entry.slug || entry.id);

      return {
        params: { slug },
        props: { entry },
      };
    });
}

const { entry } = Astro.props;
const currentSlug = String(entry.data.slug || entry.slug || entry.id || "")
  .replace(/^\/?blog\//, "")
  .replace(/^\/+/, "")
  .replace(/\.mdx?$/, "");
const { Content } = await render(entry);
---

<BlogLayout frontmatter={entry.data} currentSlug={currentSlug}>
  <Content />
</BlogLayout>
