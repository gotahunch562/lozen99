---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const title = "Menopause at Work: Policy, Laws and the Dependence on Disclosure | Lozen Advisory";
const description = "A Lozen Advisory original research series examining menopause policy, workplace law, disclosure dependence, and the limits of what formal systems can measure.";

const seriesItems = [
  {
    number: "1.",
    title: "Menopause Workplace Frameworks: A Visibility Constraint",
    href: "/blog/menopause-workplace-visibility-constraint",
  },
  {
    number: "2.",
    title: "Virginia HB1173/SB258: What the Law Protects and What It Cannot Measure",
    href: "/blog/virginia-menopause-protected-class",
  },
  {
    number: "3.",
    title: "Virginia's Governor Substituted a Study for Menopause Protections",
    href: "/blog/virginia-menopause-bill-split-outcome",
  },
  {
    number: "4.",
    title: "Maryland SB892: What the Menopause Bill's 176 Votes Cannot Fix",
    href: "/blog/maryland-sb892-menopause",
  },
  {
    number: "5.",
    title: "New York State Senate Bill S9247: Leave Entitlement Without Visibility",
    href: "/blog/ny-s9247-menopause-leave",
  },
  {
    number: "6.",
    title: "New York S7495: The Policy Gap and The Invisible Majority",
    href: "/blog/ny-s7495-invisible-majority-policy-gap",
  },
  {
    number: "7.",
    title: "New York S3908: The Menopause Workers-Comp Policy Gap",
    href: "/blog/ny-s3908-workers-comp-menopause-gap",
  },
  {
    number: "8.",
    title: "Menopause at Work: The Data Employers Do Not See",
    href: "/blog/menopause-at-work-unquantified-data-gap",
  },
  {
    number: "9.",
    title: "Menopause at Work and Caregiving: The Cost of Tacere℠",
    href: "/blog/tacere-menopause-caregiving-attrition",
  },
];

const relatedReading = [
  {
    title: "Who Studies Menopause at Work, and Who Doesn't",
    href: "/blog/menopause-workplace-research-systems-gap",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.lozenadvisory.com/blog/menopause-policy-laws-dependence-disclosure#webpage",
  name: "Menopause at Work: Policy, Laws and the Dependence on Disclosure",
  description,
  url: "https://www.lozenadvisory.com/blog/menopause-policy-laws-dependence-disclosure",
  publisher: {
    "@type": "Organization",
    name: "Lozen Advisory LLC",
    url: "https://www.lozenadvisory.com",
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: seriesItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Article",
        name: item.title,
        url: `https://www.lozenadvisory.com${item.href}`,
      },
    })),
  },
};
---

<BaseLayout title={title} description={description} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="bg-gradient-to-b from-base-200 via-white to-base-100">
    <Wrapper variant="standard" class="py-20 lg:py-28">
      <div class="max-w-4xl">
        <Text
          tag="span"
          variant="textSM"
          class="pl-4 font-medium uppercase border-l text-base-900 font-display border-accent-500"
        >
          Series
        </Text>

        <Text
          tag="h1"
          variant="displayXL"
          class="mt-8 font-display text-base-900"
        >
          Menopause at Work: Policy, Laws and the Dependence on Disclosure
        </Text>
      </div>
    </Wrapper>
  </section>

  <section class="bg-base-50">
    <Wrapper variant="standard" class="py-12 lg:py-20">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-14">
        <div>
          <Text
            tag="h2"
            variant="displayMD"
            class="font-display text-base-900"
          >
            Series
          </Text>

          <div class="mt-8 divide-y divide-base-200 rounded-sm border border-base-200 bg-white shadow-sm">
            {
              seriesItems.map((item) => (
                <a
                  href={item.href}
                  class="group grid grid-cols-[3rem_minmax(0,1fr)] gap-4 p-6 transition-colors hover:bg-base-100 sm:grid-cols-[4rem_minmax(0,1fr)] sm:p-8"
                >
                  <span class="font-display text-sm uppercase tracking-[0.18em] text-accent-600">
                    {item.number}
                  </span>

                  <span class="font-display text-xl leading-tight text-base-900 transition-colors group-hover:text-accent-700 sm:text-2xl">
                    {item.title}
                  </span>
                </a>
              ))
            }
          </div>
        </div>

        <aside class="lg:sticky lg:top-28 lg:self-start">
          <div class="rounded-sm border border-base-200 bg-white p-6 shadow-sm sm:p-8">
            <Text
              tag="h2"
              variant="displayXS"
              class="font-display text-base-900"
            >
              Related Reading
            </Text>

            <div class="mt-6 space-y-4">
              {
                relatedReading.map((item) => (
                  <a
                    href={item.href}
                    class="block border-l border-accent-500 pl-4 font-display text-lg leading-tight text-base-900 transition-colors hover:text-accent-700"
                  >
                    {item.title}
                  </a>
                ))
              }
            </div>
          </div>
        </aside>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
