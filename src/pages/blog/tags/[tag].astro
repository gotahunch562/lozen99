---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import BlogBigCard from "@/components/blog/BlogBigCard.astro";
// Content
import { getCollection } from "astro:content";

const normalizeTag = (tag: string) => {
  const raw = (tag ?? "").toString().trim();
  const slugSource = raw
    .toLowerCase()
    .replace(/^#+/, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
  const slug = encodeURIComponent(slugSource || "tag");
  const label =
    raw.replace(/^#+/, "").replace(/[-_]+/g, " ").replace(/\s+/g, " ").trim() ||
    "Tag";
  return { label, slug };
};

export async function getStaticPaths() {
  const normalizeTagPath = (tag: string) => {
    const raw = (tag ?? "").toString().trim();
    const slugSource = raw
      .toLowerCase()
      .replace(/^#+/, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
    const slug = encodeURIComponent(slugSource || "tag");
    const label =
      raw.replace(/^#+/, "").replace(/[-_]+/g, " ").replace(/\s+/g, " ").trim() ||
      "Tag";
    return { label, slug };
  };

  const allPosts = await getCollection("posts");
  const livePosts = allPosts.filter((post) => post.data.draft !== true);
  const tagMap = new Map();

  for (const post of livePosts) {
    const tags = post.data.tags ?? [];
    for (const tag of tags) {
      const { label, slug } = normalizeTagPath(tag);
      if (!tagMap.has(slug)) {
        tagMap.set(slug, { label, slug, posts: [] });
      }
      tagMap.get(slug).posts.push(post);
    }
  }

  return Array.from(tagMap.values()).map((tag) => ({
    params: { tag: tag.slug },
    props: { label: tag.label, posts: tag.posts },
  }));
}

const { label } = Astro.props;
const { posts } = Astro.props;
---

<BaseLayout>
  <section class="bg-gradient-to-t from-base-200 to-white">
    <Wrapper variant="standard" class="lg:pt-32 pt-24 pb-12">
      <div class="max-w-3xl mx-auto text-center text-balance">
        <Text
          tag="span"
          variant="textSM"
          class="pl-4 font-medium uppercase border-l text-base-900 font-display border-accent-500"
        >
          tags
        </Text>
        <Text
          tag="h1"
          variant="displayXL"
          class="mt-8 uppercase font-display text-base-900"
        >
          blog posts tagged with
          {label}</Text
        >
      </div>
    </Wrapper>
  </section>
  <section>
    <Wrapper variant="standard" class="py-12">
      <div class="flex flex-col gap-8">
        {
          posts.map((post, index) => (
            <BlogBigCard post={post} index={index + 1} />
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
