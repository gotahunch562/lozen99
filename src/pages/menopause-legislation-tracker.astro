---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { createDatasetJsonLd } from "@/lib/seo/jsonLd";

import {
  FEDERAL,
  ENACTED,
  ACTIVE,
  DID_NOT_PASS,
  ADVISORY,
  CLUSTER_LINKS,
  IA_LINK,
} from "@/data/menopauseTracker";

const title = "Menopause Legislation Tracker: Policy & Workforce Risk | Lozen Advisory";
const description = "Track state and Federal menopause policies and compliance mandates. Evaluate operational governance gaps to identify ROI and liability risks for employers.";

const trackerJsonLd = createDatasetJsonLd({
  name: title,
  description,
  href: "/menopause-legislation-tracker",
  datePublished: "2026-04-15",
  dateModified: "2026-05-30",
  creatorName: "Lozen Advisory LLC",
  keywords: [
    "menopause legislation",
    "menopause workplace policy",
    "menopause benefits",
    "disclosure-dependent systems",
    "Invisible Attrition",
    "Tacere",
  ],
});
const focusClassByLabel: Record<string, string> = {
  Workplace: "lozen-data-badge--focus-workplace",
  Insurance: "lozen-data-badge--focus-insurance",
  Education: "lozen-data-badge--focus-education",
  Omnibus: "lozen-data-badge--focus-omnibus",
  Advisory: "lozen-data-badge--focus-advisory",
  "Military / Veteran": "lozen-data-badge--focus-military",
  "Veteran Care": "lozen-data-badge--focus-veteran-care",
};

const classificationClassByLabel: Record<string, string> = {
  "Dashboard Delay": "lozen-data-badge--classification-dashboard-delay",
  Tacere: "lozen-data-badge--classification-tacere",
  "Invisible Attrition": "lozen-data-badge--classification-invisible-attrition",
  "Outside Scope": "lozen-data-badge--classification-outside-scope",
  "No Classification": "lozen-data-badge--classification-none",
};

const focusBadgeClass = (label: string) =>
  `lozen-data-badge ${focusClassByLabel[label] || "lozen-data-badge--neutral"}`;

const statusModifier = (status: string) => {
  if (/died/i.test(status)) {
    return "lozen-tracker-status--died";
  }

  if (/did not pass|failed|withdrawn/i.test(status)) {
    return "lozen-tracker-status--failed";
  }

  if (/returned|substitute/i.test(status)) {
    return "lozen-tracker-status--returned";
  }

  if (/signed/i.test(status)) {
    return "lozen-tracker-status--signed";
  }

  if (/enacted/i.test(status)) {
    return "lozen-tracker-status--enacted";
  }

  if (/passed/i.test(status)) {
    return "lozen-tracker-status--passed";
  }

  if (/calendar/i.test(status)) {
    return "lozen-tracker-status--calendar";
  }

  if (/committee/i.test(status)) {
    return "lozen-tracker-status--committee";
  }

  if (/introduced|pending/i.test(status)) {
    return "lozen-tracker-status--introduced";
  }

  if (/study|research/i.test(status)) {
    return "lozen-tracker-status--study";
  }

  if (/active|house|senate/i.test(status)) {
    return "lozen-tracker-status--active";
  }

  return "lozen-tracker-status--neutral";
};

const statusCellClass = (_status: string) => "lozen-tracker-status-cell";

const statusBadgeClass = (status: string) =>
  `lozen-tracker-status-badge ${statusModifier(status)}`;

const statusBadgeStyle = (status: string) =>
  status.length > 96
    ? "display:block;width:100%;max-width:none;min-width:0;white-space:normal;text-align:left;border-radius:1rem;padding:0.85rem 1rem;line-height:1.45;"
    : undefined;

const classification = (label: string) => {
  const badgeClass =
    classificationClassByLabel[label] || "lozen-data-badge--classification-none";
  const href =
    CLUSTER_LINKS[label] ||
    (label === "Invisible Attrition" ? IA_LINK : undefined);

  return { badgeClass, href };
};

const classificationBadgeClass = (label: string) =>
  `lozen-data-badge ${classification(label).badgeClass}`;

const sectionId = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const standardSections = [
  { title: "Federal", rows: FEDERAL, theme: "federal" },
  { title: "Enacted / Passed", rows: ENACTED, theme: "enacted" },
  { title: "Active / In Committee", rows: ACTIVE, theme: "active" },
];

const trackerStats = [
  { label: "Federal", value: FEDERAL.length },
  { label: "Enacted", value: ENACTED.length },
  { label: "Active", value: ACTIVE.length },
  { label: "Did Not Pass", value: DID_NOT_PASS.length },
  { label: "Advisory", value: ADVISORY.length },
];

const columnDefinitions = [
  ["State / Level", "Jurisdiction."],
  ["Bill", "Bill number and short title."],
  [
    "Focus",
    "Primary domain: Workplace, Insurance, Education, Omnibus, Military / Veteran, Veteran Care, or Advisory.",
  ],
  ["Status", "Current legislative status as of May 30, 2026."],
  [
    "Policy Assumption",
    "The disclosure or participation condition the law requires to activate.",
  ],
  [
    "Governance Blind Spot",
    "The population or condition outside the formal system the law produces.",
  ],
  [
    "Lozen Classification",
    "The Invisible Attrition℠ condition this gap represents.",
  ],
  [
    "Legislative Outcome",
    "Observations from the bill text or legislative record with strategic or analytical value beyond the core gap classification.",
  ],
];


const tableWrapClass = (theme = "default") => `lozen-tracker-table-wrap lozen-tracker-table-wrap--${theme}`;

const tableClass = "lozen-tracker-table";
const compactTableClass = "lozen-tracker-table lozen-tracker-table--compact";

const thClass = "lozen-tracker-th";

const tdStrongClass = "lozen-tracker-td lozen-tracker-td--strong";

const tdMutedClass = "lozen-tracker-td";

const rowClass = "lozen-tracker-row";

const mobileCardClass = "lozen-tracker-mobile-card";

const mobileLabelClass = "lozen-tracker-mobile-label";

const mobileValueClass = "lozen-tracker-mobile-value";
---

<BaseLayout title={title} description={description} jsonLd={trackerJsonLd}>

  <main class="lozen-tracker-page">
    <section class="lozen-tracker-hero">
      <Wrapper variant="standard" class="py-14 sm:py-20 lg:py-28">
        <div
          class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(320px,0.55fr)] lg:items-end lg:gap-12"
        >
          <div class="max-w-5xl">
            <p
              class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-700"
            >
              Legislative Governance Risk Index
            </p>

            <h1
              class="mt-6 max-w-5xl font-display text-4xl font-normal uppercase leading-[1.02] tracking-[-0.04em] text-base-950 sm:mt-8 sm:text-5xl lg:text-6xl"
            >
              Menopause Legislation Tracker 2026
            </h1>

            <p class="mt-6 max-w-3xl font-sans text-base leading-7 text-base-700 sm:mt-7 sm:text-lg sm:leading-8">
              A federal-and-state audit of menopause legislation by the pathway each bill establishes, the action required before that pathway activates, the data it can collect, and the populations left unmeasured.
            </p>

            <p
              class="mt-7 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500 sm:mt-8"
            >
              Last updated: May 30, 2026
            </p>

            <div class="lozen-tracker-stat-grid" aria-label="Tracker record counts">
              {
                trackerStats.map((stat) => (
                  <div class="lozen-tracker-stat">
                    <strong>{stat.value}</strong>
                    <span>{stat.label}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <aside
            class="lozen-tracker-insight-card p-5 sm:p-6 lg:rounded-3xl"
          >
            <div
              aria-hidden="true"
              class="absolute inset-x-0 top-0 h-1 bg-accent-500"
            >
            </div>

            <p
              class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500"
            >
              Audit thesis
            </p>

            <p
              class="mt-5 font-display text-2xl font-normal uppercase leading-tight tracking-[-0.025em] text-base-950"
            >
              Legislation measures participation, not unmet need.
            </p>

            <p class="mt-5 font-sans text-sm leading-6 text-base-700">
              Each bill creates or modifies a formal pathway. The data it can produce depends on who enters that pathway through a request, claim, clinical encounter, study record, report, or other required participation event.
            </p>
          </aside>
        </div>
      </Wrapper>
    </section>

    <section class="lozen-tracker-section">
      <Wrapper variant="standard" class="py-12 sm:py-14 lg:py-20">
        <div class="mx-auto max-w-4xl">
          <p
            class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500"
          >
            Executive Summary
          </p>

          <h2
            class="mt-5 font-display text-3xl font-normal uppercase leading-tight tracking-[-0.035em] text-base-950 sm:mt-6 sm:text-4xl"
          >
            What menopause legislation can measure
          </h2>

          <div
            class="mt-7 grid gap-5 font-sans text-base leading-8 text-base-700 sm:mt-8 sm:text-lg sm:leading-9"
          >
            <p>
              This index audits menopause-related legislation by its measurement architecture: the formal pathway each bill establishes, the action required before that pathway activates, and the data the pathway can collect once someone enters it. The question is not whether a bill is well intended, politically meaningful, or useful to the women who can use it. The question is what the bill can actually measure after it becomes law, policy, study, coverage, accommodation, advisory body, or public education mandate.
            </p>

            <p>
              Across the legislative record, the same structural condition appears in different forms. Workplace protections require a request. Accommodation frameworks require disclosure. Insurance mandates require clinical engagement, diagnosis, treatment recommendation, or claim activity. Research bills produce findings after a study period. Advisory bodies produce reports, recommendations, agendas, or data-sharing structures. Each pathway can produce information only after someone enters it.
            </p>

            <p>
              That condition matters. Women managing symptoms without clinical engagement, without workplace disclosure, without a filed request, without a claim, or outside the data sources named by a bill remain outside what that bill is able to measure. Their absence can be mistaken for stability, low need, low utilization, or low impact when the more precise conclusion is that the collection condition was never met.
            </p>

            <p>
              This tracker does not rank legislation by political value or policy adequacy. It classifies what each bill assumes, what action must happen before the bill’s process begins, what data the bill can produce, and which populations remain outside what the bill is able to measure.
            </p>
          </div>
        </div>
      </Wrapper>
    </section>

    <section class="lozen-tracker-section lozen-tracker-section--muted">
      <Wrapper variant="standard" class="py-12 sm:py-14 lg:py-20">
        <div>
          <p
            class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500"
          >
            Column Definitions
          </p>

          <h2
            class="mt-5 max-w-4xl font-display text-3xl font-normal uppercase leading-tight tracking-[-0.035em] text-base-950 sm:mt-6 sm:text-4xl"
          >
            How the tracker reads the legislative record
          </h2>

          <dl class="lozen-tracker-definition-grid">
            {
              columnDefinitions.map(([term, definition]) => (
                <div class="lozen-tracker-definition-card p-5 lg:rounded-3xl">
                  <div
                    aria-hidden="true"
                    class="absolute inset-x-0 top-0 h-1 bg-accent-500"
                  >
                  </div>

                  <dt class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-base-950">
                    {term}
                  </dt>
                  <dd class="mt-4 font-sans text-sm leading-6 text-base-700">
                    {definition}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </Wrapper>
    </section>


    <section class="lozen-tracker-section lozen-tracker-section--data">
      <Wrapper variant="standard" class="py-12 sm:py-14 lg:py-20">
        <div class="lozen-tracker-table-stack">
          {
            standardSections.map((section) => {
              const id = sectionId(section.title);

              return (
                <section aria-labelledby={id}>
                  <div class="mb-6 sm:mb-8">
                    <p class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500">
                      Legislative Record
                    </p>

                    <h2
                      id={id}
                      class="mt-5 font-display text-3xl font-normal uppercase leading-tight tracking-[-0.035em] text-base-950 sm:mt-6 sm:text-4xl"
                    >
                      {section.title}
                    </h2>
                  </div>

                  <div class={tableWrapClass(section.theme)} tabindex="0" role="region" aria-label={`${section.title} legislation table`}>
                    <table class={tableClass}>
                      <thead>
                        <tr>
                          <th class={thClass}>Jurisdiction</th>
                          <th class={thClass}>Bill</th>
                          <th class={thClass}>Focus</th>
                          <th class={thClass}>Status</th>
                          <th class={thClass}>Policy Assumption</th>
                          <th class={thClass}>Governance Blind Spot</th>
                          <th class={thClass}>Classification</th>
                          <th class={thClass}>Legislative Outcome</th>
                        </tr>
                      </thead>

                      <tbody>
                        {
                          section.rows.map((row) => {
                            const c = classification(row.classification);

                            return (
                              <tr class={rowClass}>
                                <td class={tdStrongClass}>
                                  {row.jurisdiction}
                                </td>

                                <td class={tdStrongClass}>
                                  {row.url ? (
                                    <a
                                      href={row.url}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="font-semibold text-base-950 underline decoration-accent-500 underline-offset-4 transition-colors hover:text-accent-700"
                                    >
                                      {row.bill}
                                    </a>
                                  ) : (
                                    row.bill
                                  )}
                                </td>

                                <td class={tdStrongClass}>
                                  <span
                                    class={focusBadgeClass(row.focus)}
                                  >
                                    {row.focus}
                                  </span>
                                </td>

                                <td class={statusCellClass(row.status)}>
                                  <span class={statusBadgeClass(row.status)} style={statusBadgeStyle(row.status)}>
                                    {row.status}
                                  </span>
                                </td>

                                <td class={tdMutedClass}>{row.assumes}</td>

                                <td class={tdMutedClass}>
                                  {row.cannotMeasure}
                                </td>

                                <td class={tdStrongClass}>
                                  {c.href ? (
                                    <a href={c.href} class="inline-flex no-underline">
                                      <span
                                        class={classificationBadgeClass(row.classification)}
                                      >
                                        {row.classification}
                                      </span>
                                    </a>
                                  ) : (
                                    <span
                                      class={classificationBadgeClass(row.classification)}
                                    >
                                      {row.classification}
                                    </span>
                                  )}
                                </td>

                                <td class={tdMutedClass}>{row.notes}</td>
                              </tr>
                            );
                          })
                        }
                      </tbody>
                    </table>
                  </div>

                  <div class="lozen-tracker-mobile-grid">
                    {
                      section.rows.map((row) => {
                        const c = classification(row.classification);

                        return (
                          <article class={mobileCardClass}>
                            <div
                              aria-hidden="true"
                              class="absolute inset-x-0 top-0 h-1 bg-accent-500"
                            >
                            </div>

                            <div class="grid gap-5">
                              <div>
                                <p class={mobileLabelClass}>Jurisdiction</p>
                                <p class="mt-1 font-sans text-base font-semibold leading-6 text-base-950">
                                  {row.jurisdiction}
                                </p>
                              </div>

                              <div>
                                <p class={mobileLabelClass}>Bill</p>
                                <p class={mobileValueClass}>
                                  {row.url ? (
                                    <a
                                      href={row.url}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="font-semibold text-base-950 underline decoration-accent-500 underline-offset-4"
                                    >
                                      {row.bill}
                                    </a>
                                  ) : (
                                    row.bill
                                  )}
                                </p>
                              </div>

                              <div class="grid gap-4 sm:grid-cols-2">
                                <div>
                                  <p class={mobileLabelClass}>Focus</p>
                                  <span
                                    class={focusBadgeClass(row.focus)}
                                  >
                                    {row.focus}
                                  </span>
                                </div>

                                <div>
                                  <p class={mobileLabelClass}>Status</p>
                                  <p class={statusBadgeClass(row.status)} style={statusBadgeStyle(row.status)}>
                                    {row.status}
                                  </p>
                                </div>
                              </div>

                              <div>
                                <p class={mobileLabelClass}>Policy Assumption</p>
                                <p class={mobileValueClass}>{row.assumes}</p>
                              </div>

                              <div>
                                <p class={mobileLabelClass}>
                                  Governance Blind Spot
                                </p>
                                <p class={mobileValueClass}>
                                  {row.cannotMeasure}
                                </p>
                              </div>

                              <div>
                                <p class={mobileLabelClass}>Classification</p>
                                <div class="mt-2">
                                  {c.href ? (
                                    <a href={c.href} class="inline-flex no-underline">
                                      <span
                                        class={classificationBadgeClass(row.classification)}
                                      >
                                        {row.classification}
                                      </span>
                                    </a>
                                  ) : (
                                    <span
                                      class={classificationBadgeClass(row.classification)}
                                    >
                                      {row.classification}
                                    </span>
                                  )}
                                </div>
                              </div>

                              <div>
                                <p class={mobileLabelClass}>
                                  Legislative Outcome
                                </p>
                                <p class={mobileValueClass}>{row.notes}</p>
                              </div>
                            </div>
                          </article>
                        );
                      })
                    }
                  </div>
                </section>
              );
            })
          }

          <section aria-labelledby="did-not-pass">
            <div class="mb-6 sm:mb-8">
              <p
                class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500"
              >
                Legislative Record
              </p>

              <h2
                id="did-not-pass"
                class="mt-5 font-display text-3xl font-normal uppercase leading-tight tracking-[-0.035em] text-base-950 sm:mt-6 sm:text-4xl"
              >
                Did Not Pass
              </h2>
            </div>

            <div class={tableWrapClass("failed")} tabindex="0" role="region" aria-label="Did Not Pass legislation table">
              <table class={compactTableClass}>
                <thead>
                  <tr>
                    <th class={thClass}>Jurisdiction</th>
                    <th class={thClass}>Bill</th>
                    <th class={thClass}>Focus</th>
                    <th class={thClass}>Status</th>
                    <th class={thClass}>Assumed</th>
                    <th class={thClass}>Failure Confirms</th>
                    <th class={thClass}>Legislative Outcome</th>
                  </tr>
                </thead>

                <tbody>
                  {
                    DID_NOT_PASS.map((row) => (
                      <tr class={rowClass}>
                        <td class={tdStrongClass}>{row.jurisdiction}</td>

                        <td class={tdStrongClass}>
                          {row.url ? (
                            <a
                              href={row.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="font-semibold text-base-950 underline decoration-accent-500 underline-offset-4 transition-colors hover:text-accent-700"
                            >
                              {row.bill}
                            </a>
                          ) : (
                            row.bill
                          )}
                        </td>

                        <td class={tdStrongClass}>
                          <span
                            class={focusBadgeClass(row.focus)}
                          >
                            {row.focus}
                          </span>
                        </td>

                        <td class={statusCellClass(row.status)}>
                          <span class={statusBadgeClass(row.status)} style={statusBadgeStyle(row.status)}>
                            {row.status}
                          </span>
                        </td>

                        <td class={tdMutedClass}>{row.assumed}</td>

                        <td class={tdMutedClass}>{row.failureConfirms}</td>

                        <td class={tdMutedClass}>{row.notes}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>

            <div class="lozen-tracker-mobile-grid">
              {
                DID_NOT_PASS.map((row) => (
                  <article class={mobileCardClass}>
                    <div
                      aria-hidden="true"
                      class="absolute inset-x-0 top-0 h-1 bg-accent-500"
                    >
                    </div>

                    <div class="grid gap-5">
                      <div>
                        <p class={mobileLabelClass}>Jurisdiction</p>
                        <p class="mt-1 font-sans text-base font-semibold leading-6 text-base-950">
                          {row.jurisdiction}
                        </p>
                      </div>

                      <div>
                        <p class={mobileLabelClass}>Bill</p>
                        <p class={mobileValueClass}>
                          {row.url ? (
                            <a
                              href={row.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="font-semibold text-base-950 underline decoration-accent-500 underline-offset-4"
                            >
                              {row.bill}
                            </a>
                          ) : (
                            row.bill
                          )}
                        </p>
                      </div>

                      <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                          <p class={mobileLabelClass}>Focus</p>
                          <span
                            class={focusBadgeClass(row.focus)}
                          >
                            {row.focus}
                          </span>
                        </div>

                        <div>
                          <p class={mobileLabelClass}>Status</p>
                          <p class={statusBadgeClass(row.status)} style={statusBadgeStyle(row.status)}>
                            {row.status}
                          </p>
                        </div>
                      </div>

                      <div>
                        <p class={mobileLabelClass}>Assumed</p>
                        <p class={mobileValueClass}>{row.assumed}</p>
                      </div>

                      <div>
                        <p class={mobileLabelClass}>Failure Confirms</p>
                        <p class={mobileValueClass}>
                          {row.failureConfirms}
                        </p>
                      </div>

                      <div>
                        <p class={mobileLabelClass}>Legislative Outcome</p>
                        <p class={mobileValueClass}>{row.notes}</p>
                      </div>
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          <section aria-labelledby="advisory-instruments">
            <div class="mb-6 sm:mb-8">
              <p
                class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500"
              >
                Non-Legislative Instruments
              </p>

              <h2
                id="advisory-instruments"
                class="mt-5 font-display text-3xl font-normal uppercase leading-tight tracking-[-0.035em] text-base-950 sm:mt-6 sm:text-4xl"
              >
                Advisory / Non-Legislative Instruments
              </h2>
            </div>

            <div class={tableWrapClass("advisory")} tabindex="0" role="region" aria-label="Advisory and non-legislative instruments table">
              <table class={compactTableClass}>
                <thead>
                  <tr>
                    <th class={thClass}>Jurisdiction</th>
                    <th class={thClass}>Instrument</th>
                    <th class={thClass}>Focus</th>
                    <th class={thClass}>Status</th>
                    <th class={thClass}>Structural Role</th>
                    <th class={thClass}>Classification</th>
                    <th class={thClass}>Legislative Outcome</th>
                  </tr>
                </thead>

                <tbody>
                  {
                    ADVISORY.map((row) => {
                      const c = classification(row.classification);

                      return (
                        <tr class={rowClass}>
                          <td class={tdStrongClass}>{row.jurisdiction}</td>

                          <td class={tdStrongClass}>
                            {row.url ? (
                              <a
                                href={row.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-semibold text-base-950 underline decoration-accent-500 underline-offset-4 transition-colors hover:text-accent-700"
                              >
                                {row.instrument}
                              </a>
                            ) : (
                              row.instrument
                            )}
                          </td>

                          <td class={tdStrongClass}>
