---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

import {
  FEDERAL,
  ENACTED,
  ACTIVE,
  DID_NOT_PASS,
  ADVISORY,
  CLASSIFICATION_COLORS,
  FOCUS_COLORS,
  CLUSTER_LINKS,
  IA_LINK,
  getStatusColor,
} from "@/data/menopauseTracker";

const title = "Menopause Legislation Tracker 2026";
const description =
  "A governance audit of state-by-state workplace menopause legislation. Each instrument is classified by its structural activation condition and the population its disclosure requirement does not reach.";

const reportSchema = {
  "@context": "https://schema.org",
  "@type": "Report",
  name: "Menopause Legislation Tracker 2026",
  description:
    "An institutional audit of state-by-state menopause policy. Lozen Advisory classifies legislative instruments by their structural assumptions and the specific populations they architecturally exclude.",
  url: "https://www.lozenadvisory.com/menopause-legislation-tracker",
  author: {
    "@type": "Organization",
    name: "Lozen Advisory",
    url: "https://www.lozenadvisory.com",
  },
  datePublished: "2026-04-15",
  dateModified: "2026-04-30",
  keywords:
    "menopause legislation, menopause workplace policy, menopause benefits, disclosure-dependent systems, Invisible Attrition, Tacere",
  audience: {
    "@type": "Audience",
    audienceType: "Governance and Policy Leaders",
  },
};

const badgeFallback = {
  bg: "#f3f4f6",
  text: "#374151",
  border: "#d1d5db",
};

const focusStyle = (label: string) => {
  const colors = FOCUS_COLORS[label] || badgeFallback;
  return `background:${colors.bg};color:${colors.text};border:1px solid ${colors.border};`;
};

const classification = (label: string) => {
  const colors =
    CLASSIFICATION_COLORS[label] || CLASSIFICATION_COLORS["No Classification"];
  const href =
    CLUSTER_LINKS[label] ||
    (label === "Invisible Attrition" ? IA_LINK : undefined);

  return { colors, href };
};

const classificationStyle = (label: string) => {
  const c = classification(label).colors;
  return `background:${c.bg};color:${c.text};border:1px solid ${c.border};`;
};

const sectionId = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const standardSections = [
  { title: "Federal", rows: FEDERAL },
  { title: "Enacted / Passed", rows: ENACTED },
  { title: "Active / In Committee", rows: ACTIVE },
];

const columnDefinitions = [
  ["State / Level", "Jurisdiction."],
  ["Bill", "Bill number and short title."],
  [
    "Focus",
    "Primary domain: Workplace, Insurance, Education, Omnibus, Military / Veteran, Veteran Care, or Advisory.",
  ],
  ["Status", "Current legislative status as of April 30, 2026."],
  [
    "Policy Assumption",
    "The disclosure or participation condition the law requires to activate.",
  ],
  [
    "Governance Blind Spot",
    "The population or condition outside the formal system the law produces.",
  ],
  [
    "Lozen Classification",
    "The Invisible Attrition℠ condition this gap represents.",
  ],
  [
    "Legislative Outcome",
    "Observations from the bill text or legislative record with strategic or analytical value beyond the core gap classification.",
  ],
];

const tableWrapClass =
  "hidden overflow-x-auto rounded-3xl border-2 border-base-500 bg-white shadow-lg ring-1 ring-base-950/15 lg:block";

const tableClass = "min-w-[1220px] w-full border-collapse text-left";
const compactTableClass = "min-w-[1120px] w-full border-collapse text-left";

const thClass =
  "border border-base-600 bg-base-950 px-4 py-4 font-sans text-xs font-semibold uppercase tracking-[0.14em] text-white";

const tdStrongClass =
  "border border-base-400 px-4 py-4 font-sans text-sm leading-6 text-base-950";

const tdMutedClass =
  "border border-base-400 px-4 py-4 font-sans text-sm leading-6 text-base-700";

const rowClass =
  "odd:bg-white even:bg-base-100 hover:bg-accent-50/70 transition-colors duration-200";

const mobileCardClass =
  "relative overflow-hidden rounded-2xl border border-base-400 bg-white p-5 shadow-lg ring-1 ring-base-950/5";

const mobileLabelClass =
  "font-sans text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-base-500";

const mobileValueClass = "mt-1 font-sans text-sm leading-6 text-base-800";
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(reportSchema)} />

  <main class="bg-base-50">
    <section class="border-b border-base-300 bg-gradient-to-t from-base-200 via-base-100 to-white">
      <Wrapper variant="standard" class="py-14 sm:py-20 lg:py-28">
        <div
          class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(320px,0.55fr)] lg:items-end lg:gap-12"
        >
          <div class="max-w-5xl">
            <p
              class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-700"
            >
              Legislative Governance Risk Index
            </p>

            <h1
              class="mt-6 max-w-5xl font-display text-4xl font-normal uppercase leading-[1.02] tracking-[-0.04em] text-base-950 sm:mt-8 sm:text-5xl lg:text-6xl"
            >
              Menopause Legislation Tracker 2026
            </h1>

            <p class="mt-6 max-w-3xl font-sans text-base leading-7 text-base-700 sm:mt-7 sm:text-lg sm:leading-8">
              A state-by-state classification of menopause policy instruments by the assumptions they require, the participation conditions they activate, and the women they cannot reach.
            </p>

            <p
              class="mt-7 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500 sm:mt-8"
            >
              Last updated: April 30, 2026
            </p>
          </div>

          <aside
            class="relative overflow-hidden rounded-2xl border border-base-400 bg-white p-5 shadow-lg ring-1 ring-base-950/5 sm:p-6 lg:rounded-3xl"
          >
            <div
              aria-hidden="true"
              class="absolute inset-x-0 top-0 h-1 bg-accent-500"
            >
            </div>

            <p
              class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500"
            >
              Audit thesis
            </p>

            <p
              class="mt-5 font-display text-2xl font-normal uppercase leading-tight tracking-[-0.025em] text-base-950"
            >
              The legislation is visible. The nondisclosing population is not.
            </p>

            <p class="mt-5 font-sans text-sm leading-6 text-base-700">
              Each framework creates a formal system. Each system activates only after an initiating act.
            </p>
          </aside>
        </div>
      </Wrapper>
    </section>

    <section class="bg-white">
      <Wrapper variant="standard" class="py-12 sm:py-14 lg:py-20">
        <div class="mx-auto max-w-4xl">
          <p
            class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500"
          >
            Executive Summary
          </p>

          <h2
            class="mt-5 font-display text-3xl font-normal uppercase leading-tight tracking-[-0.035em] text-base-950 sm:mt-6 sm:text-4xl"
          >
            The paradox of legislative benefit instruments
          </h2>

          <div
            class="mt-7 grid gap-5 font-sans text-base leading-8 text-base-700 sm:mt-8 sm:text-lg sm:leading-9"
          >
            <p>
              This index audits the current legislative landscape of workplace menopause benefits. Our analysis finds a consistent structural condition: legislative instruments are designed to activate only upon disclosure or clinical participation. For the population that has decided not to disclose to protect professional standing, these benefits function not as support, but as a system the population cannot activate.
            </p>

            <p>
              Menopause-related legislation is emerging across the United States. Lawmakers have introduced bills spanning workplace protection, insurance coverage, public health, clinical education, and research. Some measures have been enacted. Others remain in committee or have failed to advance. The legislative record is uneven.
            </p>

            <p>
              Every framework on this page shares a structural condition: each activates at the point of disclosure. Accommodation protections require an employee to request an adjustment. Leave entitlements require a claim. Workforce studies draw from formal system records. Insurance mandates apply when treatment is sought.
            </p>

            <p>
              This tracker does not evaluate whether these frameworks are adequate. It classifies what each one assumes and identifies the population that assumption does not reach.
            </p>
          </div>
        </div>
      </Wrapper>
    </section>

    <section class="bg-base-100">
      <Wrapper variant="standard" class="py-12 sm:py-14 lg:py-20">
        <div>
          <p
            class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500"
          >
            Column Definitions
          </p>

          <h2
            class="mt-5 max-w-4xl font-display text-3xl font-normal uppercase leading-tight tracking-[-0.035em] text-base-950 sm:mt-6 sm:text-4xl"
          >
            How the tracker reads the legislative record
          </h2>

          <dl class="mt-8 grid gap-4 sm:mt-10 sm:grid-cols-2 lg:grid-cols-4">
            {
              columnDefinitions.map(([term, definition]) => (
                <div class="relative overflow-hidden rounded-2xl border border-base-400 bg-white p-5 shadow-lg ring-1 ring-base-950/5 lg:rounded-3xl">
                  <div
                    aria-hidden="true"
                    class="absolute inset-x-0 top-0 h-1 bg-accent-500"
                  >
                  </div>

                  <dt class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-base-950">
                    {term}
                  </dt>
                  <dd class="mt-4 font-sans text-sm leading-6 text-base-700">
                    {definition}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </Wrapper>
    </section>

    <section class="bg-base-50">
      <Wrapper variant="standard" class="py-12 sm:py-14 lg:py-20">
        <div class="grid gap-14 lg:gap-16">
          {
            standardSections.map((section) => {
              const id = sectionId(section.title);

              return (
                <section aria-labelledby={id}>
                  <div class="mb-6 sm:mb-8">
                    <p class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500">
                      Legislative Record
                    </p>

                    <h2
                      id={id}
                      class="mt-5 font-display text-3xl font-normal uppercase leading-tight tracking-[-0.035em] text-base-950 sm:mt-6 sm:text-4xl"
                    >
                      {section.title}
                    </h2>
                  </div>

                  <div class={tableWrapClass}>
                    <table class={tableClass}>
                      <thead>
                        <tr>
                          <th class={thClass}>Jurisdiction</th>
                          <th class={thClass}>Bill</th>
                          <th class={thClass}>Focus</th>
                          <th class={thClass}>Status</th>
                          <th class={thClass}>Policy Assumption</th>
                          <th class={thClass}>Governance Blind Spot</th>
                          <th class={thClass}>Classification</th>
                          <th class={thClass}>Legislative Outcome</th>
                        </tr>
                      </thead>

                      <tbody>
                        {
                          section.rows.map((row) => {
                            const c = classification(row.classification);

                            return (
                              <tr class={rowClass}>
                                <td class={tdStrongClass}>
                                  {row.jurisdiction}
                                </td>

                                <td class={tdStrongClass}>
                                  {row.url ? (
                                    <a
                                      href={row.url}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="font-semibold text-base-950 underline decoration-accent-500 underline-offset-4 transition-colors hover:text-accent-700"
                                    >
                                      {row.bill}
                                    </a>
                                  ) : (
                                    row.bill
                                  )}
                                </td>

                                <td class={tdStrongClass}>
                                  <span
                                    class="inline-flex rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.08em]"
                                    style={focusStyle(row.focus)}
                                  >
                                    {row.focus}
                                  </span>
                                </td>

                                <td
                                  class="border border-base-400 px-4 py-4 font-sans text-sm font-semibold leading-6"
                                  style={`color:${getStatusColor(row.status)};`}
                                >
                                  {row.status}
                                </td>

                                <td class={tdMutedClass}>{row.assumes}</td>

                                <td class={tdMutedClass}>
                                  {row.cannotMeasure}
                                </td>

                                <td class={tdStrongClass}>
                                  {c.href ? (
                                    <a href={c.href} class="inline-flex no-underline">
                                      <span
                                        class="inline-flex rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.08em]"
                                        style={classificationStyle(row.classification)}
                                      >
                                        {row.classification}
                                      </span>
                                    </a>
                                  ) : (
                                    <span
                                      class="inline-flex rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.08em]"
                                      style={classificationStyle(row.classification)}
                                    >
                                      {row.classification}
                                    </span>
                                  )}
                                </td>

                                <td class={tdMutedClass}>{row.notes}</td>
                              </tr>
                            );
                          })
                        }
                      </tbody>
                    </table>
                  </div>

                  <div class="grid gap-4 lg:hidden">
                    {
                      section.rows.map((row) => {
                        const c = classification(row.classification);

                        return (
                          <article class={mobileCardClass}>
                            <div
                              aria-hidden="true"
                              class="absolute inset-x-0 top-0 h-1 bg-accent-500"
                            >
                            </div>

                            <div class="grid gap-5">
                              <div>
                                <p class={mobileLabelClass}>Jurisdiction</p>
                                <p class="mt-1 font-sans text-base font-semibold leading-6 text-base-950">
                                  {row.jurisdiction}
                                </p>
                              </div>

                              <div>
                                <p class={mobileLabelClass}>Bill</p>
                                <p class={mobileValueClass}>
                                  {row.url ? (
                                    <a
                                      href={row.url}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="font-semibold text-base-950 underline decoration-accent-500 underline-offset-4"
                                    >
                                      {row.bill}
                                    </a>
                                  ) : (
                                    row.bill
                                  )}
                                </p>
                              </div>

                              <div class="grid gap-4 sm:grid-cols-2">
                                <div>
                                  <p class={mobileLabelClass}>Focus</p>
                                  <span
                                    class="mt-2 inline-flex rounded-full px-3 py-1 font-sans text-xs font-semibold uppercase tracking-[0.08em]"
                                    style={focusStyle(row.focus)}
                                  >
                                    {row.focus}
                                  </span>
                                </div>

                                <div>
                                  <p class={mobileLabelClass}>Status</p>
                                  <p
                                    class="mt-2 font-sans text-sm font-semibold leading-6"
                                    style={`color:${getStatusColor(row.status)};`}
                                  >
                                    {row.status}
                                  </p>
                                </div>
                              </div>

                              <div>
                                <p class={mobileLabelClass}>Policy Assumption</p>
                                <p class={mobileValueClass}>{row.assumes}</p>
                              </div>

                              <div>
                                <p class={mobileLabelClass}>
                                  Governance Blind Spot
                                </p>
                                <p class={mobileValueClass}>
                                  {row.cannotMeasure}
                                </p>
                              </div>

                              <div>
                                <p class={mobileLabelClass}>Classification</p>
                                <div class="mt-2">
                                  {c.href ? (
                                    <a href={c.href} class="inline-flex no-underline">
                                      <span
                                        class="inline-flex rounded-full px-3 py-1 font-sans text-xs font-semibold uppercase tracking-[0.08em]"
                                        style={classificationStyle(row.classification)}
                                      >
                                        {row.classification}
                                      </span>
                                    </a>
                                  ) : (
                                    <span
                                      class="inline-flex rounded-full px-3 py-1 font-sans text-xs font-semibold uppercase tracking-[0.08em]"
                                      style={classificationStyle(row.classification)}
                                    >
                                      {row.classification}
                                    </span>
                                  )}
                                </div>
                              </div>

                              <div>
                                <p class={mobileLabelClass}>
                                  Legislative Outcome
                                </p>
                                <p class={mobileValueClass}>{row.notes}</p>
                              </div>
                            </div>
                          </article>
                        );
                      })
                    }
                  </div>
                </section>
              );
            })
          }

          <section aria-labelledby="did-not-pass">
            <div class="mb-6 sm:mb-8">
              <p
                class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500"
              >
                Legislative Record
              </p>

              <h2
                id="did-not-pass"
                class="mt-5 font-display text-3xl font-normal uppercase leading-tight tracking-[-0.035em] text-base-950 sm:mt-6 sm:text-4xl"
              >
                Did Not Pass
              </h2>
            </div>

            <div class={tableWrapClass}>
              <table class={compactTableClass}>
                <thead>
                  <tr>
                    <th class={thClass}>Jurisdiction</th>
                    <th class={thClass}>Bill</th>
                    <th class={thClass}>Focus</th>
                    <th class={thClass}>Status</th>
                    <th class={thClass}>Assumed</th>
                    <th class={thClass}>Failure Confirms</th>
                    <th class={thClass}>Legislative Outcome</th>
                  </tr>
                </thead>

                <tbody>
                  {
                    DID_NOT_PASS.map((row) => (
                      <tr class={rowClass}>
                        <td class={tdStrongClass}>{row.jurisdiction}</td>

                        <td class={tdStrongClass}>
                          {row.url ? (
                            <a
                              href={row.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="font-semibold text-base-950 underline decoration-accent-500 underline-offset-4 transition-colors hover:text-accent-700"
                            >
                              {row.bill}
                            </a>
                          ) : (
                            row.bill
                          )}
                        </td>

                        <td class={tdStrongClass}>
                          <span
                            class="inline-flex rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.08em]"
                            style={focusStyle(row.focus)}
                          >
                            {row.focus}
                          </span>
                        </td>

                        <td
                          class="border border-base-400 px-4 py-4 font-sans text-sm font-semibold leading-6"
                          style={`color:${getStatusColor(row.status)};`}
                        >
                          {row.status}
                        </td>

                        <td class={tdMutedClass}>{row.assumed}</td>

                        <td class={tdMutedClass}>{row.failureConfirms}</td>

                        <td class={tdMutedClass}>{row.notes}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>

            <div class="grid gap-4 lg:hidden">
              {
                DID_NOT_PASS.map((row) => (
                  <article class={mobileCardClass}>
                    <div
                      aria-hidden="true"
                      class="absolute inset-x-0 top-0 h-1 bg-accent-500"
                    >
                    </div>

                    <div class="grid gap-5">
                      <div>
                        <p class={mobileLabelClass}>Jurisdiction</p>
                        <p class="mt-1 font-sans text-base font-semibold leading-6 text-base-950">
                          {row.jurisdiction}
                        </p>
                      </div>

                      <div>
                        <p class={mobileLabelClass}>Bill</p>
                        <p class={mobileValueClass}>
                          {row.url ? (
                            <a
                              href={row.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="font-semibold text-base-950 underline decoration-accent-500 underline-offset-4"
                            >
                              {row.bill}
                            </a>
                          ) : (
                            row.bill
                          )}
                        </p>
                      </div>

                      <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                          <p class={mobileLabelClass}>Focus</p>
                          <span
                            class="mt-2 inline-flex rounded-full px-3 py-1 font-sans text-xs font-semibold uppercase tracking-[0.08em]"
                            style={focusStyle(row.focus)}
                          >
                            {row.focus}
                          </span>
                        </div>

                        <div>
                          <p class={mobileLabelClass}>Status</p>
                          <p
                            class="mt-2 font-sans text-sm font-semibold leading-6"
                            style={`color:${getStatusColor(row.status)};`}
                          >
                            {row.status}
                          </p>
                        </div>
                      </div>

                      <div>
                        <p class={mobileLabelClass}>Assumed</p>
                        <p class={mobileValueClass}>{row.assumed}</p>
                      </div>

                      <div>
                        <p class={mobileLabelClass}>Failure Confirms</p>
                        <p class={mobileValueClass}>
                          {row.failureConfirms}
                        </p>
                      </div>

                      <div>
                        <p class={mobileLabelClass}>Legislative Outcome</p>
                        <p class={mobileValueClass}>{row.notes}</p>
                      </div>
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          <section aria-labelledby="advisory-instruments">
            <div class="mb-6 sm:mb-8">
              <p
                class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500"
              >
                Non-Legislative Instruments
              </p>

              <h2
                id="advisory-instruments"
                class="mt-5 font-display text-3xl font-normal uppercase leading-tight tracking-[-0.035em] text-base-950 sm:mt-6 sm:text-4xl"
              >
                Advisory / Non-Legislative Instruments
              </h2>
            </div>

            <div class={tableWrapClass}>
              <table class={compactTableClass}>
                <thead>
                  <tr>
                    <th class={thClass}>Jurisdiction</th>
                    <th class={thClass}>Instrument</th>
                    <th class={thClass}>Focus</th>
                    <th class={thClass}>Status</th>
                    <th class={thClass}>Structural Role</th>
                    <th class={thClass}>Classification</th>
                    <th class={thClass}>Legislative Outcome</th>
                  </tr>
                </thead>

                <tbody>
                  {
                    ADVISORY.map((row) => {
                      const c = classification(row.classification);

                      return (
                        <tr class={rowClass}>
                          <td class={tdStrongClass}>{row.jurisdiction}</td>

                          <td class={tdStrongClass}>
                            {row.url ? (
                              <a
                                href={row.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-semibold text-base-950 underline decoration-accent-500 underline-offset-4 transition-colors hover:text-accent-700"
                              >
                                {row.instrument}
                              </a>
                            ) : (
                              row.instrument
                            )}
                          </td>

                          <td class={tdStrongClass}>
                            <span
                              class="inline-flex rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.08em]"
                              style={focusStyle(row.focus)}
                            >
                              {row.focus}
                            </span>
                          </td>

                          <td
                            class="border border-base-400 px-4 py-4 font-sans text-sm font-semibold leading-6"
                            style={`color:${getStatusColor(row.status)};`}
                          >
                            {row.status}
                          </td>

                          <td class={tdMutedClass}>{row.structuralRole}</td>

                          <td class={tdStrongClass}>
                            {c.href ? (
                              <a href={c.href} class="inline-flex no-underline">
                                <span
                                  class="inline-flex rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.08em]"
                                  style={classificationStyle(row.classification)}
                                >
                                  {row.classification}
                                </span>
                              </a>
                            ) : (
                              <span
                                class="inline-flex rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.08em]"
                                style={classificationStyle(row.classification)}
                              >
                                {row.classification}
                              </span>
                            )}
                          </td>

                          <td class={tdMutedClass}>{row.notes}</td>
                        </tr>
                      );
                    })
                  }
                </tbody>
              </table>
            </div>

            <div class="grid gap-4 lg:hidden">
              {
                ADVISORY.map((row) => {
                  const c = classification(row.classification);

                  return (
                    <article class={mobileCardClass}>
                      <div
                        aria-hidden="true"
                        class="absolute inset-x-0 top-0 h-1 bg-accent-500"
                      >
                      </div>

                      <div class="grid gap-5">
                        <div>
