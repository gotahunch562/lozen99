---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

import {
  FEDERAL,
  ENACTED,
  ACTIVE,
  DID_NOT_PASS,
  ADVISORY,
  CLUSTER_LINKS,
  IA_LINK,
} from "@/data/menopauseTracker";

const title = "Menopause Legislation Tracker 2026";
const description =
  "A governance audit of state-by-state workplace menopause legislation. Each instrument is classified by its structural activation condition and the population its disclosure requirement does not reach.";

const reportSchema = {
  "@context": "https://schema.org",
  "@type": "Report",
  name: "Menopause Legislation Tracker 2026",
  description:
    "An institutional audit of state-by-state menopause policy. Lozen Advisory classifies legislative instruments by their structural assumptions and the specific populations they architecturally exclude.",
  url: "https://www.lozenadvisory.com/menopause-legislation-tracker",
  author: {
    "@type": "Organization",
    name: "Lozen Advisory",
    url: "https://www.lozenadvisory.com",
  },
  datePublished: "2026-04-15",
  dateModified: "2026-04-30",
  keywords:
    "menopause legislation, menopause workplace policy, menopause benefits, disclosure-dependent systems, Invisible Attrition, Tacere",
  audience: {
    "@type": "Audience",
    audienceType: "Governance and Policy Leaders",
  },
};

const focusClassByLabel: Record<string, string> = {
  Workplace: "lozen-policy-cell--01",
  Insurance: "lozen-policy-cell--04",
  Education: "lozen-policy-cell--08",
  Omnibus: "lozen-policy-cell--12",
  Advisory: "lozen-policy-cell--15",
  "Military / Veteran": "lozen-policy-cell--18",
  "Veteran Care": "lozen-policy-cell--22",
};

const classificationClassByLabel: Record<string, string> = {
  "Dashboard Delay": "lozen-policy-cell--06",
  Tacere: "lozen-policy-cell--09",
  "Invisible Attrition": "lozen-policy-cell--17",
  "Outside Scope": "lozen-policy-cell--20",
  "No Classification": "lozen-policy-cell--23",
};

const focusBadgeClass = (label: string) =>
  `lozen-data-badge ${focusClassByLabel[label] || "lozen-data-badge--neutral"}`;

const statusModifier = (status: string) => {
  if (/died/i.test(status)) {
    return "lozen-policy-cell--14";
  }

  if (/did not pass|failed|withdrawn/i.test(status)) {
    return "lozen-policy-cell--13";
  }

  if (/returned|substitute/i.test(status)) {
    return "lozen-policy-cell--07";
  }

  if (/signed/i.test(status)) {
    return "lozen-policy-cell--03";
  }

  if (/enacted/i.test(status)) {
    return "lozen-policy-cell--11";
  }

  if (/passed/i.test(status)) {
    return "lozen-policy-cell--21";
  }

  if (/calendar/i.test(status)) {
    return "lozen-policy-cell--02";
  }

  if (/committee/i.test(status)) {
    return "lozen-policy-cell--05";
  }

  if (/introduced|pending/i.test(status)) {
    return "lozen-policy-cell--16";
  }

  if (/study|research/i.test(status)) {
    return "lozen-policy-cell--19";
  }

  if (/active|house|senate/i.test(status)) {
    return "lozen-policy-cell--10";
  }

  return "lozen-data-badge--neutral";
};

const statusCellClass = (_status: string) => "lozen-tracker-status-cell";

const statusBadgeClass = (status: string) =>
  `lozen-tracker-status-badge ${statusModifier(status)}`;

const classification = (label: string) => {
  const badgeClass =
    classificationClassByLabel[label] || "lozen-data-badge--neutral";
  const href =
    CLUSTER_LINKS[label] ||
    (label === "Invisible Attrition" ? IA_LINK : undefined);
  return { badgeClass, href };
};

const classificationBadgeClass = (label: string) =>
  `lozen-data-badge ${classification(label).badgeClass}`;

const sectionId = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const standardSections = [
  { title: "Federal", rows: FEDERAL, theme: "federal" },
  { title: "Enacted / Passed", rows: ENACTED, theme: "enacted" },
  { title: "Active / In Committee", rows: ACTIVE, theme: "active" },
];

const trackerStats = [
  { label: "Federal", value: FEDERAL.length },
  { label: "Enacted", value: ENACTED.length },
  { label: "Active", value: ACTIVE.length },
  { label: "Did Not Pass", value: DID_NOT_PASS.length },
  { label: "Advisory", value: ADVISORY.length },
];

const columnDefinitions = [
  ["State / Level", "Jurisdiction."],
  ["Bill", "Bill number and short title."],
  [
    "Focus",
    "Primary domain: Workplace, Insurance, Education, Omnibus, Military / Veteran, Veteran Care, or Advisory.",
  ],
  ["Status", "Current legislative status as of April 30, 2026."],
  [
    "Policy Assumption",
    "The disclosure or participation condition the law requires to activate.",
  ],
  [
    "Governance Blind Spot",
    "The population or condition outside the formal system the law produces.",
  ],
  [
    "Lozen Classification",
    "The Invisible Attrition℠ condition this gap represents.",
  ],
  [
    "Legislative Outcome",
    "Observations from the bill text or legislative record with strategic or analytical value beyond the core gap classification.",
  ],
];

const tableWrapClass = (theme = "default") => `lozen-tracker-table-wrap lozen-tracker-table-wrap--${theme}`;

const tableClass = "lozen-tracker-table";
const compactTableClass = "lozen-tracker-table lozen-tracker-table--compact";
const thClass = "lozen-tracker-th";

const tdStrongClass = "lozen-tracker-td lozen-tracker-td--strong";

const tdMutedClass = "lozen-tracker-td";

const rowClass = "lozen-tracker-row";
const mobileCardClass = "lozen-tracker-mobile-card";

const mobileLabelClass = "lozen-tracker-mobile-label";

const mobileValueClass = "lozen-tracker-mobile-value";
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(reportSchema)} />

  <main class="lozen-tracker-page">
    <section class="lozen-tracker-hero">
      <Wrapper variant="standard" class="py-14 sm:py-20 lg:py-28">
        <div
          class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(320px,0.55fr)] lg:items-end lg:gap-12"
        >
          <div class="max-w-5xl">
            <p
              class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-700"
            >
              Legislative Governance Risk Index
            </p>

            <h1
              class="mt-6 max-w-5xl font-display text-4xl font-normal uppercase leading-[1.02] tracking-[-0.04em] text-base-950 sm:mt-8 sm:text-5xl lg:text-6xl"
            >
              Menopause Legislation Tracker 2026
            </h1>

            <p class="mt-6 max-w-3xl font-sans text-base leading-7 text-base-700 sm:mt-7 sm:text-lg sm:leading-8">
              A state-by-state classification of menopause policy instruments by the assumptions they require, the participation conditions they activate, and the women they cannot reach.
            </p>

            <p
              class="mt-7 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500 sm:mt-8"
            >
              Last updated: April 30, 2026
            </p>

            <div class="lozen-tracker-stat-grid" aria-label="Tracker record counts">
              {
                trackerStats.map((stat) => (
                  <div class="lozen-tracker-stat">
                    <strong>{stat.value}</strong>
                    <span>{stat.label}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <aside class="lozen-tracker-insight-card p-5 sm:p-6 lg:rounded-3xl" >
            <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1 bg-accent-500" >
            </div>
            <p class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500" >
              Audit thesis
            </p>
            <p class="mt-5 font-display text-2xl font-normal uppercase leading-tight tracking-[-0.025em] text-base-950" >
              The legislation is visible.
              The nondisclosing population is not.
            </p>
            <p class="mt-5 font-sans text-sm leading-6 text-base-700">
              Each framework creates a formal system.
              Each system activates only after an initiating act.
            </p>
          </aside>
        </div>
      </Wrapper>
    </section>

    <section class="lozen-tracker-section">
      <Wrapper variant="standard" class="py-12 sm:py-14 lg:py-20">
        <div class="mx-auto max-w-4xl">
          <p class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500" >
            Executive Summary
          </p>
          <h2 class="mt-5 font-display text-3xl font-normal uppercase tracking-[-0.03em] text-base-950 sm:text-4xl" >
            The Measurement Gap
          </h2>
          <div class="mt-7 grid gap-5 font-sans text-base leading-8 text-base-700 sm:mt-8 sm:text-lg sm:leading-9" >
            <p>
              This audit documents a structural friction between legislative design and workforce behavior. Across 2026, state-level menopause initiatives rely almost exclusively on a disclosure-dependent model. To access an accommodation, an employee must declare their status; to trigger a benefit provision, an insured individual must generate a clinical code.
            </p>
            <p>
              By structuring state interventions around the point of visibility, governance frameworks fail to account for workplace attrition that occurs prior to formal disclosure. The records below categorize each instrument by its explicit legal design and the population left uncounted by that design.
            </p>
          </div>
        </div>
      </Wrapper>
    </section>

    {
      standardSections.map((section) => (
        <section id={sectionId(section.title)} class="lozen-tracker-section border-t border-base-200 bg-white even:bg-base-50">
          <Wrapper variant="standard" class="py-12 sm:py-16 lg:py-24">
            <div class="mb-8 sm:mb-12">
              <p class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500">
                Data Set
              </p>
              <h2 class="mt-4 font-display text-2xl font-normal uppercase tracking-[-0.02em] text-base-950 sm:text-3xl">
                {section.title} Legislation
              </h2>
            </div>

            <div class={tableWrapClass(section.theme)}>
              <table class={tableClass}>
                <thead>
                  <tr>
                    {columnDefinitions.map(([title, tooltip]) => (
                      <th class={thClass} title={tooltip}>{title}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {section.rows.map((row) => (
                    <tr class={rowClass}>
                      <td class={tdStrongClass}>{row.state}</td>
                      <td class={tdStrongClass}>
                        {row.billUrl ? (
                          <a href={row.billUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent-600 transition-colors">
                            {row.bill}
                          </a>
                        ) : (
                          row.bill
                        )}
                      </td>
                      <td class={tdMutedClass}>
                        <span class={focusBadgeClass(row.focus)}>{row.focus}</span>
                      </td>
                      <td class={statusCellClass(row.status)}>
                        <span class={statusBadgeClass(row.status)}>{row.status}</span>
                      </td>
                      <td class={tdMutedClass}>{row.assumption}</td>
                      <td class={tdMutedClass}>{row.blindSpot}</td>
                      <td class={tdMutedClass}>
                        {classification(row.classification).href ? (
                          <a href={classification(row.classification).href} class={classificationBadgeClass(row.classification)}>
                            {row.classification}
                          </a>
                        ) : (
                          <span class={classificationBadgeClass(row.classification)}>{row.classification}</span>
                        )}
                      </td>
                      <td class={tdMutedClass}>{row.outcome}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="grid gap-6 md:hidden">
              {section.rows.map((row) => (
                <div class={mobileCardClass}>
                  <div class="flex flex-wrap items-start justify-between gap-2 border-b border-base-100 pb-3">
                    <div>
                      <span class={mobileLabelClass}>Jurisdiction</span>
                      <div class={`${mobileValueClass} font-bold text-base-950`}>{row.state}</div>
                    </div>
                    <div>
                      <span class={mobileLabelClass}>Bill</span>
                      <div class={`${mobileValueClass} font-bold text-accent-700`}>
                        {row.billUrl ? (
                          <a href={row.billUrl} target="_blank" rel="noopener noreferrer">
                            {row.bill}
                          </a>
                        ) : (
                          row.bill
                        )}
                      </div>
                    </div>
                  </div>

                  <div class="grid grid-cols-2 gap-4 pt-3">
                    <div>
                      <span class={mobileLabelClass}>Focus</span>
                      <div class="mt-1">
                        <span class={focusBadgeClass(row.focus)}>{row.focus}</span>
                      </div>
                    </div>
                    <div>
                      <span class={mobileLabelClass}>Status</span>
                      <div class="mt-1">
                        <span class={statusBadgeClass(row.status)}>{row.status}</span>
                      </div>
                    </div>
                  </div>

                  <div class="mt-4 border-t border-base-100 pt-3">
                    <span class={mobileLabelClass}>Policy Assumption</span>
                    <div class={mobileValueClass}>{row.assumption}</div>
                  </div>

                  <div class="mt-3">
                    <span class={mobileLabelClass}>Governance Blind Spot</span>
                    <div class={mobileValueClass}>{row.blindSpot}</div>
                  </div>

                  <div class="mt-4 border-t border-base-100 pt-3">
                    <span class={mobileLabelClass}>Lozen Classification</span>
                    <div class="mt-1">
                      {classification(row.classification).href ? (
                        <a href={classification(row.classification).href} class={classificationBadgeClass(row.classification)}>
                          {row.classification}
                        </a>
                      ) : (
                        <span class={classificationBadgeClass(row.classification)}>{row.classification}</span>
                      )}
                    </div>
                  </div>

                  <div class="mt-3">
                    <span class={mobileLabelClass}>Legislative Outcome</span>
                    <div class={mobileValueClass}>{row.outcome}</div>
                  </div>
                </div>
              ))}
            </div>
          </Wrapper>
        </section>
      ))
    }

    <section id="did-not-pass" class="lozen-tracker-section border-t border-base-200 bg-white">
      <Wrapper variant="standard" class="py-12 sm:py-16 lg:py-24">
        <div class="mb-8 sm:mb-12">
          <p class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500">
            Data Set
          </p>
          <h2 class="mt-4 font-display text-2xl font-normal uppercase tracking-[-0.02em] text-base-950 sm:text-3xl">
            Bills That Did Not Pass
          </h2>
        </div>

        <div class={tableWrapClass("failed")}>
          <table class={compactTableClass}>
            <thead>
              <tr>
                {columnDefinitions.map(([title, tooltip]) => (
                  <th class={thClass} title={tooltip}>{title}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {DID_NOT_PASS.map((row) => (
                <tr class={rowClass}>
                  <td class={tdStrongClass}>{row.state}</td>
                  <td class={tdStrongClass}>
                    {row.billUrl ? (
                      <a href={row.billUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent-600 transition-colors">
                        {row.bill}
                      </a>
                    ) : (
                      row.bill
                    )}
                  </td>
                  <td class={tdMutedClass}>
                    <span class={focusBadgeClass(row.focus)}>{row.focus}</span>
                  </td>
                  <td class={statusCellClass(row.status)}>
                    <span class={statusBadgeClass(row.status)}>{row.status}</span>
                  </td>
                  <td class={tdMutedClass}>{row.assumption}</td>
                  <td class={tdMutedClass}>{row.blindSpot}</td>
                  <td class={tdMutedClass}>
                    {classification(row.classification).href ? (
                      <a href={classification(row.classification).href} class={classificationBadgeClass(row.classification)}>
                        {row.classification}
                      </a>
                    ) : (
                      <span class={classificationBadgeClass(row.classification)}>{row.classification}</span>
                    )}
                  </td>
                  <td class={tdMutedClass}>{row.outcome}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="grid gap-6 md:hidden">
          {DID_NOT_PASS.map((row) => (
            <div class={mobileCardClass}>
              <div class="flex flex-wrap items-start justify-between gap-2 border-b border-base-100 pb-3">
                <div>
                  <span class={mobileLabelClass}>Jurisdiction</span>
                  <div class={`${mobileValueClass} font-bold text-base-950`}>{row.state}</div>
                </div>
                <div>
                  <span class={mobileLabelClass}>Bill</span>
                  <div class={`${mobileValueClass} font-bold text-accent-700`}>
                    {row.billUrl ? (
                      <a href={row.billUrl} target="_blank" rel="noopener noreferrer">
                        {row.bill}
                      </a>
                    ) : (
                      row.bill
                    )}
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-4 pt-3">
                <div>
                  <span class={mobileLabelClass}>Focus</span>
                  <div class="mt-1">
                    <span class={focusBadgeClass(row.focus)}>{row.focus}</span>
                  </div>
                </div>
                <div>
                  <span class={mobileLabelClass}>Status</span>
                  <div class="mt-1">
                    <span class={statusBadgeClass(row.status)}>{row.status}</span>
                  </div>
                </div>
              </div>

              <div class="mt-4 border-t border-base-100 pt-3">
                <span class={mobileLabelClass}>Policy Assumption</span>
                <div class={mobileValueClass}>{row.assumption}</div>
              </div>

              <div class="mt-3">
                <span class={mobileLabelClass}>Governance Blind Spot</span>
                <div class={mobileValueClass}>{row.blindSpot}</div>
              </div>

              <div class="mt-4 border-t border-base-100 pt-3">
                <span class={mobileLabelClass}>Lozen Classification</span>
                <div class="mt-1">
                  {classification(row.classification).href ? (
                    <a href={classification(row.classification).href} class={classificationBadgeClass(row.classification)}>
                      {row.classification}
                    </a>
                  ) : (
                    <span class={classificationBadgeClass(row.classification)}>{row.classification}</span>
                  )}
                </div>
              </div>

              <div class="mt-3">
                <span class={mobileLabelClass}>Legislative Outcome</span>
                <div class={mobileValueClass}>{row.outcome}</div>
              </div>
            </div>
          ))}
        </div>
      </Wrapper>
    </section>

    <section id="advisory-boards" class="lozen-tracker-section border-t border-base-200 bg-base-50">
      <Wrapper variant="standard" class="py-12 sm:py-16 lg:py-24">
        <div class="mb-8 sm:mb-12">
          <p class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500">
            Data Set
          </p>
          <h2 class="mt-4 font-display text-2xl font-normal uppercase tracking-[-0.02em] text-base-950 sm:text-3xl">
            Advisory Boards & Commissions
          </h2>
        </div>

        <div class={tableWrapClass("advisory")}>
          <table class={compactTableClass}>
            <thead>
              <tr>
                {columnDefinitions.map(([title, tooltip]) => (
                  <th class={thClass} title={tooltip}>{title}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {ADVISORY.map((row) => (
                <tr class={rowClass}>
                  <td class={tdStrongClass}>{row.state}</td>
                  <td class={tdStrongClass}>
                    {row.billUrl ? (
                      <a href={row.billUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent-600 transition-colors">
                        {row.bill}
                      </a>
                    ) : (
                      row.bill
                    )}
                  </td>
                  <td class={tdMutedClass}>
                    <span class={focusBadgeClass(row.focus)}>{row.focus}</span>
                  </td>
                  <td class={statusCellClass(row.status)}>
                    <span class={statusBadgeClass(row.status)}>{row.status}</span>
                  </td>
                  <td class={tdMutedClass}>{row.assumption}</td>
                  <td class={tdMutedClass}>{row.blindSpot}</td>
                  <td class={tdMutedClass}>
                    {classification(row.classification).href ? (
                      <a href={classification(row.classification).href} class={classificationBadgeClass(row.classification)}>
                        {row.classification}
                      </a>
                    ) : (
                      <span class={classificationBadgeClass(row.classification)}>{row.classification}</span>
                    )}
                  </td>
                  <td class={tdMutedClass}>{row.outcome}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="grid gap-6 md:hidden">
          {ADVISORY.map((row) => (
            <div class={mobileCardClass}>
              <div class="flex flex-wrap items-start justify-between gap-2 border-b border-base-100 pb-3">
                <div>
                  <span class={mobileLabelClass}>Jurisdiction</span>
                  <div class={`${mobileValueClass} font-bold text-base-950`}>{row.state}</div>
                </div>
                <div>
                  <span class={mobileLabelClass}>Bill</span>
                  <div class={`${mobileValueClass} font-bold text-accent-700`}>
                    {row.billUrl ? (
                      <a href={row.billUrl} target="_blank" rel="noopener noreferrer">
                        {row.bill}
                      </a>
                    ) : (
                      row.bill
                    )}
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-4 pt-3">
                <div>
                  <span class={mobileLabelClass}>Focus</span>
                  <div class="mt-1">
                    <span class={focusBadgeClass(row.focus)}>{row.focus}</span>
                  </div>
                </div>
                <div>
                  <span class={mobileLabelClass}>Status</span>
                  <div class="mt-1">
                    <span class={statusBadgeClass(row.status)}>{row.status}</span>
                  </div>
                </div>
              </div>

              <div class="mt-4 border-t border-base-100 pt-3">
                <span class={mobileLabelClass}>Policy Assumption</span>
                <div class={mobileValueClass}>{row.assumption}</div>
              </div>

              <div class="mt-3">
                <span class={mobileLabelClass}>Governance Blind Spot</span>
                <div class={mobileValueClass}>{row.blindSpot}</div>
              </div>

              <div class="mt-4 border-t border-base-100 pt-3">
                <span class={mobileLabelClass}>Lozen Classification</span>
                <div class="mt-1">
                  {classification(row.classification).href ? (
                    <a href={classification(row.classification).href} class={classificationBadgeClass(row.classification)}>
                      {row.classification}
                    </a>
                  ) : (
                    <span class={classificationBadgeClass(row.classification)}>{row.classification}</span>
                  )}
                </div>
              </div>

              <div class="mt-3">
                <span class={mobileLabelClass}>Legislative Outcome</span>
                <div class={mobileValueClass}>{row.outcome}</div>
              </div>
            </div>
          ))}
        </div>
      </Wrapper>
    </section>

    <section class="lozen-tracker-section border-t border-base-200 bg-white">
      <Wrapper variant="standard" class="py-12 sm:py-14 lg:py-20">
        <div class="mx-auto max-w-4xl">
          <p
            class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500"
          >
            Closing Analysis
          </p>

          <div
            class="mt-7 grid gap-5 font-sans text-base leading-8 text-base-700 sm:mt-8 sm:text-lg sm:leading-9"
          >
            <p>
              The pattern across every entry in this table is consistent with the framework this site has developed across its policy series. Each law creates a formal system. Each formal system activates at the point of participation. The population that has already decided participation carries more professional risk than it returns is not reflected in the utilization data, the leave records, the accommodation requests, or the workforce study findings any of these laws will produce.
            </p>

            <p>
              That population is not small. The Michigan Women's Commission found that fewer than one in five women disclosed their menopause status at work. The Bank of America and National Menopause Foundation study found a 73-point gap between HR managers who believed they were having the conversation and employees who said they had it.
            </p>

            <p>
              The legislation is real. The protections are meaningful for the women who use them. The measurement gap is structural.
            </p>
          </div>
        </div>
      </Wrapper>
    </section>
  </main>
</BaseLayout>
