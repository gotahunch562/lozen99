                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-semibold text-base-950 underline decoration-accent-500 underline-offset-4"
                              >
                                {row.instrument}
                              </a>
                            ) : (
                              row.instrument
                            )}
                          </p>
                        </div>

                        <div class="grid gap-4 sm:grid-cols-2">
                          <div>
                            <p class={mobileLabelClass}>Focus</p>
                            <span
                              class="mt-2 inline-flex rounded-full px-3 py-1 font-sans text-xs font-semibold uppercase tracking-[0.08em]"
                              style={focusStyle(row.focus)}
                            >
                              {row.focus}
                            </span>
                          </div>

                          <div>
                            <p class={mobileLabelClass}>Status</p>
                            <p
                              class="mt-2 font-sans text-sm font-semibold leading-6"
                              style={`color:${getStatusColor(row.status)};`}
                            >
                              {row.status}
                            </p>
                          </div>
                        </div>

                        <div>
                          <p class={mobileLabelClass}>Structural Role</p>
                          <p class={mobileValueClass}>
                            {row.structuralRole}
                          </p>
                        </div>

                        <div>
                          <p class={mobileLabelClass}>Classification</p>
                          <div class="mt-2">
                            {c.href ? (
                              <a href={c.href} class="inline-flex no-underline">
                                <span
                                  class="inline-flex rounded-full px-3 py-1 font-sans text-xs font-semibold uppercase tracking-[0.08em]"
                                  style={classificationStyle(row.classification)}
                                >
                                  {row.classification}
                                </span>
                              </a>
                            ) : (
                              <span
                                class="inline-flex rounded-full px-3 py-1 font-sans text-xs font-semibold uppercase tracking-[0.08em]"
                                style={classificationStyle(row.classification)}
                              >
                                {row.classification}
                              </span>
                            )}
                          </div>
                        </div>

                        <div>
                          <p class={mobileLabelClass}>Legislative Outcome</p>
                          <p class={mobileValueClass}>{row.notes}</p>
                        </div>
                      </div>
                    </article>
                  );
                })
              }
            </div>
          </section>
        </div>
      </Wrapper>
    </section>

    <section class="bg-white">
      <Wrapper variant="standard" class="py-12 sm:py-14 lg:py-20">
        <div class="mx-auto max-w-4xl">
          <p
            class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500"
          >
            Closing Analysis
          </p>

          <div
            class="mt-7 grid gap-5 font-sans text-base leading-8 text-base-700 sm:mt-8 sm:text-lg sm:leading-9"
          >
            <p>
              The pattern across every entry in this table is consistent with the framework this site has developed across its policy series. Each law creates a formal system. Each formal system activates at the point of participation. The population that has already decided participation carries more professional risk than it returns is not reflected in the utilization data, the leave records, the accommodation requests, or the workforce study findings any of these laws will produce.
            </p>

            <p>
              That population is not small. The Michigan Women's Commission found that fewer than one in five women disclosed their menopause status at work. The Bank of America and National Menopause Foundation study found a 73-point gap between HR managers who believed they were having the conversation and employees who said they had it.
            </p>

            <p>
              The legislation is real. The protections are meaningful for the women who use them. The measurement gap is structural.
            </p>
          </div>
        </div>
      </Wrapper>
    </section>
  </main>
