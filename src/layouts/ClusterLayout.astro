---
/**
 * ClusterLayout.astro
 * src/layouts/ClusterLayout.astro
 *
 * Frontmatter fields expected from the .md file:
 *   title, heading, subtitle, metaDescription, pubDate, clusterNumber,
 *   pillarSlug, pillarTitle, prevCluster, nextCluster
 *
 * In Astro, markdown frontmatter is passed as Astro.props.frontmatter
 * when the file uses the layout: field. All fields destructure from there.
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const { frontmatter } = Astro.props;

const {
  title,
  heading,
  subtitle,
  metaDescription,
  pubDate,
  clusterNumber,
  pillarSlug,
  pillarTitle,
  prevCluster,
  nextCluster,
} = frontmatter;

const pageTitle = title || heading || "Lozen Advisory";
const pageDescription = metaDescription || subtitle || "";

const formattedDate = pubDate
  ? new Date(pubDate).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "2-digit",
    })
  : "";

const clusterLabel = clusterNumber
  ? String(clusterNumber).padStart(2, "0")
  : "00";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Page header -->
  <section class="overflow-hidden border-b border-base-200 bg-white">
    <Wrapper
      variant="standard"
      class="pt-28 pb-12 sm:pt-32 sm:pb-14 lg:pt-36 lg:pb-16"
    >
      <div class="mx-auto max-w-5xl">
        {
          pillarSlug && pillarTitle && (
            <a
              href={pillarSlug}
              class="inline-flex font-sans text-sm font-semibold text-base-500 transition-colors duration-200 hover:text-accent-700"
            >
              ← {pillarTitle}
            </a>
          )
        }

        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
          <Text
            tag="span"
            variant="textSM"
            class="border-l border-accent-500 pl-4 font-sans font-semibold uppercase tracking-[0.18em] text-base-700"
          >
            Cluster {clusterLabel} · {pillarTitle}
          </Text>

          {
            pubDate && (
              <time
                datetime={pubDate}
                class="font-sans text-sm font-medium text-base-500"
              >
                {formattedDate}
              </time>
            )
          }
        </div>

        <Text
          tag="h1"
          variant="displayLG"
          class="mt-7 max-w-4xl font-display font-normal uppercase leading-[1.02] tracking-[-0.04em] text-base-950 sm:mt-8"
        >
          {heading}
        </Text>

        {
          subtitle && (
            <Text
              tag="p"
              variant="textLG"
              class="mt-5 max-w-3xl font-sans leading-8 text-base-700"
            >
              {subtitle}
            </Text>
          )
        }
      </div>
    </Wrapper>
  </section>

  <!-- Article body -->
  <section class="bg-white">
    <Wrapper
      variant="prose"
      class="cluster-article py-10 sm:py-12 lg:py-16 prose-headings:font-display prose-headings:font-normal prose-headings:uppercase prose-headings:tracking-[-0.025em] prose-headings:text-base-950 prose-h2:mt-14 prose-h2:mb-6 prose-h2:text-2xl sm:prose-h2:text-3xl prose-p:font-sans prose-p:text-base-700 prose-p:leading-8 sm:prose-p:leading-9 prose-a:font-semibold prose-a:text-accent-700 prose-a:decoration-accent-500 prose-a:underline-offset-4 hover:prose-a:text-base-950"
    >
      <slot />
    </Wrapper>
  </section>

  <!-- Cluster pagination -->
  <section class="border-t border-base-200 bg-white">
    <Wrapper variant="standard" class="py-10 sm:py-12 lg:py-14">
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-4 sm:grid-cols-3 sm:items-stretch">
          <div>
            {
              prevCluster?.slug ? (
                <a
                  href={prevCluster.slug}
                  class="group flex h-full flex-col justify-between rounded-2xl border border-base-300 bg-base-50 p-5 no-underline shadow-sm ring-1 ring-base-950/5 transition-all duration-300 hover:-translate-y-1 hover:border-accent-500 hover:bg-white hover:shadow-lg"
                >
                  <span class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500">
                    ← Previous
                  </span>

                  <span class="mt-4 font-display text-base font-normal uppercase leading-snug tracking-[-0.015em] text-base-950 transition-colors duration-200 group-hover:text-accent-700">
                    {prevCluster.title}
                  </span>
                </a>
              ) : (
                <div class="hidden h-full rounded-2xl border border-transparent sm:block" />
              )
            }
          </div>

          <div>
            {
              pillarSlug && pillarTitle && (
                <a
                  href={pillarSlug}
                  class="group flex h-full min-h-[8rem] flex-col items-center justify-center rounded-2xl border border-base-400 bg-white p-5 text-center no-underline shadow-lg ring-1 ring-base-950/5 transition-all duration-300 hover:-translate-y-1 hover:border-accent-500 hover:shadow-xl"
                >
                  <span class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-accent-700">
                    Framework
                  </span>

                  <span class="mt-4 font-display text-base font-normal uppercase leading-snug tracking-[-0.015em] text-base-950 transition-colors duration-200 group-hover:text-accent-700">
                    Back to {pillarTitle}
                  </span>
                </a>
              )
            }
          </div>

          <div>
            {
              nextCluster?.slug ? (
                <a
                  href={nextCluster.slug}
                  class="group flex h-full flex-col justify-between rounded-2xl border border-base-300 bg-base-50 p-5 text-left no-underline shadow-sm ring-1 ring-base-950/5 transition-all duration-300 hover:-translate-y-1 hover:border-accent-500 hover:bg-white hover:shadow-lg sm:text-right"
                >
                  <span class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-500">
                    Next →
                  </span>

                  <span class="mt-4 font-display text-base font-normal uppercase leading-snug tracking-[-0.015em] text-base-950 transition-colors duration-200 group-hover:text-accent-700">
                    {nextCluster.title}
                  </span>
                </a>
              ) : (
                <div class="hidden h-full rounded-2xl border border-transparent sm:block" />
              )
            }
          </div>
        </div>
      </div>
    </Wrapper>
  </section>

  <!-- Briefing CTA -->
  <section class="border-t border-base-200 bg-white">
    <Wrapper variant="standard" class="py-12 sm:py-16 lg:py-20">
      <div class="mx-auto max-w-5xl">
        <div
          class="relative overflow-hidden rounded-2xl border border-base-800 bg-base-950 p-6 shadow-2xl ring-1 ring-base-950/20 sm:p-8 lg:rounded-3xl lg:p-10"
        >
          <div
            aria-hidden="true"
            class="absolute inset-x-0 top-0 h-1 bg-accent-500"
          >
          </div>

          <div class="max-w-3xl">
            <Text
              tag="span"
              variant="textSM"
              class="font-sans font-semibold uppercase tracking-[0.18em] text-accent-300"
            >
              Strategic Briefing
            </Text>

            <Text
              tag="h2"
              variant="displayXS"
              class="mt-4 font-display font-normal uppercase leading-tight tracking-[-0.02em] text-white"
            >
              Invisible Attrition℠ Retention Risk Audit
            </Text>

            <Text
              tag="p"
              variant="textBase"
              class="mt-4 max-w-2xl font-sans leading-7 text-base-300"
            >
              A strategic consultation to identify why clean performance records
              and engagement scores can mask compounding leadership continuity risk.
            </Text>

            <Button
              isLink
              href="/request-briefing"
              variant="accent"
              size="sm"
              class="mt-7 w-fit"
            >
              Request Briefing →
            </Button>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
