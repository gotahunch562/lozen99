---
/**
 * PillarLayout.astro
 * Layout for pillar pages (e.g., /invisible-attrition).
 * Wraps inside BaseLayout. Uses project design system components only.
 *
 * Frontmatter fields (set in the .md file):
 *   title          — <title> tag and og:title
 *   heading        — rendered as <h1>
 *   subtitle       — deck line below heading (optional)
 *   slug           — canonical path, e.g. /invisible-attrition
 *   metaDescription
 *   datePublished  — ISO date string, e.g. 2026-02-15
 *   dateModified   — ISO date string (optional)
 *   heroImage      — path relative to /public (optional)
 *   heroAlt        — required if heroImage is set
 *   clusters       — array of { slug, title, description }
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

export interface ClusterLink {
  slug: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  heading: string;
  subtitle?: string;
  slug: string;
  metaDescription: string;
  datePublished: string;
  dateModified?: string;
  heroImage?: string;
  heroAlt?: string;
  clusters?: ClusterLink[];
}

const {
  heading,
  subtitle,
  datePublished,
  heroImage,
  heroAlt = "",
  clusters = [],
} = Astro.props;

const formattedDate = new Date(datePublished).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "2-digit",
});
---

<!-- DEVELOPER NOTE — verify before merging:
     1. PATH: layout files must be in src/layouts/. Pillar pages resolve
        from src/pages/, so "../layouts/" is correct.
     2. BaseLayout PROPS: title and metaDescription are passed below.
        If your BaseLayout passes these to BaseHead, SEO metadata will be
        page-specific. Confirm the prop names match your BaseLayout signature.
     3. Wrapper variants: confirm variant="narrow" and variant="prose"
        exist in your Wrapper.astro before first build.
-->
<BaseLayout>

  <!-- ── Page header ── -->
  <section class="bg-gradient-to-t from-base-200 to-white overflow-hidden">
    <Wrapper variant="narrow" class="pt-24 lg:pt-32 pb-12">

      <div class="flex items-center gap-4 mb-8">
        <Text
          tag="span"
          variant="textSM"
          class="pl-4 font-medium uppercase border-l text-base-900 font-display border-accent-500"
        >
          Framework · Pillar Article
        </Text>
        <time datetime={datePublished} class="text-sm text-base-500">
          {formattedDate}
        </time>
      </div>

      <Text
        tag="h1"
        variant="displayMD"
        class="font-display text-base-900 uppercase"
      >
        {heading}
      </Text>

      {subtitle && (
        <Text
          tag="p"
          variant="textLG"
          class="mt-4 text-base-600 max-w-2xl"
        >
          {subtitle}
        </Text>
      )}

    </Wrapper>
  </section>

  <!-- ── Optional hero image ── -->
  {heroImage && (
    <Wrapper variant="narrow" class="pb-8">
      <img
        src={heroImage}
        alt={heroAlt}
        class="w-full rounded-2xl object-cover aspect-[4/2] shadow-2xl outline-4 outline-base-500/10"
        loading="eager"
        decoding="async"
      />
    </Wrapper>
  )}

  <!-- ── Article body ──
       Markdown content renders here via <slot />.
       Wrapper variant="prose" applies @tailwindcss/typography
       plus the project's prose token overrides. -->
  <section>
    <Wrapper variant="prose" class="py-12">
      <slot />
    </Wrapper>
  </section>

  <!-- ── Service mark footnote ── -->
  <Wrapper variant="narrow" class="pb-8">
    <Text tag="p" variant="textSM" class="italic text-base-500">
      Invisible Attrition℠ is a service mark of Lozen Advisory LLC.
      The Invisible Attrition℠ framework was first published publicly on
      February 15, 2026 at lozenadvisory.com/invisible-attrition.
    </Text>
  </Wrapper>

  <!-- ── Cluster accordion ── -->
  {clusters.length > 0 && (
    <section class="bg-gradient-to-b from-white to-base-200">
      <Wrapper variant="narrow" class="py-12 lg:py-16">

        <div class="mb-8">
          <Text
            tag="span"
            variant="textSM"
            class="pl-4 font-medium uppercase border-l text-base-900 font-display border-accent-500"
          >
            Pillar Cluster
          </Text>
          <Text
            tag="h2"
            variant="displayXS"
            class="font-display text-base-900 uppercase mt-4"
          >
            What the Framework Measures: Nine Dimensions of Invisible Attrition℠
          </Text>
          <Text tag="p" variant="textBase" class="text-base-500 mt-2">
            Nine cluster articles expanding the Invisible Attrition℠ framework.
          </Text>
        </div>

        <ol
          class="divide-y divide-base-200 border-t border-base-200"
          role="list"
        >
          {clusters.map((cluster, index) => (
            <li data-accordion-item>
              <button
                class="flex items-baseline gap-4 w-full py-5 text-left group"
                aria-expanded="false"
                aria-controls={`cluster-panel-${index}`}
                id={`cluster-trigger-${index}`}
                data-accordion-trigger
              >
                <span class="text-xs font-semibold tracking-widest text-base-400 w-6 shrink-0">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="flex-1 font-display text-base-900 text-base group-hover:text-accent-600 transition-colors duration-200">
                  {cluster.title}
                </span>
                <span
                  class="shrink-0 text-base-400 text-lg font-light w-5 text-right"
                  aria-hidden="true"
                  data-accordion-icon
                >
                  +
                </span>
              </button>

              <div
                id={`cluster-panel-${index}`}
                role="region"
                aria-labelledby={`cluster-trigger-${index}`}
                class="pb-5 pl-10"
                hidden
              >
                <Text
                  tag="p"
                  variant="textBase"
                  class="text-base-500 max-w-2xl mb-4"
                >
                  {cluster.description}
                </Text>
                <Button
                  isLink
                  href={cluster.slug}
                  variant="muted"
                  size="xs"
                  class="w-fit"
                >
                  Read article →
                </Button>
              </div>
            </li>
          ))}
        </ol>

      </Wrapper>
    </section>
  )}

  <!-- ── Briefing CTA ── -->
  <section class="bg-base-200">
    <Wrapper variant="narrow" class="py-12 lg:py-16">
      <div class="border-l-2 border-accent-500 pl-6">
        <Text
          tag="span"
          variant="textSM"
          class="font-medium uppercase text-base-500 font-display tracking-wide"
        >
          Strategic Briefing
        </Text>
        <Text
          tag="h2"
          variant="textLG"
          class="font-display text-base-900 uppercase mt-2"
        >
          Invisible Attrition℠ Retention Risk Audit
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-base-500 mt-3 max-w-xl"
        >
          A strategic consultation to identify why clean performance records
          and engagement scores can mask compounding leadership continuity risk.
        </Text>
        <Button
          isLink
          href="/request-briefing"
          variant="default"
          size="sm"
          class="mt-6 w-fit"
        >
          Request Briefing →
        </Button>
      </div>
    </Wrapper>
  </section>

</BaseLayout>

<script>
  document.querySelectorAll("[data-accordion-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const expanded = trigger.getAttribute("aria-expanded") === "true";
      const panelId = trigger.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : null;
      const icon = trigger.querySelector("[data-accordion-icon]");

      trigger.setAttribute("aria-expanded", String(!expanded));
      if (panel) panel.hidden = expanded;
      if (icon) icon.textContent = expanded ? "+" : "−";
    });
  });
</script>
