---
// Assets
import { Image } from "astro:assets";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { createArticleJsonLd } from "@/lib/seo/jsonLd";
// Sections
import BlogCard from "@/components/blog/BlogCard.astro";
import LegalSeriesConnector from "@/components/series/LegalSeriesConnector.astro";
const { frontmatter, currentSlug: suppliedCurrentSlug } = Astro.props;
const currentSlug = suppliedCurrentSlug || "";

// Get all posts and filter by tag
import { getCollection } from "astro:content";
const allPosts = await getCollection("posts");
const relatedPosts = allPosts.filter((post) =>
  post.data.tags.some((tag) => frontmatter.tags.includes(tag))
);
const filteredRelatedPosts = relatedPosts
  .filter((post) => post.data.title !== frontmatter.title)
  .slice(0, 2);
const publishedDate = new Date(frontmatter.pubDate);
const formattedPubDate = publishedDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "2-digit",
});

const seoDescription =
  frontmatter.metaDescription || frontmatter.description || frontmatter.excerpt || "";

const ogImage = frontmatter.image?.url?.src ?? frontmatter.image?.url;
const ogImageAlt = frontmatter.image?.alt || frontmatter.title;

const publishedDateIso = (frontmatter.datePublished || frontmatter.pubDate)?.toISOString?.() || new Date(frontmatter.datePublished || frontmatter.pubDate).toISOString();
const modifiedDateIso = (frontmatter.dateModified || frontmatter.datePublished || frontmatter.pubDate)?.toISOString?.() || new Date(frontmatter.dateModified || frontmatter.datePublished || frontmatter.pubDate).toISOString();

const articleJsonLd = createArticleJsonLd({
  title: frontmatter.title,
  description: seoDescription,
  href: `/blog/${currentSlug}`,
  image: ogImage,
  datePublished: publishedDateIso,
  dateModified: modifiedDateIso,
  type: "BlogPosting",
  section: frontmatter.category || frontmatter.tags?.[0],
  keywords: frontmatter.tags,
  breadcrumbs: [
    { name: "Home", href: "/" },
    { name: "Research & Analysis", href: "/blog" },
    { name: frontmatter.title, href: `/blog/${currentSlug}` },
  ],
});

const tags = (frontmatter.tags ?? []).map((tag) => {
  const raw = (tag ?? "").toString().trim();
  const slugSource = raw
    .toLowerCase()
    .replace(/^#+/, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
  const slug = encodeURIComponent(slugSource || "tag");
  const label =
    raw.replace(/^#+/, "").replace(/[-_]+/g, " ").replace(/\s+/g, " ").trim() ||
    "Tag";
  return { label, slug };
});
---

<BaseLayout
  title={frontmatter.title}
  description={seoDescription}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ogType="article"
  jsonLd={articleJsonLd}
>
  <section class="bg-gradient-to-t from-base-200 to-white overflow-hidden">
    <Wrapper variant="standard" class="pt-24 lg:pt-32">
      <div class="max-w-3xl mx-auto text-center">
        <Text
          tag="span"
          variant="textSM"
          class="lozen-type-eyebrow border-l border-base-300 pl-4 text-base-700"
        >
          {tags[0]?.label ?? "Insights"}
        </Text>
        <Text
          tag="h1"
          variant="displayMD"
          class="mt-8 text-base-900"
        >
          {frontmatter.title}
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="mt-4 text-base-800 text-balance"
        >
          {frontmatter.description}
        </Text>
      </div>
      <Image
        width={1920}
        height={1080}
        src={frontmatter.image.url}
        alt={frontmatter.image.alt}
        class="size-full object-cover object-center rounded-t-3xl aspect-4/2 shadow-2xl outline-4 outline-base-500/10 mt-12"
      />
    </Wrapper>
  </section>
  <section>
    <Wrapper variant="standard" class="py-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          <div class="relative pl-4 border-l-2 border-accent-500">
            <Text
              tag="h2"
              variant="textLG"
              class="font-display font-normal text-base-900"
            >
              In this article
            </Text>
            <Text
              tag="p"
              variant="textBase"
              class="text-base-700 max-w-2xl mt-4 text-balance"
            >
              {frontmatter.description}
            </Text>
          </div>
          <Wrapper variant="prose" class="mt-8">
            <slot />
            <LegalSeriesConnector currentSlug={currentSlug} />
          </Wrapper>
        </div>
        <div>
          <aside class="lg:sticky lg:top-32">
            <div
              class="flex flex-col bg-white rounded-3xl shadow-2xl outline-4 outline-base-500/10 divide-y divide-base-500/10"
            >
              <div class="p-6">
                <Text
                  tag="h3"
                  variant="textLG"
                  class="font-display font-normal text-base-900"
                >
                  Published
                  <time class="ml-1" datetime={publishedDate.toISOString()}>
                    {formattedPubDate}
                  </time>
                </Text>
                <ul role="list" class="flex flex-col gap-1 mt-4">
                  {
                    tags.map(({ label, slug }) => (
                      <a
                        href={`/blog/tags/${slug}`}
                        class="text-base-900 capitalize text-sm hover:text-accent-500 underline-offset-4 hover:underline flex"
                      >
                        {label}
                      </a>
                    ))
                  }
                </ul>
              </div>
              <div class="p-6">
                <Text
                  tag="h3"
                  variant="textLG"
                  class="font-display font-normal text-base-900"
                >
                  Explore more topics
                </Text>
                <Text tag="p" variant="textSM" class="mt-2 text-base-700">
                  Discover more insights.
                </Text>
                <Button
                  isLink
                  href="/blog"
                  variant="default"
                  size="xs"
                  class="mt-12 w-fit"
                >
                  View all articles
                </Button>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </Wrapper>
  </section>
  {
    filteredRelatedPosts.length > 0 && (
      <section class="bg-gradient-to-b from-base-200 to-white">
        <Wrapper variant="standard" class="py-12 lg:py-24">
          <div class="grid grid-cols-1 lg:grid-cols-3 lg:items-end">
            <div class="lg:col-span-2">
              <Text
                tag="h2"
                variant="displayXL"
                class="mt-8 text-base-900"
              >
                Related articles
              </Text>
              <Text tag="p" variant="textBase" class="text-base-800 mt-2">
                Keep learning with more stories from our team.
              </Text>
            </div>
            <Button
              isLink
              href="/blog"
              variant="muted"
              size="sm"
              class="w-fit lg:mt-auto lg:ml-auto"
            >
              View all posts
            </Button>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
            {filteredRelatedPosts.map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        </Wrapper>
      </section>
    )
  }
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const links = document.querySelectorAll("main a[href]");

      links.forEach((link) => {
        const href = link.getAttribute("href");

        if (
          !href ||
          href.startsWith("#") ||
          href.startsWith("mailto:") ||
          href.startsWith("tel:")
        ) {
          return;
        }

        let url;

        try {
          url = new URL(href, window.location.href);
        } catch {
          return;
        }

        if (url.hostname !== window.location.hostname) {
          link.setAttribute("target", "_blank");

          const relValues = new Set(
            (link.getAttribute("rel") || "")
              .split(/\s+/)
              .filter(Boolean)
          );

          relValues.add("noopener");
          relValues.add("noreferrer");

          link.setAttribute("rel", Array.from(relValues).join(" "));
        }
      });
    });
  </script>
  <style is:inline>
    .lozen-blog-share {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.625rem;
      margin: 1.5rem 0 0;
      font-family: var(--font-sans);
    }

    .lozen-blog-share__label {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-base-700);
    }

    .lozen-blog-share__link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--color-base-300);
      border-radius: 999px;
      padding: 0.45rem 0.85rem;
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1;
      color: var(--color-base-900);
      background: rgba(255, 255, 255, 0.86);
      text-decoration: none;
      transition:
        border-color 180ms ease,
        background-color 180ms ease,
        color 180ms ease,
        transform 180ms ease;
    }

    .lozen-blog-share__link:hover,
    .lozen-blog-share__link:focus-visible {
      border-color: var(--color-accent-600);
      color: var(--color-base-950);
      background: var(--color-accent-100);
      transform: translateY(-1px);
      outline: none;
    }

    @media (max-width: 640px) {
      .lozen-blog-share {
        margin-top: 1.25rem;
      }

      .lozen-blog-share__link {
        padding: 0.55rem 0.95rem;
        font-size: 0.9375rem;
      }
    }
  </style>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      if (document.querySelector(".lozen-blog-share")) return;

      const heading = document.querySelector("main h1");
      if (!heading) return;

      const currentUrl = window.location.href.split("#")[0];
      const pageTitle = document.title.replace(/\s*\|\s*Lozen Advisory\s*$/i, "").trim();

      const links = [
        {
          label: "LinkedIn",
          href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`,
          external: true,
        },
        {
          label: "X",
          href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(pageTitle)}`,
          external: true,
        },
        {
          label: "Facebook",
          href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`,
          external: true,
        },
        {
          label: "Email",
          href: `mailto:?subject=${encodeURIComponent(pageTitle)}&body=${encodeURIComponent(currentUrl)}`,
          external: false,
        },
      ];

      const nav = document.createElement("nav");
      nav.className = "lozen-blog-share";
      nav.setAttribute("aria-label", "Share this article");

      const label = document.createElement("span");
      label.className = "lozen-blog-share__label";
      label.textContent = "Share";
      nav.appendChild(label);

      links.forEach((item) => {
        const link = document.createElement("a");
        link.className = "lozen-blog-share__link";
        link.href = item.href;
        link.textContent = item.label;

        if (item.external) {
          link.target = "_blank";
          link.rel = "noopener noreferrer";
        }

        nav.appendChild(link);
      });

      heading.insertAdjacentElement("afterend", nav);
    });
  </script>

</BaseLayout>
