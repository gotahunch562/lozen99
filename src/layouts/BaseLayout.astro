---
// Fundations
import "@/styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";
// Components
import Search from "@/components/global/Search.astro";

import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";

interface Props {
  title?: string;
  description?: string;
  metaDescription?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  hideNavigation?: boolean;
  hideFooter?: boolean;
}

// Hides the navigation, or footer on selected screens by passing props:
// <BaseLayout hideNavigation={true} hideFooter={true}>
const {
  title,
  description,
  metaDescription,
  canonical,
  ogImage,
  ogImageAlt,
  ogType,
  hideNavigation = false,
  hideFooter = false,
} = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead
      title={title}
      description={description ?? metaDescription}
      canonical={canonical}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
    />
  </head>
  <body class="flex flex-col bg-white min-h-dvh">
    {!hideNavigation && <Navigation />}
    <main class="grow"><slot /></main>
    {!hideFooter && <Footer />}
    <Search />
  </body>
</html>
