---
import NarrativePage from "@/components/authority/NarrativePage.astro";

const { frontmatter } = Astro.props;

import { getCollection } from "astro:content";

const allServices = await getCollection("services");
const relatedServices = allServices
  .filter((service) => service.data.title !== frontmatter.title)
  .slice(0, 2);

const title = `${frontmatter.title} | Lozen Advisory`;
const description =
  frontmatter.metaDescription ||
  frontmatter.shortDescription ||
  frontmatter.description;

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: frontmatter.title,
  description,
  provider: {
    "@type": "Organization",
    name: "Lozen Advisory LLC",
    url: "https://www.lozenadvisory.com",
  },
};
---

<NarrativePage
  title={frontmatter.title}
  seoTitle={title}
  description={frontmatter.shortDescription || frontmatter.description}
  metaDescription={description}
  eyebrow="Professional Service"
  articleJsonLd={pageJsonLd}
  bottomCta={{
    label: "Strategic Briefing",
    title: "Request a private briefing.",
    description:
      "Lozen Advisory works with leaders when visibility, disclosure, retention risk, AI implementation burden, or workforce exposure requires a clearer decision structure.",
    href: "/request-briefing",
    linkLabel: "Request Briefing →",
  }}
>
  <h2>Service Details</h2>

  <p>{frontmatter.description}</p>

  <slot />

  {
    relatedServices.length > 0 && (
      <section class="service-detail-related" aria-label="Related services">
        <h2>Related Services</h2>

        <div class="service-detail-related__list">
          {relatedServices.map((service) => (
            <a href={`/services/${service.slug}`} class="service-detail-related__link">
              <span>{service.data.title}</span>
              {service.data.shortDescription && <small>{service.data.shortDescription}</small>}
            </a>
          ))}
        </div>
      </section>
    )
  }
</NarrativePage>

<style>
  .service-detail-related {
    margin-top: 3rem;
    border-top: 1px solid var(--color-base-300);
    padding-top: 2.25rem;
  }

  .service-detail-related__list {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.25rem;
  }

  .service-detail-related__link {
    display: grid;
    gap: 0.4rem;
    border-top: 1px solid var(--color-base-200);
    padding-top: 1rem;
    color: var(--color-base-950) !important;
    text-decoration: none !important;
  }

  .service-detail-related__link span {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .service-detail-related__link small {
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .service-detail-related__link:hover span,
  .service-detail-related__link:focus-visible span {
    color: var(--color-accent-700);
  }
</style>
