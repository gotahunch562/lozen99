---
interface ClusterItem {
  title: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: ClusterItem[];
}

const {
  eyebrow = "Cluster Articles",
  title,
  description,
  items,
} = Astro.props;
---

<section class="rounded-3xl border border-base-200 bg-white p-6 shadow-sm sm:p-8">
  <p class="border-l border-accent-500 pl-4 text-xs font-medium uppercase tracking-[0.18em] text-base-600">
    {eyebrow}
  </p>

  <div class="mt-6">
    <h2 class="font-display text-xl font-medium uppercase leading-tight tracking-tight text-base-950 sm:text-2xl">
      {title}
    </h2>

    {
      description && (
        <p class="mt-4 max-w-3xl text-sm leading-6 text-base-800">
          {description}
        </p>
      )
    }
  </div>

  <nav aria-label="Invisible Attrition cluster articles" class="mt-8">
    <ol class="grid gap-3 md:grid-cols-2">
      {
        items.map((item, index) => (
          <li>
            <a
              href={item.href}
              class="group flex h-full items-start gap-4 rounded-2xl border border-base-200 bg-base-50 px-4 py-4 transition-all duration-300 hover:-translate-y-1 hover:border-accent-400 hover:bg-white hover:shadow-sm"
            >
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-base-300 text-xs font-semibold text-base-700">
                {(index + 1).toString().padStart(2, "0")}
              </span>

              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold leading-6 text-base-900">
                  {item.title}
                </p>
              </div>

              <span class="ml-auto self-center text-accent-600 transition-transform duration-300 group-hover:translate-x-1">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</section>
