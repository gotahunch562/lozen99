---
/**
 * CategoryHubLayout.astro
 * Drop-in replacement for NarrativePage.
 * Change one import line in your page — content stays untouched.
 *
 * Usage in disclosure-independent-governance.astro:
 *   import CategoryHubLayout from "@/components/authority/CategoryHubLayout.astro";
 *   <CategoryHubLayout ...same props... />
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import InternalPageHero from "@/components/fundations/sections/InternalPageHero.astro";

interface RailItem {
  label: string;
  value: string;
}

interface RailLink {
  label: string;
  href: string;
  description: string;
}

interface RailCta {
  label: string;
  title: string;
  description: string;
  href: string;
  linkLabel: string;
}

interface RelatedItem {
  label: string;
  href: string;
  description: string;
}

interface Props {
  title: string;
  seoTitle?: string;
  description?: string;
  metaDescription?: string;
  canonical?: string;
  eyebrow?: string;
  typeLabel?: string;
  dateLabel?: string;
  textHeroLayout?: "wide" | "standard";
  articleJsonLd?: Record<string, unknown>[];
  railTitle?: string;
  railItems?: RailItem[];
  railLinks?: RailLink[];
  railCta?: RailCta;
  bottomCta?: RailCta;
  relatedEyebrow?: string;
  relatedTitle?: string;
  relatedItems?: RelatedItem[];
}

const {
  title,
  seoTitle,
  description,
  metaDescription,
  canonical,
  eyebrow,
  typeLabel,
  dateLabel,
  articleJsonLd,
  railTitle = "Category Context",
  railItems = [],
  railLinks = [],
  railCta,
  bottomCta,
  relatedEyebrow,
  relatedTitle,
  relatedItems = [],
} = Astro.props;

const ogDescription = metaDescription ?? description;
---

<BaseLayout
  title={seoTitle ?? title}
  description={ogDescription}
  canonical={canonical}
>
  {
    articleJsonLd?.map((ld) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(ld)}
      />
    ))
  }

  <main class="chub-root">

    <!-- ─── HERO ─────────────────────────────────────────────── -->
    <InternalPageHero
      eyebrow={[typeLabel, eyebrow].filter(Boolean).join(' · ')}
      title={title}
      deck={description ?? ''}
    />

    <!-- ─── BODY: CONTENT + RAIL ─────────────────────────────── -->
    <div class="chub-body">
      <div class="chub-body__inner">

        <!-- Article content (slot) -->
        <article class="chub-article">
          <div class="chub-prose">
            <slot />
          </div>
        </article>

        <!-- Sticky rail sidebar -->
        <aside class="chub-rail">

          {/* Category context metadata */}
          {railItems.length > 0 && (
            <div class="chub-rail__panel">
              <h2 class="chub-rail__heading">{railTitle}</h2>
              <dl class="chub-rail__meta">
                {railItems.map((item) => (
                  <div class="chub-rail__meta-row">
                    <dt class="chub-rail__meta-label">{item.label}</dt>
                    <dd class="chub-rail__meta-value">{item.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}

          {/* Framework links */}
          {railLinks.length > 0 && (
            <div class="chub-rail__panel chub-rail__panel--links">
              <h2 class="chub-rail__heading">Related Frameworks</h2>
              <ul class="chub-rail__links">
                {railLinks.map((link) => (
                  <li class="chub-rail__link-item">
                    <a href={link.href} class="chub-rail__link">
                      <span class="chub-rail__link-label">{link.label}</span>
                      <span class="chub-rail__link-desc">{link.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* CTA card */}
          {railCta && (
            <div class="chub-rail__cta">
              <p class="chub-rail__cta-eyebrow">{railCta.label}</p>
              <h3 class="chub-rail__cta-title">{railCta.title}</h3>
              <p class="chub-rail__cta-desc">{railCta.description}</p>
              <a href={railCta.href} class="chub-rail__cta-link">
                {railCta.linkLabel}
              </a>
            </div>
          )}

        </aside>
      </div>
    </div>

    <!-- ─── RELATED ───────────────────────────────────────────── -->
    {relatedItems.length > 0 && (
      <section class="chub-related">
        <div class="chub-related__inner">
          {relatedEyebrow && (
            <p class="chub-related__eyebrow">{relatedEyebrow}</p>
          )}
          {relatedTitle && (
            <h2 class="chub-related__title">{relatedTitle}</h2>
          )}
          <ul class="chub-related__grid">
            {relatedItems.map((item) => (
              <li>
                <a href={item.href} class="chub-related__card">
                  <span class="chub-related__card-label">{item.label}</span>
                  <span class="chub-related__card-desc">{item.description}</span>
                  <span class="chub-related__card-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- ─── BOTTOM CTA ────────────────────────────────────────── -->
    {bottomCta && (
      <section class="chub-bottom-cta">
        <div class="chub-bottom-cta__inner">
          <p class="chub-bottom-cta__label">{bottomCta.label}</p>
          <h2 class="chub-bottom-cta__title">{bottomCta.title}</h2>
          <p class="chub-bottom-cta__desc">{bottomCta.description}</p>
          <a href={bottomCta.href} class="chub-bottom-cta__link">
            {bottomCta.linkLabel}
          </a>
        </div>
      </section>
    )}

  </main>
</BaseLayout>

<style>
  /* ─── ROOT ─────────────────────────────────────────────────── */
  .chub-root {
    background: var(--color-base-50);
  }

  /* ─── BODY ──────────────────────────────────────────────────── */
  .chub-body {
    background: var(--color-base-50);
    border-bottom: 1px solid var(--color-base-200);
  }

  .chub-body__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 1024px) {
    .chub-body__inner {
      grid-template-columns: minmax(0, 1fr) 22rem;
      gap: clamp(3rem, 5vw, 5rem);
      align-items: start;
    }
  }

  /* ─── ARTICLE PROSE ─────────────────────────────────────────── */
  .chub-article {
    min-width: 0;
    padding: clamp(2.5rem, 5vw, 4rem) 0;
  }

  /* All prose styles are scoped via :global() so they apply inside the slot */
  .chub-prose :global(p) {
    margin-top: 1.45rem;
    font-family: var(--font-sans);
    font-size: var(--lozen-body-copy-large-size);
    line-height: var(--lozen-body-copy-large-line-height);
    color: var(--color-base-700);
  }

  .chub-prose :global(p:first-child) {
    margin-top: 0;
  }

  .chub-prose :global(p strong) {
    font-weight: 700;
    color: var(--color-base-950);
  }

  .chub-prose :global(h2) {
    margin-top: 3.5rem;
    margin-bottom: 0;
    font-family: var(--font-display);
    font-size: var(--lozen-subsection-title-size);
    font-weight: 400;
    letter-spacing: var(--lozen-section-title-letter-spacing);
    line-height: var(--lozen-section-title-line-height);
    text-transform: uppercase;
    color: var(--color-base-950);
  }

  .chub-prose :global(h2 + p) {
    margin-top: 1.1rem;
  }

  .chub-prose :global(h3) {
    margin-top: 2.25rem;
    font-family: var(--font-display);
    font-size: var(--lozen-subsection-title-size);
    font-weight: 400;
    letter-spacing: var(--lozen-subsection-title-letter-spacing);
    line-height: var(--lozen-subsection-title-line-height);
    color: var(--color-base-900);
  }

  .chub-prose :global(blockquote) {
    margin: 2.25rem 0;
    padding: 1.5rem 1.75rem;
    border-left: 3px solid var(--color-accent-500);
    background: var(--color-base-50);
    border-radius: 0 6px 6px 0;
  }

  .chub-prose :global(blockquote p) {
    margin-top: 0;
    font-family: var(--font-display);
    font-size: var(--lozen-pullquote-size);
    font-weight: 400;
    line-height: var(--lozen-pullquote-line-height);
    color: var(--color-base-800);
    font-style: normal;
  }

  .chub-prose :global(ul),
.chub-prose :global(ol) {
  margin-top: 1.25rem;
  padding-left: 1.5rem;
  list-style-type: disc;
}

.chub-prose :global(ul li),
.chub-prose :global(ol li) {
  margin-top: 0.5rem;
}

  .chub-prose :global(ul li),
  .chub-prose :global(ol li) {
    font-family: var(--font-sans);
    font-size: var(--lozen-body-copy-large-size);
    line-height: 1.72;
    color: var(--color-base-700);
    padding-left: 0.5rem;
  }

  .chub-prose :global(ul li::marker) {
    color: var(--color-accent-600);
  }

  .chub-prose :global(a) {
    color: var(--color-accent-700);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent-300);
    transition:
      color 250ms ease,
      border-color 250ms ease;
  }

  .chub-prose :global(a:hover) {
    color: var(--color-base-950);
    border-color: var(--color-base-950);
  }

  /* Framework vocabulary grid (from their page styles) */
  .chub-prose :global(.lozen-framework-grid),
  .chub-prose :global(.lozen-asset-grid) {
    display: grid;
    gap: 1rem;
    margin: 1.8rem 0 2.1rem;
  }

  .chub-prose :global(.lozen-framework-grid) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .chub-prose :global(.lozen-asset-grid) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .chub-prose :global(.lozen-framework-card),
  .chub-prose :global(.lozen-asset-grid > article) {
    border: 1px solid var(--color-base-200);
    border-radius: 1.05rem;
    background: var(--color-base-50);
    padding: clamp(1.1rem, 2.2vw, 1.45rem);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 250ms ease, border-color 250ms ease;
  }

  .chub-prose :global(.lozen-framework-card:hover),
  .chub-prose :global(.lozen-asset-grid > article:hover) {
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent-400);
  }

  .chub-prose :global(.lozen-framework-card h3),
  .chub-prose :global(.lozen-asset-grid h3) {
    margin: 0;
    color: var(--color-base-950);
    font-family: var(--font-display);
    font-size: var(--lozen-card-title-size);
    font-weight: var(--lozen-card-title-weight);
    letter-spacing: var(--lozen-card-title-letter-spacing);
    line-height: var(--lozen-card-title-line-height);
  }

  .chub-prose :global(.lozen-framework-card p),
  .chub-prose :global(.lozen-asset-grid p) {
    margin: 0.75rem 0 0;
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--color-base-600);
  }

  .chub-prose :global(.lozen-framework-card a),
  .chub-prose :global(.lozen-asset-grid a) {
    color: inherit;
    text-decoration: none;
    border-bottom: none;
  }

  .chub-prose :global(.lozen-framework-card a:hover),
  .chub-prose :global(.lozen-asset-grid a:hover) {
    color: var(--color-accent-700);
    border-bottom: none;
  }

  .chub-prose :global(.lozen-asset-grid__eyebrow) {
    margin: 0 0 0.55rem !important;
    color: var(--color-base-500) !important;
    font-family: var(--font-sans) !important;
    font-size: 0.65rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.16em !important;
    line-height: 1.3 !important;
    text-transform: uppercase !important;
  }

  @media (max-width: 900px) {
    .chub-prose :global(.lozen-framework-grid),
    .chub-prose :global(.lozen-asset-grid) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ─── RAIL ──────────────────────────────────────────────────── */
  .chub-rail {
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media (min-width: 1024px) {
    .chub-rail {
      position: sticky;
      top: 6rem;
      align-self: start;
    }
  }

  .chub-rail__panel {
    background: var(--color-base-50);
    border: 1px solid var(--color-base-200);
    border-radius: 10px;
    padding: 1.35rem 1.5rem;
  }

  .chub-rail__panel--links {
    background: #ffffff;
  }

  .chub-rail__heading {
    margin: 0 0 1rem;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-base-500);
  }

  /* Metadata list */
  .chub-rail__meta {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .chub-rail__meta-row {
    padding: 0.7rem 0;
    border-top: 1px solid var(--color-base-200);
  }

  .chub-rail__meta-row:first-child {
    border-top: none;
    padding-top: 0;
  }

  .chub-rail__meta-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-base-500);
    margin-bottom: 0.2rem;
  }

  .chub-rail__meta-value {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-base-800);
  }

  /* Framework links */
  .chub-rail__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .chub-rail__link-item {
    border-top: 1px solid var(--color-base-200);
  }

  .chub-rail__link-item:first-child {
    border-top: none;
  }

  .chub-rail__link {
    display: block;
    padding: 0.8rem 0;
    text-decoration: none;
    border-bottom: none;
    transition: none;
  }

  .chub-rail__link:hover .chub-rail__link-label {
    color: var(--color-accent-700);
  }

  .chub-rail__link-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-base-900);
    transition: color 200ms ease;
  }

  .chub-rail__link-desc {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--color-base-500);
  }

  /* Rail CTA card */
  .chub-rail__cta {
    background: var(--color-base-950);
    border-radius: 10px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .chub-rail__cta-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-500);
    margin: 0;
  }

  .chub-rail__cta-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.3;
    color: #ffffff;
  }

  .chub-rail__cta-desc {
    margin: 0.25rem 0 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-base-300);
  }

  .chub-rail__cta-link {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.1rem;
    background: var(--color-accent-500);
    color: var(--color-base-950);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    border-bottom: none;
    transition: background 200ms ease;
    align-self: flex-start;
  }

  .chub-rail__cta-link:hover {
    background: var(--color-accent-400);
    color: var(--color-base-950);
    border-bottom: none;
  }

  /* ─── RELATED ───────────────────────────────────────────────── */
  .chub-related {
    background: var(--color-base-950);
    border-top: 1px solid var(--color-base-800);
  }

  .chub-related__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3rem);
  }

  .chub-related__eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-500);
  }

  .chub-related__title {
    margin: 0 0 2.25rem;
    font-family: var(--font-display);
    font-size: var(--lozen-section-title-size);
    font-weight: 400;
    letter-spacing: var(--lozen-section-title-letter-spacing);
    line-height: var(--lozen-section-title-line-height);
    color: #ffffff;
    text-transform: uppercase;
  }

  .chub-related__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 768px) {
    .chub-related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .chub-related__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .chub-related__card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.3rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-base-800);
    text-decoration: none;
    border-bottom: none;
    transition: none;
  }

  .chub-related__card:hover .chub-related__card-label {
    color: var(--color-accent-400);
  }

  .chub-related__card:hover .chub-related__card-arrow {
    transform: translateX(4px);
    color: var(--color-accent-500);
  }

  .chub-related__card-label {
    font-family: var(--font-display);
    font-size: var(--lozen-card-title-small-size);
    font-weight: 400;
    line-height: var(--lozen-card-title-small-line-height);
    letter-spacing: var(--lozen-card-title-letter-spacing);
    color: #ffffff;
    transition: color 200ms ease;
  }

  .chub-related__card-desc {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--color-base-400);
    padding-right: 1rem;
  }

  .chub-related__card-arrow {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-base-500);
    transition: transform 200ms ease, color 200ms ease;
    align-self: end;
    margin-top: 0.5rem;
  }

  /* ─── BOTTOM CTA ─────────────────────────────────────────────── */
  .chub-bottom-cta {
    background: var(--color-accent-500);
    border-top: 1px solid var(--color-accent-400);
  }

  .chub-bottom-cta__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 3rem);
    display: grid;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .chub-bottom-cta__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 1rem 3rem;
    }
  }

  .chub-bottom-cta__label {
    grid-column: 1;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-base-800);
  }

  .chub-bottom-cta__title {
    grid-column: 1;
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-size: var(--lozen-subsection-title-size);
    font-weight: 400;
    letter-spacing: var(--lozen-subsection-title-letter-spacing);
    line-height: var(--lozen-subsection-title-line-height);
    color: var(--color-base-950);
    text-transform: uppercase;
  }

  .chub-bottom-cta__desc {
    grid-column: 1;
    margin: 0.75rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-base-800);
    max-width: 44rem;
  }

  .chub-bottom-cta__link {
    grid-column: 1;
    display: inline-flex;
    align-items: center;
    margin-top: 1.25rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-base-950);
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: none;
    border-radius: 4px;
    transition: background 200ms ease;
    align-self: start;
    justify-self: start;
  }

  @media (min-width: 768px) {
    .chub-bottom-cta__label {
      grid-column: 1;
    }
    .chub-bottom-cta__title {
      grid-column: 1;
    }
    .chub-bottom-cta__desc {
      grid-column: 1;
    }
    .chub-bottom-cta__link {
      grid-column: 2;
      grid-row: 1 / -1;
      margin-top: 0;
      align-self: center;
      white-space: nowrap;
    }
  }

  .chub-bottom-cta__link:hover {
    background: var(--color-base-800);
    border-bottom: none;
    color: #ffffff;
  }
</style>
