---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { JsonLdObject } from "@/lib/seo/jsonLd";

interface ReportLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  metaDescription: string;
  articleJsonLd: JsonLdObject | JsonLdObject[];
  dateLabel: string;
  reportNumber: string;
  ogImage?: string;
  ogImageAlt?: string;
  heroImage?: string;
  heroImageAlt?: string;
  heroImagePosition?: string;
  previousReport?: ReportLink;
  nextReport?: ReportLink;
  ctaTitle?: string;
  ctaDescription?: string;
}

const {
  title,
  metaDescription,
  articleJsonLd,
  dateLabel,
  reportNumber,
  ogImage = "/images/unrecorded-talent-infrastructure-gap.webp",
  ogImageAlt = "A diagnostic visualization of corporate retention infrastructure and the data gaps that remain outside formal reporting systems.",
  heroImage,
  heroImageAlt = "",
  heroImagePosition = "center center",
  previousReport,
  nextReport,
  ctaTitle = "Schedule an Invisible Attrition℠ Retention Risk Audit →",
  ctaDescription = "A strategic consultation to identify why clean performance records and engagement scores can mask compounding leadership continuity risk.",
} = Astro.props;

const seriesTitle = "The Architecture of Invisible Attrition℠ — Executive Report Series";
const seriesHref = "/architecture-of-invisible-attrition-series";
const hasHeroImage = Boolean(heroImage);
const heroClass = hasHeroImage
  ? "executive-report__hero executive-report__hero--split"
  : "executive-report__hero";
const heroShellClass = hasHeroImage
  ? "executive-report__shell executive-report__hero-shell executive-report__hero-shell--split"
  : "executive-report__shell executive-report__hero-shell";
---

<BaseLayout
  title={title}
  description={metaDescription}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ogType="article"
  jsonLd={articleJsonLd}
>
  <article class="executive-report">
    <header class={heroClass}>
      <div class={heroShellClass}>
        <div class="executive-report__hero-copy">
        <a href="/blog" class="executive-report__back">← Back to Research</a>

        <div class="executive-report__meta" aria-label="Report metadata">
          <span>Executive Report Series</span>
          <span>{dateLabel}</span>
          <span>Report {reportNumber} of 04</span>
        </div>

        <h1>{title}</h1>

        <p class="executive-report__deck">
          {seriesTitle}
        </p>

        <nav class="executive-report__series-nav" aria-label="Executive report series navigation">
          <a href={seriesHref}>Series Hub</a>
          {previousReport && <a href={previousReport.href}>Previous: {previousReport.label}</a>}
          {nextReport && <a href={nextReport.href}>Next: {nextReport.label}</a>}
        </nav>
        </div>

        {
          heroImage && (
            <figure class="executive-report__hero-figure">
              <img
                src={heroImage}
                alt={heroImageAlt}
                loading="eager"
                decoding="async"
                style={`object-position: ${heroImagePosition};`}
              />
            </figure>
          )
        }
      </div>
    </header>

    <div class="executive-report__shell executive-report__layout">
      <div class="executive-report__body">
        <div class="executive-report__content">
          <slot />
        </div>

        <section class="executive-report__cta" aria-label="Strategic briefing">
          <a href="/request-briefing">{ctaTitle}</a>
          <p>{ctaDescription}</p>
        </section>

        <footer class="executive-report__footer-nav" aria-label="Report footer navigation">
          <a href={seriesHref}>{seriesTitle}</a>
          {previousReport && <a href={previousReport.href}>← Previous Report: {previousReport.label}</a>}
          {nextReport && <a href={nextReport.href}>Next Report: {nextReport.label} →</a>}
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .executive-report {
    background: var(--color-base-50);
    color: var(--color-base-950);
  }

  .executive-report__shell {
    width: min(100%, 82rem);
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .executive-report__hero {
    border-bottom: 1px solid var(--color-base-200);
    background:
      linear-gradient(135deg, rgba(6, 23, 47, 0.025), rgba(245, 239, 224, 0.42)),
      var(--color-base-50);
  }

  .executive-report__hero-shell {
    padding-top: 2rem;
    padding-bottom: 2.65rem;
  }

  .executive-report__hero--split {
    border-bottom-color: color-mix(in oklch, var(--color-base-500) 28%, var(--color-base-950));
    background: linear-gradient(135deg, var(--color-base-950) 0%, var(--color-base-900) 58%, #020a17 100%);
    color: white;
  }

  .executive-report__hero-shell--split {
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(21rem, 0.78fr);
    min-height: clamp(28rem, 46vw, 39rem);
    gap: clamp(2rem, 5vw, 4.75rem);
    align-items: center;
    padding-top: clamp(6.25rem, 9vw, 8rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .executive-report__hero-copy {
    width: min(100%, 56rem);
  }

  .executive-report__back {
    display: inline-flex;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 650;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .executive-report__back:hover,
  .executive-report__back:focus-visible {
    color: var(--color-base-800);
  }

  .executive-report__hero--split .executive-report__back {
    color: color-mix(in oklch, var(--color-base-100) 76%, white);
  }

  .executive-report__hero--split .executive-report__back:hover,
  .executive-report__hero--split .executive-report__back:focus-visible {
    color: var(--color-base-100);
  }

  .executive-report__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin-top: 1.65rem;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: var(--lozen-meta-label-size);
    font-weight: var(--lozen-meta-label-weight);
    letter-spacing: var(--lozen-meta-label-letter-spacing);
    text-transform: uppercase;
  }

  .executive-report__meta span:first-child {
    border-left: 1px solid var(--color-base-300);
    padding-left: 1rem;
    color: var(--color-base-900);
  }

  .executive-report__hero--split .executive-report__meta {
    color: color-mix(in oklch, var(--color-base-100) 78%, white);
  }

  .executive-report__hero--split .executive-report__meta span:first-child {
    border-left-color: color-mix(in oklch, var(--color-base-300) 62%, transparent);
    color: white;
  }

  .executive-report h1 {
    max-width: 62rem;
    margin: 1.15rem 0 0;
    color: var(--color-base-900);
    font-family: var(--font-display);
    font-size: var(--lozen-article-hero-title-size);
    font-weight: var(--lozen-article-hero-title-weight);
    line-height: var(--lozen-article-hero-title-line-height);
    letter-spacing: var(--lozen-article-hero-title-letter-spacing);
  }

  .executive-report__hero--split h1 {
    color: white;
  }

  .executive-report__deck {
    max-width: 52rem;
    margin: 1rem 0 0;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: var(--lozen-page-hero-deck-size);
    line-height: var(--lozen-page-hero-deck-line-height);
  }

  .executive-report__hero--split .executive-report__deck {
    color: color-mix(in oklch, var(--color-base-100) 76%, white);
  }

  .executive-report__hero--split .executive-report__series-nav a {
    color: color-mix(in oklch, var(--color-base-100) 84%, white);
  }

  .executive-report__hero--split .executive-report__series-nav a:hover,
  .executive-report__hero--split .executive-report__series-nav a:focus-visible {
    color: white;
    border-color: white;
  }

  .executive-report__hero-figure {
    position: relative;
    overflow: hidden;
    min-height: clamp(22rem, 38vw, 34rem);
    border: 1px solid color-mix(in oklch, var(--color-base-300) 18%, transparent);
    border-radius: 1.25rem;
    background: color-mix(in oklch, var(--color-base-900) 72%, black);
    box-shadow:
      0 28px 80px rgba(0, 0, 0, 0.36),
      0 0 0 1px rgba(255, 255, 255, 0.05) inset;
  }

  .executive-report__hero-figure img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
  }

  .executive-report__series-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.35rem;
    margin-top: 1.5rem;
  }

  .executive-report__series-nav a {
    color: var(--color-base-800);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .executive-report__series-nav a:hover,
  .executive-report__series-nav a:focus-visible {
    color: var(--color-base-950);
    border-color: var(--color-base-950);
  }

  .executive-report__layout {
    padding-top: 3rem;
    padding-bottom: 4.5rem;
  }

  .executive-report__body {
    width: min(100%, var(--lozen-prose-content-width));
    margin-inline: auto;
  }

  :global(.executive-report__content) {
    color: var(--color-base-600);
  }

  :global(.executive-report__content p) {
    margin: 0 0 1.5rem;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: var(--lozen-body-copy-large-size);
    line-height: var(--lozen-body-copy-large-line-height);
  }

  :global(.executive-report__content h2) {
    margin: 3rem 0 1.15rem;
    color: var(--color-base-900);
    font-family: var(--font-display);
    font-size: var(--lozen-section-title-size);
    font-weight: var(--lozen-section-title-weight);
    line-height: var(--lozen-section-title-line-height);
    letter-spacing: var(--lozen-section-title-letter-spacing);
  }

  :global(.executive-report__content h2 + p) {
    margin-top: 0;
  }

  :global(.executive-report__content a) {
    color: var(--color-base-800);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color 180ms ease;
  }

  :global(.executive-report__content a:hover),
  :global(.executive-report__content a:focus-visible) {
    color: var(--color-base-900);
  }

  :global(.executive-report__content strong) {
    color: var(--color-base-900);
    font-weight: 700;
  }

  :global(.executive-report__content ul),
  :global(.executive-report__content ol) {
    margin: 1.5rem 0 1.5rem 1.5rem;
    padding-left: 1rem;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: var(--lozen-body-copy-large-size);
    line-height: var(--lozen-body-copy-large-line-height);
  }

  :global(.executive-report__content ul) {
    list-style: disc;
  }

  :global(.executive-report__content ol) {
    list-style: decimal;
  }

  :global(.executive-report__content li) {
    margin-bottom: 0.75rem;
    padding-left: 0.25rem;
  }

  .executive-report__cta {
    margin-top: 3rem;
    border-top: 1px solid var(--color-base-300);
    border-bottom: 1px solid var(--color-base-200);
    padding: 1.45rem 0 1.55rem;
  }

  .executive-report__cta a {
    display: inline-flex;
    color: var(--color-base-950);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
  }

  .executive-report__cta a:hover,
  .executive-report__cta a:focus-visible {
    color: var(--color-base-950);
  }

  .executive-report__cta p {
    max-width: 44rem;
    margin: 0.75rem 0 0;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
  }

  .executive-report__footer-nav {
    display: grid;
    gap: 0.85rem;
    margin-top: 2rem;
    padding-top: 1.55rem;
    border-top: 1px solid var(--color-base-200);
  }

  .executive-report__footer-nav a {
    width: fit-content;
    color: var(--color-base-800);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .executive-report__footer-nav a:hover,
  .executive-report__footer-nav a:focus-visible {
    color: var(--color-base-950);
    border-color: var(--color-base-950);
  }

  @media (max-width: 760px) {
    .executive-report__shell {
      padding-inline: 1.25rem;
    }

    .executive-report__hero-shell {
      padding-top: 1.5rem;
      padding-bottom: 2.35rem;
    }

    .executive-report__hero-shell--split {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 5.75rem;
      padding-bottom: 2.75rem;
    }

    .executive-report__hero-figure {
      min-height: 18rem;
    }

    .executive-report__meta {
      margin-top: 1.45rem;
      font-size: 0.72rem;
      letter-spacing: 0.1em;
    }

    .executive-report h1 {
      font-size: var(--lozen-article-hero-title-size);
      line-height: var(--lozen-article-hero-title-line-height);
    }

    .executive-report__deck {
      font-size: var(--lozen-page-hero-deck-size);
      line-height: var(--lozen-page-hero-deck-line-height);
    }

    .executive-report__layout {
      padding-top: 2.45rem;
      padding-bottom: 3.6rem;
    }

    .executive-report__body {
      width: 100%;
    }

    :global(.executive-report__content p),
    :global(.executive-report__content ul),
    :global(.executive-report__content ol) {
      font-size: var(--lozen-body-copy-size);
      line-height: var(--lozen-body-copy-line-height);
    }

    :global(.executive-report__content h2) {
      margin-top: 2.55rem;
      font-size: var(--lozen-section-title-size);
      letter-spacing: var(--lozen-section-title-letter-spacing);
    }
  }
</style>
