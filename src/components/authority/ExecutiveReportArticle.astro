---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface ReportLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  metaDescription: string;
  articleJsonLd: Record<string, unknown>;
  dateLabel: string;
  reportNumber: string;
  ogImage?: string;
  ogImageAlt?: string;
  previousReport?: ReportLink;
  nextReport?: ReportLink;
  ctaTitle?: string;
  ctaDescription?: string;
}

const {
  title,
  metaDescription,
  articleJsonLd,
  dateLabel,
  reportNumber,
  ogImage = "/images/unrecorded-talent-infrastructure-gap.webp",
  ogImageAlt = "A diagnostic visualization of corporate retention infrastructure and the data gaps that remain outside formal reporting systems.",
  previousReport,
  nextReport,
  ctaTitle = "Schedule an Invisible Attrition℠ Retention Risk Audit →",
  ctaDescription = "A strategic consultation to identify why clean performance records and engagement scores can mask compounding leadership continuity risk.",
} = Astro.props;

const seriesTitle = "The Architecture of Invisible Attrition℠ — Executive Report Series";
const seriesHref = "/architecture-of-invisible-attrition-series";
---

<BaseLayout
  title={title}
  description={metaDescription}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ogType="article"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(articleJsonLd)}
  />

  <article class="executive-report">
    <header class="executive-report__hero">
      <div class="executive-report__shell executive-report__hero-shell">
        <a href="/blog" class="executive-report__back">← Back to Research</a>

        <div class="executive-report__meta" aria-label="Report metadata">
          <span>Executive Report Series</span>
          <span>{dateLabel}</span>
          <span>Report {reportNumber} of 04</span>
        </div>

        <h1>{title}</h1>

        <p class="executive-report__deck">
          {seriesTitle}
        </p>

        <nav class="executive-report__series-nav" aria-label="Executive report series navigation">
          <a href={seriesHref}>Series Hub</a>
          {previousReport && <a href={previousReport.href}>Previous: {previousReport.label}</a>}
          {nextReport && <a href={nextReport.href}>Next: {nextReport.label}</a>}
        </nav>
      </div>
    </header>

    <div class="executive-report__shell executive-report__layout">
      <div class="executive-report__body">
        <div class="executive-report__content">
          <slot />
        </div>

        <section class="executive-report__cta" aria-label="Strategic briefing">
          <a href="/request-briefing">{ctaTitle}</a>
          <p>{ctaDescription}</p>
        </section>

        <footer class="executive-report__footer-nav" aria-label="Report footer navigation">
          <a href={seriesHref}>{seriesTitle}</a>
          {previousReport && <a href={previousReport.href}>← Previous Report: {previousReport.label}</a>}
          {nextReport && <a href={nextReport.href}>Next Report: {nextReport.label} →</a>}
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .executive-report {
    background: var(--color-base-50);
    color: var(--color-base-950);
  }

  .executive-report__shell {
    width: min(100%, 82rem);
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .executive-report__hero {
    border-bottom: 1px solid var(--color-base-200);
    background:
      linear-gradient(135deg, rgba(6, 23, 47, 0.025), rgba(245, 239, 224, 0.42)),
      var(--color-base-50);
  }

  .executive-report__hero-shell {
    padding-top: 2rem;
    padding-bottom: 2.65rem;
  }

  .executive-report__back {
    display: inline-flex;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 650;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .executive-report__back:hover,
  .executive-report__back:focus-visible {
    color: var(--color-accent-700);
  }

  .executive-report__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin-top: 1.65rem;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .executive-report__meta span:first-child {
    border-left: 1px solid var(--color-accent-500);
    padding-left: 1rem;
    color: var(--color-base-900);
  }

  .executive-report h1 {
    max-width: 62rem;
    margin: 1.15rem 0 0;
    color: var(--color-base-900);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.15vw, 3.15rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .executive-report__deck {
    max-width: 52rem;
    margin: 1rem 0 0;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.68;
  }

  .executive-report__series-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.35rem;
    margin-top: 1.5rem;
  }

  .executive-report__series-nav a {
    color: var(--color-accent-700);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .executive-report__series-nav a:hover,
  .executive-report__series-nav a:focus-visible {
    color: var(--color-base-950);
    border-color: var(--color-base-950);
  }

  .executive-report__layout {
    padding-top: 3rem;
    padding-bottom: 4.5rem;
  }

  .executive-report__body {
    width: min(100%, 60rem);
    margin-inline: auto;
  }

  :global(.executive-report__content) {
    color: var(--color-base-600);
  }

  :global(.executive-report__content p) {
    margin: 0 0 1.5rem;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.9;
  }

  :global(.executive-report__content h2) {
    margin: 3rem 0 1.15rem;
    color: var(--color-base-900);
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 2.15vw, 2.15rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  :global(.executive-report__content h2 + p) {
    margin-top: 0;
  }

  :global(.executive-report__content a) {
    color: var(--color-accent-700);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color 180ms ease;
  }

  :global(.executive-report__content a:hover),
  :global(.executive-report__content a:focus-visible) {
    color: var(--color-base-900);
  }

  :global(.executive-report__content strong) {
    color: var(--color-base-900);
    font-weight: 700;
  }

  :global(.executive-report__content ul),
  :global(.executive-report__content ol) {
    margin: 1.5rem 0 1.5rem 1.5rem;
    padding-left: 1rem;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.85;
  }

  :global(.executive-report__content ul) {
    list-style: disc;
  }

  :global(.executive-report__content ol) {
    list-style: decimal;
  }

  :global(.executive-report__content li) {
    margin-bottom: 0.75rem;
    padding-left: 0.25rem;
  }

  .executive-report__cta {
    margin-top: 3rem;
    border-top: 1px solid var(--color-accent-500);
    border-bottom: 1px solid var(--color-base-200);
    padding: 1.45rem 0 1.55rem;
  }

  .executive-report__cta a {
    display: inline-flex;
    color: var(--color-base-950);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
  }

  .executive-report__cta a:hover,
  .executive-report__cta a:focus-visible {
    color: var(--color-accent-800);
  }

  .executive-report__cta p {
    max-width: 44rem;
    margin: 0.75rem 0 0;
    color: var(--color-base-600);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
  }

  .executive-report__footer-nav {
    display: grid;
    gap: 0.85rem;
    margin-top: 2rem;
    padding-top: 1.55rem;
    border-top: 1px solid var(--color-base-200);
  }

  .executive-report__footer-nav a {
    width: fit-content;
    color: var(--color-accent-700);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .executive-report__footer-nav a:hover,
  .executive-report__footer-nav a:focus-visible {
    color: var(--color-base-950);
    border-color: var(--color-base-950);
  }

  @media (max-width: 760px) {
    .executive-report__shell {
      padding-inline: 1.25rem;
    }

    .executive-report__hero-shell {
      padding-top: 1.5rem;
      padding-bottom: 2.35rem;
    }

    .executive-report__meta {
      margin-top: 1.45rem;
      font-size: 0.72rem;
      letter-spacing: 0.1em;
    }

    .executive-report h1 {
      font-size: clamp(1.9rem, 8.8vw, 2.65rem);
      line-height: 1.1;
    }

    .executive-report__deck {
      font-size: 1rem;
      line-height: 1.6;
    }

    .executive-report__layout {
      padding-top: 2.45rem;
      padding-bottom: 3.6rem;
    }

    .executive-report__body {
      width: 100%;
    }

    :global(.executive-report__content p),
    :global(.executive-report__content ul),
    :global(.executive-report__content ol) {
      font-size: 1rem;
      line-height: 1.8;
    }

    :global(.executive-report__content h2) {
      margin-top: 2.55rem;
      font-size: clamp(1.45rem, 7vw, 2rem);
      letter-spacing: -0.022em;
    }
  }
</style>
