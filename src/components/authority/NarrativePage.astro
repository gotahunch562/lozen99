---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface NarrativeRailItem {
  label: string;
  value: string;
}

interface NarrativeLink {
  label: string;
  href: string;
  description?: string;
}

interface NarrativeCta {
  label?: string;
  title: string;
  description?: string;
  href: string;
  linkLabel?: string;
}

interface Props {
  title: string;
  seoTitle?: string;
  description?: string;
  metaDescription?: string;
  canonical?: string;
  eyebrow?: string;
  typeLabel?: string;
  dateLabel?: string;
  backHref?: string;
  backLabel?: string;
  ogImage?: string;
  ogImageAlt?: string;
  heroImage?: string;
  heroImageAlt?: string;
  heroImageCaption?: string;
  heroImagePosition?: string;
  articleJsonLd?: Record<string, unknown>;
  railTitle?: string;
  railItems?: NarrativeRailItem[];
  railLinks?: NarrativeLink[];
  railCta?: NarrativeCta;
  bottomCta?: NarrativeCta;
  relatedEyebrow?: string;
  relatedTitle?: string;
  relatedItems?: NarrativeLink[];
}

const {
  title,
  seoTitle,
  description,
  metaDescription,
  canonical,
  eyebrow = "Lozen Advisory",
  typeLabel,
  dateLabel,
  backHref,
  backLabel = "Back",
  ogImage,
  ogImageAlt,
  heroImage,
  heroImageAlt = "",
  heroImageCaption,
  heroImagePosition = "center center",
  articleJsonLd,
  railTitle = "Page Context",
  railItems = [],
  railLinks = [],
  railCta,
  bottomCta,
  relatedEyebrow = "Related Reading",
  relatedTitle = "Continue through the architecture",
  relatedItems = [],
} = Astro.props;

const pageDescription = metaDescription ?? description;
const pageImage = ogImage ?? heroImage;
const pageImageAlt = ogImageAlt ?? heroImageAlt;
const hasRailSlot = Astro.slots.has("rail");
const hasAfterContentSlot = Astro.slots.has("after-content");
const hasRailContent =
  hasRailSlot || railItems.length > 0 || railLinks.length > 0 || Boolean(railCta);
const hasRelatedItems = relatedItems.length > 0;
const hasHeroImage = Boolean(heroImage);
const heroClass = hasHeroImage
  ? "narrative-page__hero narrative-page__hero--split"
  : "narrative-page__hero narrative-page__hero--text-only";
const heroShellClass = hasHeroImage
  ? "narrative-page__shell narrative-page__hero-shell narrative-page__hero-shell--split"
  : hasRailContent
    ? "narrative-page__shell narrative-page__hero-shell narrative-page__hero-shell--text-only narrative-page__hero-shell--text-only-with-rail"
    : "narrative-page__shell narrative-page__hero-shell narrative-page__hero-shell--text-only narrative-page__hero-shell--text-only-article";
const contentShellClass = hasRailContent
  ? "narrative-page__content-shell narrative-page__content-shell--with-rail"
  : "narrative-page__content-shell";
---

<BaseLayout
  title={seoTitle ?? title}
  description={pageDescription}
  canonical={canonical}
  ogImage={pageImage}
  ogImageAlt={pageImageAlt}
  ogType="article"
>
  {
    articleJsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(articleJsonLd)}
      ></script>
    )
  }

  <article class="narrative-page">
    <header class={heroClass}>
      <div class={heroShellClass}>
        <div class="narrative-page__hero-copy">
          {backHref && <a href={backHref} class="narrative-page__back">← {backLabel}</a>}

          <div class="narrative-page__meta" aria-label="Page metadata">
            <span>{eyebrow}</span>
            {typeLabel && <span>{typeLabel}</span>}
            {dateLabel && <span>{dateLabel}</span>}
          </div>

          <h1>{title}</h1>

          {
            description && (
              <p class="narrative-page__deck">
                {description}
              </p>
            )
          }
        </div>

        {
          heroImage && (
            <figure class="narrative-page__hero-figure">
              <img
                src={heroImage}
                alt={heroImageAlt}
                loading="eager"
                decoding="async"
                style={`object-position: ${heroImagePosition};`}
              />
              {
                heroImageCaption && (
                  <figcaption>{heroImageCaption}</figcaption>
                )
              }
            </figure>
          )
        }
      </div>
    </header>

    <div class={contentShellClass}>
      <div class="narrative-page__article-column">
        <div class="narrative-page__body">
          <slot />
        </div>

        {hasAfterContentSlot && <slot name="after-content" />}

        {
          hasRelatedItems && (
            <nav class="narrative-page__related" aria-label="Related reading">
              <p class="narrative-page__related-eyebrow">{relatedEyebrow}</p>
              <h2>{relatedTitle}</h2>

              <div class="narrative-page__related-list">
                {relatedItems.map((item) => (
                  <a href={item.href} class="narrative-page__related-link">
                    <span>{item.label}</span>
                    {item.description && <small>{item.description}</small>}
                  </a>
                ))}
              </div>
            </nav>
          )
        }

        {
          bottomCta && (
            <section class="narrative-page__bottom-cta" aria-label={bottomCta.label ?? "Next step"}>
              {bottomCta.label && <p>{bottomCta.label}</p>}
              <h2>{bottomCta.title}</h2>
              {bottomCta.description && <div>{bottomCta.description}</div>}
              <a href={bottomCta.href}>{bottomCta.linkLabel ?? "Request Briefing →"}</a>
            </section>
          )
        }
      </div>

      {
        hasRailContent && (
          <aside class="narrative-page__rail" aria-label="Page context">
            {hasRailSlot && <slot name="rail" />}

            {
              (railItems.length > 0 || railLinks.length > 0 || railCta) && (
                <div class="narrative-page__rail-stack">
                  {railItems.length > 0 && (
                    <section class="narrative-page__rail-section">
                      <p class="narrative-page__rail-title">{railTitle}</p>
                      <dl>
                        {railItems.map((item) => (
                          <div>
                            <dt>{item.label}</dt>
                            <dd>{item.value}</dd>
                          </div>
                        ))}
                      </dl>
                    </section>
                  )}

                  {railCta && (
                    <a href={railCta.href} class="narrative-page__rail-cta">
                      {railCta.label && <p>{railCta.label}</p>}
                      <strong>{railCta.title}</strong>
                      {railCta.description && <span>{railCta.description}</span>}
                      <em>{railCta.linkLabel ?? "Request Briefing →"}</em>
                    </a>
                  )}

                  {railLinks.length > 0 && (
                    <section class="narrative-page__rail-section narrative-page__rail-section--links">
                      <p class="narrative-page__rail-title">Related</p>
                      <nav aria-label="Related page links">
                        {railLinks.map((link) => (
                          <a href={link.href}>
                            <span>{link.label}</span>
                            {link.description && <small>{link.description}</small>}
                          </a>
                        ))}
                      </nav>
                    </section>
                  )}
                </div>
              )
            }
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .narrative-page {
    background: var(--color-base-50);
    color: var(--color-base-700);
  }

  .narrative-page__shell,
  .narrative-page__content-shell {
    width: min(100%, 86rem);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .narrative-page__hero {
    overflow: hidden;
    border-bottom: 1px solid color-mix(in oklch, var(--color-accent-500) 34%, var(--color-base-950));
    background:
      radial-gradient(circle at 20% 18%, rgba(232, 230, 60, 0.1), transparent 30%),
      linear-gradient(135deg, var(--color-base-950) 0%, var(--color-base-900) 52%, #020a17 100%);
    color: white;
  }

  .narrative-page__hero-shell {
    display: grid;
    padding-top: clamp(6.25rem, 9vw, 8rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .narrative-page__hero-shell--split {
    grid-template-columns: minmax(0, 0.96fr) minmax(21rem, 0.78fr);
    min-height: clamp(28rem, 46vw, 39rem);
    gap: clamp(2rem, 5vw, 4.75rem);
    align-items: center;
  }

  .narrative-page__hero-shell.narrative-page__hero-shell--text-only {
    display: block;
    grid-template-columns: none;
    min-height: 0 !important;
    height: auto;
    padding-top: clamp(5rem, 7vw, 6.25rem);
    padding-bottom: clamp(2.35rem, 3.75vw, 3.15rem);
    align-items: start;
  }

  .narrative-page__hero-shell.narrative-page__hero-shell--text-only-article {
    width: min(100%, 58rem);
  }

  .narrative-page__hero-shell.narrative-page__hero-shell--text-only-with-rail {
    width: min(100%, 86rem);
  }

  .narrative-page__hero-shell.narrative-page__hero-shell--text-only .narrative-page__hero-copy {
    width: 100%;
  }

  .narrative-page__hero-shell.narrative-page__hero-shell--text-only h1 {
    max-width: 58rem;
    font-size: clamp(2.35rem, 4.05vw, 4.45rem);
  }

  .narrative-page__hero-shell.narrative-page__hero-shell--text-only .narrative-page__deck {
    max-width: 50rem;
  }

  .narrative-page__hero-shell.narrative-page__hero-shell--text-only-with-rail h1 {
    max-width: 62rem;
  }

  .narrative-page__hero-shell.narrative-page__hero-shell--text-only-with-rail .narrative-page__deck {
    max-width: 54rem;
  }

  .narrative-page__hero-copy {
    width: min(100%, 56rem);
  }

  .narrative-page__back {
    display: inline-flex;
    margin-bottom: 1.75rem;
    color: color-mix(in oklch, var(--color-base-100) 76%, white);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .narrative-page__back:hover,
  .narrative-page__back:focus-visible {
    color: var(--color-accent-300);
  }

  .narrative-page__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    color: color-mix(in oklch, var(--color-base-100) 78%, white);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .narrative-page__meta span:first-child {
    border-left: 1px solid var(--color-accent-500);
    padding-left: 1rem;
    color: white;
  }

  .narrative-page h1 {
    max-width: 62rem;
    margin: 1.2rem 0 0;
    color: white;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.4vw, 4.85rem);
    font-weight: 500;
    letter-spacing: -0.047em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .narrative-page__deck {
    max-width: 45rem;
    margin: 1.35rem 0 0;
    color: color-mix(in oklch, var(--color-base-100) 90%, white);
    font-family: var(--font-sans);
    font-size: clamp(1.0625rem, 1.45vw, 1.25rem);
    line-height: 1.72;
  }

  .narrative-page__hero-figure {
    position: relative;
    align-self: stretch;
    min-height: clamp(23rem, 36vw, 35rem);
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in oklch, var(--color-base-100) 18%, transparent);
    border-radius: 1.35rem;
    background: var(--color-base-950);
    box-shadow:
      0 28px 80px rgba(0, 0, 0, 0.36),
      0 0 0 1px rgba(255, 255, 255, 0.05) inset;
  }

  .narrative-page__hero-figure::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(6, 23, 47, 0.02), rgba(6, 23, 47, 0.22)),
      linear-gradient(90deg, rgba(6, 23, 47, 0.12), transparent 34%);
  }

  .narrative-page__hero-figure img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.05);
  }

  .narrative-page__hero-figure figcaption {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    z-index: 1;
    max-width: calc(100% - 1.7rem);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(6, 23, 47, 0.72);
    padding: 0.5rem 0.75rem;
    color: color-mix(in oklch, var(--color-base-100) 86%, white);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.35;
    backdrop-filter: blur(10px);
  }

  .narrative-page__content-shell {
    display: block;
    padding-top: clamp(3rem, 5vw, 4.75rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .narrative-page__content-shell--with-rail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
    gap: clamp(3rem, 5vw, 5rem);
    align-items: start;
  }

  .narrative-page__article-column {
    width: min(100%, 58rem);
  }

  .narrative-page__content-shell:not(.narrative-page__content-shell--with-rail) .narrative-page__article-column {
    margin-inline: auto;
  }

  .narrative-page__body {
    color: var(--color-base-700);
  }

  .narrative-page__body :global(*:first-child) {
    margin-top: 0;
  }

  .narrative-page__body :global(p) {
    margin: 0 0 1.45rem;
    color: var(--color-base-700);
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.92;
  }

  .narrative-page__body :global(h2) {
    margin: 3.2rem 0 1.1rem;
    color: var(--color-base-950);
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .narrative-page__body :global(h3) {
    margin: 2.25rem 0 0.85rem;
    color: var(--color-base-900);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .narrative-page__body :global(h2 + p),
  .narrative-page__body :global(h3 + p) {
    margin-top: 0;
  }

  .narrative-page__body :global(a) {
    color: var(--color-accent-700);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent-700) 48%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition:
      color 180ms ease,
      text-decoration-color 180ms ease;
  }

  .narrative-page__body :global(a:hover),
  .narrative-page__body :global(a:focus-visible) {
    color: var(--color-base-950);
    text-decoration-color: var(--color-base-950);
  }

  .narrative-page__body :global(strong) {
    color: var(--color-base-950);
    font-weight: 750;
  }

  .narrative-page__body :global(em) {
    font-style: italic;
  }

  .narrative-page__body :global(ul),
  .narrative-page__body :global(ol) {
    margin: 1.25rem 0 1.6rem 1.5rem;
    padding-left: 1rem;
    color: var(--color-base-700);
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.85;
  }

  .narrative-page__body :global(ul) {
    list-style: disc;
  }

  .narrative-page__body :global(ol) {
    list-style: decimal;
  }

  .narrative-page__body :global(li) {
    margin-bottom: 0.75rem;
    padding-left: 0.25rem;
  }

  .narrative-page__body :global(blockquote),
  .narrative-page__body :global(.narrative-pullquote) {
    margin: 2.75rem 0;
    border-left: 2px solid var(--color-accent-500);
    padding-left: 1.35rem;
    color: var(--color-base-950);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }

  .narrative-page__body :global(blockquote p),
  .narrative-page__body :global(.narrative-pullquote p) {
    margin: 0;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  .narrative-page__body :global(.narrative-callout) {
    margin: 2.5rem 0;
    border: 1px solid var(--color-base-200);
    border-left: 3px solid var(--color-accent-500);
    border-radius: 1.25rem;
    background: white;
    padding: 1.5rem;
    box-shadow: var(--shadow-lg);
  }

  .narrative-page__body :global(.narrative-callout p:last-child) {
    margin-bottom: 0;
  }

  .narrative-page__body :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--color-base-200);
  }

  .narrative-page__body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 1.25rem;
  }

  .narrative-page__rail {
    position: sticky;
    top: 6.5rem;
  }

  .narrative-page__rail-stack,
  .narrative-page__rail :global(.narrative-page__rail-custom) {
    display: grid;
    gap: 1rem;
  }

  .narrative-page__rail-section {
    border-top: 1px solid var(--color-base-300);
    padding-top: 1.25rem;
  }

  .narrative-page__rail-title {
    margin: 0 0 1rem;
    color: var(--color-base-900);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .narrative-page__rail dl {
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .narrative-page__rail dt {
    color: var(--color-base-500);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .narrative-page__rail dd {
    margin: 0.35rem 0 0;
    color: var(--color-base-800);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .narrative-page__rail-cta {
    display: block;
    border: 1px solid var(--color-base-300);
    border-radius: 1.1rem;
    background: white;
    padding: 1.15rem;
    text-decoration: none;
    box-shadow: var(--shadow-md);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .narrative-page__rail-cta:hover,
  .narrative-page__rail-cta:focus-visible {
    border-color: var(--color-accent-500);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .narrative-page__rail-cta p {
    margin: 0 0 0.65rem;
    color: var(--color-accent-700);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .narrative-page__rail-cta strong {
    display: block;
    color: var(--color-base-950);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .narrative-page__rail-cta span {
    display: block;
    margin-top: 0.65rem;
    color: var(--color-base-700);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.58;
  }

  .narrative-page__rail-cta em {
    display: inline-flex;
    margin-top: 0.85rem;
    color: var(--color-accent-700);
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-style: normal;
    font-weight: 800;
  }

  .narrative-page__rail-section--links nav {
    display: grid;
    gap: 0.75rem;
  }

  .narrative-page__rail-section--links a {
    display: block;
    border-bottom: 1px solid var(--color-base-200);
    padding-bottom: 0.75rem;
    color: var(--color-base-900);
    font-family: var(--font-sans);
    text-decoration: none;
  }

  .narrative-page__rail-section--links a:hover,
  .narrative-page__rail-section--links a:focus-visible {
    color: var(--color-accent-700);
  }

  .narrative-page__rail-section--links span {
    display: block;
    font-size: 0.92rem;
    font-weight: 800;
    line-height: 1.35;
  }

  .narrative-page__rail-section--links small {
    display: block;
    margin-top: 0.25rem;
    color: var(--color-base-600);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .narrative-page__related {
    margin-top: 3.25rem;
    border-top: 1px solid var(--color-base-300);
    padding-top: 1.75rem;
  }

  .narrative-page__related-eyebrow {
    margin: 0;
    color: var(--color-base-500);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .narrative-page__related h2 {
    margin: 0.65rem 0 1.25rem;
    color: var(--color-base-950);
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  .narrative-page__related-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-base-200);
  }

  .narrative-page__related-link {
    display: grid;
    gap: 0.25rem;
    border-bottom: 1px solid var(--color-base-200);
    padding: 1rem 0;
    color: var(--color-base-950);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .narrative-page__related-link:hover,
  .narrative-page__related-link:focus-visible {
    color: var(--color-accent-700);
  }

  .narrative-page__related-link span {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 800;
