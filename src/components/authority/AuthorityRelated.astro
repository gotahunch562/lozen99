---
interface RelatedItem {
  title: string;
  href: string;
  description?: string;
  eyebrow?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  items: RelatedItem[];
}

const {
  eyebrow = "Related Reading",
  title = "Continue through the architecture",
  items,
} = Astro.props;
---

<section class="rounded-3xl border border-base-200 bg-base-950 p-6 text-white shadow-sm sm:p-8">
  <p class="border-l border-accent-500 pl-4 text-xs font-medium uppercase tracking-[0.18em] text-base-300">
    {eyebrow}
  </p>

  <h2 class="mt-6 max-w-2xl font-display text-3xl font-medium uppercase leading-none tracking-tight text-white sm:text-4xl">
    {title}
  </h2>

  <div class="mt-8 grid gap-4">
    {
      items.map((item) => (
        <a
          href={item.href}
          class="group block rounded-2xl border border-white/10 bg-white/[0.04] p-5 transition-all duration-300 hover:-translate-y-1 hover:border-accent-400 hover:bg-white/[0.08]"
        >
          {item.eyebrow && (
            <p class="text-xs font-medium uppercase tracking-[0.16em] text-accent-300">
              {item.eyebrow}
            </p>
          )}

          <h3 class="mt-3 text-base font-semibold leading-6 text-white">
            {item.title}
          </h3>

          {item.description && (
            <p class="mt-3 text-sm leading-6 text-base-300">
              {item.description}
            </p>
          )}

          <span class="mt-5 inline-flex text-sm font-medium text-accent-300 transition-transform duration-300 group-hover:translate-x-1">
            Read next →
          </span>
        </a>
      ))
    }
  </div>
</section>
