---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  dateLabel?: string;
  backHref?: string;
  backLabel?: string;
  articleJsonLd?: Record<string, unknown>;
}

const {
  eyebrow = "Research & Policy",
  title,
  description,
  image,
  imageAlt = "",
  dateLabel,
  backHref = "/blog",
  backLabel = "Back to Research",
  articleJsonLd,
} = Astro.props;

const articleDescription =
  typeof articleJsonLd?.description === "string"
    ? articleJsonLd.description
    : description;
---

<BaseLayout
  title={title}
  description={articleDescription}
  ogImage={image}
  ogImageAlt={imageAlt}
  ogType="article"
>
  {
    articleJsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(articleJsonLd)}
      ></script>
    )
  }

  <main class="bg-base-50">
    <section class="border-b border-base-200 bg-base-50">
      <div class="mx-auto w-full max-w-7xl px-8 pb-12 pt-8 lg:pb-16 lg:pt-12">
        {
          image && (
            <figure class="overflow-hidden rounded-3xl border border-base-200 bg-base-100 shadow-sm">
              <img
                src={image}
                alt={imageAlt}
                class="h-[18rem] w-full object-cover sm:h-[24rem] lg:h-[32rem]"
                loading="eager"
                decoding="async"
              />
            </figure>
          )
        }

        <div class="mt-10 max-w-5xl">
          <a
            href={backHref}
            class="inline-flex items-center text-sm font-medium text-base-700 transition-colors duration-300 hover:text-accent-700"
          >
            ← {backLabel}
          </a>

          <div class="mt-8 flex flex-wrap items-center gap-3 text-xs font-medium uppercase tracking-[0.18em] text-base-600">
            <span class="border-l border-accent-500 pl-4 text-base-700">
              {eyebrow}
            </span>

            {
              dateLabel && (
                <>
                  <span class="h-1 w-1 rounded-full bg-accent-500"></span>
                  <span>{dateLabel}</span>
                </>
              )
            }
          </div>

          <h1 class="mt-6 max-w-4xl font-display text-3xl font-medium uppercase leading-[1.02] tracking-tight text-base-950 sm:text-4xl lg:text-5xl">
            {title}
          </h1>

          {
            description && (
              <p class="mt-7 max-w-3xl text-base leading-7 text-base-800 sm:text-lg">
                {description}
              </p>
            )
          }
        </div>
      </div>
    </section>

    <section class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-10 px-8 py-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16 lg:py-16">
      <article class="min-w-0">
        <div class="authority-prose">
          <slot />
        </div>
      </article>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <slot name="rail" />
      </aside>
    </section>
  </main>
</BaseLayout>

<style>
  .authority-prose {
    max-width: 56rem;
  }

  .authority-prose :global(.authority-article-body) {
    border-bottom: 1px solid var(--color-base-200);
    padding-bottom: 3rem;
  }

  .authority-prose :global(.authority-article-body p) {
    margin-top: 1.35rem;
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--color-base-700);
  }

  .authority-prose :global(.authority-article-body p:first-child) {
    margin-top: 0;
  }

  .authority-prose :global(.authority-article-body a) {
    color: var(--color-accent-700);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent-400);
    transition:
      color 300ms ease,
      border-color 300ms ease;
  }

  .authority-prose :global(.authority-article-body a:hover) {
    color: var(--color-base-950);
    border-color: var(--color-base-950);
  }

  .authority-prose :global(.authority-article-body h2) {
    margin-top: 3.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: var(--color-base-950);
  }

  .authority-prose :global(.authority-article-body .section-number) {
    display: inline-flex;
    margin-top: 4rem;
    margin-bottom: 1rem;
    border-left: 1px solid var(--color-accent-500);
    padding-left: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-base-500);
  }

  .authority-prose :global(.authority-bottom-stack) {
    margin-top: 3rem;
    display: grid;
    gap: 2rem;
  }
</style>
