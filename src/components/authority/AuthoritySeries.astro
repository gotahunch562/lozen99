---
interface SeriesItem {
  number: string;
  title: string;
  href?: string;
  status?: "current" | "available" | "forthcoming";
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: SeriesItem[];
}

const {
  eyebrow = "Series",
  title,
  description,
  items,
} = Astro.props;

const getItemClasses = (status?: SeriesItem["status"]) => {
  if (status === "current") {
    return "border-accent-500 bg-accent-50 text-base-950";
  }

  if (status === "forthcoming") {
    return "border-base-200 bg-base-100 text-base-700";
  }

  return "border-base-200 bg-white text-base-800 hover:-translate-y-1 hover:border-accent-400 hover:bg-accent-50 hover:shadow-sm";
};
---

<section class="rounded-3xl border border-base-200 bg-white p-6 shadow-sm sm:p-8">
  <p class="border-l border-accent-500 pl-4 text-xs font-medium uppercase tracking-[0.18em] text-base-600">
    {eyebrow}
  </p>

  <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-8">
    <div>
      <h2 class="font-display text-xl font-medium uppercase leading-tight tracking-tight text-base-950 sm:text-2xl">
        {title}
      </h2>

      {
        description && (
          <p class="mt-4 text-sm leading-6 text-base-800">
            {description}
          </p>
        )
      }
    </div>

    <ol class="grid gap-3">
      {
        items.map((item) => {
          const isLinked =
            Boolean(item.href) &&
            item.status !== "current" &&
            item.status !== "forthcoming";

          const itemClasses = getItemClasses(item.status);

          return (
            <li>
              {isLinked ? (
                <a href={item.href} class="block no-underline">
                  <div class={`group flex gap-4 rounded-2xl border p-4 transition-all duration-300 ${itemClasses}`}>
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-current/20 text-xs font-semibold">
                      {item.number}
                    </span>

                    <div class="min-w-0">
                      <p class="text-sm font-semibold leading-6">
                        {item.title}
                      </p>
                    </div>

                    <span class="ml-auto self-center text-accent-600 transition-transform duration-300 group-hover:translate-x-1">
                      →
                    </span>
                  </div>
                </a>
              ) : (
                <div
                  class={`group flex gap-4 rounded-2xl border p-4 transition-all duration-300 ${itemClasses}`}
                  aria-current={item.status === "current" ? "page" : undefined}
                >
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-current/20 text-xs font-semibold">
                    {item.number}
                  </span>

                  <div class="min-w-0">
                    <p class="text-sm font-semibold leading-6">
                      {item.title}
                    </p>

                    {item.status === "current" && (
                      <p class="mt-1 text-xs font-medium uppercase tracking-[0.14em] text-accent-700">
                        Current report
                      </p>
                    )}

                    {item.status === "forthcoming" && (
                      <p class="mt-1 text-xs font-medium uppercase tracking-[0.14em] text-base-400">
                        Forthcoming
                      </p>
                    )}
                  </div>
                </div>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
