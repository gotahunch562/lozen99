---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Category {
  id: string;
  title: string;
  description: string;
  icon?: string;
  href: string;
  featured?: boolean;
}

interface Resource {
  id: string;
  title: string;
  excerpt: string;
  category: string;
  date?: string;
  href: string;
  featured?: boolean;
}

interface Props {
  categoryName: string;
  categoryTitle: string;
  heroDescription: string;
  heroImage?: string;
  heroImageAlt?: string;
  categoryColor?: "workplace" | "insurance" | "education" | "omnibus" | "advisory" | "military" | "veteran-care";
  subcategories?: Category[];
  featuredResources?: Resource[];
  showStats?: boolean;
  stats?: { label: string; value: string }[];
}

const {
  categoryName,
  categoryTitle,
  heroDescription,
  heroImage,
  heroImageAlt = "",
  categoryColor = "advisory",
  subcategories = [],
  featuredResources = [],
  showStats = true,
  stats = [],
} = Astro.props;

const badgeColorClass = `lozen-data-badge--focus-${categoryColor}`;
---

<BaseLayout
  title={categoryTitle}
  description={heroDescription}
  ogImage={heroImage}
  ogImageAlt={heroImageAlt}
>
  <main class="bg-base-50">
    <!-- Hero Section -->
    <section class="border-b border-base-200 bg-gradient-to-b from-base-100 via-white to-base-50">
      <div class="mx-auto w-full max-w-7xl px-8 py-12 lg:py-20">
        <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-12 lg:items-center">
          <!-- Hero Content -->
          <div class="flex flex-col justify-center">
            <!-- Eyebrow -->
            <div class="inline-flex items-center gap-3 mb-6">
              <span class="inline-flex h-2 w-2 rounded-full bg-accent-500"></span>
              <span class="text-xs font-bold uppercase tracking-[0.18em] text-base-600">
                Category Hub
              </span>
            </div>

            <!-- Title -->
            <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-medium uppercase leading-[1.02] tracking-tight text-base-950 mb-6">
              {categoryTitle}
            </h1>

            <!-- Description -->
            <p class="text-base sm:text-lg leading-relaxed text-base-700 mb-8 max-w-xl">
              {heroDescription}
            </p>

            <!-- CTA Group -->
            <div class="flex flex-wrap gap-4">
              <a
                href="#resources"
                class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-accent-500 text-base-950 font-medium text-sm uppercase tracking-[0.12em] transition-all duration-300 hover:bg-accent-600 active:scale-95"
              >
                Explore Resources
              </a>
              <a
                href="#categories"
                class="inline-flex items-center justify-center px-6 py-3 rounded-lg border border-base-300 bg-white text-base-950 font-medium text-sm uppercase tracking-[0.12em] transition-all duration-300 hover:bg-base-50 hover:border-base-400"
              >
                Browse Topics
              </a>
            </div>
          </div>

          <!-- Hero Image -->
          {
            heroImage && (
              <figure class="overflow-hidden rounded-2xl border border-base-200 bg-base-100 shadow-md lg:shadow-lg">
                <img
                  src={heroImage}
                  alt={heroImageAlt}
                  class="w-full h-auto object-cover aspect-square sm:aspect-auto lg:h-96"
                  loading="eager"
                  decoding="async"
                />
              </figure>
            )
          }
        </div>
      </div>
    </section>

    <!-- Stats Section (Optional) -->
    {
      showStats && stats.length > 0 && (
        <section class="bg-base-950 text-white border-b border-base-800">
          <div class="mx-auto w-full max-w-7xl px-8 py-12 lg:py-16">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
              {stats.map((stat) => (
                <div class="flex flex-col">
                  <span class="text-3xl sm:text-4xl font-display font-medium mb-2">
                    {stat.value}
                  </span>
                  <span class="text-sm font-medium text-base-400 uppercase tracking-[0.1em]">
                    {stat.label}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Subcategories Grid -->
    {
      subcategories.length > 0 && (
        <section class="mx-auto w-full max-w-7xl px-8 py-12 lg:py-16" id="categories">
          <div class="mb-12 lg:mb-16">
            <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-medium uppercase leading-tight tracking-tight text-base-950 mb-3">
              Explore Topics
            </h2>
            <p class="text-base text-base-700 max-w-2xl">
              Dive deeper into specific areas within {categoryTitle.toLowerCase()}. Each topic features curated research, insights, and resources.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {subcategories.map((subcategory) => (
              <a
                href={subcategory.href}
                class="group relative p-6 rounded-xl bg-white border border-base-200 transition-all duration-300 hover:shadow-lg hover:border-accent-400 active:scale-98"
              >
                {subcategory.featured && (
                  <div class="absolute top-4 right-4">
                    <span class={`lozen-data-badge ${badgeColorClass} text-xs`}>
                      Featured
                    </span>
                  </div>
                )}

                <div class="mb-4 flex items-start gap-3">
                  {subcategory.icon && (
                    <span class="text-3xl">{subcategory.icon}</span>
                  )}
                  <h3 class="font-display text-lg sm:text-xl font-medium text-base-950 group-hover:text-accent-700 transition-colors duration-300">
                    {subcategory.title}
                  </h3>
                </div>

                <p class="text-sm text-base-600 leading-relaxed mb-4">
                  {subcategory.description}
                </p>

                <div class="inline-flex items-center text-sm font-medium text-accent-700 group-hover:translate-x-1 transition-transform duration-300">
                  Learn more
                  <span class="ml-2">→</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- Featured Resources -->
    {
      featuredResources.length > 0 && (
        <section class="mx-auto w-full max-w-7xl px-8 py-12 lg:py-16 border-t border-base-200" id="resources">
          <div class="mb-12 lg:mb-16">
            <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-medium uppercase leading-tight tracking-tight text-base-950 mb-3">
              Featured Resources
            </h2>
            <p class="text-base text-base-700 max-w-2xl">
              Start with our most impactful analysis, reports, and research in {categoryName}.
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {featuredResources.map((resource, index) => (
              <a
                href={resource.href}
                class="group relative rounded-xl overflow-hidden bg-white border border-base-200 transition-all duration-300 hover:shadow-lg hover:border-accent-400 active:scale-98 flex flex-col"
              >
                {resource.featured && index === 0 && (
                  <div class="absolute top-6 left-6 z-10">
                    <span class={`lozen-data-badge ${badgeColorClass} text-xs`}>
                      Top Resource
                    </span>
                  </div>
                )}

                <div class="p-6 flex flex-col flex-1">
                  <div class="mb-3 flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-[0.14em] text-base-600 bg-base-100 px-3 py-1 rounded-md">
                      {resource.category}
                    </span>
                    {resource.date && (
                      <span class="text-xs text-base-500">{resource.date}</span>
                    )}
                  </div>

                  <h3 class="font-display text-lg sm:text-xl font-medium text-base-950 mb-3 group-hover:text-accent-700 transition-colors duration-300 leading-tight">
                    {resource.title}
                  </h3>

                  <p class="text-sm text-base-600 leading-relaxed flex-1 mb-4">
                    {resource.excerpt}
                  </p>

                  <div class="inline-flex items-center text-sm font-medium text-accent-700 group-hover:translate-x-1 transition-transform duration-300">
                    Read article
                    <span class="ml-2">→</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- CTA Footer -->
    <section class="bg-base-950 text-white border-t border-base-800">
      <div class="mx-auto w-full max-w-7xl px-8 py-12 lg:py-16">
        <div class="max-w-3xl">
          <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-medium uppercase leading-tight tracking-tight mb-4">
            Explore Beyond {categoryTitle}
          </h2>
          <p class="text-base text-base-300 mb-8 leading-relaxed">
            Discover how these insights connect to other categories, stay updated with our latest research, and subscribe to our curated briefings.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="/research"
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-accent-500 text-base-950 font-medium text-sm uppercase tracking-[0.12em] transition-all duration-300 hover:bg-accent-600 active:scale-95"
            >
              Browse All Research
            </a>
            <a
              href="/subscribe"
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg border border-base-700 bg-transparent text-white font-medium text-sm uppercase tracking-[0.12em] transition-all duration-300 hover:bg-base-900 hover:border-base-600"
            >
              Subscribe to Updates
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .lozen-data-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    border: 1px solid;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  a:active {
    transform: scale(0.98);
  }
</style>
