---
interface SeriesItem {
  number: string;
  title: string;
  href: string;
  slug: string;
}

const { currentSlug } = Astro.props as { currentSlug?: string };

const seriesItems: SeriesItem[] = [
  {
    number: "1.",
    title: "Menopause Workplace Frameworks: A Visibility Constraint",
    href: "/blog/menopause-workplace-visibility-constraint",
    slug: "menopause-workplace-visibility-constraint",
  },
  {
    number: "2.",
    title: "Virginia HB1173/SB258: What the Law Protects and What It Cannot Measure",
    href: "/blog/virginia-menopause-protected-class",
    slug: "virginia-menopause-protected-class",
  },
  {
    number: "3.",
    title: "Virginia's Governor Substituted a Study for Menopause Protections",
    href: "/blog/virginia-menopause-bill-split-outcome",
    slug: "virginia-menopause-bill-split-outcome",
  },
  {
    number: "4.",
    title: "Maryland SB892: What the Menopause Bill's 176 Votes Cannot Fix",
    href: "/blog/maryland-sb892-menopause",
    slug: "maryland-sb892-menopause",
  },
  {
    number: "5.",
    title: "New York State Senate Bill S9247: Leave Entitlement Without Visibility",
    href: "/blog/ny-s9247-menopause-leave",
    slug: "ny-s9247-menopause-leave",
  },
  {
    number: "6.",
    title: "New York S7495: The Policy Gap and The Invisible Majority",
    href: "/blog/ny-s7495-invisible-majority-policy-gap",
    slug: "ny-s7495-invisible-majority-policy-gap",
  },
  {
    number: "7.",
    title: "New York S3908: The Menopause Workers-Comp Policy Gap",
    href: "/blog/ny-s3908-workers-comp-menopause-gap",
    slug: "ny-s3908-workers-comp-menopause-gap",
  },
  {
    number: "8.",
    title: "Menopause at Work: The Data Employers Do Not See",
    href: "/blog/menopause-at-work-unquantified-data-gap",
    slug: "menopause-at-work-unquantified-data-gap",
  },
  {
    number: "9.",
    title: "Menopause at Work and Caregiving: The Cost of Tacere℠",
    href: "/blog/tacere-menopause-caregiving-attrition",
    slug: "tacere-menopause-caregiving-attrition",
  },
];

const normalizedCurrentSlug = String(currentSlug || "")
  .replace(/^\/?blog\//, "")
  .replace(/^\/+/, "")
  .replace(/\.mdx?$/, "");

const isSeriesArticle = seriesItems.some((item) => item.slug === normalizedCurrentSlug);
---

{
  isSeriesArticle && (
    <aside
      class="not-prose mt-14 border-t border-base-200 pt-8"
      aria-labelledby="legal-series-heading"
    >
      <div class="rounded-sm border border-base-200 bg-base-50 p-6 shadow-sm sm:p-8">
        <p class="font-display text-sm uppercase tracking-[0.18em] text-accent-700">
          Series
        </p>

        <h2
          id="legal-series-heading"
          class="mt-3 font-display text-2xl leading-tight text-base-900 sm:text-3xl"
        >
          Menopause at Work, Policy, and the Measurement Gap
        </h2>

        <p class="mt-4 text-base leading-7 text-base-600">
          This article is part of a nine-part series examining how existing menopause workplace frameworks, legislation, and workforce studies are bounded by the same disclosure condition they are designed to address.
        </p>

        <ol class="mt-7 space-y-3">
          {seriesItems.map((item) => {
            const isCurrent = item.slug === normalizedCurrentSlug;

            return (
              <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-3 text-base leading-7 sm:grid-cols-[3rem_minmax(0,1fr)]">
                <span class="font-display text-sm uppercase tracking-[0.16em] text-base-500">
                  {item.number}
                </span>

                {isCurrent ? (
                  <span
                    class="font-display text-base-900"
                    aria-current="page"
                  >
                    <span aria-hidden="true" class="mr-1 text-accent-700">
                      ▸
                    </span>
                    {item.title}
                  </span>
                ) : (
                  <a
                    href={item.href}
                    class="font-display text-base-800 underline-offset-4 transition-colors hover:text-accent-700 hover:underline"
                  >
                    {item.title}
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    </aside>
  )
}
