---
// Assets
import { Image } from "astro:assets";

// Fundations
import Text from "@/components/fundations/elements/Text.astro";

const service = Astro.props.service;

const { title, description, url, eyebrow, duration, image } = {
  url: "/services/" + service.id + "/",
  title: service.data.title,
  description: service.data.shortDescription || service.data.description,
  eyebrow: service.data.priceFrom,
  duration: service.data.duration,
  image: service.data.image,
};

const imageAsset = image?.url ?? image;
const imageAlt = image?.alt || `${title} service image`;
---

<article class="group">
  <a
    href={url}
    title={`View service: ${title}`}
    aria-label={`View service: ${title}`}
    class="block no-underline"
  >
    <div class="relative aspect-[4/3] overflow-hidden bg-base-100">
      {
        imageAsset && (
          <Image
            src={imageAsset}
            alt={imageAlt}
            width={1200}
            height={900}
            class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        )
      }

      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-base-950/35 via-transparent to-transparent"
      >
      </div>
    </div>

    <div class="pt-6">
      <Text
        tag="span"
        variant="textXS"
        class="font-sans font-semibold uppercase tracking-[0.16em] text-accent-700"
      >
        {eyebrow}
      </Text>

      <div class="mt-3 flex items-start justify-between gap-4">
        <Text
          tag="h3"
          variant="displayXS"
          class="font-display font-normal uppercase leading-tight tracking-[-0.015em] text-base-950 transition-colors duration-300 group-hover:text-accent-700"
        >
          {title}
        </Text>

        <span
          aria-hidden="true"
          class="mt-1 shrink-0 font-sans text-xl leading-none text-base-950 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-accent-700"
        >
          →
        </span>
      </div>

      <Text
        tag="p"
        variant="textBase"
        class="mt-4 max-w-xl font-sans leading-7 text-base-700"
      >
        {description}
      </Text>

      {
        duration && (
          <Text
            tag="p"
            variant="textXS"
            class="mt-5 border-t border-base-200 pt-4 font-sans font-semibold uppercase tracking-[0.12em] text-base-500"
          >
            {duration}
          </Text>
        )
      }
    </div>
  </a>
</article>
