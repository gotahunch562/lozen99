---
import { Image } from "astro:assets";
// Assets
// Fundations
import Text from "@/components/fundations/elements/Text.astro";

const { post } = Astro.props;

const normalizeSlug = (value: string) =>
  String(value || "")
    .replace(/^\/?blog\//, "")
    .replace(/^\/+/, "")
    .replace(/\.mdx?$/, "");

const getPostHref = (post: any) =>
  `/blog/${normalizeSlug(post.data.slug || post.slug || post.id)}`;

// Content
const { title, description, url, image, imageAlt, pubDate } = {
  url: getPostHref(post),
  title: post.data.title,
  description: post.data.description,
  image: post.data.image.url,
  imageAlt: post.data.image.alt || post.data.title,
  pubDate: post.data.pubDate,
};
---

<article
  class="group relative min-h-[30rem] overflow-hidden rounded-2xl border border-base-400 bg-base-950 shadow-2xl ring-1 ring-base-950/10 transition-all duration-300 hover:-translate-y-1 hover:border-accent-500 hover:shadow-2xl lg:aspect-[4/3] lg:min-h-0 lg:rounded-3xl"
>
  <a
    href={url}
    title={`Read more: ${title}`}
    aria-label={`Read blog post: ${title}`}
    class="absolute inset-0 z-30"
  >
  </a>

  <Image  loading="lazy" 
    
    src={image}
    alt={imageAlt}
    width={1000}
    height={750}
    class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105"
  />

  <div
    aria-hidden="true"
    class="absolute inset-0 pointer-events-none bg-gradient-to-b from-base-950/88 via-base-950/72 to-base-950/96"
  >
  </div>

  <div
    aria-hidden="true"
    class="absolute inset-0 pointer-events-none bg-gradient-to-r from-base-950/55 via-base-950/20 to-base-950/50"
  >
  </div>

  <div
    aria-hidden="true"
    class="absolute inset-x-0 top-0 z-10 h-1 bg-accent-500"
  >
  </div>

  <div class="absolute inset-0 z-10 flex flex-col justify-end p-5 sm:p-6 lg:p-8">
    <div class="relative">
      <Text
        tag="span"
        variant="textSM"
        class="border-l border-accent-500 pl-4 font-sans font-semibold uppercase tracking-[0.16em] text-base-200"
      >
        {
          new Date(pubDate).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </Text>

      <Text
        tag="h2"
        variant="displaySM"
        class="mt-6 font-display font-normal uppercase leading-tight tracking-[-0.02em] text-white sm:mt-8"
      >
        {title}
      </Text>

      <Text
        tag="p"
        variant="textBase"
        class="mt-4 max-w-2xl font-sans leading-7 text-base-200 text-balance"
      >
        {description}
      </Text>

      <span
        class="mt-6 inline-flex font-sans text-sm font-semibold text-accent-300 transition-all duration-300 group-hover:translate-x-1 group-hover:text-accent-200"
      >
        Read article →
      </span>
    </div>
  </div>
</article>
