---
// Assets
import { Image } from "astro:assets";

const { post } = Astro.props;

const normalizeSlug = (value: string) =>
  String(value || "")
    .replace(/^\/?blog\//, "")
    .replace(/^\/+/, "")
    .replace(/\.mdx?$/, "");

const getPostHref = (post: any) =>
  `/blog/${normalizeSlug(post.data.slug || post.slug || post.id)}`;

// Content
const { title, description, url, image, pubDate } = {
  url: getPostHref(post),
  title: post.data.title,
  description: post.data.description,
  image: post.data.image.url,
  pubDate: post.data.pubDate,
};
---

<article
  class="group relative min-h-[24rem] overflow-hidden rounded-2xl border border-base-400 bg-base-950 shadow-xl ring-1 ring-base-950/10 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent-500 hover:shadow-2xl sm:min-h-[25rem] lg:aspect-[16/10] lg:min-h-0 lg:rounded-3xl"
>
  <a
    href={url}
    title={`Read more: ${title}`}
    aria-label={`Read blog post: ${title}`}
    class="absolute inset-0 z-30"
  >
  </a>

  <Image
    src={image}
    alt={title}
    width={1000}
    height={750}
    class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105"
  />

  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-base-950/82 via-base-950/68 to-base-950/96"
  >
  </div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-gradient-to-r from-base-950/62 via-base-950/25 to-base-950/42"
  >
  </div>

  <div
    aria-hidden="true"
    class="absolute inset-x-0 top-0 z-10 h-0.5 bg-accent-500"
  >
  </div>

  <div class="absolute inset-0 z-10 flex flex-col justify-end p-5 sm:p-6 lg:p-7">
    <div class="relative max-w-2xl">
      <p class="lozen-home-card-meta border-l border-accent-500 pl-4 text-base-200">
        {
          new Date(pubDate).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </p>

      <h2 class="mt-5 font-display text-[1.35rem] font-normal leading-[1.16] tracking-[-0.018em] text-white sm:text-[1.5rem] lg:text-[1.6rem]">
        {title}
      </h2>

      <p class="mt-4 max-w-2xl font-sans text-[0.96rem] leading-7 text-base-200 text-pretty">
        {description}
      </p>

      <span class="mt-5 inline-flex font-sans text-sm font-semibold text-accent-300 transition-all duration-300 group-hover:translate-x-1 group-hover:text-accent-200">
        Read article →
      </span>
    </div>
  </div>
</article>
