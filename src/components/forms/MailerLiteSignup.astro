---
interface Props {
  formId: string;
  group: "footer" | "tacere" | "poweruser";
  label?: string;
  placeholder?: string;
  buttonLabel?: string;
  successMessage?: string;
  downloadHref?: string;
  downloadLabel?: string;
  theme?: "light" | "dark";
  compact?: boolean;
}

const {
  formId,
  group,
  label = "Email address",
  placeholder = "Email address",
  buttonLabel = "Submit",
  successMessage = "Thank you. You are subscribed.",
  downloadHref,
  downloadLabel = "Download the brief",
  theme = "light",
  compact = false,
} = Astro.props;

const isDark = theme === "dark";
const inputClass = isDark
  ? "min-h-11 w-full rounded-lg border border-white/20 bg-white/10 px-4 py-3 font-sans text-sm text-white placeholder:text-white/52 outline-none transition-colors focus:border-accent-300 focus:bg-white/15 focus:ring-2 focus:ring-accent-300/25"
  : "min-h-11 w-full rounded-lg border border-base-300 bg-white px-4 py-3 font-sans text-sm text-base-950 placeholder:text-base-500 outline-none transition-colors focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20";

const buttonClass = isDark
  ? "inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg bg-accent-500 px-4 py-3 font-sans text-xs font-semibold uppercase tracking-[0.08em] text-base-950 transition-colors hover:bg-accent-400 focus:outline-2 focus:outline-offset-4 focus:outline-accent-300 disabled:cursor-not-allowed disabled:opacity-60"
  : "inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg bg-base-950 px-4 py-3 font-sans text-xs font-semibold uppercase tracking-[0.08em] text-white transition-colors hover:bg-base-800 focus:outline-2 focus:outline-offset-4 focus:outline-base-800 disabled:cursor-not-allowed disabled:opacity-60";

const statusClass = isDark
  ? "mt-3 hidden font-sans text-sm leading-6 text-white/76"
  : "mt-3 hidden font-sans text-sm leading-6 text-base-700";

const successClass = isDark
  ? "mt-4 hidden rounded-lg border border-accent-300/40 bg-white/10 p-4 font-sans text-sm leading-6 text-white/86"
  : "mt-4 hidden rounded-lg border border-accent-500/30 bg-accent-50 p-4 font-sans text-sm leading-6 text-base-800";

const downloadClass = isDark
  ? "mt-3 inline-flex font-sans text-sm font-semibold text-accent-300 underline decoration-accent-300/50 underline-offset-4 transition-colors hover:text-accent-200"
  : "mt-3 inline-flex font-sans text-sm font-semibold text-accent-800 underline decoration-accent-600/50 underline-offset-4 transition-colors hover:text-accent-700";
---

<div
  id={formId}
  class={compact ? "max-w-md" : "w-full max-w-xl"}
  data-mailerlite-signup
  data-group={group}
  data-success-message={successMessage}
>
  <form class={compact ? "space-y-3" : "space-y-4"} novalidate>
    <input
      type="text"
      name="company"
      class="hidden"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />

    <label class="sr-only" for={`${formId}-email`}>{label}</label>

    <div class={compact ? "flex flex-col gap-3 sm:flex-row" : "flex flex-col gap-3 sm:flex-row"}>
      <input
        id={`${formId}-email`}
        class={inputClass}
        type="email"
        name="email"
        placeholder={placeholder}
        autocomplete="email"
        required
      />

      <button class={buttonClass} type="submit">
        {buttonLabel}
      </button>
    </div>

    <p class={statusClass} data-status role="status" aria-live="polite"></p>
  </form>

  <div class={successClass} data-success role="status" aria-live="polite">
    <p>{successMessage}</p>
    {
      downloadHref && (
        <a class={downloadClass} href={downloadHref} target="_blank" rel="noreferrer">
          {downloadLabel}
        </a>
      )
    }
  </div>
</div>

<script is:inline define:vars={{ formId }}>
  (() => {
    const root = document.getElementById(formId);
    if (!root) return;

    const form = root.querySelector("form");
    const emailInput = root.querySelector('input[name="email"]');
    const companyInput = root.querySelector('input[name="company"]');
    const submitButton = root.querySelector('button[type="submit"]');
    const status = root.querySelector("[data-status]");
    const success = root.querySelector("[data-success]");
    const group = root.dataset.group;

    if (!form || !emailInput || !submitButton || !status || !success || !group) {
      return;
    }

    const showStatus = (message, isError = false) => {
      status.textContent = message;
      status.classList.remove("hidden");
      status.setAttribute("data-error", isError ? "true" : "false");
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const email = emailInput.value.trim();
      const company = companyInput?.value?.trim() || "";

      success.classList.add("hidden");
      status.classList.add("hidden");
      status.textContent = "";

      if (!email || !email.includes("@")) {
        showStatus("Enter a valid email address.", true);
        return;
      }

      submitButton.disabled = true;
      const originalButtonText = submitButton.textContent;
      submitButton.textContent = "Submitting...";

      try {
        const response = await fetch("/api/subscribe", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ email, group, company }),
        });

        const payload = await response.json().catch(() => ({}));

        if (!response.ok) {
          showStatus(
            typeof payload.message === "string"
              ? payload.message
              : "Unable to complete signup.",
            true,
          );
          return;
        }

        form.reset();
        success.classList.remove("hidden");
      } catch {
        showStatus("Unable to complete signup right now.", true);
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = originalButtonText;
      }
    });
  })();
</script>
