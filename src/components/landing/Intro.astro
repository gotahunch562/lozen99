---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const introSections = [
  {
    title: "Data Gap",
    description:
      "When an employee never files a claim, never flags a performance issue, and never requests an FMLA or ADA accommodation, the data point was never created. The risk is still real.",
    href: "/contact",
  },
  {
    title: "Silence as Stability",
    description:
      "Your systems are working exactly as designed: a filed claim, a flagged issue, a requested accommodation. When none of those events occur, the system reads silence as stability. That accuracy is the problem.",
    href: "/contact",
  },
  {
    title: "Unexpected Exits",
    description:
      "The benefit required her to request it. The accommodation required her to disclose. Your infrastructure was built for employees who use it. Not every employee can.",
    href: "/contact",
  },
  {
    title: "Performance Blindness",
    description:
      "AI is concentrating output in your most capable people. That group is also the least likely to file a claim, request an accommodation, or appear in a benefits report. Your best investment is running without a net, and your data does not show it.",
    href: "/contact",
  },
];
---

<section class="bg-gradient-to-t from-base-200 via-base-100 to-white">
  <Wrapper variant="standard" class="py-12 sm:py-14 lg:py-20 xl:py-24">
    <div class="mx-auto max-w-6xl">
      <div
        class="grid gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(320px,0.55fr)] lg:items-end lg:gap-8"
      >
        <div>
          <p
            class="border-l border-accent-500 pl-4 font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-base-600"
          >
            Disclosure-Dependent Data
          </p>

          <h2
            class="mt-5 max-w-4xl font-display text-[2.05rem] font-normal leading-[1.08] tracking-[-0.032em] text-base-950 sm:mt-6 sm:text-[2.45rem] lg:text-[2.9rem]"
          >
            Low benefits utilization?
          </h2>
        </div>

        <p class="max-w-md font-sans text-base leading-7 text-base-700 sm:text-[1.0625rem] sm:leading-8 lg:pb-1">
          For women executives, the cost of using them is too high.
        </p>
      </div>

      <div class="mt-8 grid gap-5 sm:mt-10 lg:grid-cols-2">
        {
          introSections.map((section) => (
            <article class="group relative overflow-hidden rounded-2xl border border-base-300 bg-white p-5 shadow-sm ring-1 ring-base-950/5 transition-all duration-300 hover:-translate-y-1 hover:border-accent-500 hover:bg-base-50 hover:shadow-md sm:p-6 lg:rounded-3xl">
              <div
                aria-hidden="true"
                class="absolute inset-x-0 top-0 h-0.5 bg-accent-500"
              >
              </div>

              <div class="mb-4 h-7 w-px bg-accent-500 sm:mb-5 sm:h-8">
              </div>

              <h3 class="font-display text-[1.25rem] font-normal leading-[1.2] tracking-[-0.015em] text-base-950 sm:text-[1.35rem]">
                {section.title}
              </h3>

              <p class="mt-4 font-sans text-base leading-8 text-base-700">
                {section.description}
              </p>

              <a
                href={section.href}
                class="mt-6 inline-flex font-sans text-sm font-semibold text-accent-700 transition-all duration-300 group-hover:translate-x-1 group-hover:text-base-950"
              >
                Contact Lozen Advisory →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
