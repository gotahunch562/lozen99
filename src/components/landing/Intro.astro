---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const introSections = [
  {
    title: "Low Utilization Is Not a Communication Failure",
    description:
      "The collection condition was never met. The women this benefit was built for never entered the system. The data was never created because the condition was never triggered.",
    href: "/contact",
  },
  {
    title: "You Are Measuring What Gets Reported",
    description:
      "When a woman never files a claim, never flags a performance issue, and never requests an accommodation, your data shows no problem. The cost does not stop because the data did.",
    href: "/contact",
  },
  {
    title: "The Exit You Did Not See Coming",
    description:
      "Senior women are navigating menopause without using a single benefit you offered. The exit that follows will not be labeled correctly in your data either.",
    href: "/contact",
  },
  {
    title: "Your Highest Performers Are Outside the Report",
    description:
      "AI is concentrating output in your most capable people. That group is also the least likely to file a claim, request an accommodation, or appear in a benefits report. Your best investment is running without a net, and your data does not show it.",
    href: "/contact",
  },
];
---

<section class="bg-gradient-to-t from-base-100 to-white">
  <Wrapper variant="standard" class="py-16 lg:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(320px,0.55fr)] lg:items-end">
        <div>
          <p class="border-l border-accent-500 pl-4 text-xs font-medium uppercase tracking-[0.18em] text-base-600">
            Disclosure-Dependent Data
          </p>

          <h2 class="mt-6 max-w-5xl font-display text-3xl font-medium uppercase leading-[1.08] tracking-tight text-base-950 sm:text-4xl lg:text-5xl">
            Low benefits utilization?
          </h2>
        </div>

        <p class="max-w-md text-base leading-7 text-base-700 sm:text-lg lg:pb-1">
          For women executives, the cost of using them is too high.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {
          introSections.map((section) => (
            <article class="group flex min-h-[20rem] flex-col justify-between rounded-3xl border border-base-300 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-accent-400 hover:bg-base-100 hover:shadow-md">
              <div>
                <div class="mb-6 h-10 w-px bg-accent-500"></div>

                <h3 class="font-display text-lg font-medium uppercase leading-snug tracking-tight text-base-950">
                  {section.title}
                </h3>

                <p class="mt-5 text-sm leading-6 text-base-700">
                  {section.description}
                </p>
              </div>

              <a
                href={section.href}
                class="mt-8 inline-flex text-sm font-semibold text-accent-700 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-base-950"
              >
                Contact Lozen Advisory →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
