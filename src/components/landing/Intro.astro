---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const introSections = [
  {
    title: "You Are Measuring What Gets Reported",
    description:
      "When a senior woman never files a claim, never flags a performance issue, and never requests an accommodation, your data shows no problem. The cost is running anyway.",
  },
  {
    title: "The Exit You Did Not See Coming",
    description:
      "Senior women leave at higher rates due to menopause symptoms than any other group — yet they are the least likely to have used a single benefit you offered. That gap is not a communications problem.",
  },
  {
    title: "You Have a Moment Coming",
    description:
      "A review. A promotion decision. A presentation that will be remembered. You know exactly what is at stake and what you will not say. The MAPS Blueprint℠ is a 90-minute private session built around that moment, your role, and your constraints.",
  },
  {
    title: "You Do Not Have to Explain It to Work on It",
    description:
      "The session does not require you to name what is happening. It requires only that you know what is coming and want to be ready for it. You leave with one clear position and exactly how to execute it.",
  },
];
---

<section class="bg-gradient-to-t from-base-100 to-white">
  <Wrapper variant="standard" class="py-16 lg:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(320px,0.55fr)] lg:items-end">
        <div>
          <p class="border-l border-accent-500 pl-4 text-xs font-medium uppercase tracking-[0.18em] text-base-600">
            Disclosure-Dependent Data
          </p>

          <h2 class="mt-6 max-w-5xl font-display text-3xl font-medium uppercase leading-[1.08] tracking-tight text-base-950 sm:text-4xl lg:text-5xl">
            Low benefits utilization?
          </h2>
        </div>

        <p class="max-w-md text-base leading-7 text-base-700 sm:text-lg lg:pb-1">
          For women executives, the cost of using them is too high.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {
          introSections.map((section) => (
            <article class="group flex min-h-[18rem] flex-col justify-end rounded-3xl border border-base-300 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-accent-400 hover:bg-base-100 hover:shadow-md">
              <div>
                <div class="mb-6 h-10 w-px bg-accent-500"></div>

                <h3 class="font-display text-lg font-medium uppercase leading-snug tracking-tight text-base-950">
                  {section.title}
                </h3>

                <p class="mt-5 text-sm leading-6 text-base-700">
                  {section.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
