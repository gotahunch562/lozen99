---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const introSections = [
  {
    title: "Data Gap",
    description:
      "When an employee never files a claim, never flags a performance issue, and never requests an FMLA or ADA accommodation, your report shows nothing. The data point is hidden, the impact to your bottom line is not.",
  },
  {
    title: "Silence as Stability",
    description:
      "Your systems are working exactly as designed: a filed claim, a flagged issue, a requested accommodation. When none of those events occur, the system reads silence as stability. That accuracy is the problem.",
  },
  {
    title: "Unexpected Exits",
    description:
      "The benefit required her to request it. The accommodation required her to disclose. Your infrastructure was built for employees who use it. Not every employee can.",
  },
  {
    title: "Performance Blindness",
    description:
      "AI is concentrating output in your most capable people. That group is also the least likely to file a claim, request an accommodation, or appear in a benefits report. Your best investment is running without a net, and your data does not show it.",
  },
];
---

<section class="bg-gradient-to-t from-base-200 via-base-100 to-white">
  <Wrapper variant="standard" class="py-12 sm:py-14 lg:py-16 xl:py-18">
    <div class="mx-auto max-w-6xl">
      <div
        class="grid gap-6 lg:grid-cols-[minmax(0,0.95fr)_minmax(320px,0.55fr)] lg:items-end lg:gap-8"
      >
        <div>
          <p
            class="font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-base-600"
          >
            Disclosure-Dependent Data
          </p>

          <h2
            class="mt-5 max-w-5xl font-display text-[2.05rem] font-normal leading-[1.05] tracking-[-0.035em] text-base-950 sm:mt-6 sm:text-[2.45rem] lg:text-[2.9rem]"
          >
            Low benefits utilization?
          </h2>
        </div>

        <p class="max-w-md font-sans text-base leading-7 text-base-700 sm:text-[1.0625rem] sm:leading-8 lg:pb-1">
          For women executives, the cost of using them is too high.
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:mt-10 sm:grid-cols-2 xl:grid-cols-4">
        {
          introSections.map((section) => (
            <article class="group relative overflow-hidden rounded-2xl border border-base-300 bg-white/95 p-5 shadow-[0_18px_45px_rgba(6,23,47,0.10)] ring-1 ring-base-950/5 transition-all duration-300 hover:-translate-y-1 hover:border-base-500 hover:bg-white hover:shadow-[0_24px_60px_rgba(6,23,47,0.14)] sm:min-h-[15rem] sm:p-6 lg:rounded-3xl xl:min-h-[16rem]">
              <div class="mb-4 h-7 w-px bg-base-400/80 sm:mb-5 sm:h-8">
              </div>

              <h3 class="font-display text-[1.2rem] font-normal leading-tight tracking-[-0.015em] text-base-950 sm:text-[1.3rem]">
                {section.title}
              </h3>

              <p class="mt-4 font-sans text-[0.925rem] leading-6 text-base-700 sm:text-[0.975rem] sm:leading-7">
                {section.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
