---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const introSections = [
  {
    title: "Data Gap",
    description:
      "When an employee never files a claim, never flags a performance issue, and never requests an FMLA or ADA accommodation, the data point was never created. The risk is still real.",
    href: "/contact",
  },
  {
    title: "Silence as Stability",
    description:
      "Your systems are working exactly as designed: a filed claim, a flagged issue, a requested accommodation. When none of those events occur, the system reads silence as stability. That accuracy is the problem.",
    href: "/contact",
  },
  {
    title: "Unexpected Exits",
    description:
      "The benefit required her to request it. The accommodation required her to disclose. Your infrastructure was built for employees who use it. Not every employee can.",
    href: "/contact",
  },
  {
    title: "Performance Blindness",
    description:
      "AI is concentrating output in your most capable people. That group is also the least likely to file a claim, request an accommodation, or appear in a benefits report. Your best investment is running without a net, and your data does not show it.",
    href: "/contact",
  },
];
---

<section class="lozen-home-section lozen-home-section--surface">
  <Wrapper variant="standard" class="py-0">
    <div class="lozen-home-container lozen-home-container--wide">
      <div class="lozen-home-header lozen-home-header--split">
        <div>
          <p class="lozen-home-eyebrow">Disclosure-Dependent Data</p>

          <h2 class="lozen-home-title">Low benefits utilization?</h2>
        </div>

        <p class="lozen-home-deck lg:pb-1">
          For women executives, the cost of using them is too high.
        </p>
      </div>

      <div class="lozen-home-grid lozen-home-grid--two">
        {
          introSections.map((section) => (
            <article class="lozen-home-card lozen-home-card--large">
              <h3 class="lozen-home-card-title">{section.title}</h3>

              <p class="lozen-home-card-body">{section.description}</p>

              <a href={section.href} class="lozen-home-card-link">
                Contact Lozen Advisory <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
