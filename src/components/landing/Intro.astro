---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const introSections = [
  {
    title: "Low Utilization Is Not a Communication Failure",
    description:
      "The collection condition was never met. The women this benefit was built for never entered the system. The data was never created because the condition was never triggered.",
    href: "/contact",
  },
  {
    title: "You Are Measuring What Gets Reported",
    description:
      "When a woman never files a claim, never flags a performance issue, and never requests an accommodation, your data shows no problem. The cost does not stop because the data did.",
    href: "/contact",
  },
  {
    title: "The Exit You Did Not See Coming",
    description:
      "Senior women are navigating menopause without using a single benefit you offered. The exit that follows will not be labeled correctly in your data either.",
    href: "/contact",
  },
  {
    title: "Your Highest Performers Are Outside the Report",
    description:
      "AI is concentrating output in your most capable people. That group is also the least likely to file a claim, request an accommodation, or appear in a benefits report. Your best investment is running without a net, and your data does not show it.",
    href: "/contact",
  },
];
---

<section class="bg-gradient-to-t from-base-200 via-base-100 to-white">
  <Wrapper variant="standard" class="py-12 sm:py-16 lg:py-24">
    <div class="mx-auto max-w-6xl">
      <div
        class="grid gap-6 lg:grid-cols-[minmax(0,0.95fr)_minmax(320px,0.55fr)] lg:items-end lg:gap-8"
      >
        <div>
          <p
            class="border-l border-accent-500 pl-4 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-base-600"
          >
            Disclosure-Dependent Data
          </p>

          <h2
            class="mt-5 max-w-5xl font-display text-3xl font-normal uppercase leading-[1.05] tracking-[-0.035em] text-base-950 sm:mt-6 sm:text-4xl lg:text-5xl"
          >
            Low benefits utilization?
          </h2>
        </div>

        <p class="max-w-md font-sans text-base leading-7 text-base-700 sm:text-lg lg:pb-1">
          For women executives, the cost of using them is too high.
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:mt-12 sm:grid-cols-2 xl:grid-cols-4">
        {
          introSections.map((section) => (
            <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-base-400 bg-white p-5 shadow-lg ring-1 ring-base-950/5 transition-all duration-300 hover:-translate-y-1 hover:border-accent-500 hover:bg-base-50 hover:shadow-xl sm:min-h-[18rem] sm:p-6 lg:rounded-3xl xl:min-h-[20rem]">
              <div
                aria-hidden="true"
                class="absolute inset-x-0 top-0 h-1 bg-accent-500"
              >
              </div>

              <div>
                <div class="mb-5 h-8 w-px bg-accent-500 sm:mb-6 sm:h-10">
                </div>

                <h3 class="font-display text-[1.35rem] font-normal uppercase leading-snug tracking-[-0.01em] text-base-950 sm:text-lg">
                  {section.title}
                </h3>

                <p class="mt-4 font-sans text-sm leading-6 text-base-700 sm:mt-5">
                  {section.description}
                </p>
              </div>

              <a
                href={section.href}
                class="mt-7 inline-flex font-sans text-sm font-semibold text-accent-700 transition-all duration-300 group-hover:translate-x-1 group-hover:text-base-950 sm:mt-8"
              >
                Contact Lozen Advisory →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
