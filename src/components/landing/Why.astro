---
// Foundations
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const trackerRows = [
  {
    jurisdiction: "Virginia",
    instrument: "SB258 / HB1173",
    classification: "Dashboard Delay",
  },
  {
    jurisdiction: "Rhode Island",
    instrument: "S0361",
    classification: "Tacere",
  },
  {
    jurisdiction: "Illinois",
    instrument: "HB5284",
    classification: "Tacere",
  },
];
---

<section class="bg-gradient-to-b from-base-950 to-base-900 text-white">
  <Wrapper variant="standard" class="py-16 lg:py-24">
    <div class="overflow-hidden rounded-3xl border border-white/10 bg-white/[0.04] shadow-2xl ring-1 ring-white/10">
      <div class="grid gap-0 lg:grid-cols-[minmax(0,0.86fr)_minmax(340px,0.64fr)]">
        <div class="p-8 sm:p-10 lg:p-14">
          <p class="border-l border-accent-500 pl-4 text-xs font-medium uppercase tracking-[0.18em] text-base-300">
            Policy & Governance Tool
          </p>

          <h2 class="mt-8 max-w-4xl font-display text-3xl font-medium uppercase leading-[1.08] tracking-tight text-white sm:text-4xl lg:text-5xl">
            Menopause legislation is increasing.
          </h2>

          <p class="mt-6 max-w-3xl text-base leading-8 text-base-200 sm:text-lg">
            The Menopause Legislation Tracker classifies state and federal policy instruments by the assumptions they require, the systems they activate, and the women they cannot reach.
          </p>

          <p class="mt-5 max-w-3xl text-base leading-8 text-base-200 sm:text-lg">
            This is not a bill list. It is a governance audit of disclosure-dependent policy design.
          </p>

          <div class="mt-8">
            <Button
              isLink
              href="/menopause-legislation-tracker"
              variant="accent"
              size="xs"
            >
              View the Legislation Tracker
            </Button>
          </div>
        </div>

        <aside class="border-t border-white/10 bg-base-50 p-6 text-base-950 sm:p-8 lg:border-l lg:border-t-0 lg:p-10">
          <div class="rounded-3xl border-2 border-base-500 bg-white shadow-lg ring-1 ring-base-950/10">
            <div class="border-b border-base-400 bg-base-950 px-5 py-4">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white">
                Legislative Record
              </p>
            </div>

            <div class="grid grid-cols-3 border-b border-base-400 bg-base-100 px-5 py-3 text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-base-800">
              <span>Jurisdiction</span>
              <span>Instrument</span>
              <span>Classification</span>
            </div>

            <div>
              {
                trackerRows.map((row) => (
                  <div class="grid grid-cols-3 gap-3 border-b border-base-300 px-5 py-4 text-sm last:border-b-0 odd:bg-white even:bg-base-100">
                    <span class="font-semibold text-base-950">
                      {row.jurisdiction}
                    </span>

                    <span class="text-base-700">
                      {row.instrument}
                    </span>

                    <span class="inline-flex w-fit rounded-full border border-accent-500 bg-accent-50 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.08em] text-base-950">
                      {row.classification}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="mt-5 rounded-3xl border border-base-300 bg-base-100 p-5">
            <p class="text-xs font-medium uppercase tracking-[0.16em] text-base-600">
              What the tracker measures
            </p>

            <p class="mt-4 text-sm leading-6 text-base-800">
              Policy assumption, governance blind spot, activation condition, legislative outcome, and Lozen classification.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </Wrapper>
</section>
