---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const features = [
  {
    title: "The Convergence",
    description:
      "Women at the top of their field do not leave their careers to chance. They build strategy around what matters. That standard does not change because the environment does not acknowledge everything they are navigating. It extends to include it. When disclosure isn't an option, preparation is protection.",
    icon: "convergence",
  },
  {
    title: "The Gap",
    description:
      "Most support structures address only one dimension. Medicine treats the symptom. Coaching targets the goal. Therapy processes the emotion. Organizational resources, where they exist, typically require formal disclosure to access. In environments where perception carries consequence, disclosure is not always neutral.",
    icon: "gap",
  },
  {
    title: "The Premise",
    description:
      "Lozen Advisory was built around a different premise. Disclosure-Independent Performance Protection℠ protects leadership capacity and professional continuity without requiring a woman to formally disclose that she is navigating health conditions or other personal challenges.",
    icon: "premise",
  },
  {
    title: "The Name",
    description:
      "Lozen was an Apache warrior and strategist known for two things: protecting her people, and sensing what was coming before it arrived. That legacy is the practice. The work we do together is called The Tender Path℠.",
    icon: "name",
  },
];
---

<section class="bg-gradient-to-t from-base-200 to-white">
  <Wrapper variant="standard" class="py-24">
<div class="items-start grid grid-cols-1 lg:grid-cols-[420px_1fr] gap-8">
      <div>
        <Text
          tag="span"
          variant="textSM"
          class="pl-4 font-medium uppercase border-l text-base-900 font-display border-accent-500"
        >
          Disclosure-Independent Performance Protection℠
        </Text>

        <Text
          tag="h2"
          variant="displayMD"
          class="mt-8 uppercase font-display text-base-900"
        >
          Why Lozen <br /> Advisory
        </Text>

        <Text
          tag="p"
          variant="textBase"
          class="mt-4 text-base-600 text-balance"
        >
          The women who sustain leadership through perimenopause and menopause do not do it by accident. They do it because they treated it the same way they treated every other professional challenge: with clarity, with a plan, and with the right resource in their corner.
        </Text>
      </div>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4 lg:col-span-2"> 
        {
          features.map((feature) => (
            <div class="flex flex-col p-6 shadow-2xl pt-42 bg-base-50 rounded-3xl outline-4 outline-base-500/10">
              <Text
                tag="h3"
                variant="textBase"
                class="pl-4 font-medium uppercase border-l-2 font-display text-base-900 border-accent-500"
              >
                {feature.title}
              </Text>

              <Text
                tag="p"
                variant="textSM"
                class="mt-4 text-base-600 text-balance"
              >
                {feature.description}
              </Text>
            </div>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
