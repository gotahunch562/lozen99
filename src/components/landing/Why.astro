---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const features = [
  {
    title: "Your benefits data shows low utilization.",
    description:
      "That is not the finding. It is the failure of the collection condition. The system was never entered, so the data required to measure need, risk, and cost was never created.",
    icon: "collection-condition",
  },
  {
    title: "You expanded benefits. Confidence still dropped.",
    description:
      "The gap between what you offer and what gets used is not a communications problem. It is a measurement problem with a cost your current reporting cannot isolate.",
    icon: "measurement-gap",
  },
  {
    title: "Market intelligence. Executive briefings. Ongoing advisory.",
    description:
      "Lozen Advisory works with leadership teams evaluating menopause benefits strategy, utilization gaps, and disclosure-dependent measurement risk.",
    icon: "advisory",
  },
  {
    title: "Your benefits architecture depends on a collection condition it cannot consistently produce.",
    description:
      "The cost appears elsewhere: attrition data, succession gaps, performance strain, and leadership-capacity loss. None of those records are labeled correctly.",
    icon: "architecture",
  },
];
---

<section class="bg-gradient-to-t from-base-200 to-white">
  <Wrapper variant="standard" class="py-24">
    <div class="items-start grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div>
        <Text
          tag="span"
          variant="textSM"
          class="pl-4 font-medium uppercase border-l text-base-900 font-display border-accent-500"
        >
          How We Can Help
        </Text>

        <Text
          tag="h2"
          variant="displayMD"
          class="mt-8 uppercase font-display text-base-900"
        >
          Why Lozen <br /> Advisory
        </Text>

        <Text
          tag="p"
          variant="textBase"
          class="mt-4 text-base-600 text-balance"
        >
          Lozen Advisory brings research, data analysis, and risk expertise to one of the most undercounted problems in workforce strategy. Menopause at work is generating costs that standard benefits reporting was not designed to capture. We know where to look and what it means for your organization.
        </Text>
      </div>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4 lg:col-span-2">
        {
          features.map((feature) => (
            <div class="flex flex-col p-6 shadow-2xl pt-42 bg-base-50 rounded-3xl outline-4 outline-base-500/10">
              <Text
                tag="h3"
                variant="textBase"
                class="pl-4 font-medium uppercase border-l-2 font-display text-base-900 border-accent-500"
              >
                {feature.title}
              </Text>

              <Text
                tag="p"
                variant="textXS"
                class="mt-4 text-base-600 text-balance"
              >
                {feature.description}
              </Text>

              <a
                href="/contact"
                class="mt-6 inline-flex text-sm font-medium text-accent-600 transition-colors hover:text-base-900"
              >
                Contact Lozen Advisory →
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
