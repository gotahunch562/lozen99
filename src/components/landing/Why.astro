---
// Foundations
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const trackerRows = [
  {
    jurisdiction: "Virginia",
    instrument: "SB258 / HB1173",
    classification: "Dashboard Delay",
  },
  {
    jurisdiction: "Rhode Island",
    instrument: "S0361",
    classification: "Tacere",
  },
  {
    jurisdiction: "Illinois",
    instrument: "HB5284",
    classification: "Tacere",
  },
];
---

<section class="lozen-home-section lozen-home-section--navy">
  <Wrapper variant="standard" class="py-0">
    <div class="lozen-home-container lozen-home-container--wide">
      <div class="lozen-home-feature-panel lozen-home-feature-panel--navy">
        <div
          class="grid gap-0 lg:grid-cols-[minmax(0,1fr)_minmax(340px,0.58fr)]"
        >
          <div class="p-6 sm:p-10 lg:p-14">
            <p class="lozen-home-eyebrow">Policy & Governance Tool</p>

            <h2 class="lozen-home-title mt-5 text-white sm:mt-6">
              Menopause legislation is accelerating.
            </h2>

            <div class="mt-5 max-w-3xl space-y-4 sm:mt-6">
              <p class="lozen-home-deck text-base-100">
                The Menopause Legislation Tracker classifies each instrument by three things: the assumption it makes about how women will engage with formal systems, the activation condition that determines who the law reaches, and the population that condition structurally excludes.
              </p>

              <p class="lozen-home-deck text-base-100">
                Every framework in this tracker activates at the point of disclosure. This is a governance audit of disclosure-dependent policy design.
              </p>
            </div>

            <div class="mt-7 sm:mt-8">
              <Button
                isLink
                href="/menopause-legislation-tracker"
                variant="accent"
                size="xs"
              >
                View the Legislation Tracker
              </Button>
            </div>
          </div>

          <aside
            class="border-t border-white/10 bg-base-50 p-5 text-base-950 sm:p-8 lg:border-l lg:border-t-0 lg:p-10"
          >
            <div
              class="overflow-hidden rounded-2xl border-2 border-base-500 bg-white shadow-lg ring-1 ring-base-950/10 lg:rounded-3xl"
            >
              <div class="border-b border-base-400 bg-base-950 px-5 py-4">
                <p class="lozen-home-card-meta text-white">
                  Legislative Record
                </p>
              </div>

              <div
                class="hidden grid-cols-3 border-b border-base-400 bg-base-100 px-5 py-3 font-sans text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-base-800 sm:grid"
              >
                <span>Jurisdiction</span>
                <span>Instrument</span>
                <span>Classification</span>
              </div>

              <div>
                {
                  trackerRows.map((row) => (
                    <div class="grid gap-3 border-b border-base-300 px-5 py-4 font-sans text-sm last:border-b-0 odd:bg-white even:bg-base-100 sm:grid-cols-3 sm:items-center">
                      <div>
                        <span class="block text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-base-500 sm:hidden">
                          Jurisdiction
                        </span>
                        <span class="mt-1 block font-semibold text-base-950 sm:mt-0">
                          {row.jurisdiction}
                        </span>
                      </div>

                      <div>
                        <span class="block text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-base-500 sm:hidden">
                          Instrument
                        </span>
                        <span class="mt-1 block text-base-700 sm:mt-0">
                          {row.instrument}
                        </span>
                      </div>

                      <div>
                        <span class="block text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-base-500 sm:hidden">
                          Classification
                        </span>
                        <span class="mt-2 inline-flex w-fit rounded-full border border-accent-500 bg-accent-50 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.08em] text-base-950 sm:mt-0">
                          {row.classification}
                        </span>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="mt-4 rounded-2xl border border-base-300 bg-base-100 p-5 lg:mt-5 lg:rounded-3xl">
              <p class="lozen-home-card-meta text-base-600">
                What the tracker measures
              </p>

              <p class="lozen-home-card-body mt-3 text-sm leading-6 text-base-800">
                Policy assumption, governance blind spot, activation condition, legislative outcome, and Lozen classification.
              </p>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </Wrapper>
</section>
