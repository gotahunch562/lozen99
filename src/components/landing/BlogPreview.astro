---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import BlogCard from "@/components/blog/BlogCard.astro";
// Content
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");

allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});
---

<section class="bg-gradient-to-t from-base-200 via-base-100 to-white">
  <Wrapper variant="standard" class="py-12 sm:py-16 lg:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <Text
        tag="span"
        variant="textSM"
        class="inline-flex border-l border-accent-500 pl-4 font-sans font-semibold uppercase tracking-[0.18em] text-base-600"
      >
        insights
      </Text>

      <Text
        tag="h2"
        variant="displayXL"
        class="mt-5 font-display font-normal uppercase leading-[1.05] tracking-[-0.035em] text-base-950 sm:mt-6"
      >
        Menopause at Work
      </Text>

      <Text
        tag="p"
        variant="textBase"
        class="mx-auto mt-4 max-w-2xl font-sans leading-7 text-base-700 text-balance sm:text-lg sm:leading-8"
      >
        Legislative analysis, Clinical reality, Workplace systems, & Self.
        <br />
        <span class="italic">
          What do we write about? What matters to her.
        </span>
      </Text>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 sm:mt-12 md:grid-cols-2">
      {allPosts.slice(0, 2).map((post) => <BlogCard post={post} />)}
    </div>

    <Button
      isLink
      href="/blog"
      variant="default"
      size="base"
      class="mx-auto mt-10 w-fit sm:mt-12"
    >
      View all articles
    </Button>
  </Wrapper>
</section>
