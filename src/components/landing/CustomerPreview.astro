---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const proofCards = [
  {
    title: "Analytical Foundation",
    description:
      "Lozen Advisory is built on decades of solving expensive data problems for major institutions across finance, healthcare, cybersecurity, and media.",
  },
  {
    title: "Disclosure-Dependent Systems",
    description:
      "The work identifies where benefits data, HR records, utilization reports, and retention metrics depend on an initiating act before risk can be seen.",
  },
  {
    title: "Policy & Workforce Risk",
    description:
      "The legislation tracker, executive reports, and Invisible Attrition℠ framework connect policy design to measurable leadership continuity risk.",
  },
];
---

<section class="bg-white">
  <Wrapper variant="standard" class="py-12 sm:py-14 lg:py-20 xl:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-5xl">
        <p
          class="border-l border-accent-500 pl-4 font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-base-600"
        >
          Advisory Foundation
        </p>

        <h2
          class="mt-5 max-w-4xl font-display text-[2.05rem] font-normal leading-[1.08] tracking-[-0.032em] text-base-950 sm:mt-6 sm:text-[2.45rem] lg:text-[2.9rem]"
        >
          Where Strategy Meets the Limits of Your Data
        </h2>

        <p class="mt-5 max-w-4xl font-sans text-base leading-8 text-base-700 sm:text-[1.0625rem] lg:mt-6">
          Most organizations have governance frameworks, benefits infrastructure, and retention metrics in place. The question Lozen Advisory addresses is whether those systems remain attached to organizational reality — or whether they are measuring the activity that gets reported while missing the risk that does not.
        </p>
      </div>

      <div class="mt-8 grid gap-5 sm:mt-10 md:grid-cols-3">
        {
          proofCards.map((card) => (
            <article class="group relative overflow-hidden rounded-2xl border border-base-300 bg-white p-5 shadow-sm ring-1 ring-base-950/5 transition-all duration-300 hover:-translate-y-1 hover:border-accent-500 hover:bg-base-50 hover:shadow-md sm:p-6 lg:rounded-3xl">
              <div
                aria-hidden="true"
                class="absolute inset-x-0 top-0 h-0.5 bg-accent-500"
              >
              </div>

              <div class="mb-4 h-7 w-px bg-accent-500 sm:mb-5 sm:h-8"></div>

              <h3 class="font-display text-[1.22rem] font-normal leading-[1.2] tracking-[-0.014em] text-base-950 sm:text-[1.32rem]">
                {card.title}
              </h3>

              <p class="mt-4 font-sans text-[0.975rem] leading-7 text-base-700">
                {card.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
