---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const proofCards = [
  {
    title: "Sovereignty — The Goal",
    description:
      "Preserve the institutional judgment, specialized memory, and executive execution capacity that no software can replicate.",
  },
  {
    title: "Substitution",
    description:
      "The capital allocation blind spot where boards fund technology as direct replacement capacity — the Capacity Substitution Error℠.",
  },
  {
    title: "Silence",
    description:
      "Structural non-disclosure mechanisms that keep key talent attrition entirely invisible until the institutional loss becomes a liability.",
  },
  {
    title: "Supervision",
    description:
      "The perilous governance gap where AI systems scale faster than the human accountability layer required to protect them — the",
    linkText: "Power User Trap℠",
    href: "https://www.lozenadvisory.com/invisible-attrition/power-user-trap/",
  },
];
---

<section class="bg-white">
  <Wrapper variant="standard" class="py-10 sm:py-12 lg:py-16">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-5xl">
        <p
          class="border-l border-accent-500 pl-4 font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-base-600"
        >
          Advisory Foundation
        </p>

        <h2
          class="mt-5 max-w-4xl font-display text-[2.2rem] font-normal leading-[1.06] tracking-[-0.035em] text-base-950 sm:mt-6 sm:text-[2.65rem] lg:text-[3rem]"
        >
          <a
            href="/sovereign-capacity-model/"
            class="text-inherit no-underline transition-colors hover:text-accent-700 focus-visible:text-accent-700"
          >
            The Sovereign Capacity Model℠
          </a>
        </h2>

        <p class="mt-6 max-w-4xl font-sans text-base leading-8 text-base-700 sm:text-[1.0625rem] sm:leading-8 lg:mt-7">
          Boards are approving AI investment as a productivity solution while the capacity baseline that investment depends on is quietly collapsing. Lozen Advisory's menopause-at-work analysis is not a benefits argument. It is the visible entry point into a larger capacity-risk problem: senior human judgment can be lost, hidden, substituted, and overloaded while boards fund technology as if the human baseline is stable.
        </p>

        <p class="mt-5 max-w-4xl font-sans text-base leading-8 text-base-700 sm:text-[1.0625rem] sm:leading-8">
          The Sovereign Capacity Model℠ is Lozen Advisory's diagnostic architecture for evaluating where corporate strategy depends on human capacity the organization has not measured, priced, protected, or governed. It organizes one strategic goal, Sovereignty, against three diagnostic pressure points: Substitution, Silence, and Supervision. The model helps organizations treat non-disclosure as a design condition, not an individual communication failure, before hidden capacity costs become unrecoverable.
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:mt-10 sm:grid-cols-2 xl:grid-cols-4">
        {
          proofCards.map((card) => (
            <article class="group relative overflow-hidden rounded-2xl border border-base-300 bg-white p-5 shadow-sm ring-1 ring-base-950/5 transition-all duration-300 hover:-translate-y-1 hover:border-accent-500 hover:bg-base-50 hover:shadow-md sm:p-6 lg:rounded-3xl">
              <div
                aria-hidden="true"
                class="absolute inset-x-0 top-0 h-1 bg-accent-500"
              >
              </div>

              <div class="mb-5 h-9 w-px bg-accent-500 sm:mb-6 sm:h-10"></div>

              <h3 class="max-w-sm font-display text-[1.45rem] font-normal leading-[1.14] tracking-[-0.02em] text-base-950 sm:text-[1.55rem]">
                {card.title}
              </h3>

              <p class="mt-4 font-sans text-[0.975rem] leading-8 text-base-700 sm:mt-5">
                {card.description}
                {card.href && card.linkText && (
                  <>
                    {" "}
                    <a
                      href={card.href}
                      class="font-semibold text-base-950 underline decoration-accent-500 decoration-1 underline-offset-4 transition-colors hover:text-accent-700"
                    >
                      {card.linkText}
                    </a>
                    .
                  </>
                )}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
