---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="relative overflow-hidden bg-base-950">
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[url('/images/herobg.webp')] bg-cover bg-center"
  >
  </div>

  <div
    aria-hidden="true"
    class="absolute inset-0 bg-base-950/82"
  >
  </div>

  <div
    aria-hidden="true"
    class="absolute inset-0 bg-gradient-to-b from-base-950/70 via-base-950/40 to-base-950/85"
  >
  </div>

  <Wrapper
    variant="standard"
    class="relative z-10 flex min-h-[34rem] items-center py-24 sm:min-h-[38rem] lg:min-h-[42rem] lg:py-28"
  >
    <div class="mx-auto max-w-5xl text-center">
      <h1 class="mx-auto max-w-5xl font-sans text-[2rem] font-normal leading-[1.18] tracking-[-0.035em] text-white sm:text-[2.75rem] lg:text-[3.55rem]">
        Working at the edge of what organizations can measure and what leaders are managing.
      </h1>

      <p class="mx-auto mt-8 max-w-4xl font-sans text-base font-normal leading-8 text-base-100 sm:text-lg lg:text-[1.25rem] lg:leading-9">
        Lozen Advisory helps organizations and senior women leaders navigate the gap between visible performance records and the private constraints that shape retention, succession, benefits utilization, and leadership continuity.
      </p>
    </div>
  </Wrapper>
</section>
