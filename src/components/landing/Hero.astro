---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="relative w-full overflow-hidden bg-base-950 lg:h-dvh">
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[url('/images/herobg.webp')] bg-cover bg-center"
  >
  </div>

  <Wrapper
    variant="standard"
    class="relative z-10 flex min-h-[44rem] items-center py-28 lg:h-full lg:min-h-0 lg:py-0"
  >
    <div class="mx-auto max-w-6xl">
      <h1 class="mx-auto max-w-5xl text-justify font-display text-[2rem] font-normal leading-[1.16] tracking-[-0.025em] text-white [text-align-last:left] [text-shadow:0_2px_18px_rgba(0,31,43,0.95)] sm:text-[2.3rem] lg:text-[2.625rem]">
        Working at the edge of what organizations can measure and what leaders are managing.
      </h1>

      <p class="mx-auto mt-8 max-w-5xl text-justify font-display text-[1.05rem] font-normal leading-8 tracking-[-0.01em] text-white [text-align-last:left] [text-shadow:0_2px_14px_rgba(0,31,43,0.95)] sm:text-[1.15rem] lg:text-[1.25rem] lg:leading-9">
        Lozen Advisory helps organizations and senior women leaders navigate the gap between visible performance records and the private constraints that shape retention, succession, benefits utilization, and leadership continuity.
      </p>
    </div>
  </Wrapper>
</section>
