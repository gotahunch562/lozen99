---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<style is:global>
  .lozen-hero {
    background-color: #06172f;
  }

  .lozen-hero__image {
    background-image: url("/images/herobg.webp");
    background-size: cover;
    background-position: center;
    opacity: 0.9;
    filter: saturate(0.95) contrast(1.05);
  }

  .lozen-hero__navy-veil {
    background: radial-gradient(
      ellipse at 55% 43%,
      rgba(6, 23, 47, 0.18) 0%,
      rgba(6, 23, 47, 0.3) 18%,
      rgba(6, 23, 47, 0.62) 42%,
      rgba(6, 23, 47, 0.92) 100%
    );
  }

  .lozen-hero__depth {
    background:
      linear-gradient(
        to bottom,
        rgba(2, 10, 22, 0.76) 0%,
        rgba(6, 23, 47, 0.28) 34%,
        rgba(6, 23, 47, 0.46) 62%,
        rgba(2, 10, 22, 0.94) 100%
      ),
      linear-gradient(
        to right,
        rgba(2, 10, 22, 0.84) 0%,
        rgba(6, 23, 47, 0.5) 31%,
        rgba(6, 23, 47, 0.24) 53%,
        rgba(6, 23, 47, 0.58) 76%,
        rgba(2, 10, 22, 0.88) 100%
      );
  }
</style>

<section class="lozen-hero relative w-full overflow-hidden lg:h-dvh lg:p-8">
  <div class="absolute inset-0 isolate overflow-hidden lg:m-4 lg:rounded-3xl">
    <div aria-hidden="true" class="lozen-hero__image absolute inset-0 z-0"></div>

    <div
      aria-hidden="true"
      class="lozen-hero__navy-veil pointer-events-none absolute inset-0 z-10"
    >
    </div>

    <div
      aria-hidden="true"
      class="lozen-hero__depth pointer-events-none absolute inset-0 z-20"
    >
    </div>
  </div>

  <Wrapper
    variant="paddingLess"
    class="relative z-30 flex min-h-[36rem] items-center py-24 sm:min-h-[40rem] sm:py-28 lg:h-full lg:min-h-0 lg:py-0"
  >
    <div
      class="w-full max-w-[96rem] -translate-y-4 px-6 text-left sm:px-10 lg:-translate-y-10 lg:px-16 xl:px-20 2xl:px-24"
    >
      <h1
        class="max-w-[92rem] font-display text-[2.85rem] font-normal leading-[0.98] tracking-[-0.055em] text-white [text-shadow:0_2px_18px_rgba(2,10,22,0.95)] sm:text-[3.65rem] md:text-[4.25rem] lg:text-[4.65rem] xl:text-[5rem] 2xl:text-[5.35rem]"
      >
        If your data depends on disclosure, your dashboard is incomplete by design.
      </h1>

      <p
        class="mt-9 max-w-[82rem] font-sans text-[1.05rem] font-normal leading-8 tracking-[-0.01em] text-white/92 text-pretty [text-shadow:0_1px_8px_rgba(2,10,22,0.85)] sm:mt-10 sm:text-[1.12rem] sm:leading-8 lg:text-[1.2rem] lg:leading-9"
      >
        Lozen Advisory helps women leaders protect their performance and career trajectory, and helps organizations understand the disclosure-dependence gap in their data, that impacts retention, succession, benefits utilization and leadership continuity.
      </p>
    </div>
  </Wrapper>
</section>
