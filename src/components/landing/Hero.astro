---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<style is:global>
  .lozen-hero {
    background-color: #06172f;
  }

  .lozen-hero__image {
    background-image: url("/images/herobg.webp");
    background-size: cover;
    background-position: center;
    opacity: 0.9;
    filter: saturate(0.95) contrast(1.05);
  }

  .lozen-hero__navy-veil {
    background:
      radial-gradient(
        ellipse at 58% 42%,
        rgba(6, 23, 47, 0.08) 0%,
        rgba(6, 23, 47, 0.28) 24%,
        rgba(6, 23, 47, 0.68) 54%,
        rgba(6, 23, 47, 0.96) 100%
      );
  }

  .lozen-hero__depth {
    background:
      linear-gradient(
        to bottom,
        rgba(2, 10, 22, 0.82) 0%,
        rgba(6, 23, 47, 0.26) 31%,
        rgba(6, 23, 47, 0.48) 64%,
        rgba(2, 10, 22, 0.96) 100%
      ),
      linear-gradient(
        to right,
        rgba(2, 10, 22, 0.92) 0%,
        rgba(6, 23, 47, 0.64) 28%,
        rgba(6, 23, 47, 0.3) 58%,
        rgba(6, 23, 47, 0.62) 78%,
        rgba(2, 10, 22, 0.9) 100%
      );
  }
</style>

<section class="lozen-hero relative w-full overflow-hidden lg:h-dvh lg:p-8">
  <div class="absolute inset-0 isolate overflow-hidden lg:m-4 lg:rounded-3xl">
    <div aria-hidden="true" class="lozen-hero__image absolute inset-0 z-0">
    </div>

    <div
      aria-hidden="true"
      class="lozen-hero__navy-veil pointer-events-none absolute inset-0 z-10"
    >
    </div>

    <div
      aria-hidden="true"
      class="lozen-hero__depth pointer-events-none absolute inset-0 z-20"
    >
    </div>
  </div>

  <Wrapper
    variant="standard"
    class="relative z-30 flex min-h-[38rem] items-center justify-center py-24 sm:min-h-[42rem] sm:py-28 lg:h-full lg:min-h-0 lg:items-center lg:py-0"
  >
    <div
      class="mx-auto w-full max-w-[88rem] text-center sm:-translate-y-2 lg:-translate-y-8"
    >
      <h1
        class="mx-auto max-w-[86rem] text-center font-display text-[2.75rem] font-normal leading-[1.08] tracking-[-0.035em] text-white [text-shadow:0_2px_18px_rgba(2,10,22,0.95)] sm:text-[3.4rem] md:text-[3.95rem] lg:text-[4.35rem] xl:text-[4.7rem] 2xl:text-[5rem]"
      >
        If your data depends on disclosure, your dashboard is incomplete by design.
      </h1>

      <p
        class="mx-auto mt-8 max-w-[76rem] text-center font-sans text-base font-normal leading-7 tracking-[-0.01em] text-white/92 text-pretty [text-shadow:0_1px_8px_rgba(2,10,22,0.85)] sm:text-[1.0625rem] sm:leading-8 lg:mt-9 lg:text-[1.1875rem] lg:leading-9"
      >
        Lozen Advisory helps women leaders protect their performance and career trajectory, and helps organizations understand the disclosure-dependence gap in their data, that impacts retention, succession, benefits utilization and leadership continuity.
      </p>
    </div>
  </Wrapper>
</section>
