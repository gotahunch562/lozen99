---
// Foundations
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="relative overflow-hidden bg-gradient-to-b from-base-50 via-base-100 to-white">
  <Wrapper variant="standard" class="py-24 lg:py-36">
    <div class="mx-auto max-w-7xl text-center">
      <p class="mx-auto inline-flex border-l border-accent-500 pl-4 text-xs font-medium uppercase tracking-[0.18em] text-base-700">
        Disclosure-Independent Performance Protection℠
      </p>

      <h1 class="mx-auto mt-10 max-w-6xl font-display text-[2.65rem] font-medium leading-[1.12] tracking-tight text-base-950 sm:text-5xl lg:text-[4.85rem]">
        Working at the edge of what organizations can measure and what leaders are managing.
      </h1>

      <p class="mx-auto mt-8 max-w-4xl text-lg leading-8 text-base-700 sm:text-xl lg:text-[1.45rem] lg:leading-10">
        Lozen Advisory helps organizations and senior women leaders navigate the gap between visible performance records and the private constraints that shape retention, succession, benefits utilization, and leadership continuity.
      </p>

      <div class="mt-10 flex justify-center">
        <Button
          isLink
          href="/request-briefing"
          variant="accent"
          size="xs"
        >
          Request Briefing
        </Button>
      </div>
    </div>
  </Wrapper>
</section>
