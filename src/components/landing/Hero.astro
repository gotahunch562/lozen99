---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<style is:global>
  .lozen-hero {
    background-color: #06172f;
  }

  .lozen-hero__image {
    background-image: url("/images/herobg.webp");
    background-size: cover;
    background-position: center;
    opacity: 0.9;
    filter: saturate(0.95) contrast(1.05);
  }

  .lozen-hero__navy-veil {
    background:
      radial-gradient(
        ellipse at 60% 40%,
        rgba(6, 23, 47, 0.1) 0%,
        rgba(6, 23, 47, 0.28) 22%,
        rgba(6, 23, 47, 0.68) 52%,
        rgba(6, 23, 47, 0.96) 100%
      );
  }

  .lozen-hero__depth {
    background:
      linear-gradient(
        to bottom,
        rgba(2, 10, 22, 0.8) 0%,
        rgba(6, 23, 47, 0.24) 31%,
        rgba(6, 23, 47, 0.5) 64%,
        rgba(2, 10, 22, 0.96) 100%
      ),
      linear-gradient(
        to right,
        rgba(2, 10, 22, 0.92) 0%,
        rgba(6, 23, 47, 0.68) 30%,
        rgba(6, 23, 47, 0.3) 58%,
        rgba(6, 23, 47, 0.62) 78%,
        rgba(2, 10, 22, 0.9) 100%
      );
  }
</style>

<section class="lozen-hero relative w-full overflow-hidden lg:h-dvh lg:p-8">
  <div class="absolute inset-0 isolate overflow-hidden lg:m-4 lg:rounded-3xl">
    <div aria-hidden="true" class="lozen-hero__image absolute inset-0 z-0">
    </div>

    <div
      aria-hidden="true"
      class="lozen-hero__navy-veil pointer-events-none absolute inset-0 z-10"
    >
    </div>

    <div
      aria-hidden="true"
      class="lozen-hero__depth pointer-events-none absolute inset-0 z-20"
    >
    </div>
  </div>

  <Wrapper
    variant="standard"
    class="relative z-30 flex min-h-[38rem] items-center py-24 sm:min-h-[42rem] sm:py-28 lg:h-full lg:min-h-0 lg:items-center lg:py-0"
  >
    <div
      class="w-full max-w-[88rem] -translate-y-2 text-left sm:-translate-y-4 lg:-translate-y-8"
    >
      <h1
        class="max-w-[78rem] text-left font-display text-[3rem] font-normal leading-[0.95] tracking-[-0.055em] text-white [text-shadow:0_2px_18px_rgba(2,10,22,0.95)] sm:text-[4rem] md:text-[4.75rem] lg:text-[5.75rem] xl:text-[6.65rem] 2xl:text-[7.25rem]"
      >
        If your data depends on disclosure, your dashboard is incomplete by design.
      </h1>

      <p
        class="mt-7 max-w-[55rem] text-left font-sans text-base font-normal leading-7 tracking-[-0.01em] text-white/92 text-pretty [text-shadow:0_1px_8px_rgba(2,10,22,0.85)] sm:mt-8 sm:text-[1.0625rem] sm:leading-8 lg:mt-9 lg:text-[1.125rem] lg:leading-8"
      >
        Lozen Advisory helps women leaders protect their performance and career trajectory, and helps organizations understand the disclosure-dependence gap in their data, that impacts retention, succession, benefits utilization and leadership continuity.
      </p>
    </div>
  </Wrapper>
</section>
