---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<style is:global>
  .lozen-hero {
    background-color: #06172f;
  }

  .lozen-hero__image {
    background-image: url("/images/herobg.webp");
    background-size: cover;
    background-position: center;
    opacity: 0.9;
    filter: saturate(0.95) contrast(1.05);
  }

  .lozen-hero__navy-veil {
    background:
      radial-gradient(
        ellipse at 55% 43%,
        rgba(6, 23, 47, 0.18) 0%,
        rgba(6, 23, 47, 0.3) 18%,
        rgba(6, 23, 47, 0.62) 42%,
        rgba(6, 23, 47, 0.92) 100%
      );
  }

  .lozen-hero__depth {
    background:
      linear-gradient(
        to bottom,
        rgba(2, 10, 22, 0.76) 0%,
        rgba(6, 23, 47, 0.28) 34%,
        rgba(6, 23, 47, 0.46) 62%,
        rgba(2, 10, 22, 0.94) 100%
      ),
      linear-gradient(
        to right,
        rgba(2, 10, 22, 0.84) 0%,
        rgba(6, 23, 47, 0.5) 31%,
        rgba(6, 23, 47, 0.24) 53%,
        rgba(6, 23, 47, 0.58) 76%,
        rgba(2, 10, 22, 0.88) 100%
      );
  }
</style>

<section class="lozen-hero relative w-full overflow-hidden lg:h-dvh lg:p-8">
  <div class="absolute inset-0 isolate overflow-hidden lg:m-4 lg:rounded-3xl">
    <div aria-hidden="true" class="lozen-hero__image absolute inset-0 z-0">
    </div>

    <div
      aria-hidden="true"
      class="lozen-hero__navy-veil pointer-events-none absolute inset-0 z-10"
    >
    </div>

    <div
      aria-hidden="true"
      class="lozen-hero__depth pointer-events-none absolute inset-0 z-20"
    >
    </div>
  </div>

  <Wrapper
    variant="standard"
    class="relative z-30 flex min-h-[36rem] items-center py-24 sm:min-h-[40rem] sm:py-28 lg:h-full lg:min-h-0 lg:py-0"
  >
    <div
      class="mx-auto max-w-[88rem] -translate-y-3 text-center sm:-translate-y-4 lg:-translate-y-10"
    >
      <h1
        class="mx-auto max-w-7xl text-center font-display text-[2.05rem] font-normal leading-[1.15] tracking-[-0.04em] text-white [text-shadow:0_2px_18px_rgba(2,10,22,0.95)] sm:text-[2.35rem] md:text-[2.5rem] lg:text-[2.625rem]"
      >
        Working at the edge of what organizations can measure and what leaders are managing.
      </h1>

      <p
        class="mx-auto mt-7 max-w-6xl text-center font-sans text-[1rem] font-normal leading-7 tracking-[-0.01em] text-white/92 [text-shadow:0_1px_8px_rgba(2,10,22,0.85)] sm:mt-8 sm:text-[1.08rem] sm:leading-8 lg:text-[1.15rem]"
      >
        Lozen Advisory helps organizations and senior women leaders navigate the gap between visible performance records and the private constraints that shape retention, succession, benefits utilization, and leadership continuity.
      </p>
    </div>
  </Wrapper>
</section>
