---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="relative w-full overflow-hidden bg-base-950 lg:h-dvh">
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[url('/images/herobg.webp')] bg-cover bg-center"
  >
  </div>

  <div
    aria-hidden="true"
    class="absolute inset-0 bg-base-950/76"
  >
  </div>

  <div
    aria-hidden="true"
    class="absolute inset-0 bg-gradient-to-b from-base-950/55 via-base-950/35 to-base-950/80"
  >
  </div>

  <Wrapper
    variant="standard"
    class="relative z-10 flex min-h-[42rem] items-center py-28 lg:h-full lg:min-h-0 lg:py-0"
  >
    <div class="mx-auto max-w-5xl text-center">
      <h1 class="mx-auto max-w-4xl font-display text-[1.95rem] font-normal leading-[1.18] tracking-[-0.025em] text-white sm:text-[2.15rem] lg:text-4xl">
        Working at the edge of what organizations can measure and what leaders are managing.
      </h1>

      <p class="mx-auto mt-8 max-w-3xl font-sans text-base font-normal leading-8 text-base-100 sm:text-lg lg:text-xl lg:leading-9">
        Lozen Advisory helps organizations and senior women leaders navigate the gap between visible performance records and the private constraints that shape retention, succession, benefits utilization, and leadership continuity.
      </p>
    </div>
  </Wrapper>
</section>
