---
// Foundations
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="relative overflow-hidden bg-gradient-to-b from-base-50 via-base-100 to-white">
  <Wrapper variant="standard" class="py-20 lg:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(320px,0.5fr)] lg:items-end">
        <div>
          <p class="border-l border-accent-500 pl-4 text-xs font-medium uppercase tracking-[0.18em] text-base-700">
            Disclosure-Independent Performance Protection℠
          </p>

          <h1 class="mt-8 max-w-5xl font-display text-4xl font-medium uppercase leading-[1.04] tracking-tight text-base-950 sm:text-5xl lg:text-6xl">
            Working at the edge of what organizations can measure and what leaders are managing.
          </h1>

          <p class="mt-8 max-w-4xl text-lg leading-8 text-base-700 sm:text-xl">
            Lozen Advisory helps organizations and senior women leaders navigate the gap between visible performance records and the private constraints that shape retention, succession, benefits utilization, and leadership continuity.
          </p>

          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <Button
              isLink
              href="/request-briefing"
              variant="accent"
              size="xs"
            >
              Request Briefing
            </Button>

            <Button
              isLink
              href="/invisible-attrition"
              variant="secondary"
              size="xs"
            >
              Explore Invisible Attrition℠
            </Button>
          </div>
        </div>

        <aside class="rounded-3xl border border-base-300 bg-white p-6 shadow-sm ring-1 ring-base-950/5 sm:p-8">
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-base-500">
            What Lozen Measures
          </p>

          <div class="mt-8 grid gap-4">
            <div class="rounded-2xl border border-base-300 bg-base-50 p-5">
              <p class="text-sm font-semibold uppercase tracking-[0.12em] text-base-950">
                Retention Risk
              </p>
              <p class="mt-3 text-sm leading-6 text-base-700">
                The exposure that forms before departure appears in the data.
              </p>
            </div>

            <div class="rounded-2xl border border-base-300 bg-base-50 p-5">
              <p class="text-sm font-semibold uppercase tracking-[0.12em] text-base-950">
                Succession Exposure
              </p>
              <p class="mt-3 text-sm leading-6 text-base-700">
                The gap between who appears stable and who is already carrying unsustainable load.
              </p>
            </div>

            <div class="rounded-2xl border border-accent-500 bg-accent-50 p-5">
              <p class="text-sm font-semibold uppercase tracking-[0.12em] text-base-950">
                Disclosure Dependency
              </p>
              <p class="mt-3 text-sm leading-6 text-base-800">
                The systems that cannot measure risk until someone creates a record.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </Wrapper>
</section>
