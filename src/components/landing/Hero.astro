---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Tenor+Sans&display=swap");
</style>

<section class="relative w-full overflow-hidden bg-[#001f2b] lg:h-dvh lg:p-8">
  <div class="absolute inset-0 overflow-hidden lg:m-4 lg:rounded-3xl">
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-[url('/images/herobg.webp')] bg-cover bg-center"
    >
    </div>

    <div
      aria-hidden="true"
      class="absolute inset-0 pointer-events-none"
      style="background-color: rgba(0, 31, 43, 0.62);"
    >
    </div>

    <div
      aria-hidden="true"
      class="absolute inset-0 pointer-events-none"
      style="background: linear-gradient(to bottom, rgba(0, 31, 43, 0.42), rgba(0, 41, 56, 0.24), rgba(0, 31, 43, 0.72));"
    >
    </div>
  </div>

  <Wrapper
    variant="standard"
    class="relative z-10 flex h-full min-h-[44rem] items-center py-28 lg:min-h-0 lg:py-0"
  >
    <div class="mx-auto max-w-[88rem] text-center">
      <h1 class="mx-auto max-w-7xl text-center text-[2.15rem] font-normal leading-[1.18] tracking-[-0.035em] text-white [font-family:'Tenor_Sans',sans-serif] [text-shadow:0_2px_18px_rgba(0,31,43,0.95)] sm:text-[2.35rem] lg:text-[2.625rem]">
        Working at the edge of what organizations can measure and what leaders are managing.
      </h1>

      <p class="mx-auto mt-8 max-w-7xl text-center text-[1rem] font-normal leading-8 tracking-[-0.01em] text-white [font-family:'Tenor_Sans',sans-serif] [text-shadow:0_1px_8px_rgba(0,31,43,0.75)] sm:text-[1.08rem] lg:text-[1.15rem] lg:leading-8">
        Lozen Advisory helps organizations and senior women leaders navigate the gap between visible performance records and the private constraints that shape retention, succession, benefits utilization, and leadership continuity.
      </p>
    </div>
  </Wrapper>
</section>
