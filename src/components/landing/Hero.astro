---
// Foundations
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="relative w-full overflow-hidden bg-base-950 lg:h-dvh lg:p-8">
  <div class="absolute inset-0 overflow-hidden lg:m-4 lg:rounded-3xl">
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-[url('/images/herobg.webp')] bg-cover bg-center"
    >
    </div>

    <div
      aria-hidden="true"
      class="absolute inset-0 pointer-events-none bg-base-950/78"
    >
    </div>

    <div
      aria-hidden="true"
      class="absolute inset-0 pointer-events-none bg-gradient-to-b from-base-950/60 via-base-950/35 to-base-950/85"
    >
    </div>
  </div>

  <Wrapper
    variant="standard"
    class="relative z-10 flex min-h-[42rem] flex-col justify-center py-24 lg:h-full lg:min-h-0 lg:py-0"
  >
    <div class="mx-auto max-w-6xl text-center">
      <h1 class="mx-auto max-w-6xl font-display text-[2.9rem] font-normal leading-[1.08] tracking-[-0.035em] text-white sm:text-[4rem] lg:text-[5rem]">
        Working at the edge of what organizations can measure and what leaders are managing.
      </h1>

      <p class="mx-auto mt-8 max-w-5xl font-sans text-base font-normal leading-8 text-base-100 sm:text-xl lg:text-[1.45rem] lg:leading-10">
        Lozen Advisory helps organizations and senior women leaders navigate the gap between visible performance records and the private constraints that shape retention, succession, benefits utilization, and leadership continuity.
      </p>

      <div class="mt-10 flex justify-center">
        <Button
          isLink
          href="/request-briefing"
          variant="accent"
          size="xs"
        >
          Request Briefing
        </Button>
      </div>
    </div>
  </Wrapper>
</section>
