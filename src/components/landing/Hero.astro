---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="relative w-full overflow-hidden bg-base-950 lg:h-dvh">
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[url('/images/herobg.webp')] bg-cover bg-center"
  >
  </div>

  <div
    aria-hidden="true"
    class="absolute inset-0 bg-base-950/74"
  >
  </div>

  <div
    aria-hidden="true"
    class="absolute inset-0 bg-gradient-to-b from-base-950/55 via-base-950/35 to-base-950/78"
  >
  </div>

  <Wrapper
    variant="standard"
    class="relative z-10 flex min-h-[44rem] items-center py-28 lg:h-full lg:min-h-0 lg:py-0"
  >
    <div class="max-w-6xl">
      <h1 class="max-w-5xl font-display text-[2.35rem] font-normal leading-[1.14] tracking-[-0.035em] text-white sm:text-[3.25rem] lg:text-[4.15rem]">
        Working at the edge of what organizations can measure and what leaders are managing.
      </h1>

      <p class="mt-9 max-w-4xl font-sans text-base font-normal leading-8 tracking-[-0.01em] text-base-100 sm:text-lg lg:text-[1.3rem] lg:leading-9">
        Lozen Advisory helps organizations and senior women leaders navigate the gap between visible performance records and the private constraints that shape retention, succession, benefits utilization, and leadership continuity.
      </p>
    </div>
  </Wrapper>
</section>
