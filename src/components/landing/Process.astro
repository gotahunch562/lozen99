---
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const steps = [
  {
    title: "Market Intelligence",
    description:
      "Research and analysis on menopause benefits utilization delivered to your leadership team. What the data is not capturing, why utilization understates the problem, and what it is costing your organization.",
  },
  {
    title: "Executive Briefing",
    description:
      "A focused advisory session with your leadership team. We bring the analysis. You leave knowing what your current benefits architecture is missing and what it is costing.",
  },
  {
    title: "Advisory Engagement",
    description:
      "Ongoing counsel on menopause benefits strategy. We provide the knowledge, industry understanding, and strategic thinking your team needs to act.",
  },
  {
    title: "The MAPS Blueprint℠",
    description:
      "A 90-minute private session for the woman executive. She arrives with a situation. She leaves with a plan.",
  },
];
---

<section class="lozen-home-section lozen-home-section--surface">
  <Wrapper variant="standard">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,0.88fr)_minmax(0,1.12fr)] lg:gap-8 xl:gap-10">
      <div>
        <div
          class="lozen-home-media-panel min-h-[24rem] sm:min-h-[28rem] lg:sticky lg:top-24 lg:min-h-[34rem] xl:min-h-[36rem]"
        >
          <video
            autoplay
            muted
            loop
            playsinline
            class="absolute inset-0 size-full object-cover"
          >
            <source src="/videos/womenworkingvideo.mp4" type="video/mp4" />
          </video>

          <div
            aria-hidden="true"
            class="absolute inset-0 pointer-events-none bg-gradient-to-b from-base-950/82 via-base-900/54 to-base-950/92"
          >
          </div>

          <div
            aria-hidden="true"
            class="absolute inset-0 pointer-events-none bg-gradient-to-r from-base-950/70 via-base-950/24 to-base-950/38"
          >
          </div>

          <div class="relative z-10 flex min-h-[24rem] items-end p-6 sm:min-h-[28rem] sm:p-8 lg:min-h-[34rem] lg:p-9 xl:min-h-[36rem]">
            <div class="max-w-xl">
              <span class="lozen-home-eyebrow text-base-200">
                Services
              </span>

              <h2 class="lozen-home-title mt-5 text-white sm:mt-6">
                What We Do
              </h2>

              <p class="lozen-home-deck mt-4 max-w-md text-base-200">
                We advise on the infrastructure questions that standard systems are not built to answer. The focus is disclosure-independent design: what the current architecture can reach, what it cannot, and what that gap is costing.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid content-start gap-4 sm:gap-5">
        {
          steps.map((step, index) => (
            <article class="lozen-home-card lozen-home-card--quiet flex min-h-0 items-start gap-4 sm:gap-5 lg:gap-6">
              <span
                aria-hidden="true"
                class="lozen-home-card-number lozen-home-card-number--small w-12 shrink-0 pt-1 text-right sm:w-16"
              >
                {String(index + 1).padStart(2, "0")}
              </span>

              <div class="min-w-0 flex-1 border-l border-accent-500/70 pl-4 sm:pl-5">
                <h3 class="lozen-home-card-title">
                  {step.title}
                </h3>

                <p class="lozen-home-card-body mt-3">
                  {step.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
