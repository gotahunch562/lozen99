---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const steps = [
  {
    title: "Market Intelligence",
    description:
      "Research and analysis on menopause benefits utilization delivered to your leadership team. What the data is not capturing, why utilization understates the problem, and what it is costing your organization.",
  },
  {
    title: "Executive Briefing",
    description:
      "A focused advisory session with your leadership team. We bring the analysis. You leave knowing what your current benefits architecture is missing and what it is costing.",
  },
  {
    title: "Advisory Engagement",
    description:
      "Ongoing counsel on menopause benefits strategy. We provide the knowledge, industry understanding, and strategic thinking your team needs to act.",
  },
  {
    title: "The MAPS Blueprint℠",
    description:
      "A 90-minute private session for the woman executive. She arrives with a situation. She leaves with a plan.",
  },
];
---

<section class="bg-gradient-to-b from-base-200 via-base-100 to-white">
  <Wrapper variant="standard" class="py-12 sm:py-16 lg:py-24">
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2 lg:gap-8">
      <div>
        <div
          class="relative min-h-[26rem] overflow-hidden rounded-2xl border border-white/10 shadow-2xl ring-1 ring-base-950/10 sm:min-h-[30rem] lg:sticky lg:top-24 lg:h-[calc(100vh-9rem)] lg:rounded-3xl"
        >
          <video
            autoplay
            muted
            loop
            playsinline
            class="absolute inset-0 size-full object-cover"
          >
            <source src="/videos/womenworkingvideo.mp4" type="video/mp4" />
          </video>

          <div
            aria-hidden="true"
            class="absolute inset-0 pointer-events-none bg-gradient-to-b from-base-950/80 via-base-900/52 to-base-950/92"
          >
          </div>

          <div
            aria-hidden="true"
            class="absolute inset-0 pointer-events-none bg-gradient-to-r from-base-950/65 via-base-950/20 to-base-950/45"
          >
          </div>

          <div class="relative z-10 flex min-h-[26rem] items-end p-6 sm:min-h-[30rem] sm:p-8 lg:h-full lg:p-10">
            <div class="max-w-xl">
              <Text
                tag="span"
                variant="textSM"
                class="border-l border-accent-500 pl-4 font-sans font-semibold uppercase tracking-[0.18em] text-base-200"
              >
                Services
              </Text>

              <Text
                tag="h2"
                variant="displayMD"
                class="mt-6 font-display font-normal uppercase leading-[1.05] tracking-[-0.035em] text-white sm:mt-8"
              >
                What We Do
              </Text>

              <Text
                tag="p"
                variant="textBase"
                class="mt-4 max-w-md font-sans leading-7 text-base-200 sm:text-lg sm:leading-8"
              >
                We help leaders understand the data clearly and act decisively with a focus on non-disclosure infrastructure design.
              </Text>
            </div>
          </div>
        </div>
      </div>

      <div class="grid gap-5">
        {
          steps.map((step, index) => (
            <article class="group relative overflow-hidden rounded-2xl border border-base-400 bg-white p-5 shadow-lg ring-1 ring-base-950/5 transition-all duration-300 hover:-translate-y-1 hover:border-accent-500 hover:bg-base-50 hover:shadow-xl sm:p-6 lg:rounded-3xl lg:p-8">
              <div
                aria-hidden="true"
                class="absolute inset-x-0 top-0 h-1 bg-accent-500"
              >
              </div>

              <span class="absolute right-4 top-4 z-0 font-display text-6xl font-normal leading-none text-base-500/10 transition-colors duration-300 group-hover:text-accent-500/20 sm:right-6 sm:top-5 sm:text-7xl lg:text-8xl">
                {index + 1}
              </span>

              <div class="relative z-10 max-w-xl pr-10 sm:pr-16">
                <Text
                  tag="h3"
                  variant="displayXS"
                  class="border-l-2 border-accent-500 pl-4 font-display font-normal uppercase leading-tight tracking-[-0.015em] text-base-950"
                >
                  {step.title}
                </Text>

                <Text
                  tag="p"
                  variant="textBase"
                  class="mt-4 font-sans leading-7 text-base-700"
                >
                  {step.description}
                </Text>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
