---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const frameworkCards = [
  {
    eyebrow: "Pillar Framework",
    title: "Invisible Attrition℠",
    description:
      "The unmeasured erosion of leadership capacity before retention metrics detect risk. This pillar explains how organizations lose women executives while dashboards still show stability.",
    href: "/invisible-attrition",
    cta: "Read the pillar article",
  },
  {
    eyebrow: "Executive Reports",
    title: "The Architecture of Invisible Attrition℠",
    description:
      "A report series examining how benefits utilization, billable-hour systems, succession planning, and leadership pipeline data fail when risk remains disclosure-dependent.",
    href: "/architecture-of-invisible-attrition-series",
    cta: "View the report series",
  },
];
---

<section class="lozen-home-section lozen-home-section--quiet">
  <Wrapper variant="standard" class="py-0">
    <div class="lozen-home-container lozen-home-container--wide">
      <div class="lozen-home-header lozen-home-header--split">
        <div>
          <p class="lozen-home-eyebrow">Invisible Attrition℠</p>

          <h2 class="lozen-home-title">Intelligence Analysis</h2>
        </div>

        <p class="lozen-home-deck lg:pb-1">
          Understand how disclosure-dependent systems fail before standard retention metrics detect risk.
        </p>
      </div>

      <div class="lozen-home-grid lozen-home-grid--two">
        {
          frameworkCards.map((card) => (
            <a
              href={card.href}
              class="lozen-home-card lozen-home-card--large block no-underline"
            >
              <p class="lozen-home-card-meta">{card.eyebrow}</p>

              <h3 class="lozen-home-card-title">{card.title}</h3>

              <p class="lozen-home-card-body">{card.description}</p>

              <span class="lozen-home-card-link">
                {card.cta} <span aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
