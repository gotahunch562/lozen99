---
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const steps = [
  {
    title: "Market Intelligence",
    description:
      "Public-data research, charts, trackers, and reports on disclosure-dependent workforce risk, AI governance, and corporate board accountability.",
  },
  {
    title: "Executive Briefing",
    description:
      "A focused advisory session for leaders evaluating AI investment, attrition, and capacity exposure.",
  },
  {
    title: "Advisory Engagement",
    description:
      "Strategic counsel on board-ready AI legislation intelligence, the Name Standard℠, and the human-accountability questions directors should ask as AI governance expands.",
  },
  {
    title: "The MAPS Blueprint℠",
    description:
      "A private advisory session for senior women executives navigating disclosure, performance, and exit risk.",
  },
];
---

<section class="bg-gradient-to-b from-base-200 via-base-100 to-white">
  <Wrapper variant="standard" class="py-14 sm:py-16 lg:py-24">
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2 lg:gap-8">
      <div>
        <div
          class="relative min-h-[26rem] overflow-hidden rounded-2xl border border-white/10 shadow-2xl ring-1 ring-base-950/10 sm:min-h-[30rem] lg:sticky lg:top-24 lg:h-full lg:min-h-[42rem] lg:rounded-3xl"
        >
          <video
            autoplay
            muted
            loop
            playsinline
            class="absolute inset-0 size-full object-cover"
          >
            <source src="/videos/womenworkingvideo.mp4" type="video/mp4" />
          </video>

          <div
            aria-hidden="true"
            class="absolute inset-0 pointer-events-none bg-gradient-to-b from-base-950/80 via-base-900/52 to-base-950/92"
          >
          </div>

          <div
            aria-hidden="true"
            class="absolute inset-0 pointer-events-none bg-gradient-to-r from-base-950/65 via-base-950/20 to-base-950/45"
          >
          </div>

          <div class="relative z-10 flex min-h-[26rem] items-end p-6 sm:min-h-[30rem] sm:p-8 lg:h-full lg:p-10">
            <div class="max-w-xl">
              <span
                class="border-l border-accent-500 pl-4 font-sans text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-base-200"
              >
                Services
              </span>

              <h2
                class="mt-6 font-display text-[2.25rem] font-normal uppercase leading-[1.02] tracking-[-0.035em] text-white sm:mt-8 sm:text-[2.75rem] lg:text-[3.25rem]"
              >
                What We Do
              </h2>

              <p
                class="mt-4 max-w-md font-sans text-base leading-7 text-base-200 sm:text-[1.0625rem] sm:leading-8"
              >
                We advise on the infrastructure questions that standard systems are not built to answer. The focus is disclosure-independent design: what the current architecture can reach, what it cannot, and what that gap is costing.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid gap-4 lg:gap-4">
        {
          steps.map((step, index) => (
            <article class="group relative overflow-hidden rounded-2xl border border-base-400 bg-white p-5 shadow-lg ring-1 ring-base-950/5 transition-all duration-300 hover:-translate-y-1 hover:border-accent-500 hover:bg-base-50 hover:shadow-xl sm:p-6 lg:rounded-3xl">
              <div
                aria-hidden="true"
                class="absolute inset-x-0 top-0 h-1 bg-accent-500"
              >
              </div>

              <span class="absolute right-4 top-4 z-0 font-display text-6xl font-normal leading-none text-base-500/10 transition-colors duration-300 group-hover:text-accent-500/20 sm:right-6 sm:top-5 sm:text-7xl lg:text-8xl">
                {index + 1}
              </span>

              <div class="relative z-10 max-w-xl pr-10 sm:pr-16">
                <h3 class="border-l-2 border-accent-500 pl-4 font-display text-[1.35rem] font-normal uppercase leading-tight tracking-[-0.015em] text-base-950 sm:text-[1.45rem]">
                  {step.title}
                </h3>

                <p class="mt-4 font-sans text-[0.9375rem] leading-7 text-base-700 sm:text-base">
                  {step.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
