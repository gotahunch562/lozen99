---
interface Props {
  variant?: "standard" | "paddingLess" | "prose" | "narrow";
  class?: string;
}

const { variant = "standard", class: extraClass = "" } = Astro.props;

const variantClasses = {
  narrow: "max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 w-full",
  standard: "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full",
  paddingLess: "max-w-screen mx-auto w-full 2xl:max-w-[120rem]",
  prose:
    "prose prose-lg w-full max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 \
   prose-headings:font-display prose-headings:font-normal prose-headings:text-base-900 \
   prose-p:font-sans prose-p:text-base-800 prose-p:leading-8 prose-strong:text-base-900 \
   prose-li:text-base-800 prose-li:leading-8 \
   prose-a:text-accent-700 prose-a:border-b prose-a:border-accent-600 prose-a:no-underline \
   prose-a:transition-colors prose-a:duration-200 \
   prose-a:hover:text-base-950 prose-a:hover:border-accent-500 \
   prose-blockquote:border-l-accent-500 prose-blockquote:text-base-800 \
   prose-li:marker:text-accent-500 \
   prose-pre:border prose-pre:border-base-200 prose-pre:bg-base-50 \
   prose-pre:rounded-xl prose-pre:scrollbar-hide \
   prose-tr:border-base-200 prose-thead:border-base-300",
};

const classes = `${variantClasses[variant]} ${extraClass}`.trim();
---

<div class={classes}>
  <slot />
</div>
