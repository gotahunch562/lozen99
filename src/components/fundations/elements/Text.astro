---
export interface Props {
  tag?:
    | "a"
    | "p"
    | "em"
    | "span"
    | "small"
    | "strong"
    | "blockquote"
    | "h1"
    | "h2"
    | "h3"
    | "h4"
    | "h5"
    | "h6";
  id?: string;
  rel?: string;
  style?: string;
  target?: string;
  href?: string;
  title?: string;
  variant?: keyof typeof textStyles;
  class?: string;
  ariaLabel?: string;
}

/*
  Typography variants map to the central Lozen type scale in global.css.
  Keep the legacy variant names so existing pages do not break, but make the
  visible sizes inherit one governed system. Homepage-specific display classes
  are retained for deliberate exceptional use only.
*/
const textStyles = {
  display6XL: "lozen-type-home-display",
  display5XL: "lozen-type-home-display",
  display4XL: "lozen-type-page-title",
  display3XL: "lozen-type-page-title",
  display2XL: "lozen-type-page-title",
  displayXL: "lozen-type-page-title",
  displayLG: "lozen-type-section-title",
  displayMD: "lozen-type-article-title",
  displaySM: "lozen-type-card-title",
  displayXS: "lozen-type-card-title-small",

  textXL: "lozen-type-body-large",
  textLG: "lozen-type-body-large",
  textBase: "lozen-type-body",
  textSM: "lozen-type-body-small",
  textXS: "font-sans text-xs leading-relaxed",
} as const;

const {
  tag: Tag = "p",
  class: className = "",
  variant = "textBase",
  ariaLabel,
  ...rest
} = Astro.props;

const baseClasses = textStyles[variant] || textStyles.textBase;
const combinedClasses = `${baseClasses} ${className}`.trim();
---

<Tag class={combinedClasses} aria-label={ariaLabel} {...rest}>
  <slot name="left-icon" />
  <slot />
  <slot name="right-icon" />
</Tag>
