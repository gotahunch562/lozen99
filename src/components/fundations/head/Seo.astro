---
import { AstroSeo } from "@lexingtonthemes/seo";

const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const title = "Institutional Risk & Executive Performance Continuity | Lozen Advisory";

const description =
  "Strategic counsel addressing the disclosure-dependent measurement failure in leadership pipelines. Protect executive trajectory and institutional authority.";
---

<AstroSeo
  title={title}
  description={description}
  canonical={canonical}
  openGraph={{
    url: canonical,
    title,
    description,
    images: [
      {
        url: "https://www.lozenadvisory.com/og-image.jpg",
        width: 1200,
        height: 630,
        alt: "Lozen Advisory",
        type: "image/jpeg",
      },
    ],
    site_name: "Lozen Advisory",
    type: "website",
    locale: "en_US",
  }}
  twitter={{
    cardType: "summary_large_image",
  }}
/>
