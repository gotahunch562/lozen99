---
import { AstroSeo } from "@lexingtonthemes/seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
}

const {
  title: pageTitle,
  description: pageDescription,
  canonical: pageCanonical,
  ogImage,
  ogImageAlt,
  ogType,
} = Astro.props;

const site = Astro.site ?? new URL("https://www.lozenadvisory.com");

const normalizePath = (pathname: string) => {
  const cleanPath = pathname.replace(/\/+$/, "");
  return cleanPath || "/";
};

const currentPath = normalizePath(Astro.url.pathname);

const canonical = pageCanonical
  ? new URL(pageCanonical, site).toString()
  : new URL(currentPath, site).toString();

const title =
  pageTitle?.trim() ||
  "Lozen Advisory | Invisible Attrition℠ & Leadership Advisory";

const description =
  pageDescription?.trim() ||
  "Strategic advisory for leadership. We identify disclosure-dependence gaps impacting retention, AI governance, performance risk, and menopause utilization.";

const imageSource = ogImage || "/images/herobg.webp";
const imageUrl = /^https?:\/\//i.test(imageSource)
  ? imageSource
  : new URL(imageSource, site).toString();

const lowerImageSource = imageSource.toLowerCase();

const imageType = lowerImageSource.endsWith(".png")
  ? "image/png"
  : lowerImageSource.endsWith(".jpg") || lowerImageSource.endsWith(".jpeg")
    ? "image/jpeg"
    : "image/webp";

const type =
  ogType ||
  (currentPath.startsWith("/blog/") ||
  currentPath.startsWith("/invisible-attrition/") ||
  currentPath.includes("legislation")
    ? "article"
    : "website");

const noindex =
  currentPath === "/blog/tags" || currentPath.startsWith("/blog/tags/");
---

<AstroSeo
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  openGraph={{
    url: canonical,
    title,
    description,
    images: [
      {
        url: imageUrl,
        width: 1200,
        height: 630,
        alt: ogImageAlt || "Lozen Advisory",
        type: imageType,
      },
    ],
    site_name: "Lozen Advisory",
    type,
    locale: "en_US",
  }}
  twitter={{
    cardType: "summary_large_image",
  }}
/>
