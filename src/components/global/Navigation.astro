---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import MobileMenu from "@/components/global/MobileMenu.astro";
import MegaMenu from "@/components/global/MegaMenu.astro";
// Icons
import Close from "@/components/fundations/icons/Close.astro";
import Burger from "@/components/fundations/icons/Burger.astro";

type PrimaryLink = {
  href: string;
  label: string;
  activePaths?: string[];
};

const primaryLinks: PrimaryLink[] = [
  { href: "/services", label: "What We Do" },
  { href: "/ai-legislation-tracker", label: "AILegiRisk Map" },
  { href: "/about", label: "About" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
  {
    href: "/news-press",
    label: "News & Press",
    activePaths: ["/news-press/menopause-market-correction"],
  },
];

const normalizePath = (path: string) =>
  path.length > 1 ? path.replace(/\/+$/, "") : path;

const currentPath = normalizePath(Astro.url.pathname);

const isActivePath = (href: string) => {
  const normalizedHref = normalizePath(href);
  return (
    currentPath === normalizedHref ||
    currentPath.startsWith(`${normalizedHref}/`)
  );
};

const isPrimaryActive = (link: PrimaryLink) =>
  isActivePath(link.href) ||
  Boolean(link.activePaths?.some((path) => isActivePath(path)));

const morePaths = [
  "/disclosure-independent-governance",
  "/frameworks",
  "/menopause-and-the-law",
  "/tools-resources",
  "/retention-calculator",
  "/download",
  "/invisible-attrition",
  "/architecture-of-invisible-attrition-series",
  "/ai-workforce-materiality",
  "/menopause-legislation-tracker",
  "/events",
  "/faq",
];

const isMoreActive = morePaths.some((path) => isActivePath(path));
---

<header class="fixed top-0 z-50 w-full">
  <Wrapper variant="standard" class="py-2.5">
    <nav
      class="lozen-primary-nav flex items-center justify-between gap-3 rounded-2xl bg-base-900/78 p-3.5 shadow-xl outline-4 outline-base-500/5 backdrop-blur-xl sm:p-4"
      aria-label="Primary navigation"
    >
      <a
        href="/"
        class="lozen-primary-nav__brand min-w-0 shrink-0 rounded-full px-1 py-1 transition-opacity duration-200 hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-400"
        aria-label="Go to Lozen Advisory home page"
        aria-current={currentPath === "/" ? "page" : undefined}
      >
        <Logo class="text-base font-normal text-white uppercase font-display sm:text-lg" />
      </a>

      <div class="hidden items-center justify-center gap-1 xl:flex">
        {
          primaryLinks.map((link) => {
            const active = isPrimaryActive(link);

            return (
              <a
                href={link.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "lozen-primary-nav__link",
                  active && "lozen-primary-nav__link--active",
                ]}
              >
                <span>{link.label}</span>
              </a>
            );
          })
        }

        <button
          id="megamenu-trigger"
          type="button"
          class:list={[
            "lozen-primary-nav__link lozen-primary-nav__link--button",
            isMoreActive && "lozen-primary-nav__link--active",
          ]}
          aria-expanded="false"
          aria-controls="megamenu"
          aria-label="Open secondary navigation menu"
          aria-current={isMoreActive ? "page" : undefined}
        >
          <span>More</span>
          <span class="lozen-primary-nav__plus" aria-hidden="true">+</span>
        </button>
      </div>

      <div class="flex shrink-0 items-center gap-2">
        <div class="hidden xl:block">
          <Button isLink size="xs" variant="accent" href="/request-briefing/">
            Request Briefing
          </Button>
        </div>

        <Button
          iconOnly
          size="sm"
          variant="default"
          id="mobile-menu-button"
          type="button"
          class="xl:hidden"
          aria-label="Toggle menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <Burger slot="icon" id="menu-icon-open" size="sm" />
          <Close slot="icon" id="menu-icon-close" size="sm" class="hidden" />
        </Button>
      </div>
    </nav>
  </Wrapper>

  <MegaMenu />
  <MobileMenu />
</header>

<style>
  .lozen-primary-nav__link {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 0.75rem;
    padding: 0.78rem 0.98rem;
    color: rgba(255, 255, 255, 0.84);
    font-family: var(--font-sans);
    font-size: 0.91rem;
    font-weight: 520;
    letter-spacing: 0.018em;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
    white-space: nowrap;
  }

  .lozen-primary-nav__link:hover,
  .lozen-primary-nav__link:focus-visible {
    border-color: rgba(255, 255, 255, 0.11);
    background-color: rgba(255, 255, 255, 0.055);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .lozen-primary-nav__link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent-300) 72%, white);
    outline-offset: 3px;
  }

  .lozen-primary-nav__link--active {
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.035);
    color: #ffffff;
  }

  .lozen-primary-nav__link--active::after {
    content: "";
    position: absolute;
    right: 0.9rem;
    bottom: 0.46rem;
    left: 0.9rem;
    height: 1px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent-300) 72%, white);
    opacity: 0.8;
  }

  .lozen-primary-nav__link--button {
    cursor: pointer;
  }

  .lozen-primary-nav__plus {
    display: inline-flex;
    transform: translateY(-0.02em);
    color: currentColor;
    font-size: 1.05em;
    line-height: 1;
  }

  @media (min-width: 1280px) and (max-width: 1365px) {
    .lozen-primary-nav__link {
      padding-right: 0.78rem;
      padding-left: 0.78rem;
      font-size: 0.88rem;
      letter-spacing: 0.012em;
    }
  }
</style>
