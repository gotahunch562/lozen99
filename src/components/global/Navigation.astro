---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import MobileMenu from "@/components/global/MobileMenu.astro";
// Icons
import Close from "@/components/fundations/icons/Close.astro";
import Burger from "@/components/fundations/icons/Burger.astro";

const quickLinks = [
  { href: "/invisible-attrition", label: "Invisible Attrition" },
  {
    href: "/disclosure-independence-infrastructure",
    label: "Disclosure Infrastructure",
  },
  { href: "/blog", label: "Research" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

// Sets link color based on current path
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 z-50 w-full">
  <Wrapper variant="standard" class="py-2">
    <nav
      class="flex items-center justify-between p-4 shadow-xl bg-base-900/60 outline-4 outline-base-500/5 backdrop-blur-xl rounded-xl"
    >
      <a href="/" aria-label="Go to Lozen Advisory home page">
        <Logo class="text-lg font-medium text-white uppercase font-display" />
      </a>

      <div class="items-center hidden lg:flex gap-8">
        {
          quickLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "text-sm font-medium transition-colors duration-200",
                currentPath.startsWith(link.href)
                  ? "text-accent-400"
                  : "text-white hover:text-white",
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-2">
        <Button isLink size="xs" variant="accent" href="/request-briefing">
          Request Briefing
        </Button>

        <Button
          iconOnly
          size="sm"
          variant="default"
          id="mobile-menu-button"
          type="button"
          class="lg:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <Burger slot="icon" id="menu-icon-open" size="sm" />
          <Close slot="icon" id="menu-icon-close" size="sm" class="hidden" />
        </Button>
      </div>
    </nav>
  </Wrapper>

  <MobileMenu />
</header>
