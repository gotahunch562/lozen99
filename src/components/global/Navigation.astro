---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import MobileMenu from "@/components/global/MobileMenu.astro";
import MegaMenu from "@/components/global/MegaMenu.astro";
// Icons
import Close from "@/components/fundations/icons/Close.astro";
import Burger from "@/components/fundations/icons/Burger.astro";

const quickLinks = [
  { href: "/services", label: "Services" },
  { href: "/events", label: "Events" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;

const isActiveLink = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);

const isResearchActive =
  currentPath.startsWith("/blog") ||
  currentPath.startsWith("/invisible-attrition") ||
  currentPath.startsWith("/disclosure-independence-infrastructure") ||
  currentPath.startsWith("/architecture-of-invisible-attrition-series") ||
  currentPath.startsWith("/menopause-legislation-tracker") ||
  currentPath.startsWith("/voluntary-benefit-disclosure-gap") ||
  currentPath.startsWith("/billable-hour-visibility-tax") ||
  currentPath.startsWith("/succession-planning-retention-risk-data-gap") ||
  currentPath.startsWith("/leadership-pipeline-manager-engagement");
---

<header class="fixed top-0 z-50 w-full">
  <Wrapper variant="standard" class="py-2">
    <nav
      class="flex items-center justify-between gap-4 rounded-xl bg-base-900/70 p-3 shadow-xl outline-4 outline-base-500/5 backdrop-blur-xl sm:p-4"
      aria-label="Primary navigation"
    >
      <a
        href="/"
        class="min-w-0 shrink-0"
        aria-label="Go to Lozen Advisory home page"
      >
        <Logo class="text-base font-normal text-white uppercase font-display sm:text-lg" />
      </a>

      <div class="hidden items-center gap-8 lg:flex">
        <a
          href="/services"
          class:list={[
            "text-sm font-medium transition-colors duration-200",
            isActiveLink("/services")
              ? "text-accent-400"
              : "text-white/85 hover:text-white",
          ]}
        >
          Services
        </a>

        <button
          id="megamenu-trigger"
          type="button"
          class:list={[
            "inline-flex items-center gap-1 text-sm font-medium transition-colors duration-200",
            isResearchActive
              ? "text-accent-400"
              : "text-white/85 hover:text-white",
          ]}
          aria-expanded="false"
          aria-controls="megamenu"
          aria-label="Open research menu"
        >
          <span>Research</span>
          <span aria-hidden="true">+</span>
        </button>

        {
          quickLinks.slice(1).map((link) => (
            <a
              href={link.href}
              class:list={[
                "text-sm font-medium transition-colors duration-200",
                isActiveLink(link.href)
                  ? "text-accent-400"
                  : "text-white/85 hover:text-white",
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <div class="flex shrink-0 items-center gap-2">
        <div class="hidden lg:block">
          <Button isLink size="xs" variant="accent" href="/request-briefing">
            Request Briefing
          </Button>
        </div>

        <Button
          iconOnly
          size="sm"
          variant="default"
          id="mobile-menu-button"
          type="button"
          class="lg:hidden"
          aria-label="Toggle menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <Burger slot="icon" id="menu-icon-open" size="sm" />
          <Close slot="icon" id="menu-icon-close" size="sm" class="hidden" />
        </Button>
      </div>
    </nav>
  </Wrapper>

  <MegaMenu />
  <MobileMenu />
</header>
