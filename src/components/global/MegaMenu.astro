---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const megaMenuSections = [
  {
    title: "Frameworks",
    description: "Core Lozen Advisory architecture.",
    links: [
      {
        href: "/invisible-attrition",
        label: "Invisible Attrition℠ Series",
        description: "A research-grounded 6 part editorial series examining disclosure in the workplace infrastructure and the effects.",
      },
      {
        href: "/4s-sovereign-capacity-model/",
        label: "4S Framework",
        description:
          "Lozen Advisory's foundational model for structural workforce risk, AI investment, and institutional capacity exposure.",
      },
      {
        href: "/disclosure-independence-infrastructure",
        label: "Disclosure Infrastructure",
        description: "Why disclosure-dependent systems cannot fully measure risk.",
      },
      {
        href: "/ai-workforce-materiality/",
        label: "AI Workforce Materiality",
        description:
          "A series on AI adoption, hidden labor, Power User Trap℠ exposure, and human-capital materiality risk.",
      },
    ],
  },
  {
    title: "Research",
    description: "Focused research destinations.",
    links: [
      {
        href: "/menopause-legislation-tracker",
        label: "Menopause Legislation Tracker",
        description: "A governance audit of disclosure-dependent policy design.",
      },
      {
        href: "/retention-calculator",
        label: "Retention Calculator",
        description: "Estimate the replacement cost of women in leadership.",
      },
      {
        href: "https://www.executiveaiskills.com/",
        label: "AI Evaluation Training",
        description: "Not how to use AI. How to keep AI-generated errors from leaving your office.",
        external: true,
      },
    ],
  },
  {
    title: "Access",
    description: "Secondary paths into the site.",
    links: [
      {
        href: "/why-lozen-advisory",
        label: "Why Lozen Advisory",
        description: "The firm’s positioning, method, and advisory frame.",
      },
      {
        href: "/events",
        label: "Events",
        description: "Speaking engagements and public appearances.",
      },
      {
        href: "/faq",
        label: "FAQ",
        description: "Common questions about Lozen Advisory and advisory paths.",
      },
      {
        href: "/booking",
        label: "MAPS Blueprint℠",
        description:
          "Private 90-minute advisory session for an upcoming evaluation moment.",
      },
      {
        href: "/menopause-support-women-lawyers",
        label: "For Women Lawyers",
        description: "Private performance protection for women in law.",
      },
    ],
  },
];
---

<div id="megamenu" class="absolute inset-x-0 top-full z-40 hidden">
  <Wrapper variant="standard" class="py-1">
    <div
      class="max-h-[calc(100vh-7.25rem)] overflow-y-auto rounded-2xl border border-base-200 bg-white shadow-2xl outline-4 outline-base-500/5 lg:rounded-3xl"
    >
      <div class="grid grid-cols-3 divide-x divide-base-200">
        {
          megaMenuSections.map((section) => (
            <div>
              <div class="border-b border-[#dfe7ee] bg-[#06172f] px-5 py-3.5">
                <Text
                  tag="h3"
                  variant="textSM"
                  class="font-sans text-[0.78rem] font-semibold uppercase tracking-[0.16em] text-white"
                >
                  {section.title}
                </Text>

                <Text
                  tag="p"
                  variant="textSM"
                  class="mt-1.5 font-sans text-[0.82rem] leading-5 text-white/70"
                >
                  {section.description}
                </Text>
              </div>

              <ul class="space-y-0.5 p-3">
                {
                  section.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noopener noreferrer" : undefined}
                        class="group block rounded-xl px-3 py-2 no-underline transition-colors duration-200 hover:bg-base-50 focus-visible:bg-base-50"
                      >
                        <Text
                          tag="h4"
                          variant="textSM"
                          class="font-sans text-[0.73rem] font-semibold uppercase tracking-[0.09em] text-base-950 transition-colors duration-200 group-hover:text-accent-700"
                        >
                          {link.label}
                        </Text>

                        <Text
                          tag="p"
                          variant="textSM"
                          class="mt-1 font-sans text-[0.9rem] leading-5 text-base-600"
                        >
                          {link.description}
                        </Text>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
        }
      </div>

      <div class="border-t border-base-200 bg-base-50 px-5 py-3.5">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <Text
              tag="h3"
              variant="textSM"
              class="font-sans text-[0.82rem] font-semibold uppercase tracking-[0.14em] text-base-950"
            >
              Discover how we can help?
            </Text>

            <Text
              tag="p"
              variant="textSM"
              class="mt-1 font-sans text-[0.9rem] leading-5 text-base-600"
            >
              Request a briefing on disclosure-dependent workforce risk.
            </Text>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <Button isLink size="xs" variant="accent" href="/ai-workforce-materiality-briefing/">
              Request Briefing
            </Button>

            <Button isLink size="xs" variant="muted" href="/tools-resources">
              Tools & Downloads
            </Button>
          </div>
        </div>
      </div>
    </div>
  </Wrapper>
</div>

<script is:inline>
  const initMegaMenu = () => {
    const megamenuTrigger = document.getElementById("megamenu-trigger");
    const megamenu = document.getElementById("megamenu");

    if (!megamenuTrigger || !megamenu) return;

    let isMegaOpen = false;

    function openMegaMenu() {
      megamenu.classList.remove("hidden");
      megamenuTrigger.setAttribute("aria-expanded", "true");
      isMegaOpen = true;
    }

    function closeMegaMenu() {
      megamenu.classList.add("hidden");
      megamenuTrigger.setAttribute("aria-expanded", "false");
      isMegaOpen = false;
    }

    megamenuTrigger.addEventListener("click", (event) => {
      event.stopPropagation();

      if (isMegaOpen) {
        closeMegaMenu();
      } else {
        openMegaMenu();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;

      if (
        isMegaOpen &&
        target instanceof Node &&
        !megamenu.contains(target) &&
        !megamenuTrigger.contains(target)
      ) {
        closeMegaMenu();
      }
    });

    megamenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMegaMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isMegaOpen) {
        closeMegaMenu();
      }
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMegaMenu, { once: true });
  } else {
    initMegaMenu();
  }
</script>
