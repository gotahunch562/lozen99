---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const megaMenuSections = [
  {
    title: "Research",
    description: "Articles, frameworks, and current analysis.",
    links: [
      {
        href: "/blog",
        label: "Research Archive",
        description: "Articles, legislative analysis, and framework development.",
      },
      {
        href: "/menopause-legislation-tracker",
        label: "Menopause Legislation Tracker",
        description: "A governance audit of disclosure-dependent policy design.",
      },
      {
        href: "/architecture-of-invisible-attrition-series",
        label: "Executive Report Series",
        description: "The Architecture of Invisible Attrition℠ report collection.",
      },
      {
        href: "/voluntary-benefit-disclosure-gap",
        label: "Voluntary Benefit Disclosure Gap",
        description: "Analysis of utilization data and the disclosure-dependent measurement gap.",
      },
    ],
  },
  {
    title: "Frameworks",
    description: "Core Lozen Advisory concepts.",
    links: [
      {
        href: "/invisible-attrition",
        label: "Invisible Attrition℠",
        description: "Leadership capacity erosion before metrics detect risk.",
      },
      {
        href: "/disclosure-independence-infrastructure",
        label: "Disclosure Infrastructure",
        description: "Why systems dependent on disclosure cannot fully measure risk.",
      },
      {
        href: "/billable-hour-visibility-tax",
        label: "Billable Hour Visibility Tax",
        description: "How billable-hour systems miss capacity strain before loss is visible.",
      },
      {
        href: "/succession-planning-retention-risk-data-gap",
        label: "Succession Planning Data Gap",
        description: "Succession exposure where stable performance masks leadership risk.",
      },
    ],
  },
  {
    title: "Access",
    description: "Paths into Lozen Advisory.",
    links: [
      {
        href: "/services",
        label: "Services",
        description: "How Lozen Advisory works with organizations and women leaders.",
      },
      {
        href: "/services#tacere-download",
        label: "Tacere Paper",
        description: "Download the framework paper on employees who remain uncounted.",
      },
      {
        href: "/events",
        label: "Events",
        description: "Speaking engagements and public appearances.",
      },
      {
        href: "/request-briefing",
        label: "Request Briefing",
        description: "Start a B2B briefing request.",
      },
    ],
  },
];
---

<div id="megamenu" class="absolute inset-x-0 top-full z-40 hidden">
  <Wrapper variant="standard" class="py-2">
    <div
      class="overflow-hidden rounded-2xl border border-base-200 bg-white shadow-2xl outline-4 outline-base-500/5 lg:rounded-3xl"
    >
      <div class="grid grid-cols-3 divide-x divide-base-200">
        {
          megaMenuSections.map((section) => (
            <div>
              <div class="px-6 py-5">
                <Text
                  tag="h3"
                  variant="textBase"
                  class="font-sans font-semibold uppercase tracking-[0.14em] text-base-950"
                >
                  {section.title}
                </Text>

                <Text
                  tag="p"
                  variant="textSM"
                  class="mt-2 font-sans leading-6 text-base-600"
                >
                  {section.description}
                </Text>
              </div>

              <ul class="space-y-1 border-t border-base-200 p-4">
                {
                  section.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="group block rounded-xl px-3 py-3 no-underline transition-colors duration-200 hover:bg-base-50"
                      >
                        <Text
                          tag="h4"
                          variant="textSM"
                          class="font-sans font-semibold uppercase tracking-[0.08em] text-base-950 transition-colors duration-200 group-hover:text-accent-700"
                        >
                          {link.label}
                        </Text>

                        <Text
                          tag="p"
                          variant="textSM"
                          class="mt-1 font-sans leading-5 text-base-600"
                        >
                          {link.description}
                        </Text>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
        }
      </div>

      <div class="border-t border-base-200 bg-base-50 px-6 py-5">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <Text
              tag="h3"
              variant="textBase"
              class="font-sans font-semibold uppercase tracking-[0.12em] text-base-950"
            >
              Need clarity before the issue becomes visible?
            </Text>

            <Text
              tag="p"
              variant="textSM"
              class="mt-1 font-sans leading-6 text-base-600"
            >
              Request a briefing on disclosure-dependent workforce risk.
            </Text>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <Button isLink size="xs" variant="accent" href="/request-briefing">
              Request Briefing
            </Button>

            <Button isLink size="xs" variant="muted" href="/services">
              Services
            </Button>
          </div>
        </div>
      </div>
    </div>
  </Wrapper>
</div>

<script is:inline>
  const initMegaMenu = () => {
    const megamenuTrigger = document.getElementById("megamenu-trigger");
    const megamenu = document.getElementById("megamenu");

    if (!megamenuTrigger || !megamenu) return;

    let isMegaOpen = false;

    function openMegaMenu() {
      megamenu.classList.remove("hidden");
      megamenuTrigger.setAttribute("aria-expanded", "true");
      isMegaOpen = true;
    }

    function closeMegaMenu() {
      megamenu.classList.add("hidden");
      megamenuTrigger.setAttribute("aria-expanded", "false");
      isMegaOpen = false;
    }

    megamenuTrigger.addEventListener("click", (event) => {
      event.stopPropagation();

      if (isMegaOpen) {
        closeMegaMenu();
      } else {
        openMegaMenu();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;

      if (
        isMegaOpen &&
        target instanceof Node &&
        !megamenu.contains(target) &&
        !megamenuTrigger.contains(target)
      ) {
        closeMegaMenu();
      }
    });

    megamenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMegaMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isMegaOpen) {
        closeMegaMenu();
      }
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMegaMenu, { once: true });
  } else {
    initMegaMenu();
  }
</script>
