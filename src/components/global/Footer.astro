---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import MailerLiteSignup from "@/components/forms/MailerLiteSignup.astro";

const footerSections = [
  {
    title: "Company",
    links: [
      { label: "What We Do", href: "/services" },
      { label: "MAPS Blueprint℠", href: "/booking" },
      { label: "About", href: "/about" },
      { label: "Contact", href: "/contact" },
      { label: "FAQ", href: "/faq" },
    ],
  },
  {
    title: "Research",
    links: [
      { label: "Blog", href: "/blog" },
      { label: "Resource Library", href: "/blog/archive" },
      { label: "News & Press", href: "/news-press" },
      { label: "Menopause and the Law", href: "/menopause-and-the-law/" },
      { label: "Events", href: "/events" },
    ],
  },
  {
    title: "Frameworks",
    links: [

      { label: "Invisible Attrition℠", href: "/invisible-attrition" },
      {
        label: "Executive Report Series",
        href: "/architecture-of-invisible-attrition-series",
      },
      {
        label: "AI Workforce Materiality",
        href: "/ai-workforce-materiality",
      },
      {
        label: "Disclosure Infrastructure",
        href: "/disclosure-independence-infrastructure",
      },
      { label: "Retention Risk Analysis", href: "/retention-risk-analysis" },
    ],
  },
  {
    title: "Tools",
    links: [
      { label: "Tools & Downloads", href: "/tools-resources" },
      {
        label: "Menopause Legislation Tracker",
        href: "/menopause-legislation-tracker",
      },
      {
        label: "AI Legislation Tracker",
        href: "/ai-legislation-tracker/",
      },
      { label: "Retention Calculator", href: "/retention-calculator" },
      {
        label: "AI Evaluation Training",
        href: "https://www.executiveaiskills.com/",
        external: true,
      },
    ],
  },
];
const utilityLinks = [
  { label: "Privacy Policy", href: "/privacy-policy" },
  { label: "Terms of Service", href: "/terms-of-service" },
  { label: "About AI", href: "/about-ai" },
  { label: "Request Briefing", href: "/ai-workforce-materiality-briefing/" },
];
---

<footer class="relative w-full overflow-hidden bg-base-950 lg:p-6">
  <div class="absolute inset-0 overflow-hidden lg:m-4 lg:rounded-3xl">
    <video
      class="size-full object-cover object-center opacity-80"
      autoplay
      muted
      loop
      playsinline
    >
      <source src="/videos/car3.mp4" type="video/mp4" />
    </video>

    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-base-950/68"
    >
    </div>

    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-r from-base-950/86 via-base-950/52 to-base-950/76"
    >
    </div>
  </div>

  <Wrapper
    variant="standard"
    class="relative z-10 flex flex-col gap-8 py-10 sm:py-12 lg:min-h-[20rem] lg:py-12"
  >
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,0.88fr)_minmax(0,1.12fr)] lg:gap-14">
      <div class="max-w-xl">
        <a
          href="/"
          aria-label="Go to Lozen Advisory home page"
          class="font-display text-lg font-normal tracking-[-0.01em] text-white transition-colors hover:text-accent-300"
        >
          Lozen Advisory
        </a>

        <Text
          tag="p"
          variant="textSM"
          class="mt-5 max-w-md font-sans leading-7 text-white/78"
        >
          Governance advisory examining disclosure-dependent data gaps across AI workforce risk, retention risk, succession exposure, menopause at work, and leadership continuity.
        </Text>

        <div class="mt-6 max-w-md">
          <Text
            tag="p"
            variant="textSM"
            class="mb-3 font-sans font-semibold uppercase tracking-[0.12em] text-white"
          >
            Join the email list
          </Text>

          <MailerLiteSignup
            formId="footer-mailerlite-signup"
            group="footer"
            theme="dark"
            compact
            buttonLabel="Subscribe"
            successMessage="Thank you. You are subscribed."
          />
        </div>
      </div>

      <nav
        aria-label="Footer navigation"
        class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4 lg:gap-x-8"
      >
        {
          footerSections.map((section) => (
            <div>
              <Text
                tag="h3"
                variant="textSM"
                class="font-sans font-semibold uppercase tracking-[0.14em] text-white"
              >
                {section.title}
              </Text>

              <ul class="mt-4 space-y-2.5">
                {section.links.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noopener noreferrer" : undefined}
                      class="inline-flex font-sans text-sm leading-5 text-white/72 transition-colors hover:text-accent-300"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="border-t border-white/12 pt-5">
      <div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
        <Text tag="p" variant="textSM" class="font-sans text-white/68">
          &copy; {new Date().getFullYear()} Lozen Advisory LLC. All rights reserved.
        </Text>

        <div class="flex flex-wrap gap-x-5 gap-y-2">
          {
            utilityLinks.map((link) => (
              <a
                href={link.href}
                class="font-sans text-xs text-white/68 transition-colors hover:text-accent-300"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </Wrapper>
</footer>
