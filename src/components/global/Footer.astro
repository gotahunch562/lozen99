---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const footerLinks = [
  {
    title: "Advisory",
    links: [
      { label: "Disclosure Infrastructure", href: "/disclosure-independence-infrastructure" },
      { label: "Invisible Attrition", href: "/invisible-attrition" },
      { label: "Retention Risk Analysis", href: "/retention-risk-analysis" },
      { label: "Retention Calculator", href: "/retention-calculator" },
      { label: "Request Briefing", href: "/request-briefing" },
    ],
  },
  {
    title: "Research",
    links: [
      { label: "Blog", href: "/blog" },
      { label: "Menopause Legislation Tracker", href: "/menopause-legislation-tracker" },
      {
        label: "Menopause Policy & Laws Series",
        href: "/blog/menopause-policy-laws-dependence-disclosure",
      },
      { label: "Voluntary Benefit Disclosure Gap", href: "/voluntary-benefit-disclosure-gap" },
      { label: "Billable Hour Visibility Tax", href: "/billable-hour-visibility-tax" },
    ],
  },
  {
    title: "Lozen Advisory",
    links: [
      { label: "About", href: "/about" },
      { label: "Why Lozen Advisory", href: "/why-lozen-advisory" },
      { label: "Women Lawyers", href: "/menopause-support-women-lawyers" },
      { label: "Events", href: "/events" },
      { label: "Contact", href: "/contact" },
    ],
  },
];
---

<footer class="relative w-full overflow-hidden lg:p-8">
  <div class="absolute inset-0 overflow-hidden lg:m-4 lg:rounded-3xl">
    <video
      class="object-cover object-center size-full"
      autoplay
      muted
      loop
      playsinline
    >
      <source src="/videos/car3.mp4" type="video/mp4" />
    </video>
    <div
      aria-hidden="true"
      class="absolute inset-0 pointer-events-none bg-base-950/90"
    >
    </div>
  </div>

  <Wrapper
    variant="standard"
    class="relative z-10 flex flex-col justify-between h-full pt-24 pb-8 gap-8 lg:gap-44"
  >
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-12">
      <div class="col-span-2">
        <a
          href="/"
          aria-label="Go to Lozen Advisory home page"
          class="text-lg font-medium text-white uppercase font-display"
        >
          Lozen Advisory
        </a>

        <Text tag="p" variant="textXS" class="max-w-sm mt-12 text-base-500">
          Disclosure-independent advisory for organizations measuring retention,
          succession, leadership risk, and performance loss where no disclosure
          event was created.
        </Text>

        <div class="mt-8">
          <a
            href="/request-briefing"
            class="inline-flex h-10 items-center justify-center rounded-lg bg-accent-500 px-4 py-2 text-xs font-medium text-white transition-colors hover:bg-accent-600"
          >
            Request a Briefing
          </a>
        </div>
      </div>

      {
        footerLinks.map((section) => (
          <div>
            <Text
              tag="h3"
              variant="textSM"
              class="font-medium text-white uppercase font-display"
            >
              {section.title}
            </Text>
            <ul class="mt-2 space-y-1">
              {section.links.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="flex text-xs text-base-500 hover:text-white transition-colors"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div>
      <div
        class="flex flex-col justify-between mt-auto md:flex-row lg:items-center gap-4"
      >
        <Text tag="p" variant="textSM" class="text-base-500">
          &copy; {new Date().getFullYear()} Lozen Advisory LLC. All rights reserved.
        </Text>

        <div class="flex flex-wrap gap-6">
          <a
            href="/privacy-policy"
            class="text-xs text-base-500 hover:text-accent-500 transition-colors"
          >
            Privacy Policy
          </a>
          <a
            href="/terms-of-service"
            class="text-xs text-base-500 hover:text-accent-500 transition-colors"
          >
            Terms of Service
          </a>
          <a
            href="/about-ai"
            class="text-xs text-base-500 hover:text-accent-500 transition-colors"
          >
            About AI
          </a>
          <a
            href="/tools-resources"
            class="text-xs text-base-500 hover:text-accent-500 transition-colors"
          >
            Tools & Resources
          </a>
        </div>
      </div>

      <div
        class="pt-8 mt-2 border-t text-white/10 border-white/10 mix-blend-multiply"
      >
        <div
          class="font-display font-medium uppercase leading-none tracking-tight text-[clamp(3.5rem,14vw,13rem)]"
        >
          Lozen Advisory
        </div>
      </div>
    </div>
  </Wrapper>
</footer>
