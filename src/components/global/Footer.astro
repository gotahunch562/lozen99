---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const footerLinks = [
  {
    title: "Advisory",
    links: [
      { label: "What We Do", href: "/what-we-do" },
      {
        label: "Disclosure Infrastructure",
        href: "/disclosure-independence-infrastructure",
      },
      { label: "Invisible Attrition℠", href: "/invisible-attrition" },
      { label: "Retention Risk Analysis", href: "/retention-risk-analysis" },
      { label: "Request Briefing", href: "/request-briefing" },
    ],
  },
  {
    title: "Research",
    links: [
      { label: "Blog", href: "/blog" },
      {
        label: "Executive Report Series",
        href: "/architecture-of-invisible-attrition-series",
      },
      {
        label: "Menopause Legislation Tracker",
        href: "/menopause-legislation-tracker",
      },
      {
        label: "Voluntary Benefit Disclosure Gap",
        href: "/voluntary-benefit-disclosure-gap",
      },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About", href: "/about" },
      { label: "Why Lozen Advisory", href: "/why-lozen-advisory" },
      { label: "Women Lawyers", href: "/menopause-support-women-lawyers" },
      { label: "Events", href: "/events" },
      { label: "Contact", href: "/contact" },
    ],
  },
];

const utilityLinks = [
  { label: "Privacy Policy", href: "/privacy-policy" },
  { label: "Terms of Service", href: "/terms-of-service" },
  { label: "About AI", href: "/about-ai" },
  { label: "Tools & Resources", href: "/tools-resources" },
];

const year = new Date().getFullYear();
---

<footer class="relative w-full overflow-hidden bg-base-950 lg:p-8">
  <div class="absolute inset-0 overflow-hidden lg:m-4 lg:rounded-3xl">
    <video
      class="size-full object-cover object-center opacity-50"
      autoplay
      muted
      loop
      playsinline
    >
      <source src="/videos/car3.mp4" type="video/mp4" />
    </video>

    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-base-950/94 via-base-950/88 to-base-950/98"
    >
    </div>

    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-r from-base-950/96 via-base-950/74 to-base-950/92"
    >
    </div>
  </div>

  <Wrapper
    variant="standard"
    class="relative z-10 flex h-full flex-col justify-between gap-16 py-12 sm:py-16 lg:min-h-[34rem] lg:gap-32 lg:py-20"
  >
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <a
          href="/"
          aria-label="Go to Lozen Advisory home page"
          class="font-display text-lg font-normal uppercase tracking-[-0.01em] text-white transition-colors hover:text-accent-300"
        >
          Lozen Advisory
        </a>

        <Text
          tag="p"
          variant="textSM"
          class="mt-12 max-w-sm font-sans leading-6 text-base-300"
        >
          Disclosure-independent advisory for organizations measuring retention,
          succession, leadership risk, and performance loss where no disclosure
          event was created.
        </Text>

        <div class="mt-8 max-w-md">
          <div class="lozen-mailerlite">
            <div class="ml-embedded" data-form="HVvUgr"></div>
          </div>
        </div>
      </div>

      {
        footerLinks.map((section) => (
          <div class="lg:col-span-2">
            <Text
              tag="h3"
              variant="textSM"
              class="font-sans font-semibold uppercase tracking-[0.14em] text-white"
            >
              {section.title}
            </Text>

            <ul class="mt-4 space-y-2">
              {section.links.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="inline-flex font-sans text-sm leading-5 text-base-300 transition-colors hover:text-accent-300 focus:outline-none focus-visible:text-accent-300"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="lg:col-span-2">
        <Text
          tag="h3"
          variant="textSM"
          class="font-sans font-semibold uppercase tracking-[0.14em] text-white"
        >
          Briefing
        </Text>

        <ul class="mt-4 space-y-2">
          <li>
            <a
              href="/request-briefing"
              class="inline-flex font-sans text-sm leading-5 text-base-300 transition-colors hover:text-accent-300 focus:outline-none focus-visible:text-accent-300"
            >
              Request Briefing
            </a>
          </li>

          <li>
            <a
              href="/booking"
              class="inline-flex font-sans text-sm leading-5 text-base-300 transition-colors hover:text-accent-300 focus:outline-none focus-visible:text-accent-300"
            >
              MAPS Blueprint℠
            </a>
          </li>

          <li>
            <a
              href="https://www.executiveaiskills.com/"
              target="_blank"
              rel="noreferrer"
              class="inline-flex font-sans text-sm leading-5 text-base-300 transition-colors hover:text-accent-300 focus:outline-none focus-visible:text-accent-300"
            >
              AI Evaluation Training ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div>
      <div
        class="flex flex-col justify-between gap-6 border-t border-white/10 pt-8 md:flex-row md:items-center"
      >
        <Text tag="p" variant="textSM" class="font-sans text-base-300">
          &copy; {year} Lozen Advisory LLC. All rights reserved.
        </Text>

        <div class="flex flex-wrap gap-x-6 gap-y-3">
          {
            utilityLinks.map((item) => (
              <a
                href={item.href}
                class="font-sans text-xs text-base-300 transition-colors hover:text-accent-300 focus:outline-none focus-visible:text-accent-300"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="mt-8 overflow-hidden border-t border-white/10 pt-8">
        <div
          class="font-display text-[clamp(2.75rem,14vw,13rem)] font-normal uppercase leading-none tracking-[-0.05em] text-white/10"
        >
          Lozen Advisory
        </div>
      </div>
    </div>
  </Wrapper>

  <script is:inline>
    (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[])
    .push(arguments);},l=d.createElement(e),l.async=1,l.src=u,
    n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
    (window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
    ml('account', '2164541');
  </script>

  <style is:global>
    .lozen-mailerlite .ml-form-embedContainer,
    .lozen-mailerlite .ml-form-embedWrapper,
    .lozen-mailerlite .ml-form-embedBody,
    .lozen-mailerlite .ml-form-successBody {
      max-width: 100% !important;
      width: 100% !important;
      background: transparent !important;
      border: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
      box-shadow: none !important;
    }

    .lozen-mailerlite .ml-form-embedContent,
    .lozen-mailerlite .ml-form-embedPermissions {
      display: none !important;
    }

    .lozen-mailerlite form {
      display: flex !important;
      align-items: center !important;
      gap: 1rem !important;
    }

    .lozen-mailerlite .ml-form-formContent {
      flex: 1 1 auto !important;
      margin: 0 !important;
    }

    .lozen-mailerlite .ml-form-fieldRow,
    .lozen-mailerlite .ml-field-group {
      margin: 0 !important;
      padding: 0 !important;
    }

    .lozen-mailerlite input[type="email"] {
      min-height: 2.75rem !important;
      border: 0 !important;
      border-radius: 0.5rem !important;
      background: rgba(255, 255, 255, 0.08) !important;
      color: #ffffff !important;
      font-family: inherit !important;
      font-size: 0.875rem !important;
      padding: 0 1rem !important;
      outline: none !important;
    }

    .lozen-mailerlite input[type="email"]::placeholder {
      color: rgba(255, 255, 255, 0.45) !important;
    }

    .lozen-mailerlite .ml-form-embedSubmit {
      flex: 0 0 auto !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .lozen-mailerlite button {
      min-height: 2.75rem !important;
      border: 0 !important;
      border-radius: 0.5rem !important;
      background: rgb(250 204 21) !important;
      color: rgb(2 6 23) !important;
      font-family: inherit !important;
      font-size: 0.875rem !important;
      font-weight: 700 !important;
      padding: 0 1.25rem !important;
      transition: background-color 180ms ease !important;
    }

    .lozen-mailerlite button:hover {
      background: rgb(253 224 71) !important;
    }

    @media (max-width: 640px) {
      .lozen-mailerlite form {
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 0.75rem !important;
      }

      .lozen-mailerlite button {
        width: 100% !important;
      }
    }
  </style>
</footer>
