---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import MailerLiteSignup from "@/components/forms/MailerLiteSignup.astro";

const footerLinks = [
  {
    title: "Navigate",
    links: [
      { label: "What We Do", href: "/services" },
      { label: "Blog", href: "/blog" },
      { label: "News & Press", href: "/news-press" },
      { label: "Tools & Downloads", href: "/tools-resources" },
      { label: "Why Lozen Advisory", href: "/why-lozen-advisory" },
      { label: "About", href: "/about" },
      { label: "Contact", href: "/contact" },
      { label: "Request Briefing", href: "/request-briefing" },
    ],
  },
  {
    title: "Frameworks",
    links: [
      { label: "Invisible Attrition℠", href: "/invisible-attrition" },
      {
        label: "Executive Report Series",
        href: "/architecture-of-invisible-attrition-series",
      },
      {
        label: "Disclosure Infrastructure",
        href: "/disclosure-independence-infrastructure",
      },
      { label: "Retention Risk Analysis", href: "/retention-risk-analysis" },
      {
        label: "Menopause Legislation Tracker",
        href: "/menopause-legislation-tracker",
      },
      {
        label: "AI Evaluation Training",
        href: "https://www.executiveaiskills.com/",
        external: true,
      },
    ],
  },
  {
    title: "Access",
    links: [
      { label: "MAPS Blueprint℠", href: "/booking" },
      { label: "Retention Calculator", href: "/retention-calculator" },
      { label: "Events", href: "/events" },
      { label: "FAQ", href: "/faq" },
      { label: "For Women Lawyers", href: "/menopause-support-women-lawyers" },
      { label: "Normal Blood Tests", href: "/normal-blood-tests-feel-off" },
    ],
  },
];
---

<footer class="relative w-full overflow-hidden bg-base-950 lg:p-6">
  <div class="absolute inset-0 overflow-hidden lg:m-4 lg:rounded-3xl">
    <video
      class="size-full object-cover object-center opacity-80"
      autoplay
      muted
      loop
      playsinline
    >
      <source src="/videos/car3.mp4" type="video/mp4" />
    </video>

    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-base-950/62"
    >
    </div>

    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-r from-base-950/80 via-base-950/42 to-base-950/68"
    >
    </div>
  </div>

  <Wrapper
    variant="standard"
    class="relative z-10 flex flex-col gap-10 py-10 sm:py-12 lg:min-h-[20rem] lg:py-12"
  >
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
      <div class="max-w-xl">
        <a
          href="/"
          aria-label="Go to Lozen Advisory home page"
          class="font-display text-lg font-normal uppercase tracking-[-0.01em] text-white transition-colors hover:text-accent-300"
        >
          Lozen Advisory
        </a>

        <Text
          tag="p"
          variant="textSM"
          class="mt-5 max-w-md font-sans leading-7 text-white/78"
        >
          Disclosure-independent advisory for organizations measuring retention,
          succession, leadership risk, and performance loss where no disclosure
          event was created.
        </Text>

        <div class="mt-7 max-w-md">
          <Text
            tag="p"
            variant="textSM"
            class="mb-3 font-sans font-semibold uppercase tracking-[0.12em] text-white"
          >
            Join the email list
          </Text>

          <MailerLiteSignup
            formId="footer-mailerlite-signup"
            group="footer"
            theme="dark"
            compact
            buttonLabel="Subscribe"
            successMessage="Thank you. You are subscribed."
          />
        </div>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
        {
          footerLinks.map((section) => (
            <div>
              <Text
                tag="h3"
                variant="textSM"
                class="font-sans font-semibold uppercase tracking-[0.14em] text-white"
              >
                {section.title}
              </Text>

              <ul class="mt-4 space-y-2">
                {section.links.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noopener noreferrer" : undefined}
                      class="inline-flex font-sans text-sm leading-5 text-white/72 transition-colors hover:text-accent-300"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="border-t border-white/12 pt-5">
      <div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
        <Text tag="p" variant="textSM" class="font-sans text-white/68">
          &copy; {new Date().getFullYear()} Lozen Advisory LLC. All rights reserved.
        </Text>

        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <a
            href="/privacy-policy"
            class="font-sans text-xs text-white/68 transition-colors hover:text-accent-300"
          >
            Privacy Policy
          </a>

          <a
            href="/terms-of-service"
            class="font-sans text-xs text-white/68 transition-colors hover:text-accent-300"
          >
            Terms of Service
          </a>

          <a
            href="/about-ai"
            class="font-sans text-xs text-white/68 transition-colors hover:text-accent-300"
          >
            About AI
          </a>

          <a
            href="/tools-resources"
            class="font-sans text-xs text-white/68 transition-colors hover:text-accent-300"
          >
            Tools & Resources
          </a>
        </div>
      </div>
    </div>
  </Wrapper>
</footer>
