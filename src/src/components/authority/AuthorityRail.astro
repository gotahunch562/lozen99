---
interface RailItem {
  label: string;
  value: string;
}

interface RailLink {
  label: string;
  href: string;
}

interface Cta {
  label?: string;
  title: string;
  description?: string;
  href: string;
}

interface Props {
  title?: string;
  items?: RailItem[];
  links?: RailLink[];
  cta?: Cta;
}

const {
  title = "Page Context",
  items = [],
  links = [],
  cta,
} = Astro.props;
---

<div class="grid gap-6">
  <section class="rounded-3xl border border-base-200 bg-white p-6 shadow-sm">
    <p class="border-l border-accent-500 pl-4 text-xs font-medium uppercase tracking-[0.18em] text-base-500">
      {title}
    </p>

    {items.length > 0 && (
      <dl class="mt-6 grid gap-5">
        {items.map((item) => (
          <div class="border-b border-base-100 pb-5 last:border-b-0 last:pb-0">
            <dt class="text-xs font-medium uppercase tracking-[0.16em] text-base-400">
              {item.label}
            </dt>
            <dd class="mt-2 text-sm leading-6 text-base-800">
              {item.value}
            </dd>
          </div>
        ))}
      </dl>
    )}
  </section>

  {cta && (
    <a
      href={cta.href}
      class="group block rounded-3xl border border-accent-400 bg-accent-50 p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-accent-600 hover:bg-accent-100 hover:shadow-md"
    >
      {cta.label && (
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-accent-700">
          {cta.label}
        </p>
      )}

      <h2 class="mt-4 font-display text-2xl font-medium uppercase leading-none tracking-tight text-base-950">
        {cta.title}
      </h2>

      {cta.description && (
        <p class="mt-4 text-sm leading-6 text-base-700">
          {cta.description}
        </p>
      )}

      <span class="mt-6 inline-flex text-sm font-medium text-base-950 transition-transform duration-300 group-hover:translate-x-1">
        Request Briefing →
      </span>
    </a>
  )}

  {links.length > 0 && (
    <section class="rounded-3xl border border-base-200 bg-white p-6 shadow-sm">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-base-500">
        Related Architecture
      </p>

      <nav class="mt-5 grid gap-3" aria-label="Authority page related links">
        {links.map((link) => (
          <a
            href={link.href}
            class="group flex items-center justify-between gap-4 rounded-2xl border border-base-100 bg-base-50 px-4 py-3 text-sm font-medium text-base-800 transition-all duration-300 hover:border-accent-400 hover:bg-white hover:text-base-950"
          >
            <span>{link.label}</span>
            <span class="text-accent-600 transition-transform duration-300 group-hover:translate-x-1">
              →
            </span>
          </a>
        ))}
      </nav>
    </section>
  )}
</div>
